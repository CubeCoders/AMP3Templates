      "setting.AsyncTaskTimeout.desc": "Sets the \u0022AsyncTaskTimeout\u0022 parameter for Engine.ini. This can be helpful for resolving connection issues (Linux only)",
      "setting.FiberFoliageRespawn.name": "Enable Fiber Foliage Respawn",
      "setting.FiberFoliageRespawn.desc": "If set, respawn of fiber foliage will be enabled",
      "setting.FiberFoliageRespawn.value.False": "False",
      "setting.FiberFoliageRespawn.value.True": "True",
      "setting.LargeStonesRespawn.name": "Enable Large Stones Respawn",
