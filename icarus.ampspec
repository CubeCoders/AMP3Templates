      "setting.ShutdownIfNotJoinedFor.name": "No Join Shutdown Interval",
      "setting.ShutdownIfNotJoinedFor.desc": "Sets the period after which the server will exit a prospect and return to the lobby, if no player has joined. -1 = run indefinitely, 0 = return to lobby immediately, \u003E0 = interval for shutdown. Note that data loss/corruption may occur if the server is shut down in AMP before returning to the lobby",
      "setting.ShutdownIfEmptyFor.name": "Empty Shutdown Interval",
      "setting.ShutdownIfEmptyFor.desc": "Sets the period after which the server will exit a prospect and return to the lobby, if the server becomes empty. -1 = run indefinitely, 0 = return to lobby immediately, \u003E0 = interval for shutdown. Note that data loss/corruption may occur if the server is shut down in AMP before returning to the lobby",
      "setting.AllowNonAdminsToLaunchProspects.name": "Allow Non-Admins To Load Prospects",
      "setting.AllowNonAdminsToLaunchProspects.desc": "If set, anyone who joins the lobby can create a new prospect or load an existing one. Otherwise, only admins can",
      "setting.AllowNonAdminsToLaunchProspects.value.False": "False",
      "setting.AllowNonAdminsToLaunchProspects.value.True": "True",
      "setting.AllowNonAdminsToDeleteProspects.name": "Allow Non-Admins To Delete Prospects",
      "setting.AllowNonAdminsToDeleteProspects.desc": "If set, anyone who joins the lobby can delete existing prospects from the server. Otherwise, only admins can",
      "setting.AllowNonAdminsToDeleteProspects.value.False": "False",
      "setting.AllowNonAdminsToDeleteProspects.value.True": "True",
