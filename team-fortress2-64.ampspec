{
  "Id": "1fe85447-6ec1-46e2-9f8c-2b6b2dda7c6b",
  "TemplateSlug": "team-fortress2-64",
  "Lifecycle": {
    "RootDir": "./tf2/",
    "BaseDirectory": "./tf2/232250/",
    "ExecutableWin": "232250\\srcds_win64.exe",
    "ExecutableLinux": "232250/srcds_linux64",
    "WorkingDir": "232250",
    "CommandLineArgs": "{{$PlatformArgs}} -game tf -console -usercon -nobreakpad -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} {{insecure}}{{nohltv}}{{CustomParameters}} {{CustomConVars}} \u002Btv_port {{$SourceTVPort}} \u002Bclientport {{$ClientPort}} \u002Bsv_logfile 1 {{$FormattedArgs}} \u002Bexec server.cfg \u002Bmap {{map}} \u002Blog on \u002Blogaddress_add {{$UDPLogAddress}}:{{$UDPLogPort}}",
    "ApplicationReadyMode": "RCONConnected",
    "ExitString": "quit",
    "ExitFile": "lock"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "UDPLogger": true,
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "ForceIPBinding": true,
    "MaxUsers": 8,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullBaseDir}}bin:{{$FullBaseDir}}bin/linux64:{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%",
      "SteamAppId": "440"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "NotSupported",
    "Author": "Greelan",
    "URL": "https://www.teamfortress.com/",
    "DisplayImageSource": "steam:440",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "6",
    "MinAMPVersion": "2.5.0.4",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^Connection to Steam servers successful\\.$",
    "UserJoinRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C\u003E\u0022 entered the game$",
    "UserLeaveRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C.*\u003E\u0022 disconnected \\(reason \u0022.*\u0022\\)$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "ServerPort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "ServerPort",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "232250",
      "UpdateSourceArgs": "440"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server.cfg Template File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/team-fortress2-64/server.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullRootDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Metamod Download",
      "UpdateSourceData": "{{MetamodBuild.downloadUrl}}-linux.tar.gz",
      "UpdateSourceArgs": "metamod.tar.gz",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Metamod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{MetamodBuild.downloadUrl}}-windows.zip",
      "UpdateSourceArgs": "metamod.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourceData": "{{$FullRootDir}}metamod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}tf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullRootDir}}metamod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}tf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "SourceMod Download Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}sm",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourceData": "{{SourceModVersion.downloadUrl}}-linux.tar.gz",
      "UpdateSourceArgs": "sourcemod.tar.gz",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{SourceModVersion.downloadUrl}}-windows.zip",
      "UpdateSourceArgs": "sourcemod.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourceData": "{{$FullRootDir}}sourcemod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullRootDir}}sourcemod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022Set-Location -Path \u0027tf2/232250\u0027; if (Test-Path \u0027tf/cfg/sourcemod\u0027) { Remove-Item -Path \u0027sm/cfg/sourcemod\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027tf/addons/sourcemod/configs\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/configs\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027tf/addons/sourcemod/plugins\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/plugins\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; Copy-Item -Path \u0027sm/*\u0027 -Destination \u0027tf\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; Remove-Item -Path \u0027sm\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd tf2/232250 \u0026\u0026 [ -d tf/cfg/sourcemod ] \u0026\u0026 rm -rf sm/cfg/sourcemod \u003E/dev/null 2\u003E\u00261; [ -d tf/addons/sourcemod/configs ] \u0026\u0026 rm -rf sm/addons/sourcemod/configs \u003E/dev/null 2\u003E\u00261; [ -d tf/addons/sourcemod/plugins ] \u0026\u0026 rm -rf sm/addons/sourcemod/plugins \u003E/dev/null 2\u003E\u00261; \\cp -rf sm/* tf/ \u003E/dev/null 2\u003E\u00261; rm -rf sm \u003E/dev/null 2\u003E\u00261\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../tf/addons/metamod/bin/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}tf/addons/metamod.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../tf/addons/metamod/bin/win64/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}tf/addons/metamod_x64.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../tf/addons/metamod/bin/linux64/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}tf/addons/metamod_x64.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C cd tf2\\232250\\tf\\addons \u003E NUL 2\u003E\u00261 \u0026\u0026 del /Q /F metamod.vdf metamod_x64.vdf \u003E NUL 2\u003E\u00261 \u0026 exit /b 0",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd tf2/232250/tf/addons \u003E/dev/null 2\u003E\u00261 \u0026\u0026 rm -rf metamod.vdf metamod_x64.vdf \u003E/dev/null 2\u003E\u00261; exit 0\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false",
      "SkipOnFailure": true
    }
  ],
  "PreStartStages": [
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../tf/addons/metamod/bin/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}tf/addons/metamod.vdf",
