{
  "Id": "0ff28908-3b0b-4cd4-b9bd-0d468d676032",
  "TemplateSlug": "v-rising",
  "Lifecycle": {
    "RootDir": "./v-rising/",
    "BaseDirectory": "./v-rising/1829350/",
    "ExecutableWin": "1829350\\VRisingServer.exe",
    "ExecutableLinux": "/usr/bin/xvfb-run",
    "WorkingDir": "1829350",
    "LinuxCommandLineArgs": "-a \u0022{{$FullRootDir}}.proton/proton\u0022 runinprefix \u0022./VRisingServer.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} -persistentDataPath \u0022{{$FullBaseDir}}save-data\u0022 -lanMode {{lanMode}}",
    "CommandLineParameterFormat": "-{0} \u0022{1}\u0022",
    "ApplicationReadyMode": "RCONConnected",
    "MonitorChildProcessName": "^.*Z:\\\\.*VRisingServer\\.exe -persistentDataPath {{$FullBaseDir}}save-data.*$",
    "ExitMethod": "OS_CLOSE",
    "ExitString": "stop",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "RCONConnectDelaySeconds": 30,
    "RCONHeartbeatMinutes": 4,
    "RCONHeartbeatCommand": "ping",
    "MaxUsers": 40,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullBaseDir}}linux64:%LD_LIBRARY_PATH%",
      "SteamAppId": "1604030",
      "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam",
      "HOME": "{{$FullBaseDir}}",
      "WINEDLLOVERRIDES": "winhttp=n,b",
      "BOX64_DYNAREC_STRONGMEM": "1",
      "BOX64_DYNAREC_BIGBLOCK": "0",
      "BOX64_DYNAREC_FASTNAN": "1",
      "BOX64_DYNAREC_FASTROUND": "1",
      "BOX64_LOG": "0"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "Emulated",
    "Author": "Greelan, IceOfWraith",
    "URL": "https://store.steampowered.com/app/1604030/V_Rising/",
    "DisplayImageSource": "steam:1604030",
    "EndpointURIFormat": "steam://connect/{ip}:{GenericModule.App.Ports.$ApplicationPort2}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux",
    "ContainerPolicyReason": "The server requires Xvfb to install and run on Linux. Using a container avoids the need for you to install this dependency on the host.",
    "ConfigVersion": "10",
    "MinAMPVersion": "2.8.0.4"
  },
  "Console": {
    "ThrowawayMessageRegex": "^((WARNING|ERROR): Shader.\u002B|Could not find Wine Gecko.*|\\[rcon\\] .* sent packet ExecCommand!|Invalid command \u0022ping\u0022)$",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^User \u0027{Steam (?\u003Cuserid\u003E\\d\u002B)}\u0027 \u0027\\d\u002B\u0027, approvedUserIndex: \\d\u002B, Character: \u0027(?\u003Cusername\u003E.\u002B?)?\u0027 connected as ID \u0027\\d\u002B,\\d\u002B\u0027, Entity \u0027[\\d,]\u002B\u0027\\.$",
    "UserLeaveRegex": "^User \u0027{Steam (?\u003Cuserid\u003E\\d\u002B)}\u0027 disconnected. approvedUserIndex: \\d\u002B Reason: (.\u002B?) (.\u002B?)$",
    "UserChatRegex": " ",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "PrimaryApplicationPortRef": "ApplicationPort1",
    "UniversalSleepApplicationUDPPortRef": "ApplicationPort1",
    "UniversalSleepSteamQueryPortRef": "ApplicationPort2"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "1829350",
      "UpdateSourceArgs": "1604030",
      "UpdateSourceVersion": "{{ReleaseStream}}",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Data Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}save-data/Settings"
    },
    {
      "UpdateSource": "CopyFilePath",
      "UpdateStageName": "Game Config File Copy",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{$FullBaseDir}}save-data/Settings/ServerHostSettings.json",
      "UpdateSourceArgs": "{{$FullBaseDir}}VRisingServer_Data/StreamingAssets/Settings/ServerHostSettings.json"
    },
    {
      "UpdateSource": "CopyFilePath",
      "UpdateStageName": "Game Config File Copy",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{$FullBaseDir}}save-data/Settings/ServerGameSettings.json",
      "UpdateSourceArgs": "{{$FullBaseDir}}VRisingServer_Data/StreamingAssets/Settings/ServerGameSettings.json"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "BepInEx Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{BepInExVersion.downloadUrl}}",
      "UpdateSourceArgs": "BepInEx.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "BepInExEnabled",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "BepInEx Extract",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{$FullRootDir}}BepInEx.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "BepInExEnabled",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "BepInEx Copy",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C xcopy /E /Y /I v-rising\\1829350\\BepInExPack_V_Rising\\* v-rising\\1829350\\ \u0026\u0026 rmdir /Q /S v-rising\\1829350\\BepInExPack_V_Rising",
      "UpdateSourceConditionSetting": "BepInExEnabled",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "BepInEx Copy",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022\\cp -rf ./v-rising/1829350/BepInExPack_V_Rising/* ./v-rising/1829350/ \u0026\u0026 rm -rf ./v-rising/1829350/BepInExPack_V_Rising/\u0022",
      "UpdateSourceConditionSetting": "BepInExEnabled",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "Proton",
      "UpdateStageName": "Proton GE Download",
      "UpdateSourceVersion": "{{SpecificReleaseVersion}}"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Prefix Sound",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullRootDir}}\\\u0022 \u0026\u0026 export PATH=\\\u0022{{$FullRootDir}}.proton/files/bin:$PATH\\\u0022; export WINEPREFIX=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx\\\u0022; export WINEARCH=win64; ./.proton/protonfixes/winetricks sound=disabled \u003E winescript_log.txt 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ApplicationPort1.name",
      "Description": "port.ApplicationPort1.desc",
      "Ref": "ApplicationPort1",
      "Port": 9876,
      "Protocol": "UDP",
      "ChildPorts": null
    },
    {
      "Name": "port.ApplicationPort2.name",
      "Description": "port.ApplicationPort2.desc",
      "Ref": "ApplicationPort2",
      "Port": 9877,
      "Protocol": "UDP",
      "ChildPorts": null
    },
    {
      "Name": "port.APIPort.name",
      "Description": "port.APIPort.desc",
      "Ref": "APIPort",
      "Port": 9090,
      "ChildPorts": null
    },
    {
      "Name": "port.RemoteAdminPort.name",
      "Description": "port.RemoteAdminPort.desc",
      "Ref": "RemoteAdminPort",
      "Port": 25575,
      "ChildPorts": null
    }
  ],
  "VersionSources": [
    {
      "Id": "bepinex.versions",
      "Url": "https://thunderstore.io/c/v-rising/api/v1/package/b86fcaaf-297a-45c8-82a0-fcbd7806fdc4/",
      "Select": "$.versions[*]",
      "Value": "$.version_number",
      "UrlTemplate": "https://gcdn.thunderstore.io/live/repository/packages/BepInEx-BepInExPack_V_Rising-{value}.zip",
      "Sort": "VersionDescending"
    },
    {
      "Id": "protonge.releases",
      "Url": "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases?per_page=100",
      "Format": "Text",
      "Select": "\u0022browser_download_url\u0022\\s*:\\s*\u0022(?\u003Curl\u003Ehttps://github\\.com/GloriousEggroll/proton-ge-custom/releases/download/(?\u003Ctag\u003EGE-Proton[0-9]\u002B-[0-9]\u002B)/\\k\u003Ctag\u003E(?:-x86_64)?\\.tar\\.gz)\u0022",
      "Value": "tag",
      "Fields": {
        "downloadUrl": "url"
      },
      "Sort": "VersionDescending"
    }
  ],
