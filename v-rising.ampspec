    },
    {
      "ConfigFile": "save-data/Settings/ServerGameSettings.json",
      "ConfigType": "json",
      "AutoMap": true
    },
    {
      "ConfigFile": "doorstop_config.ini",
      "ConfigFormat": "{0} = {1}",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?) = (?\u003Cvalue\u003E.*?)$",
      "ConfigType": "ini",
      "AutoMap": true
    },
    {
      "ConfigFile": "doorstop_config.ini",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E[^ ]\u002B?)=(?\u003Cvalue\u003E[^ ]*?)$",
