{
  "Id": "1e6029aa-85d5-4804-8b4d-5e40f7d3696a",
  "TemplateSlug": "minecraft-packwiz",
  "Lifecycle": {
    "RootDir": "./minecraft/",
    "BaseDirectory": "./minecraft/",
    "ExecutableWin": "{{JavaPath}}",
    "ExecutableLinux": "{{JavaPath}}",
    "ExecutableContainer": "java:{{JavaVersion}}",
    "CommandLineArgs": "-Xms{{MinMemory}}M -Xmx{{MaxMemory}}M {{CustomJavaArgs}} -jar {{ServerJar}} nogui",
    "CommandLineParameterFormat": "--{0}={1}",
    "SupportsUniversalSleep": true,
    "ExitTimeout": 60,
    "ExitString": "stop",
    "QuiescenceCommand": "save-off;save-all flush",
    "DequiescenceCommand": "save-on",
    "QuiesceAckRegex": "Saved the game|All dimensions are saved",
    "QuiesceSettleDelayMilliseconds": 30000
  },
  "Management": {
    "SupportsIPv6": true,
    "MaxUsers": 20
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "URL": "https://www.minecraft.net/",
    "DisplayImageSource": "internal:MinecraftJava",
    "EndpointURIFormat": "",
    "SpecificDockerImage": "cubecoders/amp3base:java-lts",
    "EULALocation": "https://www.minecraft.net/en-us/eula",
    "ConfigVersion": "1"
  },
  "Console": {
    "FilterMatchRegex": "^>+\\s*",
    "ThrowawayMessageRegex": "^\\s*>+\\s*$",
    "AppReadyRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: Done \\([\\d.,]+s\\)! For help, type \"help\"",
    "PreConnectRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: UUID of player (?<id>[^ ]+) is (?<userid>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
    "UserIdKind": "minecraft-uuid",
    "UserJoinRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<username>[^ ]+?)\\[\\/(?<endpoint>.+?)\\] logged in with entity id",
    "UserLeaveRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<username>[^ ]+?) left the game$",
    "UserChatRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: <(?<username>.+?)> (?<message>.+)$",
    "MetricsRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: Can't keep up! Is the server overloaded\\? Running (?<Lag>\\d+)ms or \\d+ ticks behind$",
    "StartupProgressRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<stage>Preparing spawn area): (?<PercentageComplete>\\d+)%$",
    "LogRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: (?<level>[A-Z]+))?\\](?: \\[(?<origin>[^\\]]*?)(?:\\/(?<level>[A-Z]+))?\\])?(?: \\[[^\\]]*\\])?: (?<message>.*)$"
  },
  "PortReferences": {
    "PrimaryApplicationPortRef": "ServerPort"
  },
  "UpdateStages": [
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Packwiz Script Download",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "https://raw.githubusercontent.com/ivybowman/AMP3Packwiz/main/scripts/minecraft-packwiz/packwiz.sh",
      "UpdateSourceArgs": "packwiz.sh",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Packwiz Script Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "https://raw.githubusercontent.com/ivybowman/AMP3Packwiz/main/scripts/minecraft-packwiz/packwiz.ps1",
      "UpdateSourceArgs": "packwiz.ps1",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Pack Server Install",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "./packwiz.sh install \"{{$FullBaseDir}}\" \"{{PackwizUrl}}\" \"{{JavaPath}}\"",
      "SkipOnFailure": false
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Pack Server Install",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -File \"packwiz.ps1\" install \"{{$FullBaseDir}}\" \"{{PackwizUrl}}\" \"{{JavaPath}}\"",
      "SkipOnFailure": false
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Packwiz Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}packwiz-installer"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Packwiz Installer Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{PackwizInstallerVersion.downloadUrl}}",
      "UpdateSourceArgs": "packwiz-installer.jar",
      "UpdateSourceTarget": "{{$FullBaseDir}}packwiz-installer/",
      "OverwriteExistingFiles": true
    }
  ],
  "PreStartStages": [
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Packwiz Pack Sync",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "./packwiz.sh sync \"{{$FullBaseDir}}\" \"{{PackwizUrl}}\" \"{{JavaPath}}\" \"{{JavaVersion}}\"",
      "SkipOnFailure": false
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Packwiz Pack Sync",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -File \"packwiz.ps1\" sync \"{{$FullBaseDir}}\" \"{{PackwizUrl}}\" \"{{JavaPath}}\" \"{{JavaVersion}}\"",
      "SkipOnFailure": false
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 25565,
      "Protocol": "Both"
    },
    {
      "Name": "port.RemoteAdminPort.name",
      "Description": "port.RemoteAdminPort.desc",
      "Ref": "RemoteAdminPort",
      "Port": 25575,
      "Required": false
    }
  ],
  "VersionSources": [
    {
      "Id": "packwiz.installer",
      "Url": "https://maven.packwiz.infra.link/repository/release/link/infra/packwiz/packwiz-installer/maven-metadata.xml",
      "Format": "Xml",
      "Select": "//versions/version",
      "Value": "text()",
      "UrlTemplate": "https://maven.packwiz.infra.link/repository/release/link/infra/packwiz/packwiz-installer/{value}/packwiz-installer-{value}-dist.jar",
      "CacheMinutes": 240
    }
  ],
  "Settings": [
    {
