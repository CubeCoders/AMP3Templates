  ],
  "ConfigFileMappings": [
    {
      "ConfigFile": "server.properties",
      "ConfigFormat": "{0}={1}",
      "ConfigType": "kvp",
      "Subsections": [
        {
          "Heading": "$root",
          "SettingMappings": {},
          "AutoMap": true
        }
      ],
      "AutoMap": true,
      "Importable": true
    },
    {
      "ConfigFile": "eula.txt",
      "ConfigFormat": "{0}={1}",
      "ConfigType": "kvp",
      "Subsections": [
        {
          "Heading": "$root",
          "SettingMappings": {
            "eula": "eula"
          }
        }
      ]
    }
  ],
  "BackupExclusions": [
    "logs/",
    "crash-reports/",
    "*.log",
    "*.log.gz",
    "hs_err_pid*.log",
    "debug/",
    "packwiz-installer/"
  ],
  "Events": [
    {
      "Id": "blockPlaced",
      "Name": "event.blockPlaced.name",
      "Description": "event.blockPlaced.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: \\[(?<User>[^\\]]+?): Changed the block at (?<Position>(?<X>-?\\d+), (?<Y>-?\\d+), (?<Z>-?\\d+))\\]",
      "ParamMap": {
        "User": {
          "Name": "event.blockPlaced.param.User.name",
          "Description": "event.blockPlaced.param.User.desc"
        },
        "Position": {
          "Name": "event.blockPlaced.param.Position.name",
          "Description": "event.blockPlaced.param.Position.desc"
        }
      }
    },
    {
      "Id": "advancementMade",
      "Name": "event.advancementMade.name",
      "Description": "event.advancementMade.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<User>\\S+) has made the advancement \\[(?<Advancement>.+?)\\]$"
    },
    {
      "Id": "goalReached",
      "Name": "event.goalReached.name",
      "Description": "event.goalReached.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<User>\\S+) has reached the goal \\[(?<Goal>.+?)\\]$"
    },
    {
      "Id": "challengeCompleted",
      "Name": "event.challengeCompleted.name",
      "Description": "event.challengeCompleted.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<User>\\S+) has completed the challenge \\[(?<Challenge>.+?)\\]$"
    },
    {
      "Id": "achievementEarned",
      "Name": "event.achievementEarned.name",
      "Description": "event.achievementEarned.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<User>\\S+) has just earned the achievement \\[(?<Achievement>.+)\\]$"
    },
    {
      "Id": "userKilled",
      "Name": "event.userKilled.name",
      "Description": "event.userKilled.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: (?<User>\\S+) was (?<Cause>.+?) by (?<Killer>.+)$",
      "ParamMap": {
        "User": {
          "Name": "event.userKilled.param.User.name",
          "Description": "event.userKilled.param.User.desc"
        },
        "Cause": {
          "Name": "event.userKilled.param.Cause.name",
          "Description": "event.userKilled.param.Cause.desc"
        },
        "Killer": {
          "Name": "event.userKilled.param.Killer.name",
          "Description": "event.userKilled.param.Killer.desc"
        }
      }
    },
    {
      "Id": "serverLagging",
      "Name": "event.serverLagging.name",
      "Description": "event.serverLagging.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\]){0,2}: Can't keep up! (?:Is the server overloaded\\? Running (?<MillisecondsBehind>\\d+)ms or (?<TicksSkipped>\\d+) ticks? behind|Did the system time change, or is the server overloaded\\? Running (?<MillisecondsBehind>\\d+)ms behind, skipping (?<TicksSkipped>\\d+) tick\\(?s?\\)?)$",
      "ParamMap": {
        "MillisecondsBehind": {
          "Name": "event.serverLagging.param.MillisecondsBehind.name",
          "Description": "event.serverLagging.param.MillisecondsBehind.desc"
        },
        "TicksSkipped": {
          "Name": "event.serverLagging.param.TicksSkipped.name",
          "Description": "event.serverLagging.param.TicksSkipped.desc"
        }
      }
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Minecraft: Packwiz",
      "meta.description": "packwiz is a command line tool for creating Minecraft modpacks.",
      "category.server-version": "Server Version",
      "setting.eula.name": "Minecraft EULA",
      "setting.eula.desc": "Whether the Minecraft EULA has been accepted.",
      "setting.JavaVersion.name": "Java Version",
      "setting.JavaVersion.desc": "Which Java version to run the server with. Each Minecraft version needs a particular Java version: Update and every start print the one this pack needs, and warn when another one is selected. Minecraft 1.12 to 1.16 needs Java 8, 1.17 to 1.20.4 Java 17, 1.20.5 to 1.21 Java 21, 26 Java 25.",
      "category.java": "Java",
      "setting.JavaVersion.value.25": "25 - LTS (current Minecraft)",
      "setting.JavaVersion.value.21": "21 - LTS",
      "setting.JavaVersion.value.17": "17 - LTS",
      "setting.JavaVersion.value.11": "11 - LTS",
      "setting.JavaVersion.value.8": "8 - legacy modpacks",
      "setting.JavaPath.name": "Java Version",
      "setting.JavaPath.desc": "Which installed Java to run the server with. Each Minecraft version needs a particular Java version: Update and every start print the one this pack needs, and warn when another one is selected.",
      "setting.MinMemory.name": "Memory pre-allocation",
      "setting.MinMemory.desc": "Java's minimum heap size. Must be lower than the maximum heap size.",
      "setting.MaxMemory.name": "Memory Limit",
      "setting.MaxMemory.desc": "Java's maximum heap size. Must be greater than the minimum heap size.",
      "setting.CustomJavaArgs.name": "Additional java options",
      "setting.CustomJavaArgs.desc": "Extra arguments to pass to Java, in addition to the ones AMP always uses (memory and the server jar).",
      "setting.ServerJar.name": "Server JAR",
      "setting.ServerJar.desc": "Which jar file to start. [Automatic] uses server.jar, which Update installs for the pack: the Vanilla server, the Fabric launcher, or NeoForge's server starter for Forge and NeoForge.",
      "setting.motd.name": "MOTD",
      "setting.motd.desc": "Headline to show in the server list.",
      "category.server": "Server",
      "setting.$MaxUsers.name": "Maximum players",
      "setting.$MaxUsers.desc": "How many players can be connected at once.",
      "setting.gamemode.name": "Game Mode",
      "setting.gamemode.desc": "The default game mode for players on the server",
      "setting.gamemode.value.survival": "Survival",
      "setting.gamemode.value.creative": "Creative",
      "setting.gamemode.value.adventure": "Adventure",
      "setting.gamemode.value.spectator": "Spectator",
      "setting.difficulty.name": "Difficulty",
      "setting.difficulty.desc": "How difficult the game is for players in survival mode",
      "setting.difficulty.value.peaceful": "Peaceful",
      "setting.difficulty.value.easy": "Easy",
      "setting.difficulty.value.normal": "Normal",
      "setting.difficulty.value.hard": "Hard",
      "setting.level-seed.name": "World Seed",
      "setting.level-seed.desc": "Seed value to use for the world generator.",
      "category.world": "World",
      "setting.level-name.name": "Level Name",
      "setting.level-name.desc": "Which world should the Minecraft server be started with.",
      "setting.view-distance.name": "View Distance",
      "setting.view-distance.desc": "How far ahead clients can request chunk data. Higher values may degrade performance.",
      "setting.allow-nether.name": "Enable 'The Nether'",
      "setting.allow-nether.desc": "Whether or not 'The Nether' can be accessed via portals.",
      "setting.online-mode.name": "Standalone Server",
      "setting.online-mode.desc": "Disable this setting if the server is connected to via a proxy such as Velocity or Bungeecord. Make sure the server is not accessible directly when disabled and can only be accessed via the proxy.",
      "category.networking": "Networking",
      "setting.white-list.name": "Use Whitelist",
      "setting.white-list.desc": "Controls who can access the server.",
      "category.players": "Players",
      "setting.allow-flight.name": "Allow Flight",
      "setting.allow-flight.desc": "Whether or not to allow players to use fly-hacks in survival mode.",
      "setting.pvp.name": "Allow Player v.s. Player combat (PvP)",
      "setting.pvp.desc": "Control whether or not players may fight each other.",
      "setting.server-port.name": "Game Port",
      "setting.server-port.desc": "Which port number the IP address should accept requests on.",
      "setting.enable-rcon.name": "Enable RCON",
      "setting.enable-rcon.desc": "Allow remote console connections on the RCON port.",
      "setting.rcon.port.name": "RCON port",
      "setting.rcon.port.desc": "The remote console port. Managed by AMP.",
      "setting.enable-query.name": "Enable query",
      "setting.enable-query.desc": "Answer server-list query requests, so tools can read the player count.",
      "setting.hardcore.name": "Hardcore Mode",
      "setting.hardcore.desc": "Permanently ban players upon death.",
      "setting.force-gamemode.name": "Force Game Mode",
      "setting.force-gamemode.desc": "Force users to use the default game mode when they connect regardless of their state when they left",
      "setting.player-idle-timeout.name": "Player idle timeout minutes",
      "setting.player-idle-timeout.desc": "How many minutes a player may stand idle/away before being kicked. (0 to disable)",
      "setting.enable-status.name": "Enable Status",
      "setting.enable-status.desc": "If disabled, servers will always appear 'offline' in the server list unless players connect. This will also disable AMPs sleep mode.",
      "setting.hide-online-players.name": "Hide Online Players",
      "setting.hide-online-players.desc": "If enabled, the list of online players will not be included in server status requests",
      "setting.snooper-enabled.name": "Allow Analytics",
      "setting.snooper-enabled.desc": "If enabled, the Minecraft server will automatically send data back to Mojang",
      "setting.announce-player-achievements.name": "Announce Player Achievements",
      "setting.announce-player-achievements.desc": "Whether or not to publicly announce when a player completes an achievement",
      "setting.max-tick-time.name": "Max tick time",
      "setting.max-tick-time.desc": "The maximum number of milliseconds a single tick may take before the server watchdog stops the server.",
      "setting.enable-command-block.name": "Allow Command Blocks",
      "setting.enable-command-block.desc": "Whether or not command blocks are permitted in-game.",
      "setting.op-permission-level.name": "Op permission level",
      "setting.op-permission-level.desc": "What permissions 'opped' players have.",
      "setting.op-permission-level.value.1": "1 - Bypass spawn protection",
      "setting.op-permission-level.value.2": "2 - Change game settings",
      "setting.op-permission-level.value.3": "3 - Kick, ban and op players",
      "setting.op-permission-level.value.4": "4 - Stop the server",
      "setting.function-permission-level.name": "Function permission level",
      "setting.function-permission-level.desc": "What permissions functions have when executed by in-game actions",
      "setting.function-permission-level.value.1": "1 - Bypass spawn protection",
      "setting.function-permission-level.value.2": "2 - Change game settings",
      "setting.function-permission-level.value.3": "3 - Kick, ban and op players",
      "setting.function-permission-level.value.4": "4 - Stop the server",
      "setting.spawn-protection.name": "Spawn Protection Radius",
      "setting.spawn-protection.desc": "The radius around the spawn point that is protected.",
      "setting.level-type.name": "World Type",
      "setting.level-type.desc": "The type of terrain the server should generate. You can also type a value of your own if a mod or plugin provides one.",
      "setting.level-type.value.minecraft:normal": "Standard",
      "setting.level-type.value.minecraft:flat": "Flat",
      "setting.level-type.value.minecraft:large_biomes": "Large biomes",
      "setting.level-type.value.minecraft:amplified": "Amplified",
      "setting.level-type.value.minecraft:single_biome_surface": "Single biome",
      "setting.generator-settings.name": "World Generator Settings",
      "setting.generator-settings.desc": "Controls how the world generator will build the world. Requires the 'Flat' world type to be set.",
      "setting.generate-structures.name": "Generate Structures",
      "setting.generate-structures.desc": "Whether or not structures such as villages or mineshafts will be created",
      "setting.max-world-size.name": "Maximum World Size",
      "setting.max-world-size.desc": "How far from the centre the world border can reach.",
      "setting.max-build-height.name": "Max build height",
      "setting.max-build-height.desc": "The highest number of blocks above the ground that players may place blocks. (Removed in 1.17 and newer)",
      "setting.spawn-monsters.name": "Allow Monsters",
      "setting.spawn-monsters.desc": "Whether or not monsters (such as zombies and skeletons) spawn in-game.",
      "setting.spawn-animals.name": "Allow Animals",
      "setting.spawn-animals.desc": "Whether or not friendly animals (such as cows and pigs) spawn in-game.",
      "setting.spawn-npcs.name": "Allow NPCs",
      "setting.spawn-npcs.desc": "Whether or not friendly mobs (such as villagers) spawn in-game.",
      "setting.resource-pack.name": "Resource Pack URL",
      "setting.resource-pack.desc": "URL of a resource pack .zip file that clients should download and use.",
      "category.resource-pack": "Resource Pack",
      "setting.resource-pack-sha1.name": "Resource Pack Hash",
      "setting.resource-pack-sha1.desc": "A SHA1 Hash of the resource pack to be used in order to verify its integrity.",
      "setting.require-resource-pack.name": "Require Resource Pack",
      "setting.require-resource-pack.desc": "If enabled, this requires the client have the specified resource pack before they connect.",
      "setting.resource-pack-prompt.name": "Resource Pack Prompt",
      "setting.resource-pack-prompt.desc": "The message shown to the user if they do not have the required resource pack when they are prompted for it. JSON formatted.",
      "setting.network-compression-threshold.name": "Network Compression Threshold",
      "setting.network-compression-threshold.desc": "Packets below this size (in bytes) will be sent uncompresesd. Should not be lower than 64 or higher than 1500.",
      "setting.rate-limit.name": "Rate Limit",
      "setting.rate-limit.desc": "Sets the maximum amount of packets a user can send before getting kicked. Setting to 0 disables this feature.",
      "setting.prevent-proxy-connections.name": "Disallow proxied connections",
      "setting.prevent-proxy-connections.desc": "Tries to prevent players who are using proxies/VPNs from joining",
      "setting.use-native-transport.name": "Use Native Transport",
      "setting.use-native-transport.desc": "On Linux systems, improve network performance by using optimized packet sending/receiving (Recommended)",
      "setting.accepts-transfers.name": "Accepts Transfers",
      "setting.accepts-transfers.desc": "Allows servers to accept incoming transfers via a transfer packet.",
      "setting.simulation-distance.name": "Simulation Distance",
      "setting.simulation-distance.desc": "How far away (in chunks) entities and blocks are updated. Higher values use more resources",
      "category.performance": "Performance",
      "setting.entity-broadcast-range-percentage.name": "Entity Broadcast Range",
      "setting.entity-broadcast-range-percentage.desc": "Controls how close entities need to be before being sent to clients. Higher values means they'll be rendered from farther away. Expressed as a percentage of the default value.",
      "setting.sync-chunk-writes.name": "Use Synchronous IO",
      "setting.sync-chunk-writes.desc": "When enabled, offers better data protection in the event of a crash or power outage at the expense of slightly slower read/write times",
      "setting.max-chained-neighbor-updates.name": "Max chained neighbour updates",
      "setting.max-chained-neighbor-updates.desc": "The maximum number of consecutive neighbours that can be updated before skipping them. Set to a negative number to disable.",
      "setting.region-file-compression.name": "Region File Compression",
      "setting.region-file-compression.desc": "Changes the algorithm for the compression of chunks in regions. \"Deflate\" uses the old algorithm. \"LZ4\" uses less CPU, but more disk space",
      "setting.region-file-compression.value.deflate": "Deflate",
      "setting.region-file-compression.value.lz4": "LZ4",
      "setting.region-file-compression.value.none": "None",
      "setting.enable-jmx-monitoring.name": "Enable JMX monitoring",
      "setting.enable-jmx-monitoring.desc": "Exposes server performance information via MBean",
      "setting.server-ip.name": "Server IP Address",
      "setting.server-ip.desc": "Which IP address the Minecraft server should listen on. Leave blank to use any available interface.",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "port.ServerPort.name": "Server Port",
      "port.ServerPort.desc": "The port players connect to. Minecraft: Java Edition is TCP; the UDP half is only used by query.",
      "port.RemoteAdminPort.name": "RCON Port",
      "port.RemoteAdminPort.desc": "Remote console port, used only when RCON is enabled.",
      "event.blockPlaced.name": "A block is changed by a command",
      "event.blockPlaced.desc": "When a command or a command block changes a block in the world. The user named is whoever ran the command.",
      "event.blockPlaced.param.User.name": "User",
      "event.blockPlaced.param.User.desc": "The user who ran the command.",
      "event.blockPlaced.param.Position.name": "Position",
      "event.blockPlaced.param.Position.desc": "All three coordinates together, exactly as the server wrote them.",
      "event.advancementMade.name": "A user makes an advancement",
      "event.advancementMade.desc": "When a user completes one of the advancements the game sets for them.",
      "event.goalReached.name": "A user reaches a goal",
      "event.goalReached.desc": "When a user reaches a goal. The game announces these separately from advancements.",
      "event.challengeCompleted.name": "A user completes a challenge",
      "event.challengeCompleted.desc": "When a user finishes a challenge, which are the hardest things the game asks of them.",
      "event.achievementEarned.name": "A user earns an achievement",
      "event.achievementEarned.desc": "When a user earns an achievement. Only older versions of Minecraft have achievements, and newer ones announce advancements instead.",
      "event.userKilled.name": "A user is killed",
      "event.userKilled.desc": "When a user is killed by something the game can name. Deaths it does not blame on anything, such as a long fall, are not included.",
      "event.userKilled.param.User.name": "User",
      "event.userKilled.param.User.desc": "The user who died.",
      "event.userKilled.param.Cause.name": "Cause",
      "event.userKilled.param.Cause.desc": "How they died, in the game's own words.",
      "event.userKilled.param.Killer.name": "Killer",
      "event.userKilled.param.Killer.desc": "What or who killed them.",
      "event.serverLagging.name": "The server falls behind",
      "event.serverLagging.desc": "When the server says it cannot keep up. A struggling server can say this many times in a row, so whatever you have it do should be safe to repeat.",
      "event.serverLagging.param.MillisecondsBehind.name": "Milliseconds behind",
      "event.serverLagging.param.MillisecondsBehind.desc": "How far behind the server had fallen when it noticed.",
      "event.serverLagging.param.TicksSkipped.name": "Ticks skipped",
      "event.serverLagging.param.TicksSkipped.desc": "How many turns of the world the server had to skip to catch up.",
      "category.packwiz": "Packwiz",
      "setting.PackwizUrl.name": "Pack URL",
      "setting.PackwizUrl.desc": "The link to the packwiz modpack: its pack.toml file, or the GitHub folder or page that holds it (for example https://github.com/owner/pack/tree/main). Update installs the server for the Minecraft version and mod loader the pack names (Vanilla, Fabric, Forge 1.17 or newer, or NeoForge). The pack itself is installed and updated every time the server starts, server-side mods only",
      "setting.PackwizInstallerVersion.name": "Packwiz installer version",
      "setting.PackwizInstallerVersion.desc": "Which packwiz-installer version to download. Latest is recommended"
    }
  }
}
