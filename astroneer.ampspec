      "DisplayName": "setting.$ApplicationIPBinding.name",
      "Description": "setting.$ApplicationIPBinding.desc",
      "Keywords": "ip,binding,bind,address,interface",
      "InputType": "text",
      "Placeholder": "0.0.0.0"
    }
  ],
  "ConfigFileMappings": [
    {
      "ConfigFile": "Astro/Saved/Config/WindowsServer/AstroServerSettings.ini",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?)=(?\u003Cvalue\u003E.*?)$",
      "ConfigType": "ini",
      "AutoMap": true
    },
    {
      "ConfigFile": "Astro/Saved/Config/WindowsServer/GameUserSettings.ini",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?)=(?\u003Cvalue\u003E.*?)$",
      "ConfigType": "ini",
      "AutoMap": true
    },
    {
      "ConfigFile": "Astro/Saved/Config/WindowsServer/Engine.ini",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?)=(?\u003Cvalue\u003E.*?)$",
      "ConfigType": "ini",
      "AutoMap": true
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Astroneer",
      "meta.description": "Astroneer Dedicated Server",
      "setting.$RemoteAdminPassword.name": "Console Password",
      "category.astroneer": "Astroneer",
      "category.server": "Server",
      "setting.$ApplicationPort1.name": "Server Port",
      "setting.$RemoteAdminPort.name": "Console Port",
      "setting.ServerName.name": "Server Name",
      "setting.ServerName.desc": "Sets the name of the server as it appears publicly",
      "setting.ServerPassword.name": "Server Password",
      "setting.ServerPassword.desc": "Sets the password required to connect to the server. Default is no password",
      "setting.OwnerName.name": "Owner Name",
      "setting.OwnerName.desc": "Sets the Steam name of the server owner (admin)",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users that may connect to the server at one time",
      "setting.bLoadAutoSave.name": "Load Latest Auto Save",
      "setting.bLoadAutoSave.desc": "If enabled, the server will load the most recent autosave on startup. Otherwise, the save specified under Active Save File Name will be loaded if it exists, or a new autosave will be created",
      "setting.ActiveSaveFileDescriptiveName.name": "Active Save File Name",
      "setting.ActiveSaveFileDescriptiveName.desc": "Sets the descriptive name of an existing save file to load, if Load Latest Auto Save is disabled",
      "setting.AutoSaveGameInterval.name": "Game Save Interval",
      "setting.AutoSaveGameInterval.desc": "Sets the interval between automatic server saves",
      "setting.BackupSaveGamesInterval.name": "Backup Save Interval",
      "setting.BackupSaveGamesInterval.desc": "Sets the interval between automatic server backups",
      "setting.DenyUnlistedPlayers.name": "Enable Whitelist",
      "setting.DenyUnlistedPlayers.desc": "If set, unlisted players will not be able to connect",
      "setting.MaxServerFramerate.name": "Maximum Active Server Framerate",
      "setting.MaxServerFramerate.desc": "Sets the maximum framerate that the server will allow when active",
      "setting.MaxServerIdleFramerate.name": "Maximum Idle Server Framerate",
      "setting.MaxServerIdleFramerate.desc": "Sets the maximum framerate that the server will allow when idle",
      "setting.PublicIP.name": "Public IP Selection Mode",
      "setting.PublicIP.desc": "Sets whether AMP should automatically select the public IP advertised for the server, or whether it should use the IP set under Server Public IP",
