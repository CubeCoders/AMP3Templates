{
  "Id": "2a9f3285-5adc-4574-8a5b-d6ef39e8b7a0",
  "TemplateSlug": "astroneer",
  "Lifecycle": {
    "RootDir": "./astroneer/",
    "BaseDirectory": "./astroneer/728470/",
    "ExecutableWin": "728470\\Astro\\Binaries\\Win64\\AstroServer-Win64-Shipping.exe",
    "ExecutableLinux": ".proton/proton",
    "WorkingDir": "728470/Astro/Binaries/Win64",
    "LinuxCommandLineArgs": "runinprefix \u0022{{$FullBaseDir}}Astro/Binaries/Win64/AstroServer-Win64-Shipping.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} Port={{$ApplicationPort1}} ConsolePort={{$RemoteAdminPort}} {{$FormattedArgs}} -log",
    "CommandLineParameterFormat": "-{0}={1}",
    "ApplicationReadyMode": "RCONConnected",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}Astro\\\\Binaries\\\\Win64\\\\AstroServer-Win64-Shipping\\.exe.*Port={{$ApplicationPort1}}.*$",
    "ExitString": "DSServerShutdown",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "TelnetRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "TailLogFilePath": "server.log",
    "MaxUsers": 8,
    "EnvironmentVariables": {
      "SteamAppId": "361420",
      "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam",
      "HOME": "{{$FullBaseDir}}"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "Emulated",
    "Author": "Greelan, Tueem",
    "URL": "https://store.steampowered.com/app/361420/ASTRONEER/",
    "DisplayImageSource": "steam:361420",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "6",
    "MinAMPVersion": "2.6.2.6"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^$",
    "UserLeaveRegex": "^$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "PrimaryApplicationPortRef": "ApplicationPort1",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "728470",
      "UpdateSourceArgs": "361420",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create Config Directory",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}Astro/Saved/Config/WindowsServer"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server Config Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/astroneer/astroserversettings.ini",
      "UpdateSourceArgs": "AstroServerSettings.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}Astro/Saved/Config/WindowsServer"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Proton GE Download",
      "UpdateSourceData": "{{SpecificReleaseVersion.downloadUrl}}",
      "UpdateSourceTarget": "{{$FullRootDir}}.proton"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Proton GE Installation",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullRootDir}}.proton\\\u0022 \u0026\u0026 mkdir -p compatdata \\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullBaseDir}}.config/protonfixes\\\u0022 || exit 1; ProtonVersion=\\\u0022{{SpecificReleaseVersion}}\\\u0022; Archive=\\\u0022{{SpecificReleaseVersion.downloadUrl}}\\\u0022; Archive=\\\u0022${Archive##*/}\\\u0022; if [[ ! -s \\\u0022$Archive\\\u0022 ]]; then InstalledVersion=\\\u0022\\\u0022; [[ -x proton \u0026\u0026 -f version ]] \u0026\u0026 read _ InstalledVersion \u003C version; if [[ \\\u0022$InstalledVersion\\\u0022 == \\\u0022$ProtonVersion\\\u0022 || \\\u0022$InstalledVersion\\\u0022 == \\\u0022$ProtonVersion\\\u0022-* ]]; then echo \\\u0022Proton GE version $ProtonVersion already installed. Skipping\\\u0022; exit 0; fi; rm -f \\\u0022$Archive\\\u0022; echo \\\u0022Proton GE version $ProtonVersion is not installed. Update again to download it\\\u0022; exit 1; fi; rm -rf compatdata/* \u003E/dev/null 2\u003E\u00261; if ! tar -xzf \\\u0022$Archive\\\u0022 --strip-components=1; then rm -f \\\u0022$Archive\\\u0022; echo \\\u0022Proton GE archive could not be extracted. Aborting\\\u0022; exit 1; fi; find . -maxdepth 1 -name \u0027GE-Proton*.tar.gz\u0027 ! -name \\\u0022$Archive\\\u0022 -delete; : \u003E \\\u0022$Archive\\\u0022; echo \\\u0022Proton GE version $ProtonVersion downloaded\\\u0022; STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 PROTON_LOG=1 \u003E/dev/null 2\u003E\u00261; exit 0\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Prefix Sound",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd astroneer \u0026\u0026 export PATH=\\\u0022{{$FullRootDir}}.proton/files/bin:$PATH\\\u0022; export WINEPREFIX=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx\\\u0022; export WINEARCH=win64; ./.proton/protonfixes/winetricks sound=disabled \u003E winescript_log.txt 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ApplicationPort1.name",
      "Description": "port.ApplicationPort1.desc",
      "Ref": "ApplicationPort1",
      "Port": 7777,
      "Protocol": "UDP"
    },
    {
      "Name": "port.RemoteAdminPort.name",
      "Description": "port.RemoteAdminPort.desc",
      "Ref": "RemoteAdminPort",
      "Port": 1234
    }
  ],
  "VersionSources": [
    {
      "Id": "protonge.releases",
      "Url": "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases?per_page=100",
      "Format": "Text",
      "Select": "\u0022browser_download_url\u0022\\s*:\\s*\u0022(?\u003Curl\u003Ehttps://github\\.com/GloriousEggroll/proton-ge-custom/releases/download/(?\u003Ctag\u003EGE-Proton[0-9]\u002B-[0-9]\u002B)/\\k\u003Ctag\u003E(?:-x86_64)?\\.tar\\.gz)\u0022",
      "Value": "tag",
      "Fields": {
        "downloadUrl": "url"
      },
      "Sort": "VersionDescending"
    }
  ],
  "Settings": [
    {
      "FieldName": "$RemoteAdminPassword",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.ConsolePassword",
      "Hidden": true,
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.$RemoteAdminPassword.name",
      "InputType": "Password",
      "ExcludeFromImport": true
    },
    {
      "FieldName": "$ApplicationPort1",
      "ParamFieldName": "URL.Port",
      "Hidden": true,
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.$ApplicationPort1.name",
      "InputType": "number"
    },
    {
      "FieldName": "$RemoteAdminPort",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.ConsolePort",
      "Hidden": true,
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.$RemoteAdminPort.name",
      "InputType": "number",
      "ExcludeFromImport": true
    },
    {
      "FieldName": "ServerName",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.ServerName",
      "DefaultValue": "Astroneer Server - Powered by AMP",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.ServerName.name",
      "Description": "setting.ServerName.desc",
      "Keywords": "name,servername",
      "InputType": "text"
    },
    {
      "FieldName": "ServerPassword",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.ServerPassword",
      "DefaultValue": "",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.ServerPassword.name",
      "Description": "setting.ServerPassword.desc",
      "Keywords": "password,serverpassword",
      "InputType": "Password"
    },
    {
      "FieldName": "OwnerName",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.OwnerName",
      "DefaultValue": "",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.OwnerName.name",
      "Description": "setting.OwnerName.desc",
      "Keywords": "owner,name,ownername",
      "InputType": "text"
    },
    {
      "FieldName": "$MaxUsers",
      "ParamFieldName": "/Script/Astro.AstroGameUserSettings.MaxPlayers",
      "DefaultValue": "8",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.$MaxUsers.name",
      "Description": "setting.$MaxUsers.desc",
      "Keywords": "players,limit,maxplayers",
      "InputType": "number",
      "Placeholder": "8",
      "Suffix": "users",
      "MinValue": 2,
      "MaxValue": 8
    },
    {
      "FieldName": "bLoadAutoSave",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.bLoadAutoSave",
      "DefaultValue": "True",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
