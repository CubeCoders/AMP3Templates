    },
    {
      "FieldName": "BackupSaveGamesInterval",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.BackupSaveGamesInterval",
      "DefaultValue": "7200",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.BackupSaveGamesInterval.name",
      "Description": "setting.BackupSaveGamesInterval.desc",
      "Keywords": "backup,interval,backupsavegamesinterval",
      "InputType": "number",
      "Placeholder": "7200",
