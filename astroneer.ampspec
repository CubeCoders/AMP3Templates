    },
    {
      "FieldName": "PublicIP",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.PublicIP",
      "DefaultValue": "{{$ExternalIP}}",
      "Category": "category.astroneer:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.PublicIP.name",
      "Description": "setting.PublicIP.desc",
      "Keywords": "public,ip,publicip",
      "InputType": "enum",
      "EnumValues": {
        "{{$ExternalIP}}": "setting.PublicIP.value._ExternalIP_",
        "{{ManualPublicIP}}": "setting.PublicIP.value._ManualPublicIP_"
      }
    },
    {
