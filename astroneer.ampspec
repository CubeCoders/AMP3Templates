    },
    {
      "FieldName": "AutoSaveGameInterval",
      "ParamFieldName": "/Script/Astro.AstroServerSettings.AutoSaveGameInterval",
      "DefaultValue": "900",
      "Category": "category.astroneer:stadia_controller",
