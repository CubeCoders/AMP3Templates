{
  "Id": "473ef3af-bc0b-4555-a42b-9f6393ffd29f",
  "TemplateSlug": "enshrouded",
  "Lifecycle": {
    "RootDir": "./enshrouded/",
    "BaseDirectory": "./enshrouded/2278520/",
    "ExecutableWin": "2278520\\enshrouded_server.exe",
    "ExecutableLinux": ".proton/proton",
    "WorkingDir": "2278520",
    "LinuxCommandLineArgs": "runinprefix \u0022{{$FullBaseDir}}enshrouded_server.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} {{$FormattedArgs}}",
    "CommandLineParameterFormat": "-{0}={1}",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}enshrouded_server\\.exe.*$",
    "ExitMethod": "OS_CLOSE",
    "ExitString": "stop",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "RCONHeartbeatCommand": "ping",
    "MaxUsers": 16,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%",
      "SteamAppId": "1203620",
      "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam",
      "HOME": "{{$FullBaseDir}}",
      "WINEDLLOVERRIDES": "dbghelp=n,b"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan, Shinynecrid",
    "URL": "https://enshrouded.com/",
    "DisplayImageSource": "url:https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1203620/7b462e81072e94d96cb4242a75f8adddd9ec1cbd/header.jpg",
    "EndpointURIFormat": "steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "12",
    "ReleaseNotes": "Enshrouded 1.0: adds the Automatic option to Enemy Amount and the Flame Altar Shroud Level setting. Limits now match the game: Diving Time Factor minimum 0.75, Enemy Damage Factor maximum 2.5, Boss Health Modifier maximum 4.",
    "MinAMPVersion": "2.6.2.8"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^.*\\[Session\\] \u0027HostOnline\u0027 \\(up\\)!$",
    "UserJoinRegex": "^.*\\[server\\] Player \u0027(?\u003Cusername\u003E.\u002B?)\u0027 logged in with Permissions:$",
    "UserLeaveRegex": "^.*\\[server\\] Remove Player \u0027(?\u003Cusername\u003E.\u002B?)\u0027$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "QueryPort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "2278520",
      "UpdateSourceArgs": "1203620",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Enshrouded_server.json Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/enshrouded/server.json",
      "UpdateSourceArgs": "enshrouded_server.json",
      "UpdateSourceTarget": "{{$FullBaseDir}}"
    },
    {
      "UpdateSource": "Proton",
      "UpdateStageName": "Proton GE Download",
      "UpdateSourceVersion": "{{SpecificReleaseVersion}}"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.QueryPort.name",
      "Description": "port.QueryPort.desc",
      "Ref": "QueryPort",
      "Port": 15637,
      "Protocol": "Both"
    }
  ],
  "VersionSources": [
    {
      "Id": "protonge.releases",
      "Url": "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases?per_page=100",
      "Format": "Text",
      "Select": "\u0022browser_download_url\u0022\\s*:\\s*\u0022(?\u003Curl\u003Ehttps://github\\.com/GloriousEggroll/proton-ge-custom/releases/download/(?\u003Ctag\u003EGE-Proton[0-9]\u002B-[0-9]\u002B)/\\k\u003Ctag\u003E(?:-x86_64)?\\.tar\\.gz)\u0022",
      "Value": "tag",
      "Fields": {
        "downloadUrl": "url"
      },
      "Sort": "VersionDescending"
    }
  ],
