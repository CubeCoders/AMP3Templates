  "Locale": {
    "en": {
      "meta.name": "Enshrouded",
      "meta.description": "Enshrouded Dedicated Server",
      "setting.$QueryPort.name": "Query Port",
      "category.enshrouded": "Enshrouded",
      "category.server": "Server",
      "setting.$ApplicationIPBinding.name": "Server IPv4 IP Binding",
      "setting.saveDirectory.name": "Save Directory",
      "setting.logDirectory.name": "Log Directory",
      "setting.name.name": "Server Name",
      "setting.name.desc": "Sets the name of the server as shown in the server browser",
      "setting.tags.name": "Server Tags",
      "setting.tags.desc": "Sets optional filter tags for the server that assist searching in the server browser. Available tags are listed in enshrouded_server_readme.txt",
      "setting.ServerRoles.name": "Server Roles",
      "setting.ServerRoles.desc": "Permissions for groups of players, including passwords to join the server, can be defined via [server roles](https://enshrouded.zendesk.com/hc/en-us/articles/19191581489309-Server-Roles-Configuration) in enshrouded_server.json. See enshrouded_server_readme.txt for further details",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users that may connect to the server at one time",
      "setting.banlist.name": "Banned Players",
      "setting.banlist.desc": "Players can be permanently banned from the server by accessing the banlist in-game via the Social-tab and adding them there. The banlist can also be edited directly by configuring \u0027bannedAccounts\u0027 in enshrouded_server.json - see enshrouded_server_readme.txt for format details",
      "category.gameplay": "Gameplay",
      "setting.enableVoiceChat.name": "Enable Voice Chat",
      "setting.enableVoiceChat.desc": "If set, voice chat will be enabled",
      "setting.voiceChatMode.name": "Voice Chat Mode",
      "setting.voiceChatMode.desc": "Sets the mode for voice chat. Requires Voice Chat to be enabled",
      "setting.voiceChatMode.value.Proximity": "Proximity (default)",
      "setting.voiceChatMode.value.Global": "Global",
      "setting.enableTextChat.name": "Enable Text Chat",
      "setting.enableTextChat.desc": "If set, text chat will be enabled",
      "setting.gameSettingsPreset.name": "Game Settings Preset",
      "setting.gameSettingsPreset.desc": "Sets the difficulty setting for the game. If \u0022Custom\u0022 is selected, the following individual gameplay settings can be configured. Otherwise the preset determines the gameplay settings",
      "setting.gameSettingsPreset.value.Default": "Default (for first-time players)",
      "setting.gameSettingsPreset.value.Relaxed": "Relaxed (for base-building and light-hearted adventuring)",
      "setting.gameSettingsPreset.value.Hard": "Hard (for a tougher combat experience)",
      "setting.gameSettingsPreset.value.Survival": "Survival (for some punishment)",
      "setting.gameSettingsPreset.value.Custom": "Custom",
      "setting.playerHealthFactor.name": "Player Health Factor",
      "setting.playerHealthFactor.desc": "Scales the maximum health for players by the set factor. Minimum = 0.25",
      "setting.playerManaFactor.name": "Player Mana Factor",
      "setting.playerManaFactor.desc": "Scales the maximum mana for players by the set factor. Minimum = 0.25",
      "setting.playerStaminaFactor.name": "Player Stamina Factor",
      "setting.playerStaminaFactor.desc": "Scales the maximum stamina for players by the set factor. Minimum = 0.25",
      "setting.playerBodyHeatFactor.name": "Player Body Heat Factor",
      "setting.playerBodyHeatFactor.desc": "Scales the maximum body heat for players by the set factor. The higher the factor the longer the player can stay in very cold areas before hypothermia sets in",
      "setting.playerBodyHeatFactor.value.0_5": "Low",
      "setting.playerBodyHeatFactor.value.1_0": "Default",
      "setting.playerBodyHeatFactor.value.1_5": "High",
      "setting.playerBodyHeatFactor.value.2_0": "Maximum",
      "setting.playerDivingTimeFactor.name": "Diving Time Factor",
      "setting.playerDivingTimeFactor.desc": "Modifies the initial amount of oxygen for players and therefore the time available underwater. Minimum = 0.75",
      "setting.enableDurability.name": "Enable Weapon Durability",
      "setting.enableDurability.desc": "If set, weapons can be broken",
      "setting.enableStarvingDebuff.name": "Enable Hunger And Starvation",
      "setting.enableStarvingDebuff.desc": "If set, hunger and starvation will be enabled. During starvation, a player will lose health periodically until death if no food or drink is consumed",
      "setting.foodBuffDurationFactor.name": "Food Buff Duration Factor",
      "setting.foodBuffDurationFactor.desc": "Scales food buff durations by the set factor. Minimum = 0.5",
      "setting.fromHungerToStarving.name": "Hungry State Duration",
      "setting.fromHungerToStarving.desc": "Set the length of the hungry state before starving sets in by configuring \u0027fromHungerToStarving\u0027 in enshrouded_server.json. Unit is nanoseconds (yes, really). Lowest = 300000000000, highest = 1200000000000",
      "setting.shroudTimeFactor.name": "Shroud Time Duration Modifier",
      "setting.shroudTimeFactor.desc": "Scales how long player characters can remain within the Shroud. Minimum = 0.5",
      "setting.tombstoneMode.name": "Tombstone Mode",
      "setting.tombstoneMode.desc": "Sets what happens to backpack items when players die. Lost items are stored in a tombstone and can be recovered there",
      "setting.tombstoneMode.value.AddBackpackMaterials": "Lose backpack materials (default)",
      "setting.tombstoneMode.value.Everything": "Lose everything",
      "setting.tombstoneMode.value.NoTombstone": "Keep everything (no tombstone)",
      "setting.enableGliderTurbulences.name": "Air Turbulences Affect Glider",
      "setting.enableGliderTurbulences.desc": "If set, the glider will be affected by air turbulences",
      "setting.weatherFrequency.name": "Weather Frequency",
      "setting.weatherFrequency.desc": "Sets how often new weather phenomena appear in the game world",
      "setting.weatherFrequency.value.Disabled": "Disabled",
      "setting.weatherFrequency.value.Rare": "Rare",
      "setting.weatherFrequency.value.Normal": "Normal",
      "setting.weatherFrequency.value.Often": "Often",
      "setting.fishingDifficulty.name": "Fishing Difficulty",
      "setting.fishingDifficulty.desc": "Sets the strength of the fish during the fishing minigame. The stronger a fish is, the longer the minigame will proceed",
      "setting.fishingDifficulty.value.VeryEasy": "Very easy",
      "setting.fishingDifficulty.value.Easy": "Easy",
      "setting.fishingDifficulty.value.Normal": "Normal",
      "setting.fishingDifficulty.value.Hard": "Hard",
      "setting.fishingDifficulty.value.VeryHard": "Very hard",
      "setting.miningDamageFactor.name": "Mining Effectiveness",
      "setting.miningDamageFactor.desc": "Scales mining damage. A higher mining damage leads to increased terraforming and more yield of resources per hit. Minimum = 0.5",
      "setting.plantGrowthSpeedFactor.name": "Plant Growth Speed Factor",
      "setting.plantGrowthSpeedFactor.desc": "Scales the plant growth speed. Minimum = 0.25",
      "setting.resourceDropStackAmountFactor.name": "Resources Gain Modifier",
      "setting.resourceDropStackAmountFactor.desc": "Scales the amount of materials per loot stack in chests, defeated enemies etc. Minimum = 0.25",
      "setting.factoryProductionSpeedFactor.name": "Workstation Effectiveness",
      "setting.factoryProductionSpeedFactor.desc": "Scales the length of production times for workshop items. Minimum = 0.25",
      "setting.perkUpgradeRecyclingFactor.name": "Weapon Recycling Yield Modifier",
      "setting.perkUpgradeRecyclingFactor.desc": "Scales the amount of Runes that are returned when salvaging upgraded weapons",
      "setting.perkCostFactor.name": "Weapon Upgrading Costs",
      "setting.perkCostFactor.desc": "Scales the amount of Runes required for upgrading weapons. Minimum = 0.25",
      "setting.experienceCombatFactor.name": "Combat Experience Modifier",
      "setting.experienceCombatFactor.desc": "Scales the amount of XP received through combat. Minimum = 0.25",
      "setting.experienceMiningFactor.name": "Mining Experience Modifier",
      "setting.experienceMiningFactor.desc": "Scales the amount of XP received by mining resources",
      "setting.experienceExplorationQuestsFactor.name": "Exploration Experience Modifier",
      "setting.experienceExplorationQuestsFactor.desc": "Scales the amount of XP received by exploring and completing quests. Minimum = 0.25",
      "setting.randomSpawnerAmount.name": "Enemy Amount",
      "setting.randomSpawnerAmount.desc": "Sets the amount of enemies in the world. Automatic scales the enemy count with the number of players nearby",
      "setting.randomSpawnerAmount.value.Few": "Few",
      "setting.randomSpawnerAmount.value.Normal": "Normal",
      "setting.randomSpawnerAmount.value.Automatic": "Automatic",
      "setting.randomSpawnerAmount.value.Many": "Many",
      "setting.randomSpawnerAmount.value.Extreme": "Extreme",
      "setting.aggroPoolAmount.name": "Simultaneous Enemy Attacks Modifier",
      "setting.aggroPoolAmount.desc": "Sets how many enemies are allowed to attack at the same time",
      "setting.aggroPoolAmount.value.Few": "Few",
      "setting.aggroPoolAmount.value.Normal": "Normal",
      "setting.aggroPoolAmount.value.Many": "Many",
      "setting.aggroPoolAmount.value.Extreme": "Extreme",
      "setting.enemyDamageFactor.name": "Enemy Damage Factor",
      "setting.enemyDamageFactor.desc": "Scales all enemy damage by the set factor, except for bosses. Minimum = 0.25, maximum = 2.5",
      "setting.enemyHealthFactor.name": "Enemy Health Factor",
      "setting.enemyHealthFactor.desc": "Scales all enemy health by the set factor, except for bosses. Minimum = 0.25",
      "setting.enemyStaminaFactor.name": "Enemy Stun Modifier",
      "setting.enemyStaminaFactor.desc": "Scales all enemy stamina by the set factor. It will take longer to stun enemies with a higher enemy stamina. This excludes bosses. Minimum = 0.5",
      "setting.enemyPerceptionRangeFactor.name": "Enemy Perception Modifier",
      "setting.enemyPerceptionRangeFactor.desc": "Scales how far enemies can see and hear a player. This excludes bosses. Minimum = 0.5",
      "setting.bossDamageFactor.name": "Boss Damage Modifier",
      "setting.bossDamageFactor.desc": "Scales the damage of boss attacks. Minimum = 0.2",
      "setting.bossHealthFactor.name": "Boss Health Modifier",
      "setting.bossHealthFactor.desc": "Scales all health of bosses by the set factor. Minimum = 0.2, maximum = 4",
      "setting.threatBonus.name": "Enemy Attacks Modifier",
      "setting.threatBonus.desc": "Scales the frequency of enemy attacks. This excludes bosses. Minimum = 0.25",
      "setting.pacifyAllEnemies.name": "Pacify All Enemies",
      "setting.pacifyAllEnemies.desc": "If set, enemies won\u0027t attack players until they are attacked. This excludes bosses",
      "setting.tamingStartleRepercussion.name": "Taming Failure Repercussions",
      "setting.tamingStartleRepercussion.desc": "Sets how the game reacts when a player startles wildlife during taming. Progress is visualized by hearts in the game",
      "setting.tamingStartleRepercussion.value.KeepProgress": "Keep all progress",
      "setting.tamingStartleRepercussion.value.LoseSomeProgress": "Lose some progress (default)",
      "setting.tamingStartleRepercussion.value.LoseAllProgress": "Lose all progress",
      "setting.dayTimeDuration.name": "Daytime Length",
      "setting.dayTimeDuration.desc": "Set the length of daytime by configuring \u0027dayTimeDuration\u0027 in enshrouded_server.json. A smaller value equals shorter daytime. Unit is nanoseconds (yes, really). Lowest = 120000000000, highest = 3600000000000",
      "setting.nightTimeDuration.name": "Nighttime Length",
      "setting.nightTimeDuration.desc": "Set the length of nighttime by configuring \u0027nightTimeDuration\u0027 in enshrouded_server.json. A smaller value equals shorter nighttime. Unit is nanoseconds (yes, really). Lowest = 120000000000, highest = 3600000000000",
      "setting.curseModifier.name": "Curse Modifier",
      "setting.curseModifier.desc": "Sets whether the Shroud curse is off or the chance of receiving the curse when being attacked by the corresponding enemies is increased",
      "setting.curseModifier.value.Easy": "Easy (off)",
      "setting.curseModifier.value.Normal": "Normal",
      "setting.curseModifier.value.Hard": "Hard (double chance)",
      "setting.flameLevelFogRemoval.name": "Flame Altar Shroud Level",
      "setting.flameLevelFogRemoval.desc": "Sets the Flame level required to place Flame Altars into the Shroud. Range 1 to 11. Default = 11",
      "setting.SpecificReleaseVersion.name": "Proton GE Release Version (Linux)",
      "setting.SpecificReleaseVersion.desc": "Sets the Proton GE [release version](https://github.com/GloriousEggroll/proton-ge-custom/releases) to install.",
      "category.updates": "Updates",
      "category.runtime-configuration": "Runtime Configuration",
      "port.QueryPort.name": "Query Port",
      "port.QueryPort.desc": "Port for query traffic"
    }
  }
