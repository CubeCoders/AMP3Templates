{
  "Id": "c2b4163c-cf2a-4d67-b6bb-5fee166b4d33",
  "TemplateSlug": "project-zomboid",
  "Lifecycle": {
    "RootDir": "./project-zomboid/",
    "BaseDirectory": "./project-zomboid/380870/",
    "ExecutableWin": "380870\\jre64\\bin\\java.exe",
    "ExecutableLinux": "380870/jre64/bin/java",
    "WorkingDir": "380870",
    "LinuxCommandLineArgs": "-Dfile.encoding=UTF-8 -Djava.awt.headless=true -Dzomboid.znetlog=1 -Dzomboid.steam={{SteamInt}} -Duser.home=./ -Xmx{{MaxMemory}}m -XX:\u002BUseZGC -XX:-OmitStackTraceInFastThrow -Djava.library.path=linux64/:natives/ -Djava.security.egd=file:/dev/urandom {{CustomJavaArgs}} -cp java/:java/*",
    "WindowsCommandLineArgs": "-Dfile.encoding=UTF-8 -Djava.awt.headless=true -Dzomboid.znetlog=1 -Dzomboid.steam={{SteamInt}} -Duser.home=./ -Xmx{{MaxMemory}}m {{JavaGCAlgo}} -XX:-CreateCoredumpOnCrash -XX:-OmitStackTraceInFastThrow -Djava.library.path=natives/;natives/win64/;. {{CustomJavaArgs}} -cp java/*;java/",
    "CommandLineArgs": "{{$PlatformArgs}} {{JavaClass}} -port {{$ApplicationPort1}} -udpport {{$ApplicationPort2}} {{CustomServerArgs}} {{$FormattedArgs}}",
    "CommandLineParameterFormat": "-{0} \u0022{1}\u0022",
    "ExitString": "quit",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "RemoteAdminPassword": "Password123",
    "RCONHeartbeatCommand": "ping",
    "MaxUsers": 32,
    "EnvironmentVariables": {
      "PATH": "{{$FullBaseDir}}jre64/bin:%PATH%",
      "LD_LIBRARY_PATH": "{{$FullBaseDir}}linux64:{{$FullBaseDir}}natives:{{$FullBaseDir}}:{{$FullBaseDir}}jre64/lib/amd64:%LD_LIBRARY_PATH%",
      "LD_PRELOAD": "{{$FullBaseDir}}jre64/lib/libjsig.so",
      "SteamAppId": "108600"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan, IceOfWraith, Dhraz",
    "URL": "https://projectzomboid.com",
    "DisplayImageSource": "steam:108600",
    "EndpointURIFormat": "steam://connect/{ip}:{GenericModule.App.Ports.$ApplicationPort1}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "7",
    "MinAMPVersion": "2.3.2.0"
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^LOG\\s\u002B: Network\\s\u002B.*\u003E \\*\u002B SERVER STARTED \\*\u002B$",
    "UserJoinRegex": "^LOG\\s\u002B: (Network\\s\u002B.*\u003E ConnectionManager: \\[fully-connected\\] (?:.\u002B?) steam-id=(?\u003Cuserid\u003E.\u002B?) (?:.\u002B?) username=\u0022(?\u003Cusername\u003E.\u002B?)\u0022 (?:.\u002B?)|Multiplayer\\s\u002B.*\u003E connection: guid=(?\u003Csessionid\u003E.\u002B?) \\[fully-connected\\] \u0022\u0022)$",
    "UserLeaveRegex": "^LOG\\s\u002B: (Network\\s\u002B.*\u003E Disconnected player \u0022(?\u003Cusername\u003E.\u002B?)\u0022 (?\u003Cuserid\u003E.\u002B?)|Multiplayer\\s\u002B.*\u003E connection: guid=(?\u003Csessionid\u003E.\u002B?) \\[disconnect\\] \u0022receive-disconnect\u0022)$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^$",
    "LogRegex": "^(?\u003Ctype\u003E\\w\u002B)\\s*:\\s(?\u003Csource\u003E\\w\u002B)\\s\u002B,\\s\\d\u002B\u003E [\\d,]\u002B\u003E (!?\\[[\\d\\- :\\.]\u002B\\] \u003E )?(?\u003Ccontents\u003E.\u002B?)$"
  },
  "PortReferences": {
    "PrimaryApplicationPortRef": "ApplicationPort1",
    "UniversalSleepApplicationUDPPortRef": "ApplicationPort1",
    "UniversalSleepSteamQueryPortRef": "ApplicationPort1"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "380870",
      "UpdateSourceArgs": "108600",
      "UpdateSourceVersion": "public",
      "UpdateSourceConditionSetting": "EnableBeta",
      "UpdateSourceConditionValue": "false"
    },
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "380870",
      "UpdateSourceArgs": "108600",
      "UpdateSourceVersion": "{{BetaBranch}}",
      "UpdateSourceConditionSetting": "EnableBeta",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Mods Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}Zomboid/mods"
    }
  ],
