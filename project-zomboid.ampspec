  "ConfigFileMappings": [
    {
      "ConfigFile": "Zomboid/Server/{{servername}}.ini",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?)=(?\u003Cvalue\u003E.*?)$",
      "ConfigType": "kvp",
      "AutoMap": true
    },
    {
      "ConfigFile": "Zomboid/Server/{{servername}}_SandboxVars.lua",
      "ConfigFormat": "    {0} = {1},",
      "ConfigFormatRegex": "^\\s*(?\u003Ckey\u003E[A-Za-z0-9_]\u002B)\\s*=(?!\\s*\\{)\\s*(?\u003Cvalue\u003E\\S.*?),?\\s*$",
      "ConfigType": "kvp",
      "AutoMap": true,
      "Importable": false
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Project Zomboid",
      "meta.description": "Project Zomboid Dedicated Server",
      "setting.$ApplicationPort1.name": "Steam Port",
      "category.project-zomboid": "Project Zomboid",
      "category.server": "Server",
      "setting.$ApplicationPort2.name": "Direct Port",
      "setting.$RemoteAdminPort.name": "RCON Port",
      "setting.PublicName.name": "Server Public Name",
      "setting.PublicName.desc": "Sets the server name as shown in the in-game browser and, if applicable, the Steam browser",
      "setting.Public.name": "Make Server Public",
      "setting.Public.desc": "If enabled, the server will be visible in the in-game browser (Steam-enabled servers are always visible in the Steam server browser)",
      "setting.Public.value.True": "true",
      "setting.Public.value.False": "false",
      "setting.PublicDescription.name": "Server Public Description",
      "setting.PublicDescription.desc": "Sets the description displayed in the in-game browser. Use \u0022\\n\u0022 to create a new line in the description",
      "setting.Password.name": "Server Password",
      "setting.Password.desc": "Sets the password for players to connect to the server. Default is no password",
      "setting.adminpassword.name": "Admin Password",
      "setting.adminpassword.desc": "Sets the in-game \u0022admin\u0022 user password (not the server password). Set before first running the server, or you will be prompted to do so in the console",
      "setting.HideAdminsInPlayerList.name": "Hide Admins In Player List",
      "setting.HideAdminsInPlayerList.desc": "If enabled, admins will be hidden in the player list. Requires b42",
      "setting.HideAdminsInPlayerList.value.False": "false",
      "setting.HideAdminsInPlayerList.value.True": "true",
      "setting.RCONPassword.name": "RCON Password",
      "setting.RCONPassword.desc": "Sets the password to connect to RCON. Default is a random, strong password",
      "setting.ServerWelcomeMessage.name": "Welcome Message",
      "setting.ServerWelcomeMessage.desc": "Sets the first welcome message visible in the chat panel, which is displayed immediately after player login. Use \u003CLINE\u003E to create a separate line, and colour formatting like \u003CRGB:1,0,0\u003E to colour the text",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users that may be on the server at one time (excluding admins). User counts above 32 will potentially result in poor map streaming and desync",
      "setting.Open.name": "Enable Open Server",
      "setting.Open.desc": "If enabled, players may join the server without already being included in the whitelist. Otherwise, admins must manually create username/password combinations",
      "setting.Open.value.True": "true",
      "setting.Open.value.False": "false",
      "setting.AutoCreateUserInWhiteList.name": "Automatically Whitelist Players",
      "setting.AutoCreateUserInWhiteList.desc": "Automatically add unknown usernames to the whitelist when players join (for open servers). Players will supply their own username/password on joining",
      "setting.AutoCreateUserInWhiteList.value.True": "true",
      "setting.AutoCreateUserInWhiteList.value.False": "false",
      "setting.DropOffWhiteListAfterDeath.name": "Drop Off Whitelist After Death",
      "setting.DropOffWhiteListAfterDeath.desc": "If set, player accounts will be removed from the whitelist after death. This prevents players creating a new character after death on non-open servers",
      "setting.DropOffWhiteListAfterDeath.value.False": "false",
      "setting.DropOffWhiteListAfterDeath.value.True": "true",
      "setting.DoLuaChecksum.name": "Enable Lua Checksum Kick",
      "setting.DoLuaChecksum.desc": "If set, clients whose game files don\u0027t match the server\u0027s file will be kicked",
      "setting.DoLuaChecksum.value.False": "false",
      "setting.DoLuaChecksum.value.True": "true",
      "setting.DenyLoginOnOverloadedServer.name": "Deny Login On Overloaded Server",
      "setting.DenyLoginOnOverloadedServer.desc": "If set, login will be denied on an overloaded server",
      "setting.DenyLoginOnOverloadedServer.value.False": "false",
      "setting.DenyLoginOnOverloadedServer.value.True": "true",
      "setting.LoginQueueEnabled.name": "Enable Login Queue",
      "setting.LoginQueueEnabled.desc": "If set, the login queue will be enabled",
      "setting.LoginQueueEnabled.value.False": "false",
      "setting.LoginQueueEnabled.value.True": "true",
      "setting.LoginQueueConnectTimeout.name": "Login Queue Connect Timeout",
      "setting.LoginQueueConnectTimeout.desc": "Sets the connection timeout for the login queue",
      "setting.MaxMemory.name": "Memory Limit",
      "setting.MaxMemory.desc": "Sets Java\u0027s maximum heap size",
      "setting.JavaGCAlgo.name": "Java Garbage Collection Algorithm (Windows)",
      "setting.JavaGCAlgo.desc": "The default Java garbage collection algorithm is ZGC, but G1GC can be selected for older Windows versions that cannot use ZGC",
      "setting.JavaGCAlgo.value.-XX_UseZGC": "ZGC Algorithm (default)",
      "setting.JavaGCAlgo.value.-XX_UseG1GC": "G1GC Algorithm",
      "setting.SteamVAC.name": "Enable Valve Anti-cheat (Steam VAC)",
      "setting.SteamVAC.desc": "If set, enables the Steam VAC system",
      "setting.SteamVAC.value.True": "true",
      "setting.SteamVAC.value.False": "false",
      "setting.SteamInt.name": "Steam Integration",
      "setting.SteamInt.desc": "Enable Steam integration",
      "setting.SteamInt.value.True": "1",
      "setting.SteamInt.value.False": "0",
      "setting.WorldGenSeed.name": "World Generation Seed",
      "setting.WorldGenSeed.desc": "The seed used to generate the world can be set by configuring the \u0027Seed\u0027 configuration variable. Remove map_worldgen.bin to regenerate with a new seed. Requires b42",
      "setting.Map.name": "Maps",
      "setting.Map.desc": "Semi-colon separated list of maps to load on the server. ONE LINE ONLY!",
      "setting.Mods.name": "Load Mods",
      "setting.Mods.desc": "Semi-colon separated list of mod IDs (eg 67commando;86oshkoshP19A) to load. With b42, prefix each ID with \\. ONE LINE ONLY! To install them, the workshop IDs for the mods also need to be added to Install Workshop Items",
      "setting.WorkshopItems.name": "Install Workshop Items",
      "setting.WorkshopItems.desc": "Semi-colon separated list of IDs of workshop items (eg 2478247379;2566953935) to install. ONE LINE ONLY! To load them, the mod IDs also need to be added to Load Mods. NOTE: Don\u0027t use \u0022Steam workshop items\u0022 under Updates",
      "setting.DisplayUserName.name": "Display Player Usernames",
      "setting.DisplayUserName.desc": "If enabled, displays players\u0027 usernames above their heads in-game",
      "setting.DisplayUserName.value.True": "true",
      "setting.DisplayUserName.value.False": "false",
      "setting.ShowFirstAndLastName.name": "Display Player Character Names",
      "setting.ShowFirstAndLastName.desc": "If enabled, displays players\u0027 first and last names above their heads in-game instead of usernames",
      "setting.ShowFirstAndLastName.value.True": "true",
      "setting.ShowFirstAndLastName.value.False": "false",
      "setting.MouseOverToSeeDisplayName.name": "Require Mouse Over To See Display Name",
      "setting.MouseOverToSeeDisplayName.desc": "If enabled, players will have to mouse over someone to see their display name",
      "setting.MouseOverToSeeDisplayName.value.False": "false",
      "setting.MouseOverToSeeDisplayName.value.True": "true",
      "setting.AllowNonAsciiUsername.name": "Allow Non-ASCII Usernames",
      "setting.AllowNonAsciiUsername.desc": "If enabled, allows the use of non-ASCII (cyrillic etc) characters in usernames",
      "setting.AllowNonAsciiUsername.value.False": "false",
      "setting.AllowNonAsciiUsername.value.True": "true",
      "setting.UsernameDisguises.name": "Enable Username Disguises",
      "setting.UsernameDisguises.desc": "If enabled, players can disguise their username in-game. Requires b42",
      "setting.UsernameDisguises.value.False": "false",
      "setting.UsernameDisguises.value.True": "true",
      "setting.HideDisguisedUserName.name": "Hide Disguised Username",
      "setting.HideDisguisedUserName.desc": "If enabled, disguised usernames are hidden from certain UI elements. Requires b42",
      "setting.HideDisguisedUserName.value.False": "false",
      "setting.HideDisguisedUserName.value.True": "true",
      "setting.SwitchZombiesOwnershipEachUpdate.name": "Switch Zombies Ownership Each Update",
      "setting.SwitchZombiesOwnershipEachUpdate.desc": "If enabled, zombies may switch ownership between players on each update. Requires b42",
      "setting.SwitchZombiesOwnershipEachUpdate.value.False": "false",
      "setting.SwitchZombiesOwnershipEachUpdate.value.True": "true",
      "setting.MaxAccountsPerUser.name": "Maximum Accounts Per User",
      "setting.MaxAccountsPerUser.desc": "Sets the limit on the number of different accounts a single Steam user may create on the server",
      "setting.AllowCoop.name": "Allow Co-op/Splitscreen Players",
      "setting.AllowCoop.desc": "If set, allows co-op/splitscreen players",
      "setting.AllowCoop.value.False": "false",
      "setting.AllowCoop.value.True": "true",
      "setting.SteamScoreboard.name": "Steam Scoreboard",
      "setting.SteamScoreboard.desc": "Sets whether steam usernames and avatars are visible in the player list",
      "setting.SteamScoreboard.value.true": "Visible to everyone",
      "setting.SteamScoreboard.value.false": "Visible to no-one",
      "setting.SteamScoreboard.value.admins": "Visible to admins only",
      "setting.DisableScoreboard.name": "Disable Scoreboard",
      "setting.DisableScoreboard.desc": "If enabled, the scoreboard will be disabled. Requires b42",
      "setting.DisableScoreboard.value.False": "false",
      "setting.DisableScoreboard.value.True": "true",
      "setting.PauseEmpty.name": "Pause When Empty",
      "setting.PauseEmpty.desc": "If enabled, game time stops when there are no players online",
      "setting.PauseEmpty.value.True": "true",
      "setting.PauseEmpty.value.False": "false",
      "setting.PingLimit.name": "Ping Limit",
      "setting.PingLimit.desc": "Sets the ping limit before a player is kicked from the server. To disable, set to 100 (b41) or 0 (b42)",
      "setting.SaveWorldEveryMinutes.name": "Auto World Save Interval",
      "setting.SaveWorldEveryMinutes.desc": "Sets the real-world time between each automatic save of loaded parts of the map. 0 = never. (The map is usually saved only after clients leave a loaded area)",
      "setting.BackupsCount.name": "Backups Count",
      "setting.BackupsCount.desc": "Sets the number of backups to keep",
      "setting.BackupsOnStart.name": "Enable Backups On Start",
      "setting.BackupsOnStart.desc": "If enable, backups will be taken on server start",
      "setting.BackupsOnStart.value.False": "false",
      "setting.BackupsOnStart.value.True": "true",
      "setting.BackupsOnVersionChange.name": "Enable Backups On Version Change",
      "setting.BackupsOnVersionChange.desc": "If set, backups will be taken on version change",
      "setting.BackupsOnVersionChange.value.False": "false",
      "setting.BackupsOnVersionChange.value.True": "true",
      "setting.BackupsPeriod.name": "Backups Period",
      "setting.BackupsPeriod.desc": "Sets the period between backups. 0 = disabled",
      "setting.server_browser_announced_ip.name": "Server Browser Announced IP",
      "setting.server_browser_announced_ip.desc": "Sets the IP from which the server is broadcast. Useful for network configurations with multiple IP addresses such as server farms",
      "setting.ClientCommandFilter.name": "Client Command Filter",
      "setting.ClientCommandFilter.desc": "Semicolon-separated list of commands that will not be written to the cmd.txt server log. Example: -vehicle. Inputting * means do NOT write any vehicle command. Inputting \u002Bvehicle.installPart means DO write that command",
      "setting.ClientActionLogs.name": "Client Action Logs",
      "setting.ClientActionLogs.desc": "Semicolon-separated list of actions that will be written to the ClientActionLogs.txt server log",
      "setting.PerkLogs.name": "Enable Perk Logs",
      "setting.PerkLogs.desc": "If enabled, changes in player perk levels will be tracked in the PerkLog.txt server log",
      "setting.PerkLogs.value.False": "false",
      "setting.PerkLogs.value.True": "true",
      "setting.UPnP.name": "Enable UPnP",
      "setting.UPnP.desc": "If enabled, the server will attempt to configure automatic port forwarding on a compatible router",
      "setting.UPnP.value.True": "true",
      "setting.UPnP.value.False": "false",
      "setting.MultiplayerStatisticsPeriod.name": "Multiplayer Statistics Period",
      "setting.MultiplayerStatisticsPeriod.desc": "Sets the multiplayer update period. 0 = disabled. Requires b42",
      "setting.CustomJavaArgs.name": "Additional Java Startup Parameters",
      "setting.CustomJavaArgs.desc": "Additional Java arguments (not server arguments) as startup parameters that are not otherwise set by AMP. Use with care",
      "setting.servername.name": "Server Local Name",
      "setting.servername.desc": "Server name as stored locally. WARNING: Do not change unless you know what you are doing! Also update the server if this is changed",
      "setting.CustomServerArgs.name": "Additional Server Startup Parameters",
      "setting.CustomServerArgs.desc": "Additional server arguments (not Java arguments) as startup parameters that are not otherwise set by AMP. Use with care",
      "setting.JavaClass.name": "Java Class",
      "setting.JavaClass.desc": "Sets the Java class type to launch the server with. If Custom is selected, it must be set under \u0022Custom Java Class\u0022. Custom is required for some mods. Use with care",
      "setting.JavaClass.value.zombie_network_GameServer": "Default",
      "setting.JavaClass.value._CustomJavaClass_": "Custom",
      "setting.CustomJavaClass.name": "Custom Java Class",
      "setting.CustomJavaClass.desc": "Sets the custom Java class to launch the server with, if Custom is selected under \u0022Java Class\u0022",
      "setting.SpawnPoint.name": "Set Spawn Point",
      "setting.SpawnPoint.desc": "Sets the spawn point for every new player. Default is 0,0,0. [Find desired coordinates](https://map.projectzomboid.com/)",
      "category.gameplay": "Gameplay",
      "setting.SpawnItems.name": "Spawn Items",
      "setting.SpawnItems.desc": "Comma-separated list of item types that new players spawn with",
      "setting.PlayerRespawnWithSelf.name": "Enable Player Respawn At Death Coordinates",
      "setting.PlayerRespawnWithSelf.desc": "If set, players will be able to respawn in-game at the coordinates where they died",
      "setting.PlayerRespawnWithSelf.value.False": "false",
      "setting.PlayerRespawnWithSelf.value.True": "true",
      "setting.PlayerRespawnWithOther.name": "Enable Player Respawn At Other\u0027s Location",
      "setting.PlayerRespawnWithOther.desc": "If set, players will be allowed to respawn in-game at a split screen / Remote Play player\u0027s location",
      "setting.PlayerRespawnWithOther.value.False": "false",
      "setting.PlayerRespawnWithOther.value.True": "true",
      "setting.PVP.name": "Allow PvP",
      "setting.PVP.desc": "If enabled, players can hurt and kill other players",
      "setting.PVP.value.True": "true",
      "setting.PVP.value.False": "false",
      "setting.PVPLogToolChat.name": "Log PvP To Admin Chat",
      "setting.PVPLogToolChat.desc": "If enabled, PvP events will be posted to the admin chat. Requires b42",
      "setting.PVPLogToolChat.value.False": "false",
      "setting.PVPLogToolChat.value.True": "true",
      "setting.PVPLogToolFile.name": "Log PvP To File",
      "setting.PVPLogToolFile.desc": "If enabled, PvP events will be written to the server log file. Requires b42",
      "setting.PVPLogToolFile.value.False": "false",
      "setting.PVPLogToolFile.value.True": "true",
      "setting.SafetySystem.name": "Enable PvP Toggle (Safety System)",
      "setting.SafetySystem.desc": "If enabled, allows players to enter and leave PvP mode on an individual basis. A player can only hurt another player when at least one of them is in PvP mode. Requires \u0022Allow PvP\u0022 to be enabled",
      "setting.SafetySystem.value.True": "true",
      "setting.SafetySystem.value.False": "false",
      "setting.ShowSafety.name": "Show Player PvP Status",
      "setting.ShowSafety.desc": "If enabled, displays a skull icon above the heads of players who have entered PvP mode",
      "setting.ShowSafety.value.True": "true",
      "setting.ShowSafety.value.False": "false",
      "setting.SafetyToggleTimer.name": "PvP Toggle Timer",
      "setting.SafetyToggleTimer.desc": "Sets the time taken for a player to enter and leave PvP mode",
      "setting.SafetyCooldownTimer.name": "PvP Cooldown Timer",
      "setting.SafetyCooldownTimer.desc": "Sets the delay before a player can enter or leave PvP mode again, having recently done so",
      "setting.SafetyDisconnectDelay.name": "PvP Disconnect Delay",
      "setting.SafetyDisconnectDelay.desc": "Sets the delay before a disconnected player\u0027s PvP safety is removed. Requires b42",
      "setting.PVPMeleeWhileHitReaction.name": "Enable PvP Melee While Hit Reaction",
      "setting.PVPMeleeWhileHitReaction.desc": "If enabled, players can hit again when struck by another player",
      "setting.PVPMeleeWhileHitReaction.value.False": "false",
      "setting.PVPMeleeWhileHitReaction.value.True": "true",
      "setting.PVPMeleeDamageModifier.name": "PvP Melee Damage Modifier",
      "setting.PVPMeleeDamageModifier.desc": "Sets the damage multiplier for PvP melee attacks",
      "setting.PVPFirearmDamageModifier.name": "PvP Firearm Damage Modifier",
      "setting.PVPFirearmDamageModifier.desc": "Sets the damage multiplier for PvP ranged attacks",
      "setting.Faction.name": "Enable Factions",
      "setting.Faction.desc": "If enabled, factions can be created and used",
      "setting.Faction.value.True": "true",
      "setting.Faction.value.False": "false",
      "setting.FactionDaySurvivedToCreate.name": "Game Days For Factions",
      "setting.FactionDaySurvivedToCreate.desc": "Number of in-game days that a player must survive for before they can create a faction",
      "setting.FactionPlayersRequiredForTag.name": "Faction Players Required For Tag",
      "setting.FactionPlayersRequiredForTag.desc": "Sets the number of players required as faction members before the faction owner can create a group tag",
      "setting.nightlengthmodifier.name": "Nighttime Length",
      "setting.nightlengthmodifier.desc": "Sets how long nighttime lasts depending on daytime: 0.5 means twice as long, 2 means half the normal time. Requires b41 - b42 use \u0022Nighttime Length (Sandbox)\u0022 instead. Note that on b41 the sandbox \u0022Nighttime Length\u0022 setting also applies",
      "setting.NightLength.name": "Nighttime Length (Sandbox)",
      "setting.NightLength.desc": "Sets the time from dusk to dawn. This is a sandbox setting and applies on both b41 and b42. On b42 it replaces the .ini-based \u0022Nighttime Length\u0022 multiplier, which b42 no longer reads. The \u0022Always Day\u0022 option requires b42",
      "setting.NightLength.value.1": "Always Night",
      "setting.NightLength.value.2": "Long",
      "setting.NightLength.value.3": "Normal (default)",
      "setting.NightLength.value.4": "Short",
      "setting.NightLength.value.5": "Always Day (b42 only)",
      "setting.NoFire.name": "Don\u0027t Allow Fire",
      "setting.NoFire.desc": "If enabled, fires are not allowed (except campfires). Enable if fires cause problems for your server",
      "setting.NoFire.value.True": "true",
      "setting.NoFire.value.False": "false",
      "setting.AnnounceDeath.name": "Announce Player Death",
      "setting.AnnounceDeath.desc": "If enabled, a global message is displayed in the chat when a player dies",
      "setting.AnnounceDeath.value.True": "true",
      "setting.AnnounceDeath.value.False": "false",
      "setting.MinutesPerPage.name": "Minutes Per Book Page",
      "setting.MinutesPerPage.desc": "Sets the number of in-game minutes it takes to read one page of a book. Requires b41",
      "setting.HoursForLootRespawn.name": "Minimum Period for Loot Respawn",
      "setting.HoursForLootRespawn.desc": "Sets the in-game hours after which all containers that have been looted at least once will respawn loot. 0 = never. Loot respawn is not impacted by visibility or subsequent looting. Requires b41",
      "setting.MaxItemsForLootRespawn.name": "Maximum Items for Loot Respawn",
      "setting.MaxItemsForLootRespawn.desc": "Sets the maximum number of items that containers can hold to be allowed to respawn. If the number of items is less than or equal to the number set, loot will respawn. Requires b41",
      "setting.ItemNumbersLimitPerContainer.name": "Item Limit Per Container",
      "setting.ItemNumbersLimitPerContainer.desc": "Sets the maximum number of items that can be placed in a container. Includes individual small items like nails. 0 = no limit",
      "setting.ConstructionPreventsLootRespawn.name": "Construction Prevents Respawn",
      "setting.ConstructionPreventsLootRespawn.desc": "If enabled, items will not respawn in buildings that players have barricaded or built in. Requires b41",
      "setting.ConstructionPreventsLootRespawn.value.True": "true",
      "setting.ConstructionPreventsLootRespawn.value.False": "false",
      "setting.SafehousePreventsLootRespawn.name": "Safehouse Prevents Respawn",
      "setting.SafehousePreventsLootRespawn.desc": "If enabled, items will not respawn in buildings that players have claimed as a safehouse. Requires b42",
      "setting.SafehousePreventsLootRespawn.value.True": "true",
      "setting.SafehousePreventsLootRespawn.value.False": "false",
      "setting.PlayerSafehouse.name": "Allow Player Safehouses",
      "setting.PlayerSafehouse.desc": "If enabled, both admins and players can claim safehouses",
      "setting.PlayerSafehouse.value.True": "true",
      "setting.PlayerSafehouse.value.False": "false",
      "setting.AdminSafehouse.name": "Allow Admin Safehouses",
      "setting.AdminSafehouse.desc": "If enabled, only admins can claim safehouses",
      "setting.AdminSafehouse.value.True": "true",
      "setting.AdminSafehouse.value.False": "false",
      "setting.DisableSafehouseWhenPlayerConnected.name": "Disable Safehouse When Player Connected",
      "setting.DisableSafehouseWhenPlayerConnected.desc": "If set, disables a safehouse when a member of the safehouse is connected, so that it acts like a normal house and is only secure when players are offline. Renamed in b42 - use \u0022Disable Safehouse When Owner Connected\u0022 instead",
      "setting.DisableSafehouseWhenPlayerConnected.value.False": "false",
      "setting.DisableSafehouseWhenPlayerConnected.value.True": "true",
      "setting.DisableSafehouseWhenOwnerConnected.name": "Disable Safehouse When Owner Connected",
      "setting.DisableSafehouseWhenOwnerConnected.desc": "If set, a safehouse acts like a normal house while its owner is connected, so it is only secure when the owner is offline. Requires b42.18 or later, where it replaced DisableSafehouseWhenPlayerConnected",
      "setting.DisableSafehouseWhenOwnerConnected.value.False": "false",
      "setting.DisableSafehouseWhenOwnerConnected.value.True": "true",
      "setting.SafehouseAllowTrepass.name": "Allow Safehouse Trespass",
      "setting.SafehouseAllowTrepass.desc": "If enabled, non-members can enter a safehouse without being invited",
      "setting.SafehouseAllowTrepass.value.True": "true",
      "setting.SafehouseAllowTrepass.value.False": "false",
      "setting.SafehouseAllowTrespass.name": "Allow Safehouse Trespass",
      "setting.SafehouseAllowTrespass.desc": "[Backup setting given typo in config key, to future proof for correction]",
      "setting.SafehouseAllowFire.name": "Allow Safehouse Fire",
      "setting.SafehouseAllowFire.desc": "If enabled, safehouses can be damaged by fire",
      "setting.SafehouseAllowFire.value.True": "true",
      "setting.SafehouseAllowFire.value.False": "false",
      "setting.SafehouseAllowLoot.name": "Allow Safehouse Loot",
      "setting.SafehouseAllowLoot.desc": "If enabled, non-members can loot safehouses",
      "setting.SafehouseAllowLoot.value.True": "true",
      "setting.SafehouseAllowLoot.value.False": "false",
      "setting.SafehouseAllowRespawn.name": "Allow Safehouse Respawn",
      "setting.SafehouseAllowRespawn.desc": "If enabled, players will respawn in a safehouse they were a member of before death",
      "setting.SafehouseAllowRespawn.value.True": "true",
      "setting.SafehouseAllowRespawn.value.False": "false",
      "setting.SafehouseDaySurvivedToClaim.name": "Game Days For Safehouse",
      "setting.SafehouseDaySurvivedToClaim.desc": "Sets the number of in-game days that a player must survive for before they can claim a safehouse",
      "setting.SafeHouseRemovalTime.name": "Safehouse Removal Period",
      "setting.SafeHouseRemovalTime.desc": "Players are automatically removed from a safehouse they have not visited for this many real-time hours",
      "setting.SafehouseAllowNonResidential.name": "Allow Non-Residential Safehouses",
      "setting.SafehouseAllowNonResidential.desc": "If enabled, players can claim non-residential buildings",
      "setting.SafehouseAllowNonResidential.value.False": "false",
      "setting.SafehouseAllowNonResidential.value.True": "true",
      "setting.SafehouseDisableDisguises.name": "Disable Disguises In Safehouse",
      "setting.SafehouseDisableDisguises.desc": "If enabled, disguises will be disabled while inside a safehouse. Requires b42",
      "setting.SafehouseDisableDisguises.value.False": "false",
      "setting.SafehouseDisableDisguises.value.True": "true",
      "setting.MaxSafezoneSize.name": "Maximum Safezone Size",
      "setting.MaxSafezoneSize.desc": "Sets the maximum allowed safezone size. Requires b42",
      "setting.AllowDestructionBySledgehammer.name": "Allow Sledgehammer Destruction",
      "setting.AllowDestructionBySledgehammer.desc": "If enabled, players can destroy world objects with sledgehammers",
      "setting.AllowDestructionBySledgehammer.value.True": "true",
      "setting.AllowDestructionBySledgehammer.value.False": "false",
      "setting.SledgehammerOnlyInSafehouse.name": "Allow Only Safehouse Sledgehammers",
      "setting.SledgehammerOnlyInSafehouse.desc": "If enabled, players can destroy world objects with sledgehammers only in their safehouse. Requires \u0022Allow Sledgehammer Destruction\u0022 to be enabled",
      "setting.SledgehammerOnlyInSafehouse.value.True": "true",
      "setting.SledgehammerOnlyInSafehouse.value.False": "false",
      "setting.WarStartDelay.name": "War Start Delay",
      "setting.WarStartDelay.desc": "Sets the time before the war starts. Requires b42",
      "setting.WarDuration.name": "War Duration",
      "setting.WarDuration.desc": "Sets the war duration. Requires b42",
      "setting.WarSafehouseHitPoints.name": "War Safehouse Hit Points",
      "setting.WarSafehouseHitPoints.desc": "Sets the safehouse hit points limit. Requires b42",
      "setting.KickFastPlayers.name": "Kick Fast Players",
      "setting.KickFastPlayers.desc": "If enabled, players that appear to be moving faster than is possible will be kicked. May be buggy - use with caution. Requires b41",
      "setting.KickFastPlayers.value.False": "false",
      "setting.KickFastPlayers.value.True": "true",
      "setting.SpeedLimit.name": "Speed Limit",
      "setting.SpeedLimit.desc": "Sets the speed limit for players",
      "setting.SleepAllowed.name": "Allow Sleep",
      "setting.SleepAllowed.desc": "If enabled, players are allowed to sleep when tired, but do not need to",
      "setting.SleepAllowed.value.True": "true",
      "setting.SleepAllowed.value.False": "false",
      "setting.SleepNeeded.name": "Require Sleep",
      "setting.SleepNeeded.desc": "If enabled, players become tired and need to sleep. Requires \u0022Allow Sleep\u0022 to be enabled",
      "setting.SleepNeeded.value.True": "true",
      "setting.SleepNeeded.value.False": "false",
      "setting.FastForwardMultiplier.name": "Sleep Fast Forward Multiplier",
      "setting.FastForwardMultiplier.desc": "Sets how fast time passes while players sleep",
      "setting.KnockedDownAllowed.name": "Allow Knock Down",
      "setting.KnockedDownAllowed.desc": "If set, players can be knocked down. Activating this setting may cause visual desynchronization of player positions",
      "setting.KnockedDownAllowed.value.False": "false",
      "setting.KnockedDownAllowed.value.True": "true",
      "setting.PlayerBumpPlayer.name": "Enable Player Bump Player",
      "setting.PlayerBumpPlayer.desc": "If enabled, players will bump (and knock over) other players when running through them",
      "setting.PlayerBumpPlayer.value.False": "false",
      "setting.PlayerBumpPlayer.value.True": "true",
      "setting.HidePlayersBehindYou.name": "Hide Players Behind You",
      "setting.HidePlayersBehindYou.desc": "If enabled, players that can\u0027t be seen will be automatically hidden (like zombies)",
      "setting.HidePlayersBehindYou.value.False": "false",
      "setting.HidePlayersBehindYou.value.True": "true",
      "setting.SneakModeHideFromOtherPlayers.name": "Hide From Other Players In Sneak Mode",
      "setting.SneakModeHideFromOtherPlayers.desc": "If set, players in sneak mode will be hidden from other players",
      "setting.SneakModeHideFromOtherPlayers.value.False": "false",
      "setting.SneakModeHideFromOtherPlayers.value.True": "true",
      "setting.UltraSpeedDoesnotAffectToAnimals.name": "Ultra Speed Does Not Affect Animals",
      "setting.UltraSpeedDoesnotAffectToAnimals.desc": "If enabled, the Ultra Speed effect will not apply to animals. Requires b42",
      "setting.UltraSpeedDoesnotAffectToAnimals.value.False": "false",
      "setting.UltraSpeedDoesnotAffectToAnimals.value.True": "true",
      "setting.RemovePlayerCorpsesOnCorpseRemoval.name": "Remove Player Corpses On Corpse Removal",
      "setting.RemovePlayerCorpsesOnCorpseRemoval.desc": "If enabled, when \u0027HoursForCorpseRemoval\u0027 triggers, it will also remove player\u2019s corpses from the ground",
      "setting.RemovePlayerCorpsesOnCorpseRemoval.value.False": "false",
      "setting.RemovePlayerCorpsesOnCorpseRemoval.value.True": "true",
      "setting.BloodSplatLifespanDays.name": "Blood Splats Lifespan Days",
      "setting.BloodSplatLifespanDays.desc": "Sets the number of days before old blood splats are removed. Removal happens when map chunks are loaded. 0 = splats never disappear",
      "setting.BanKickGlobalSound.name": "Enable Ban/Kick Global Sound",
      "setting.BanKickGlobalSound.desc": "If set, enables the global sound for ban and kick messages",
      "setting.BanKickGlobalSound.value.False": "false",
      "setting.BanKickGlobalSound.value.True": "true",
      "setting.TrashDeleteAll.name": "Enable Trash Delete All",
      "setting.TrashDeleteAll.desc": "If enabled, players can use the \u0027delete all\u0027 button on bins",
      "setting.TrashDeleteAll.value.False": "false",
      "setting.TrashDeleteAll.value.True": "true",
      "setting.CarEngineAttractionModifier.name": "Car Engine Attraction Modifier",
      "setting.CarEngineAttractionModifier.desc": "Modifies the range of zombie attraction to cars. Lower values can help lag",
      "setting.MapRemotePlayerVisibility.name": "Remote Player Map Visibility",
      "setting.MapRemotePlayerVisibility.desc": "Controls the display of remote players on the in-game map",
      "setting.MapRemotePlayerVisibility.value.1": "Hidden (default)",
      "setting.MapRemotePlayerVisibility.value.2": "Friends",
      "setting.MapRemotePlayerVisibility.value.3": "Friends And Nearby Players",
      "setting.MapRemotePlayerVisibility.value.4": "Everyone",
      "setting.DisableVehicleTowing.name": "Disable Vehicle Towing",
      "setting.DisableVehicleTowing.desc": "If set, vehicle towing will be disabled. Requires b42",
      "setting.DisableVehicleTowing.value.False": "false",
      "setting.DisableVehicleTowing.value.True": "true",
      "setting.DisableTrailerTowing.name": "Disable Trailer Towing",
      "setting.DisableTrailerTowing.desc": "If set, trailer towing will be disabled. Requires b42",
      "setting.DisableTrailerTowing.value.False": "false",
      "setting.DisableTrailerTowing.value.True": "true",
      "setting.DisableBurntTowing.name": "Disable Burnt Vehicle Towing",
      "setting.DisableBurntTowing.desc": "If enabled, burnt vehicles cannot be towed. Requires b42",
      "setting.DisableBurntTowing.value.False": "false",
      "setting.DisableBurntTowing.value.True": "true",
      "setting.UsePhysicsHitReaction.name": "Use Physics Hit Reactions",
      "setting.UsePhysicsHitReaction.desc": "If enabled, physics-based hit reactions are used. Requires b42",
      "setting.UsePhysicsHitReaction.value.False": "false",
      "setting.UsePhysicsHitReaction.value.True": "true",
      "setting.GlobalChat.name": "Enable Global Chat",
      "setting.GlobalChat.desc": "If enabled, players can communicate with everyone (using the /all command in chat)",
      "category.communication": "Communication",
      "setting.GlobalChat.value.True": "true",
      "setting.GlobalChat.value.False": "false",
      "setting.ChatStreams.name": "Chat Streams",
      "setting.ChatStreams.desc": "Sets the enabled chat streams for different message targets. Options: s (say), r (radio), a (all), w (whisper), y (yell), sh (safehouse), f (faction), all",
      "setting.ChatMessageCharacterLimit.name": "Chat Message Character Limit",
      "setting.ChatMessageCharacterLimit.desc": "Sets the maximum characters allowed per chat message. Requires b42",
      "setting.ChatMessageSlowModeTime.name": "Chat Message Slow Mode Time",
      "setting.ChatMessageSlowModeTime.desc": "Sets the time between sending chat messages when slow mode is enabled. Requires b42",
      "setting.VoiceEnable.name": "Enable VOIP",
      "setting.VoiceEnable.desc": "If set, VOIP will be enabled",
      "setting.VoiceEnable.value.False": "false",
      "setting.VoiceEnable.value.True": "true",
      "setting.VoiceMinDistance.name": "Minimum Distance For VOIP",
      "setting.VoiceMinDistance.desc": "Sets the minimum tile distance over which VOIP sounds can be heard",
      "setting.VoiceMaxDistance.name": "Maximum Distance For VOIP",
      "setting.VoiceMaxDistance.desc": "Sets the maximum tile distance over which VOIP sounds can be heard",
      "setting.Voice3D.name": "Enable VOIP 3D",
      "setting.Voice3D.desc": "If set, enables directional audio for VOIP",
      "setting.Voice3D.value.False": "false",
      "setting.Voice3D.value.True": "true",
      "setting.DisableRadioStaff.name": "Disable Radio For Staff",
      "setting.DisableRadioStaff.desc": "If set, disables radio transmissions from players with a \u0027staff\u0027 access level",
      "setting.DisableRadioStaff.value.False": "false",
      "setting.DisableRadioStaff.value.True": "true",
      "setting.DisableRadioAdmin.name": "Disable Radio For Admins",
      "setting.DisableRadioAdmin.desc": "If set, disables radio transmissions from players with an \u0027admin\u0027 access level",
      "setting.DisableRadioAdmin.value.False": "false",
      "setting.DisableRadioAdmin.value.True": "true",
      "setting.DisableRadioGM.name": "Disable Radio For GMs",
      "setting.DisableRadioGM.desc": "If set, disables radio transmissions from players with a \u0027gm\u0027 access level",
      "setting.DisableRadioGM.value.False": "false",
      "setting.DisableRadioGM.value.True": "true",
      "setting.DisableRadioOverseer.name": "Disable Radio For Overseers",
      "setting.DisableRadioOverseer.desc": "If set, disables radio transmissions from players with an \u0027overseer\u0027 access level",
      "setting.DisableRadioOverseer.value.False": "false",
      "setting.DisableRadioOverseer.value.True": "true",
      "setting.DisableRadioModerator.name": "Disable Radio For Moderators",
