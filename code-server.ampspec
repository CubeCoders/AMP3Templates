{
  "Id": "7d3f9192-9467-4c0d-b003-d0d5365342ee",
  "TemplateSlug": "code-server",
  "Lifecycle": {
    "RootDir": "./code-server/",
    "BaseDirectory": "./code-server/",
    "ExecutableWin": " ",
    "ExecutableLinux": "server/bin/code-server",
    "CommandLineArgs": "--bind-addr {{$ApplicationIPBinding}}:{{$ServerPort}} --user-data-dir \u0022{{$FullBaseDir}}data\u0022 --extensions-dir \u0022{{$FullBaseDir}}extensions\u0022 {{SSLMode}}{{$FormattedArgs}} {{ignore-last-opened}}{{disable-getting-started-override}}{{disable-workspace-trust}}{{disable-file-downloads}}{{disable-file-uploads}}{{disable-telemetry}}{{disable-update-check}}{{verbose}}{{enable-proposed-api}}{{disable-proxy}}{{skip-auth-preflight}}{{CustomArgs}} \u0022{{WorkspacePath}}\u0022",
    "CommandLineParameterFormat": "--{0} \u0022{1}\u0022",
    "SteamUpdateAnonymousLogin": "False",
    "ExitMethod": "OS_CLOSE",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "LiveSettingChangeCommandFormat": "",
    "RCONHeartbeatCommand": "ping",
    "EnvironmentVariables": {
      "PASSWORD": "{{password}}",
      "HASHED_PASSWORD": "{{hashed-password}}",
      "GITHUB_TOKEN": "{{github-auth}}",
      "XDG_CONFIG_HOME": "{{$FullInstanceDir}}",
      "XDG_DATA_HOME": "{{$FullInstanceDir}}"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "OS": "Linux",
    "AarchSupport": "Native",
    "Author": "Greelan, juzigu40-ui",
    "URL": "https://github.com/coder/code-server",
    "DisplayImageSource": "url:https://avatars.githubusercontent.com/u/95932066?s=200\u0026v=4",
    "EndpointURIFormat": "{ip}:{GenericModule.App.Ports.$ServerPort}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "2",
    "MinAMPVersion": "2.7.0.0",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^\\[[\\d-]\u002BT[\\d:]\u002B\\.\\d\u002BZ\\] info\\s\u002BSession server listening on .*$",
    "UserJoinRegex": "^$",
    "UserLeaveRegex": "^$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^$"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create Directories",
      "UpdateSourceArgs": "{{$FullBaseDir}}server"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create Directories",
      "UpdateSourceArgs": "{{$FullBaseDir}}data"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create Directories",
      "UpdateSourceArgs": "{{$FullBaseDir}}extensions"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create Directories",
      "UpdateSourceArgs": "{{$FullBaseDir}}workspace"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "code-server Download",
      "UpdateSourceArch": "x86_64",
      "UpdateSourceData": "https://github.com/coder/code-server/releases/download/v{{ServerVersion}}/code-server-{{ServerVersion}}-linux-amd64.tar.gz",
      "UpdateSourceArgs": "code-server.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "code-server Download",
      "UpdateSourceArch": "aarch64",
      "UpdateSourceData": "https://github.com/coder/code-server/releases/download/v{{ServerVersion}}/code-server-{{ServerVersion}}-linux-arm64.tar.gz",
      "UpdateSourceArgs": "code-server.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "code-server Install",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullBaseDir}}\\\u0022 \u0026\u0026 rm -rf server/* \u0026\u0026 tar -xzf code-server.tar.gz -C server --strip-components=1 \u0026\u0026 rm -f code-server.tar.gz \u0026\u0026 echo \\\u0022code-server {{ServerVersion}} installed\\\u0022\u0022"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 9090
    }
  ],
  "VersionSources": [
    {
      "Id": "code-server.versions",
      "Url": "https://registry.npmjs.org/code-server",
      "Select": "$.versions.*",
      "Value": "$.version"
    }
  ],
  "Settings": [
    {
      "FieldName": "bind-addr",
      "ParamFieldName": "bind-addr",
      "Hidden": true,
      "DefaultValue": "{{$ApplicationIPBinding}}:{{$ServerPort}}",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.bind-addr.name",
      "InputType": "text",
      "ExcludeFromImport": true
    },
    {
      "FieldName": "cert",
      "ParamFieldName": "cert",
      "Hidden": true,
      "DefaultValue": "false",
      "Category": "category.code-server:code",
      "Subcategory": "category.proxy-and-ssl:lock:2",
      "DisplayName": "setting.cert.name",
      "InputType": "text",
      "ExcludeFromImport": true
    },
    {
      "FieldName": "auth",
      "ParamFieldName": "auth",
      "DefaultValue": "password",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.auth.name",
      "Description": "setting.auth.desc",
      "Keywords": "auth,authentication,login,mode",
      "InputType": "enum",
      "IncludeInCommandLine": true,
      "EnumValues": {
        "password": "setting.auth.value.password",
        "none": "setting.auth.value.none"
      }
    },
    {
      "FieldName": "password",
      "ParamFieldName": "password",
      "DefaultValue": "{{newguid()}}",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.password.name",
      "Description": "setting.password.desc",
      "Keywords": "password,auth,login",
      "InputType": "Password"
    },
    {
      "FieldName": "hashed-password",
      "ParamFieldName": "hashed-password",
      "DefaultValue": "",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.hashed-password.name",
      "Description": "setting.hashed-password.desc",
      "Keywords": "password,hashed,auth,login,hashed-password",
      "InputType": "Password"
    },
    {
      "FieldName": "github-auth",
      "ParamFieldName": "github-auth",
      "DefaultValue": "",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.github-auth.name",
      "Description": "setting.github-auth.desc",
      "Keywords": "github,token,auth,authentication,github-auth",
      "InputType": "Password"
    },
    {
      "FieldName": "app-name",
      "ParamFieldName": "app-name",
      "DefaultValue": "",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.app-name.name",
      "Description": "setting.app-name.desc",
      "Keywords": "app,name,title,app-name",
      "InputType": "text",
      "Placeholder": "code-server",
      "IncludeInCommandLine": true,
      "SkipIfEmpty": true
    },
    {
      "FieldName": "WorkspacePath",
      "ParamFieldName": "WorkspacePath",
      "Required": true,
      "DefaultValue": "./workspace",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.WorkspacePath.name",
      "Description": "setting.WorkspacePath.desc",
      "Keywords": "workspace,path",
      "InputType": "text",
      "Placeholder": "./workspace"
    },
    {
      "FieldName": "locale",
      "ParamFieldName": "locale",
      "DefaultValue": "",
      "Category": "category.code-server:code",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.locale.name",
