  "ConfigFileMappings": [
    {
      "ConfigFile": "config.yaml",
      "ConfigFormat": "{0}: {1}",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?):\\s*(?\u003Cvalue\u003E.*?)$",
      "ConfigType": "kvp",
      "AutoMap": true
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "code-server",
      "meta.description": "Self-hosted VS Code in the browser",
      "setting.bind-addr.name": "Bind Address",
      "category.code-server": "code-server",
      "category.server": "Server",
      "setting.cert.name": "Certificate File Path",
      "category.proxy-and-ssl": "Proxy and SSL",
      "setting.auth.name": "Web Authentication Mode",
      "setting.auth.desc": "Sets the authentication mode for the web UI. The Web Password or Hashed Web Password must be set if the authentication Mode is set to \u0027Password\u0027",
      "setting.auth.value.password": "Password (default)",
      "setting.auth.value.none": "None",
      "setting.password.name": "Web Password",
      "setting.password.desc": "Sets the password for the code-server web UI. Used when Authentication Mode is set to \u0027Password\u0027, unless the Hashed Web Password is set. Default is a secure random password",
      "setting.hashed-password.name": "Hashed Web Password",
      "setting.hashed-password.desc": "Sets the [argon2-hashed password](https://coder.com/docs/code-server/FAQ#can-i-store-my-password-hashed) for the code-server web UI. Don\u0027t wrap in quotes. Used when Authentication Mode is set to \u0027Password\u0027, and overrides the plain text Web Password",
      "setting.github-auth.name": "GitHub Token",
      "setting.github-auth.desc": "Sets a GitHub authentication token for GitHub integration features",
      "setting.app-name.name": "App Name",
      "setting.app-name.desc": "Sets the application name used in the browser title bar and on the login page, and any other strings that use \u0027{{app}}\u0027. Defaults to \u0027code-server\u0027 if nothing is set",
      "setting.WorkspacePath.name": "Workspace Path",
      "setting.WorkspacePath.desc": "Sets the path to the workspace directory or a .code-workspace file to be opened on launch. Default is the \u0027workspace\u0027 directory in the instance\u0027s root directory",
      "setting.locale.name": "Display Language",
      "setting.locale.desc": "Sets the VS Code display language and the language to show on the login page. Specify the [2-letter language code](https://en.wikipedia.org/wiki/IETF_language_tag)",
      "setting.i18n.name": "Custom Translations",
      "setting.i18n.desc": "Sets the path to a JSON file with custom translations. Merges with default strings and supports all i18n keys",
      "setting.ignore-last-opened.name": "Ignore Last Opened",
      "setting.ignore-last-opened.desc": "If set, the last opened directory or workspace will be ignored in favor of an empty window on launch",
      "setting.ignore-last-opened.value.True": "--ignore-last-opened ",
      "setting.disable-getting-started-override.name": "Disable Getting Started Override",
      "setting.disable-getting-started-override.desc": "If set, the coder/coder override in the Help: Getting Started page will be disabled",
      "setting.disable-getting-started-override.value.True": "--disable-getting-started-override ",
      "setting.disable-workspace-trust.name": "Disable Workspace Trust",
      "setting.disable-workspace-trust.desc": "If set, the Workspace Trust feature will be disabled",
      "setting.disable-workspace-trust.value.True": "--disable-workspace-trust ",
      "setting.disable-file-downloads.name": "Disable File Downloads",
      "setting.disable-file-downloads.desc": "If set, file downloads from code-server will be disabled",
      "setting.disable-file-downloads.value.True": "--disable-file-downloads ",
      "setting.disable-file-uploads.name": "Disable File Uploads",
      "setting.disable-file-uploads.desc": "If set, file uploads to code-server will be disabled",
      "setting.disable-file-uploads.value.True": "--disable-file-uploads ",
      "setting.socket.name": "Socket Path",
      "setting.socket.desc": "Sets the path to a Unix socket to listen on instead of IP:Port. Empty = disabled",
      "setting.reconnection-grace-time.name": "Reconnection Grace Time",
      "setting.reconnection-grace-time.desc": "Sets the reconnection grace time. Clients that disconnect for longer than this duration will need to reload the window. Default = 3 hours",
      "setting.disable-telemetry.name": "Disable Telemetry",
      "setting.disable-telemetry.desc": "If set, telemetry reporting will be disabled",
      "setting.disable-telemetry.value.True": "--disable-telemetry ",
      "setting.disable-update-check.name": "Disable Update Check",
      "setting.disable-update-check.desc": "If set, the automatic update check will be disabled. Otherwise, code-server checks every 6 hours against the latest GitHub release and then notifies once every week that a new release is available",
      "setting.disable-update-check.value.True": "--disable-update-check ",
      "setting.verbose.name": "Enable Verbose Logging",
      "setting.verbose.desc": "If set, verbose logging output for debugging will be enabled",
      "setting.verbose.value.True": "--verbose ",
      "setting.enable-proposed-api.name": "Enable Proposed API",
      "setting.enable-proposed-api.desc": "If set, the proposed VS Code API features for extensions will be enabled",
      "setting.enable-proposed-api.value.True": "--enable-proposed-api ",
      "setting.CustomArgs.name": "Custom Command Line Arguments",
      "setting.CustomArgs.desc": "Sets custom [command line arguments](https://github.com/coder/code-server/blob/main/src/node/cli.ts) for code-server. Don\u0027t use arguments already in AMP\u0027s settings!",
      "setting.proxy-domain.name": "Proxy Domain",
      "setting.proxy-domain.desc": "Sets the [domain used](https://coder.com/docs/code-server/guide#using-a-subdomain) for proxying ports",
      "setting.abs-proxy-base-path.name": "Absolute Proxy Base Path",
      "setting.abs-proxy-base-path.desc": "Sets the [base path](https://coder.com/docs/code-server/guide#prefixing-absproxyport-with-a-path) to prefix to all absproxy requests. Useful when running behind a reverse proxy on a subpath",
      "setting.disable-proxy.name": "Disable Proxy",
      "setting.disable-proxy.desc": "If set, [domain and path proxy routes](https://coder.com/docs/code-server/FAQ#how-do-i-disable-the-proxy) will be disabled",
      "setting.disable-proxy.value.True": "--disable-proxy ",
      "setting.trusted-origins.name": "Trusted Origins",
      "setting.trusted-origins.desc": "Sets trusted origins for which the origin authentication check should be disabled. Useful when behind a reverse proxy that cannot set the origin header",
      "setting.skip-auth-preflight.name": "Skip Auth Preflight",
      "setting.skip-auth-preflight.desc": "If set, allows preflight requests through the proxy without authentication. Useful when behind a reverse proxy",
      "setting.skip-auth-preflight.value.True": "--skip-auth-preflight ",
      "setting.cookie-suffix.name": "Cookie Suffix",
      "setting.cookie-suffix.desc": "Sets a suffix to add to the cookie. This can prevent a collision of cookies for subdomains, making them explicit",
      "setting.SSLMode.name": "SSL Mode",
      "setting.SSLMode.desc": "Sets whether code-server\u0027s internal webserver should use HTTPS. Certificate Path, Certificate Key Path and Certificate Host must be set accordingly. This doesn\u0027t affect SSL termination via a reverse proxy",
      "setting.SSLMode.value._": "Do not use HTTPS (default)",
      "setting.SSLMode.value.--cert_": "Generate and use self-signed certificate",
      "setting.SSLMode.value.--cert_CertPath_--cert-key_cert-key_": "Use specified certificate",
      "setting.CertPath.name": "Certificate Path",
      "setting.CertPath.desc": "Sets the path to an SSL certificate file (which may be a self-signed certificate). Required when SSL Mode is set to \u0027Use specified certificate\u0027",
      "setting.cert-key.name": "Certificate Key Path",
      "setting.cert-key.desc": "Sets the path to the certificate key file. Required when SSL Mode is set to \u0027Use specified certificate\u0027",
      "setting.cert-host.name": "Certificate Host",
      "setting.cert-host.desc": "Sets the hostname to use when the server generates a self-signed certificate. Used when SSL Mode is set to \u0027Generate and use self-signed certificate\u0027. Defaults to \u0027localhost\u0027 if not set",
      "setting.ServerVersion.name": "Server Version",
      "setting.ServerVersion.desc": "Sets the [code-server version](https://github.com/coder/code-server/releases) to install. Latest = the newest release",
      "category.updates": "Updates",
      "category.server-updates": "Server Updates",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "The maximum number of simultaneous users. Set to 0 for unlimited.",
      "port.ServerPort.name": "Server Port",
      "port.ServerPort.desc": "Port for web UI traffic"
    }
  }
}
