      "Category": "category.networking:lan",
      "DisplayName": "setting.$ApplicationIPBinding.name",
      "Description": "setting.$ApplicationIPBinding.desc",
      "Keywords": "ip,binding,bind,address,interface",
      "InputType": "text",
      "Placeholder": "0.0.0.0"
    }
  ],
  "ConfigFileMappings": [
    {
      "ConfigFile": "ServerConfig.ini",
      "ConfigType": "ini",
      "AutoMap": true
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Alchemy Factory",
      "meta.description": "Alchemy Factory Dedicated Server",
      "setting.ServerName.name": "Server Name",
      "setting.ServerName.desc": "Sets the name of the server as shown in the server browser. Maximum 31 characters, longer names are cut off by the server",
      "category.alchemy-factory": "Alchemy Factory",
      "category.server": "Server",
      "setting.ServerPassword.name": "Server Password",
      "setting.ServerPassword.desc": "Sets the password required to join the server, alongside the join code. Default is no password",
      "setting.AdminPassword.name": "Admin Password",
      "setting.AdminPassword.desc": "Sets the password used to become admin in-game with the chat command /admin \u003Cpassword\u003E. The server has no RCON or console, so admin actions are only available in-game. Default is no admin access",
      "setting.ServerPublic.name": "Public Server",
      "setting.ServerPublic.desc": "If enabled, lists the server in the public server browser",
      "setting.ServerRelay.name": "Steam Relay",
      "setting.ServerRelay.desc": "If enabled, routes traffic via the Steam Datagram Relay so the server can be hosted without a public IP address or inbound ports. If disabled, the Game Port and Query Port must be forwarded and players can also connect by IP:port. The join code and public server list work in both modes",
      "setting.ServerLan.name": "LAN Only",
      "setting.ServerLan.desc": "If enabled, the server is only reachable on the local network",
      "setting.$MaxUsers.name": "Max Users",
      "setting.$MaxUsers.desc": "Sets the maximum number of users that may connect to the server at one time",
      "setting.MaxAdmins.name": "Max Admins",
      "setting.MaxAdmins.desc": "Sets the maximum number of players that may be logged in as admin at one time",
      "setting.AutosaveMode.name": "Autosave Mode",
      "setting.AutosaveMode.desc": "Sets how often the world is saved. Progress since the last autosave may be lost when the server is stopped or restarted",
      "category.server-settings": "Server Settings",
      "setting.AutosaveMode.value.0": "Save When Sleeping",
      "setting.AutosaveMode.value.1": "Every 5 Minutes",
      "setting.AutosaveMode.value.2": "Every 10 Minutes",
      "setting.AutosaveMode.value.3": "Never",
      "setting.PauseWhenEmpty.name": "Pause When Empty",
      "setting.PauseWhenEmpty.desc": "If enabled, pauses the game while no players are connected. The world is autosaved when the last player leaves",
      "setting.SessionRetrySeconds.name": "Session Retry Delay",
      "setting.SessionRetrySeconds.desc": "Sets how long to wait after a failed Steam session creation before retrying. Retries never stop",
      "setting.$GamePort.name": "Game Port",
      "setting.$QueryPort.name": "Query Port",
      "setting.CustomArgs.name": "Custom Server Arguments",
      "setting.CustomArgs.desc": "Sets additional command line arguments to pass to the server executable. Space-separated",
      "setting.SpecificReleaseVersion.name": "Proton GE Release Version (Linux)",
      "setting.SpecificReleaseVersion.desc": "Sets the Proton GE [release version](https://github.com/GloriousEggroll/proton-ge-custom/releases) to install. Empty = latest. The server is known to work with GE-Proton11-6. Example: GE-Proton11-6",
      "category.updates": "Updates",
      "category.runtime-configuration": "Runtime Configuration",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.GamePort.name": "Game Port",
      "port.GamePort.desc": "UDP game port. Only reachable directly when Steam Relay is disabled",
      "port.QueryPort.name": "Query Port",
      "port.QueryPort.desc": "Steam query port (UDP). Only reachable directly when Steam Relay is disabled"
    }
  }
}