      "ParamFieldName": "ServerSettings.autosave_mode",
      "DefaultValue": "1",
      "Category": "category.alchemy-factory:stadia_controller",
      "Subcategory": "category.server-settings:settings:2",
      "DisplayName": "setting.AutosaveMode.name",
      "Description": "setting.AutosaveMode.desc",
