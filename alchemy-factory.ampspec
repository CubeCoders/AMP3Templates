{
  "Id": "1abd95d4-bd7e-43b2-a0ca-2e94d00529ef",
  "TemplateSlug": "alchemy-factory",
  "Lifecycle": {
    "RootDir": "./alchemy-factory/",
    "BaseDirectory": "./alchemy-factory/4550060/",
    "ExecutableWin": "4550060\\AlchemyFactory\\Binaries\\Win64\\AlchemyFactoryServer-Win64-Shipping.exe",
    "ExecutableLinux": "/usr/bin/xvfb-run",
    "WorkingDir": "4550060",
    "LinuxCommandLineArgs": "-a \u0022{{$FullRootDir}}.proton/proton\u0022 runinprefix \u0022{{$FullBaseDir}}AlchemyFactory/Binaries/Win64/AlchemyFactoryServer-Win64-Shipping.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} -log {{$FormattedArgs}} {{CustomArgs}}",
    "CommandLineParameterFormat": "-{0}={1}",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}AlchemyFactory\\\\Binaries\\\\Win64\\\\AlchemyFactoryServer-Win64-Shipping\\.exe.*$",
    "ExitMethod": "OS_CLOSE",
    "ExitString": "stop",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "LiveSettingChangeCommandFormat": "",
    "AdminMethod": "TailLogFile",
    "RCONHeartbeatCommand": "ping",
    "TailLogFilePath": "{{$FullBaseDir}}AlchemyFactory/Saved/Logs/AlchemyFactory.log",
    "MaxUsers": 8,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%",
      "SteamAppId": "3669570",
      "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam",
      "HOME": "{{$FullBaseDir}}",
      "PROTON_USE_WINED3D": "1",
      "WINEDEBUG": "-all"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "elijah.",
    "URL": "https://store.steampowered.com/app/3669570/",
    "DisplayImageSource": "url:https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3669570/6972705aba17c765ed16a98d81312a6970a9d362/header_alt_assets_0.jpg",
    "EndpointURIFormat": "",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux",
    "ContainerPolicyReason": "The server is Windows-only and runs on Linux via Proton GE, which requires Xvfb and glibc 2.38 or newer (Debian trixie). Using a container avoids the need for you to install these dependencies on the host.",
    "ConfigVersion": "3",
    "MinAMPVersion": "2.6.2.8"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^\\[[\\d\\.]\u002B-[\\d\\.:]\u002B\\]\\[[\\d ]\u002B\\]LogTemp: \\[ServerConfig\\] session created OK \\(.*\\)$",
    "UserJoinRegex": "\\[[\\d\\.\\-:]\u002B\\]\\[\\s*\\d\u002B\\]LogTemp: Warning: BeltTDGameModeBase::FinishPlayerJoin, Unique ID: (?\u003Cusername\u003E\\d\u002B)",
    "UserLeaveRegex": "\\[[\\d\\.\\-:]\u002B\\]\\[\\s*\\d\u002B\\]LogTemp: Warning: BeltTDGameModeBase::Logout, Unique ID: (?\u003Cusername\u003E\\d\u002B)"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "GamePort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "4550060",
      "UpdateSourceArgs": "3669570",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server Config Seed",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/alchemy-factory/serverconfig.ini",
      "UpdateSourceArgs": "ServerConfig.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Proton GE Download",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullRootDir}}\\\u0022; mkdir -p \\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 \\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullBaseDir}}.config/protonfixes\\\u0022; ProtonVersion=\\\u0022{{SpecificReleaseVersion}}\\\u0022 \u0026\u0026 if [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 \u0026\u0026 -f \\\u0022{{$FullRootDir}}.proton/version\\\u0022 ]]; then read _ InstalledVersion \u003C \\\u0022{{$FullRootDir}}.proton/version\\\u0022; else InstalledVersion=\\\u0022\\\u0022; fi; if [[ -z \\\u0022$ProtonVersion\\\u0022 ]]; then ProtonVersion=$(wget -qO- https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest | jq -r .tag_name); fi; if [[ ! \\\u0022$ProtonVersion\\\u0022 =~ ^GE-Proton[0-9]\u002B-[0-9]\u002B$ ]]; then echo \\\u0022Invalid Proton GE release version format specified\\\u0022 \u0026\u0026 exit 1; elif [[ \\\u0022$InstalledVersion\\\u0022 == \\\u0022$ProtonVersion\\\u0022* ]]; then echo \\\u0022Proton GE version $ProtonVersion already installed. Skipping\\\u0022 \u0026\u0026 exit 0; else [[ -f GE-Proton.tar.gz ]] \u0026\u0026 rm -f GE-Proton.tar.gz \u003E/dev/null 2\u003E\u00261; suffix=\\\u0022\\\u0022; ver=\\\u0022${ProtonVersion#GE-Proton}\\\u0022; major=\\\u0022${ver%%-*}\\\u0022; minor=\\\u0022${ver#*-}\\\u0022; if (( major \u003E 11 || (major == 11 \u0026\u0026 minor \u003E= 4) )); then suffix=\\\u0022-x86_64\\\u0022; fi; wget -qO GE-Proton.tar.gz https://github.com/GloriousEggroll/proton-ge-custom/releases/download/$ProtonVersion/${ProtonVersion}${suffix}.tar.gz || { echo \\\u0022Proton GE download failed from GitHub. Aborting\\\u0022; exit 1; }; rm -rf \\\u0022{{$FullRootDir}}.proton/compatdata/\\\u0022* \u003E/dev/null 2\u003E\u00261; tar -xzf GE-Proton.tar.gz -C \\\u0022{{$FullRootDir}}.proton\\\u0022 --strip-components=1 \u0026\u0026 rm -f GE-Proton.tar.gz \u003E/dev/null 2\u003E\u00261 \u0026\u0026 echo \\\u0022Proton GE version $ProtonVersion downloaded\\\u0022 \u0026\u0026 { STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 PROTON_LOG=1 \u003E/dev/null 2\u003E\u00261; exit 0; }; fi\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "X11 Socket Directory",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022mkdir -p /tmp/.X11-unix \u0026\u0026 chmod 1777 /tmp/.X11-unix\u0022",
      "SkipOnFailure": true
    }
  ],
  "PreStartStages": [
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Rotate Previous Log",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022rm -f \\\u0022{{$FullBaseDir}}AlchemyFactory/Saved/Logs/AlchemyFactory.log\\\u0022 \\\u0022{{$FullBaseDir}}AlchemyFactory/Saved/Logs/AlchemyFactory-backup-\\\u0022*.log \u003E/dev/null 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Rotate Previous Log",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C del /Q /F \u0022{{$FullBaseDir}}AlchemyFactory\\Saved\\Logs\\AlchemyFactory.log\u0022 \u0022{{$FullBaseDir}}AlchemyFactory\\Saved\\Logs\\AlchemyFactory-backup-*.log\u0022 \u003E NUL 2\u003E\u00261",
      "SkipOnFailure": true
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.GamePort.name",
      "Description": "port.GamePort.desc",
      "Ref": "GamePort",
      "Port": 9877,
      "Protocol": "UDP"
    },
    {
      "Name": "port.QueryPort.name",
      "Description": "port.QueryPort.desc",
      "Ref": "QueryPort",
      "Port": 9878,
      "Protocol": "UDP"
    }
  ],
  "Settings": [
    {
      "FieldName": "ServerName",
