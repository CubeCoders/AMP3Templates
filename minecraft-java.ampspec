      "setting.player-idle-timeout.name": "Délai d'inactivité des joueurs",
      "setting.player-idle-timeout.desc": "Combien de minutes un joueur peut rester inactif avant d'être déconnecté. (0 pour désactiver)",
      "setting.enable-status.name": "Activer le statut",
      "setting.enable-status.desc": "Si désactivé, le serveur apparaîtra toujours hors ligne dans la liste des serveurs tant qu'aucun joueur n'est connecté. Cela désactive aussi le mode veille d'AMP.",
      "setting.hide-online-players.name": "Masquer les joueurs connectés",
      "setting.hide-online-players.desc": "Si activé, la liste des joueurs connectés ne sera pas incluse dans les requêtes de statut du serveur",
      "setting.snooper-enabled.name": "Autoriser les statistiques",
      "setting.snooper-enabled.desc": "Si activé, le serveur Minecraft enverra automatiquement des données à Mojang",
      "setting.announce-player-achievements.name": "Annoncer les progrès des joueurs",
      "setting.announce-player-achievements.desc": "Indique si l'obtention d'un progrès par un joueur est annoncée publiquement",
      "setting.max-tick-time.name": "Durée maximale d'un tick",
      "setting.max-tick-time.desc": "Le nombre maximal de millisecondes qu'un seul tick peut prendre avant que le chien de garde n'arrête le serveur.",
      "setting.enable-command-block.name": "Autoriser les blocs de commande",
      "setting.enable-command-block.desc": "Indique si les blocs de commande sont autorisés en jeu.",
      "setting.op-permission-level.name": "Niveau de permission des opérateurs",
      "setting.op-permission-level.desc": "Quelles permissions ont les joueurs opérateurs.",
      "setting.op-permission-level.value.1": "1 - Contourner la protection du point d'apparition",
      "setting.op-permission-level.value.2": "2 - Modifier les paramètres du jeu",
      "setting.op-permission-level.value.3": "3 - Expulser, bannir et nommer des opérateurs",
      "setting.op-permission-level.value.4": "4 - Arrêter le serveur",
      "setting.function-permission-level.name": "Niveau de permission des fonctions",
      "setting.function-permission-level.desc": "Quelles permissions ont les fonctions lorsqu'elles sont exécutées par des actions en jeu",
      "setting.function-permission-level.value.1": "1 - Contourner la protection du point d'apparition",
      "setting.function-permission-level.value.2": "2 - Modifier les paramètres du jeu",
      "setting.function-permission-level.value.3": "3 - Expulser, bannir et nommer des opérateurs",
      "setting.function-permission-level.value.4": "4 - Arrêter le serveur",
      "setting.spawn-protection.name": "Rayon de protection du point d'apparition",
      "setting.spawn-protection.desc": "Le rayon protégé autour du point d'apparition.",
      "setting.level-type.name": "Type de monde",
      "setting.level-type.desc": "Le type de terrain que le serveur doit générer. Vous pouvez aussi saisir votre propre valeur si un mod ou un plugin en fournit une.",
      "setting.level-type.value.minecraft:flat": "Plat",
      "setting.level-type.value.minecraft:large_biomes": "Grands biomes",
      "setting.level-type.value.minecraft:amplified": "Amplifié",
      "setting.level-type.value.minecraft:single_biome_surface": "Biome unique",
      "setting.generator-settings.name": "Paramètres du générateur de monde",
