      "setting.resource-pack-sha1.desc": "A SHA1 Hash of the resource pack to be used in order to verify its integrity.",
      "setting.require-resource-pack.name": "Require Resource Pack",
      "setting.require-resource-pack.desc": "If enabled, this requires the client have the specified resource pack before they connect.",
      "setting.resource-pack-prompt.name": "Resource Pack Prompt",
      "setting.resource-pack-prompt.desc": "The message shown to the user if they do not have the required resource pack when they are prompted for it. JSON formatted.",
      "setting.network-compression-threshold.name": "Network Compression Threshold",
      "setting.network-compression-threshold.desc": "Packets below this size (in bytes) will be sent uncompresesd. Should not be lower than 64 or higher than 1500.",
      "setting.rate-limit.name": "Rate Limit",
      "setting.rate-limit.desc": "Sets the maximum amount of packets a user can send before getting kicked. Setting to 0 disables this feature.",
      "setting.prevent-proxy-connections.name": "Disallow proxied connections",
      "setting.prevent-proxy-connections.desc": "Tries to prevent players who are using proxies/VPNs from joining",
      "setting.use-native-transport.name": "Use Native Transport",
      "setting.use-native-transport.desc": "On Linux systems, improve network performance by using optimized packet sending/receiving (Recommended)",
      "setting.accepts-transfers.name": "Accepts Transfers",
      "setting.accepts-transfers.desc": "Allows servers to accept incoming transfers via a transfer packet.",
      "setting.simulation-distance.name": "Simulation Distance",
      "setting.simulation-distance.desc": "How far away (in chunks) entities and blocks are updated. Higher values use more resources",
      "category.performance": "Performance",
      "setting.entity-broadcast-range-percentage.name": "Entity Broadcast Range",
      "setting.entity-broadcast-range-percentage.desc": "Controls how close entities need to be before being sent to clients. Higher values means they'll be rendered from farther away. Expressed as a percentage of the default value.",
      "setting.sync-chunk-writes.name": "Use Synchronous IO",
      "setting.sync-chunk-writes.desc": "When enabled, offers better data protection in the event of a crash or power outage at the expense of slightly slower read/write times",
      "setting.max-chained-neighbor-updates.name": "Max chained neighbour updates",
      "setting.max-chained-neighbor-updates.desc": "The maximum number of consecutive neighbours that can be updated before skipping them. Set to a negative number to disable.",
      "setting.region-file-compression.name": "Region File Compression",
      "setting.region-file-compression.desc": "Changes the algorithm for the compression of chunks in regions. \"Deflate\" uses the old algorithm. \"LZ4\" uses less CPU, but more disk space",
      "setting.region-file-compression.value.deflate": "Deflate",
      "setting.region-file-compression.value.lz4": "LZ4",
      "setting.region-file-compression.value.none": "None",
      "setting.enable-jmx-monitoring.name": "Enable JMX monitoring",
      "setting.enable-jmx-monitoring.desc": "Exposes server performance information via MBean",
      "setting.server-ip.name": "Server IP Address",
      "setting.server-ip.desc": "Which IP address the Minecraft server should listen on. Leave blank to use any available interface.",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "port.ServerPort.name": "Server Port",
      "port.ServerPort.desc": "The port players connect to. Minecraft: Java Edition is TCP; the UDP half is only used by query.",
      "port.RemoteAdminPort.name": "RCON Port",
      "port.RemoteAdminPort.desc": "Remote console port, used only when RCON is enabled.",
      "event.blockPlaced.name": "A block is changed by a command",
      "event.blockPlaced.desc": "When a command or a command block changes a block in the world. The user named is whoever ran the command.",
      "event.blockPlaced.param.User.name": "User",
      "event.blockPlaced.param.User.desc": "The user who ran the command.",
      "event.blockPlaced.param.Position.name": "Position",
      "event.blockPlaced.param.Position.desc": "All three coordinates together, exactly as the server wrote them.",
      "event.advancementMade.name": "A user makes an advancement",
      "event.advancementMade.desc": "When a user completes one of the advancements the game sets for them.",
      "event.goalReached.name": "A user reaches a goal",
      "event.goalReached.desc": "When a user reaches a goal. The game announces these separately from advancements.",
      "event.challengeCompleted.name": "A user completes a challenge",
      "event.challengeCompleted.desc": "When a user finishes a challenge, which are the hardest things the game asks of them.",
      "event.achievementEarned.name": "A user earns an achievement",
      "event.achievementEarned.desc": "When a user earns an achievement. Only older versions of Minecraft have achievements, and newer ones announce advancements instead.",
      "event.userKilled.name": "A user is killed",
      "event.userKilled.desc": "When a user is killed by something the game can name. Deaths it does not blame on anything, such as a long fall, are not included.",
      "event.userKilled.param.User.name": "User",
      "event.userKilled.param.User.desc": "The user who died.",
      "event.userKilled.param.Cause.name": "Cause",
      "event.userKilled.param.Cause.desc": "How they died, in the game's own words.",
      "event.userKilled.param.Killer.name": "Killer",
      "event.userKilled.param.Killer.desc": "What or who killed them.",
      "event.serverLagging.name": "The server falls behind",
      "event.serverLagging.desc": "When the server says it cannot keep up. A struggling server can say this many times in a row, so whatever you have it do should be safe to repeat.",
      "event.serverLagging.param.MillisecondsBehind.name": "Milliseconds behind",
      "event.serverLagging.param.MillisecondsBehind.desc": "How far behind the server had fallen when it noticed.",
      "event.serverLagging.param.TicksSkipped.name": "Ticks skipped",
      "event.serverLagging.param.TicksSkipped.desc": "How many turns of the world the server had to skip to catch up."
