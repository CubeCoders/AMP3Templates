  "ConfigFileMappings": [
    {
      "ConfigFile": "server.properties",
      "ConfigFormat": "{0}={1}",
      "ConfigType": "kvp",
      "Subsections": [
        {
          "Heading": "$root",
          "SettingMappings": {},
          "AutoMap": true
        }
      ],
      "AutoMap": true,
      "Importable": true
    },
    {
      "ConfigFile": "eula.txt",
      "ConfigFormat": "{0}={1}",
      "ConfigType": "kvp",
      "Subsections": [
        {
          "Heading": "$root",
          "SettingMappings": {
            "eula": "eula"
          }
        }
      ]
    }
  ],
  "BackupExclusions": [
    "logs/",
    "crash-reports/",
    "*.log",
    "*.log.gz",
    "hs_err_pid*.log",
    "debug/"
  ],
  "Events": [
    {
      "Id": "blockPlaced",
      "Name": "event.blockPlaced.name",
      "Description": "event.blockPlaced.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: \\[(?<User>[^\\]]+?): Changed the block at (?<Position>(?<X>-?\\d+), (?<Y>-?\\d+), (?<Z>-?\\d+))\\]",
      "ParamMap": {
        "User": {
          "Name": "event.blockPlaced.param.User.name",
          "Description": "event.blockPlaced.param.User.desc"
        },
        "Position": {
          "Name": "event.blockPlaced.param.Position.name",
          "Description": "event.blockPlaced.param.Position.desc"
        }
      }
    },
    {
      "Id": "advancementMade",
      "Name": "event.advancementMade.name",
      "Description": "event.advancementMade.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<User>\\S+) has made the advancement \\[(?<Advancement>.+?)\\]$"
    },
    {
      "Id": "goalReached",
      "Name": "event.goalReached.name",
      "Description": "event.goalReached.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<User>\\S+) has reached the goal \\[(?<Goal>.+?)\\]$"
    },
    {
      "Id": "challengeCompleted",
      "Name": "event.challengeCompleted.name",
      "Description": "event.challengeCompleted.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<User>\\S+) has completed the challenge \\[(?<Challenge>.+?)\\]$"
    },
    {
      "Id": "achievementEarned",
      "Name": "event.achievementEarned.name",
      "Description": "event.achievementEarned.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<User>\\S+) has just earned the achievement \\[(?<Achievement>.+)\\]$"
    },
    {
      "Id": "userKilled",
      "Name": "event.userKilled.name",
      "Description": "event.userKilled.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<User>\\S+) was (?<Cause>.+?) by (?<Killer>.+)$",
      "ParamMap": {
        "User": {
          "Name": "event.userKilled.param.User.name",
          "Description": "event.userKilled.param.User.desc"
        },
        "Cause": {
          "Name": "event.userKilled.param.Cause.name",
          "Description": "event.userKilled.param.Cause.desc"
        },
        "Killer": {
          "Name": "event.userKilled.param.Killer.name",
          "Description": "event.userKilled.param.Killer.desc"
        }
      }
    },
    {
      "Id": "serverLagging",
      "Name": "event.serverLagging.name",
      "Description": "event.serverLagging.desc",
      "Expression": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: Can't keep up! (?:Is the server overloaded\\? Running (?<MillisecondsBehind>\\d+)ms or (?<TicksSkipped>\\d+) ticks? behind|Did the system time change, or is the server overloaded\\? Running (?<MillisecondsBehind>\\d+)ms behind, skipping (?<TicksSkipped>\\d+) tick\\(?s?\\)?)$",
      "ParamMap": {
        "MillisecondsBehind": {
          "Name": "event.serverLagging.param.MillisecondsBehind.name",
          "Description": "event.serverLagging.param.MillisecondsBehind.desc"
        },
        "TicksSkipped": {
          "Name": "event.serverLagging.param.TicksSkipped.name",
          "Description": "event.serverLagging.param.TicksSkipped.desc"
        }
      }
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Minecraft: Java Edition",
      "meta.description": "The original Minecraft server, plus the Paper, Forge and NeoForge server flavours.",
      "setting.ServerType.name": "Server type",
      "setting.ServerType.desc": "Which flavour of Minecraft server to run. Vanilla is the official server, Paper is a faster drop-in replacement that supports plugins, Folia is Paper with multithreaded region processing, and Forge and NeoForge run mods.",
      "category.server-version": "Server Version",
      "setting.ServerType.value.Vanilla": "Vanilla (official)",
      "setting.ServerType.value.Paper": "Paper",
      "setting.ServerType.value.Folia": "Folia",
      "setting.ServerType.value.Forge": "Forge",
      "setting.ServerType.value.NeoForge": "NeoForge",
      "setting.MinecraftVersion.name": "Minecraft version",
      "setting.MinecraftVersion.desc": "Which version of Minecraft to run. Used when the server type is Vanilla.",
      "setting.MinecraftServerDownload.name": "Server download",
      "setting.MinecraftServerDownload.desc": "The server jar for the chosen Minecraft version, read from Mojang's version document.",
      "setting.PaperMinecraftVersion.name": "Minecraft version (Paper)",
      "setting.PaperMinecraftVersion.desc": "Which version of Minecraft to run Paper for.",
      "setting.PaperBuild.name": "Paper build",
      "setting.PaperBuild.desc": "Which Paper build to install. Choose the Minecraft version first.",
      "setting.FoliaMinecraftVersion.name": "Minecraft version (Folia)",
      "setting.FoliaMinecraftVersion.desc": "Which version of Minecraft to run Folia for.",
      "setting.FoliaBuild.name": "Folia build",
      "setting.FoliaBuild.desc": "Which Folia build to install. Choose the Minecraft version first.",
      "setting.ForgeVersion.name": "Forge version",
      "setting.ForgeVersion.desc": "Which Forge version to install. The list is every published build, newest first. Type a Minecraft version to narrow it down.",
      "setting.NeoForgeVersion.name": "NeoForge version",
      "setting.NeoForgeVersion.desc": "Which NeoForge version to install. Type a Minecraft version to narrow the list down.",
      "setting.eula.name": "Minecraft EULA",
      "setting.eula.desc": "Whether the Minecraft EULA has been accepted.",
      "setting.JavaVersion.name": "Java Version",
      "setting.JavaVersion.desc": "Which version of Java the server should be started with for server types that rely on Java",
      "category.java": "Java",
      "setting.JavaVersion.value.25": "25 - LTS (current Minecraft)",
      "setting.JavaVersion.value.21": "21 - LTS",
      "setting.JavaVersion.value.17": "17 - LTS",
      "setting.JavaVersion.value.11": "11 - LTS",
      "setting.JavaVersion.value.8": "8 - legacy modpacks",
      "setting.JavaPath.name": "Java Version",
      "setting.JavaPath.desc": "Which version of Java the server should be started with for server types that rely on Java",
      "setting.MinMemory.name": "Memory pre-allocation",
      "setting.MinMemory.desc": "Java's minimum heap size. Must be lower than the maximum heap size.",
      "setting.MaxMemory.name": "Memory Limit",
