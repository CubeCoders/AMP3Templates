{
  "Id": "1fc5934a-9bfd-2e56-aa3a-a7dc96db9ac5",
  "TemplateSlug": "minecraft-java",
  "Lifecycle": {
    "RootDir": "./minecraft/",
    "BaseDirectory": "./minecraft/",
    "ExecutableWin": "{{JavaPath}}",
    "ExecutableLinux": "{{JavaPath}}",
    "ExecutableContainer": "java:{{JavaVersion}}",
    "CommandLineArgs": "-Xms{{MinMemory}}M -Xmx{{MaxMemory}}M {{CustomJavaArgs}} -jar {{ServerJar}} nogui",
    "CommandLineParameterFormat": "--{0}={1}",
    "SupportsUniversalSleep": true,
    "ExitTimeout": 60,
    "ExitString": "stop",
    "QuiescenceCommand": "save-off;save-all flush",
    "DequiescenceCommand": "save-on",
    "QuiesceAckRegex": "Saved the game|All dimensions are saved",
    "QuiesceSettleDelayMilliseconds": 30000
  },
  "Management": {
    "SupportsIPv6": true,
    "MaxUsers": 20
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "URL": "https://www.minecraft.net/",
    "DisplayImageSource": "internal:MinecraftJava",
    "EndpointURIFormat": "",
    "SpecificDockerImage": "cubecoders/amp3base:java-lts",
    "EULALocation": "https://www.minecraft.net/en-us/eula",
    "ConfigVersion": "1"
  },
  "Console": {
    "FilterMatchRegex": "^>+\\s*",
    "ThrowawayMessageRegex": "^\\s*>+\\s*$",
    "AppReadyRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: Done \\([\\d.,]+s\\)! For help, type \"help\"",
    "PreConnectRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: UUID of player (?<id>[^ ]+) is (?<userid>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
    "UserIdKind": "minecraft-uuid",
    "UserJoinRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<username>[^ ]+?)\\[\\/(?<endpoint>.+?)\\] logged in with entity id",
    "UserLeaveRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<username>[^ ]+?) left the game$",
    "UserChatRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: <(?<username>.+?)> (?<message>.+)$",
    "MetricsRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: Can't keep up! Is the server overloaded\\? Running (?<Lag>\\d+)ms or \\d+ ticks behind$",
    "StartupProgressRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\](?: \\[[^\\]]*\\])?: (?<stage>Preparing spawn area): (?<PercentageComplete>\\d+)%$",
    "LogRegex": "^\\[\\d{1,2}:\\d{2}:\\d{2}(?: (?<level>[A-Z]+))?\\](?: \\[(?<origin>[^\\]]*?)(?:\\/(?<level>[A-Z]+))?\\])?: (?<message>.*)$"
  },
  "PortReferences": {
    "PrimaryApplicationPortRef": "ServerPort"
  },
  "UpdateStages": [
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Vanilla Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{MinecraftServerDownload}}",
      "UpdateSourceArgs": "server.jar",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerType",
      "UpdateSourceConditionValue": "Vanilla"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Paper Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{PaperBuild.downloadUrl}}",
      "UpdateSourceArgs": "server.jar",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerType",
      "UpdateSourceConditionValue": "Paper"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Folia Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{FoliaBuild.downloadUrl}}",
      "UpdateSourceArgs": "server.jar",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerType",
      "UpdateSourceConditionValue": "Folia"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Forge Installer Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{ForgeVersion.downloadUrl}}",
      "UpdateSourceArgs": "forge-installer.jar",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerType",
      "UpdateSourceConditionValue": "Forge"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "NeoForge Installer Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{NeoForgeVersion.downloadUrl}}",
      "UpdateSourceArgs": "forge-installer.jar",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerType",
      "UpdateSourceConditionValue": "NeoForge"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 25565,
      "Protocol": "Both"
    },
    {
      "Name": "port.RemoteAdminPort.name",
      "Description": "port.RemoteAdminPort.desc",
      "Ref": "RemoteAdminPort",
      "Port": 25575,
      "Required": false
    }
  ],
  "VersionSources": [
    {
      "Id": "mojang.versions",
      "Url": "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json",
      "Select": "$.versions[*]",
      "Value": "$.id",
      "Fields": {
        "url": "$.url",
        "type": "$.type"
      },
      "Where": {
        "type": "release"
      },
      "Sort": "AsReturned"
    },
    {
      "Id": "mojang.server",
      "Url": "{{MinecraftVersion.url}}",
      "Select": "$.downloads.server",
      "Value": "$.url",
      "Display": "$.sha1",
      "Sort": "AsReturned",
      "CacheMinutes": 1440,
      "DependsOn": [
        "MinecraftVersion"
      ]
    },
    {
      "Id": "paper.versions",
      "Url": "https://fill.papermc.io/v3/projects/paper",
      "Select": "$.versions.*[*]",
      "Value": "$"
    },
    {
      "Id": "paper.builds",
      "Url": "https://fill.papermc.io/v3/projects/paper/versions/{{PaperMinecraftVersion}}/builds",
      "Select": "$[*]",
      "Value": "$.id",
      "Fields": {
        "downloadUrl": "$.downloads['server:default'].url",
        "file": "$.downloads['server:default'].name",
        "channel": "$.channel"
      },
      "CacheMinutes": 30,
      "DependsOn": [
        "PaperMinecraftVersion"
      ]
    },
    {
      "Id": "folia.versions",
      "Url": "https://fill.papermc.io/v3/projects/folia",
      "Select": "$.versions.*[*]",
      "Value": "$"
    },
    {
      "Id": "folia.builds",
      "Url": "https://fill.papermc.io/v3/projects/folia/versions/{{FoliaMinecraftVersion}}/builds",
      "Select": "$[*]",
      "Value": "$.id",
      "Fields": {
        "downloadUrl": "$.downloads['server:default'].url",
        "file": "$.downloads['server:default'].name",
        "channel": "$.channel"
      },
      "CacheMinutes": 30,
      "DependsOn": [
        "FoliaMinecraftVersion"
      ]
    },
    {
      "Id": "forge.versions",
      "Url": "https://maven.minecraftforge.net/net/minecraftforge/forge/maven-metadata.xml",
      "Format": "Xml",
      "Select": "//versions/version",
      "Value": "text()",
      "UrlTemplate": "https://maven.minecraftforge.net/net/minecraftforge/forge/{value}/forge-{value}-installer.jar",
      "CacheMinutes": 240
    },
    {
      "Id": "neoforge.versions",
      "Documents": [
        {
          "Url": "https://maven.neoforged.net/releases/net/neoforged/neoforge/maven-metadata.xml",
          "UrlTemplate": "https://maven.neoforged.net/releases/net/neoforged/neoforge/{value}/neoforge-{value}-installer.jar"
        },
        {
          "Url": "https://maven.neoforged.net/releases/net/neoforged/forge/maven-metadata.xml",
          "UrlTemplate": "https://maven.neoforged.net/releases/net/neoforged/forge/{value}/forge-{value}-installer.jar"
        }
      ],
      "Format": "Xml",
      "Select": "//versions/version",
      "Value": "text()",
      "CacheMinutes": 240
    }
  ],
  "Settings": [
    {
      "FieldName": "ServerType",
      "DefaultValue": "Vanilla",
      "Category": "category.server-version:package",
      "DisplayName": "setting.ServerType.name",
      "Description": "setting.ServerType.desc",
      "Keywords": "type,flavour,paper,forge,neoforge,vanilla",
      "InputType": "enum",
      "Order": 1,
      "EnumValues": {
        "Vanilla": "setting.ServerType.value.Vanilla",
        "Paper": "setting.ServerType.value.Paper",
        "Folia": "setting.ServerType.value.Folia",
        "Forge": "setting.ServerType.value.Forge",
        "NeoForge": "setting.ServerType.value.NeoForge"
      }
    },
    {
      "FieldName": "MinecraftVersion",
      "Required": true,
      "ConditionSetting": "ServerType",
      "ConditionValue": "Vanilla",
      "Category": "category.server-version:package",
