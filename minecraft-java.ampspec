      "setting.difficulty.value.peaceful": "Paisible",
      "setting.difficulty.value.easy": "Facile",
      "setting.difficulty.value.hard": "Difficile",
      "setting.level-seed.name": "Graine du monde",
      "setting.level-seed.desc": "Valeur de graine utilisée par le générateur de monde.",
      "category.world": "Monde",
      "setting.level-name.name": "Nom du monde",
      "setting.level-name.desc": "Avec quel monde le serveur Minecraft doit démarrer.",
      "setting.view-distance.name": "Distance d'affichage",
      "setting.view-distance.desc": "Jusqu'où les clients peuvent demander des données de chunks. Des valeurs élevées peuvent dégrader les performances.",
      "setting.allow-nether.name": "Activer le Nether",
