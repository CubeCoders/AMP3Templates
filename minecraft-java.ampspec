      "setting.JavaVersion.value.21": "21 - LTS",
      "setting.JavaVersion.value.8": "8 - anciens modpacks",
      "setting.JavaPath.name": "Version de Java",
      "setting.JavaPath.desc": "Avec quelle version de Java démarrer le serveur, pour les types de serveur qui reposent sur Java",
