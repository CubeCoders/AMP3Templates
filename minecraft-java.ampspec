      "setting.CustomJavaArgs.name": "Options Java supplémentaires",
      "setting.CustomJavaArgs.desc": "Arguments supplémentaires à passer à Java, en plus de ceux qu'AMP utilise pour un type de serveur donné",
      "setting.ServerJar.desc": "Quel fichier jar utiliser. [Automatic] choisit celui par défaut pour le type de serveur.",
      "setting.motd.desc": "Titre affiché dans la liste des serveurs.",
      "setting.$MaxUsers.name": "Nombre maximal de joueurs",
      "setting.$MaxUsers.desc": "Combien de joueurs peuvent être connectés en même temps.",
      "setting.gamemode.name": "Mode de jeu",
      "setting.gamemode.desc": "Le mode de jeu par défaut des joueurs sur le serveur",
