      "setting.max-world-size.name": "Taille maximale du monde",
      "setting.max-world-size.desc": "Jusqu'où la bordure du monde peut s'éloigner du centre.",
      "setting.max-build-height.name": "Hauteur de construction maximale",
      "setting.max-build-height.desc": "La hauteur maximale au-dessus du sol à laquelle les joueurs peuvent poser des blocs. (Supprimé en 1.17 et versions ultérieures)",
      "setting.spawn-monsters.name": "Autoriser les monstres",
      "setting.spawn-monsters.desc": "Indique si les monstres (zombies, squelettes) apparaissent en jeu.",
      "setting.spawn-animals.name": "Autoriser les animaux",
      "setting.spawn-animals.desc": "Indique si les animaux paisibles (vaches, cochons) apparaissent en jeu.",
      "setting.spawn-npcs.name": "Autoriser les PNJ",
      "setting.spawn-npcs.desc": "Indique si les créatures paisibles (villageois) apparaissent en jeu.",
      "setting.resource-pack.name": "URL du pack de ressources",
      "setting.resource-pack.desc": "URL d'un fichier .zip de pack de ressources que les clients doivent télécharger et utiliser.",
      "category.resource-pack": "Pack de ressources",
      "setting.resource-pack-sha1.name": "Empreinte du pack de ressources",
      "setting.resource-pack-sha1.desc": "Une empreinte SHA1 du pack de ressources, afin de vérifier son intégrité.",
      "setting.require-resource-pack.name": "Exiger le pack de ressources",
      "setting.require-resource-pack.desc": "Si activé, le client doit disposer du pack de ressources indiqué avant de pouvoir se connecter.",
      "setting.resource-pack-prompt.name": "Message du pack de ressources",
      "setting.resource-pack-prompt.desc": "Le message affiché au joueur s'il ne dispose pas du pack de ressources requis lorsqu'il lui est proposé. Au format JSON.",
      "setting.network-compression-threshold.name": "Seuil de compression réseau",
      "setting.network-compression-threshold.desc": "Les paquets inférieurs à cette taille (en octets) sont envoyés sans compression. Ne doit pas être inférieur à 64 ni supérieur à 1500.",
      "setting.rate-limit.name": "Limite de débit",
      "setting.rate-limit.desc": "Définit le nombre maximal de paquets qu'un joueur peut envoyer avant d'être déconnecté. 0 désactive cette fonction.",
      "setting.prevent-proxy-connections.name": "Refuser les connexions par proxy",
      "setting.prevent-proxy-connections.desc": "Tente d'empêcher les joueurs utilisant un proxy ou un VPN de se connecter",
      "setting.use-native-transport.name": "Utiliser le transport natif",
      "setting.use-native-transport.desc": "Sur les systèmes Linux, améliore les performances réseau grâce à un envoi et une réception de paquets optimisés (recommandé)",
      "setting.accepts-transfers.name": "Accepter les transferts",
      "setting.accepts-transfers.desc": "Permet au serveur d'accepter les transferts entrants via un paquet de transfert.",
      "setting.simulation-distance.name": "Distance de simulation",
      "setting.simulation-distance.desc": "À quelle distance (en chunks) les entités et les blocs sont mis à jour. Des valeurs élevées consomment plus de ressources",
      "setting.entity-broadcast-range-percentage.name": "Portée de diffusion des entités",
      "setting.entity-broadcast-range-percentage.desc": "Contrôle à quelle distance les entités doivent se trouver avant d'être envoyées aux clients. Des valeurs élevées signifient qu'elles sont affichées de plus loin. Exprimé en pourcentage de la valeur par défaut.",
      "setting.sync-chunk-writes.name": "Utiliser les E/S synchrones",
      "setting.sync-chunk-writes.desc": "Si activé, offre une meilleure protection des données en cas de plantage ou de coupure de courant, au prix de temps de lecture et d'écriture un peu plus lents",
      "setting.max-chained-neighbor-updates.name": "Mises à jour de voisins enchaînées maximales",
      "setting.max-chained-neighbor-updates.desc": "Le nombre maximal de voisins consécutifs pouvant être mis à jour avant d'être ignorés. Une valeur négative désactive cette limite.",
      "setting.region-file-compression.name": "Compression des fichiers de région",
      "setting.region-file-compression.desc": "Modifie l'algorithme de compression des chunks dans les régions. Deflate utilise l'ancien algorithme. LZ4 consomme moins de CPU mais plus d'espace disque",
      "setting.region-file-compression.value.none": "Aucune",
      "setting.enable-jmx-monitoring.name": "Activer la supervision JMX",
      "setting.enable-jmx-monitoring.desc": "Expose les informations de performance du serveur via MBean",
      "setting.server-ip.name": "Adresse IP du serveur",
      "setting.server-ip.desc": "Sur quelle adresse IP le serveur Minecraft doit écouter. Laissez vide pour utiliser toute interface disponible.",
      "setting.$ApplicationIPBinding.name": "Liaison IP",
      "setting.$ApplicationIPBinding.desc": "L'adresse réseau à laquelle le serveur lie ses ports. 0.0.0.0 lie toutes les interfaces (recommandé dans la plupart des cas) ; sur un hôte à plusieurs IP, indiquez une adresse précise.",
      "port.ServerPort.name": "Port du serveur",
      "port.ServerPort.desc": "Le port auquel les joueurs se connectent. Minecraft: Java Edition utilise TCP ; la partie UDP ne sert qu'aux requêtes.",
      "port.RemoteAdminPort.name": "Port RCON",
      "port.RemoteAdminPort.desc": "Port de la console distante, utilisé uniquement lorsque RCON est activé.",
      "category.performance": "Performances",
      "event.blockPlaced.name": "Un bloc est modifié par une commande",
      "event.blockPlaced.desc": "Lorsqu'une commande ou un bloc de commande modifie un bloc dans le monde. L'utilisateur nommé est celui qui a lancé la commande.",
      "event.blockPlaced.param.User.name": "Utilisateur",
      "event.blockPlaced.param.User.desc": "L'utilisateur qui a lancé la commande.",
      "event.blockPlaced.param.Position.name": "Position",
      "event.blockPlaced.param.Position.desc": "Les trois coordonnées ensemble, exactement comme le serveur les a écrites.",
      "event.advancementMade.name": "Un utilisateur obtient un progrès",
      "event.advancementMade.desc": "Lorsqu'un utilisateur termine l'un des progrès que le jeu lui propose.",
      "event.goalReached.name": "Un utilisateur atteint un objectif",
      "event.goalReached.desc": "Lorsqu'un utilisateur atteint un objectif. Le jeu les annonce séparément des progrès.",
      "event.challengeCompleted.name": "Un utilisateur réussit un défi",
      "event.challengeCompleted.desc": "Lorsqu'un utilisateur termine un défi, ce que le jeu lui demande de plus difficile.",
      "event.achievementEarned.name": "Un utilisateur obtient un succès",
      "event.achievementEarned.desc": "Lorsqu'un utilisateur obtient un succès. Seules les anciennes versions de Minecraft ont des succès, les plus récentes annoncent des progrès à la place.",
      "event.userKilled.name": "Un utilisateur est tué",
      "event.userKilled.desc": "Lorsqu'un utilisateur est tué par quelque chose que le jeu sait nommer. Les morts qu'il n'attribue à rien, comme une longue chute, ne sont pas incluses.",
      "event.userKilled.param.User.name": "Utilisateur",
      "event.userKilled.param.User.desc": "L'utilisateur qui est mort.",
      "event.userKilled.param.Cause.name": "Cause",
      "event.userKilled.param.Cause.desc": "Comment il est mort, dans les mots du jeu.",
      "event.userKilled.param.Killer.name": "Responsable",
