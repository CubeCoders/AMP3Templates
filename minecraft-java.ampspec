      "setting.FoliaBuild.name": "Build Folia",
      "setting.FoliaBuild.desc": "Quel build de Folia installer. Choisissez d'abord la version de Minecraft.",
      "setting.ForgeVersion.name": "Version de Forge",
      "setting.ForgeVersion.desc": "Quelle version de Forge installer. La liste contient tous les builds publiés, du plus récent au plus ancien. Saisissez une version de Minecraft pour la restreindre.",
      "setting.NeoForgeVersion.name": "Version de NeoForge",
      "setting.NeoForgeVersion.desc": "Quelle version de NeoForge installer. Saisissez une version de Minecraft pour restreindre la liste.",
      "setting.eula.desc": "Indique si le CLUF de Minecraft a été accepté.",
      "setting.JavaVersion.name": "Version de Java",
      "setting.JavaVersion.desc": "Avec quelle version de Java démarrer le serveur, pour les types de serveur qui reposent sur Java",
