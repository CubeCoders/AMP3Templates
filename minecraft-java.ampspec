      "setting.require-resource-pack.name": "Ressourcenpaket erforderlich",
      "setting.require-resource-pack.desc": "Wenn aktiviert, müssen Clients das angegebene Ressourcenpaket haben, bevor sie sich verbinden können.",
      "setting.resource-pack-prompt.name": "Hinweistext zum Ressourcenpaket",
      "setting.resource-pack-prompt.desc": "Die Meldung, die Spielern angezeigt wird, wenn sie das erforderliche Ressourcenpaket nicht haben. Im JSON-Format.",
      "setting.network-compression-threshold.name": "Schwelle der Netzwerkkomprimierung",
      "setting.network-compression-threshold.desc": "Pakete unterhalb dieser Größe (in Bytes) werden unkomprimiert gesendet. Sollte nicht unter 64 oder über 1500 liegen.",
      "setting.rate-limit.name": "Ratenbegrenzung",
      "setting.rate-limit.desc": "Legt fest, wie viele Pakete ein Spieler senden darf, bevor er getrennt wird. 0 deaktiviert diese Funktion.",
      "setting.prevent-proxy-connections.name": "Proxy-Verbindungen ablehnen",
      "setting.prevent-proxy-connections.desc": "Versucht zu verhindern, dass Spieler über Proxys oder VPNs beitreten",
      "setting.use-native-transport.name": "Natives Transportverfahren verwenden",
      "setting.use-native-transport.desc": "Verbessert auf Linux-Systemen die Netzwerkleistung durch optimiertes Senden und Empfangen von Paketen (empfohlen)",
      "setting.accepts-transfers.name": "Übertragungen annehmen",
      "setting.accepts-transfers.desc": "Erlaubt es Servern, eingehende Übertragungen per Transfer-Paket anzunehmen.",
      "setting.simulation-distance.name": "Simulationsdistanz",
      "setting.simulation-distance.desc": "Wie weit entfernt (in Chunks) Entitäten und Blöcke aktualisiert werden. Höhere Werte verbrauchen mehr Ressourcen",
      "category.performance": "Leistung",
      "setting.entity-broadcast-range-percentage.name": "Sendereichweite für Entitäten",
      "setting.entity-broadcast-range-percentage.desc": "Steuert, wie nah Entitäten sein müssen, bevor sie an Clients gesendet werden. Höhere Werte bedeuten, dass sie aus größerer Entfernung dargestellt werden. Angegeben als Prozentsatz des Standardwerts.",
      "setting.sync-chunk-writes.name": "Synchrone Ein- und Ausgabe verwenden",
      "setting.sync-chunk-writes.desc": "Wenn aktiviert, bietet dies besseren Datenschutz bei einem Absturz oder Stromausfall, auf Kosten etwas langsamerer Lese- und Schreibzeiten",
      "setting.max-chained-neighbor-updates.name": "Maximale verkettete Nachbaraktualisierungen",
      "setting.max-chained-neighbor-updates.desc": "Die maximale Anzahl aufeinanderfolgender Nachbarn, die aktualisiert werden können, bevor sie übersprungen werden. Ein negativer Wert deaktiviert dies.",
      "setting.region-file-compression.name": "Komprimierung der Regionsdateien",
      "setting.region-file-compression.desc": "Ändert den Algorithmus zur Komprimierung von Chunks in Regionen. Deflate verwendet den alten Algorithmus. LZ4 benötigt weniger CPU, aber mehr Speicherplatz",
      "setting.region-file-compression.value.none": "Keine",
      "setting.enable-jmx-monitoring.name": "JMX-Überwachung aktivieren",
      "setting.enable-jmx-monitoring.desc": "Stellt Leistungsdaten des Servers über MBean bereit",
      "setting.server-ip.name": "IP-Adresse des Servers",
      "setting.server-ip.desc": "Auf welcher IP-Adresse der Minecraft-Server lauscht. Leer lassen, um jede verfügbare Schnittstelle zu verwenden.",
      "setting.$ApplicationIPBinding.name": "IP-Bindung",
      "setting.$ApplicationIPBinding.desc": "Die Netzwerkadresse, an die der Server seine Ports bindet. 0.0.0.0 bindet jede Schnittstelle (für die meisten Setups empfohlen); auf Hosts mit mehreren IPs sollte eine bestimmte Adresse gesetzt werden.",
      "port.ServerPort.name": "Serverport",
      "port.ServerPort.desc": "Der Port, zu dem Spieler sich verbinden. Minecraft: Java Edition nutzt TCP; der UDP-Teil wird nur für Abfragen verwendet.",
      "port.RemoteAdminPort.name": "RCON-Port",
      "port.RemoteAdminPort.desc": "Port der Remote-Konsole, wird nur verwendet wenn RCON aktiviert ist.",
      "event.blockPlaced.name": "Ein Block wird durch einen Befehl geändert",
      "event.blockPlaced.desc": "Wenn ein Befehl oder ein Befehlsblock einen Block in der Welt ändert. Genannt wird, wer den Befehl ausgeführt hat.",
      "event.blockPlaced.param.User.name": "Benutzer",
      "event.blockPlaced.param.User.desc": "Der Benutzer, der den Befehl ausgeführt hat.",
      "event.blockPlaced.param.Position.name": "Position",
      "event.blockPlaced.param.Position.desc": "Alle drei Koordinaten zusammen, genau so, wie der Server sie geschrieben hat.",
      "event.advancementMade.name": "Ein Benutzer erreicht einen Fortschritt",
      "event.advancementMade.desc": "Wenn ein Benutzer einen der Fortschritte abschließt, die das Spiel ihm stellt.",
      "event.goalReached.name": "Ein Benutzer erreicht ein Ziel",
      "event.goalReached.desc": "Wenn ein Benutzer ein Ziel erreicht. Das Spiel meldet diese getrennt von den Fortschritten.",
      "event.challengeCompleted.name": "Ein Benutzer besteht eine Herausforderung",
      "event.challengeCompleted.desc": "Wenn ein Benutzer eine Herausforderung abschließt, also das Schwerste, was das Spiel von ihm verlangt.",
      "event.achievementEarned.name": "Ein Benutzer erhält einen Erfolg",
      "event.achievementEarned.desc": "Wenn ein Benutzer einen Erfolg erhält. Nur ältere Versionen von Minecraft kennen Erfolge, neuere melden stattdessen Fortschritte.",
      "event.userKilled.name": "Ein Benutzer wird getötet",
      "event.userKilled.desc": "Wenn ein Benutzer von etwas getötet wird, das das Spiel benennen kann. Tode ohne Verursacher, etwa ein tiefer Sturz, sind nicht enthalten.",
      "event.userKilled.param.User.name": "Benutzer",
      "event.userKilled.param.User.desc": "Der Benutzer, der gestorben ist.",
      "event.userKilled.param.Cause.name": "Ursache",
      "event.userKilled.param.Cause.desc": "Wie er gestorben ist, in den Worten des Spiels.",
      "event.userKilled.param.Killer.name": "Verursacher",
      "event.userKilled.param.Killer.desc": "Was oder wer ihn getötet hat.",
      "event.serverLagging.name": "Der Server fällt zurück",
      "event.serverLagging.desc": "Wenn der Server meldet, dass er nicht mehr mitkommt. Ein überlasteter Server meldet das oft mehrmals hintereinander, was Sie auslösen lassen, sollte sich also gefahrlos wiederholen lassen.",
      "event.serverLagging.param.MillisecondsBehind.name": "Millisekunden im Rückstand",
      "event.serverLagging.param.MillisecondsBehind.desc": "Wie weit der Server zurücklag, als er es bemerkt hat.",
      "event.serverLagging.param.TicksSkipped.name": "Übersprungene Ticks",
      "event.serverLagging.param.TicksSkipped.desc": "Wie viele Weltschritte der Server überspringen musste, um aufzuholen."
    },
    "fr": {
      "meta.description": "Le serveur Minecraft d'origine, ainsi que les variantes Paper, Forge et NeoForge.",
      "setting.ServerType.name": "Type de serveur",
      "setting.ServerType.desc": "Quelle variante du serveur Minecraft exécuter. Vanilla est le serveur officiel, Paper est un remplaçant plus rapide qui prend en charge les plugins, Folia est Paper avec un traitement des régions multithreadé, et Forge et NeoForge exécutent des mods.",
      "category.server-version": "Version du serveur",
      "setting.ServerType.value.Vanilla": "Vanilla (officiel)",
      "setting.MinecraftVersion.name": "Version de Minecraft",
      "setting.MinecraftVersion.desc": "Quelle version de Minecraft exécuter. Utilisée lorsque le type de serveur est Vanilla.",
      "setting.MinecraftServerDownload.name": "Téléchargement du serveur",
      "setting.MinecraftServerDownload.desc": "Le fichier JAR du serveur pour la version de Minecraft choisie, lu depuis le document de version de Mojang.",
      "setting.PaperMinecraftVersion.name": "Version de Minecraft (Paper)",
      "setting.PaperMinecraftVersion.desc": "Pour quelle version de Minecraft exécuter Paper.",
      "setting.PaperBuild.name": "Build Paper",
      "setting.PaperBuild.desc": "Quel build de Paper installer. Choisissez d'abord la version de Minecraft.",
      "setting.FoliaMinecraftVersion.name": "Version de Minecraft (Folia)",
