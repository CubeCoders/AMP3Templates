{
  "Id": "a530b939-e389-494a-95df-efa1d0e90d9f",
  "TemplateSlug": "voyagers-of-nera",
  "Lifecycle": {
    "RootDir": "./voyagers-of-nera/",
    "BaseDirectory": "./voyagers-of-nera/3937860/",
    "ExecutableWin": "3937860\\BoatGame\\Binaries\\Win64\\BoatGameServer-Win64-Shipping.exe",
    "ExecutableLinux": "/bin/bash",
    "WorkingDir": "3937860",
    "LinuxCommandLineArgs": "-c \u0022if [[ -x /usr/bin/wine ]]; then exec /usr/bin/wine \\\u0022{{$FullBaseDir}}BoatGame/Binaries/Win64/BoatGameServer-Win64-Shipping.exe\\\u0022 \\\u0022$@\\\u0022; elif [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 ]]; then unset WINEPREFIX WINEARCH WINEDEBUG; export STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 HOME=\\\u0022{{$FullBaseDir}}\\\u0022; exec \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 runinprefix \\\u0022{{$FullBaseDir}}BoatGame/Binaries/Win64/BoatGameServer-Win64-Shipping.exe\\\u0022 \\\u0022$@\\\u0022; else echo \\\u0022ERROR: Wine was not found at /usr/bin/wine, and this instance has no Proton GE runtime to fall back to.\\\u0022; exit 1; fi\u0022 amp-launch",
    "CommandLineArgs": "{{$PlatformArgs}} BoatGame -Port={{$GamePort}} -log=BoatGame.log -LoggingInShippingEnabled=true {{$FormattedArgs}} {{CustomArgs}}",
    "CommandLineParameterFormat": "-{0}={1}",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}BoatGame\\\\Binaries\\\\Win64\\\\BoatGameServer-Win64-Shipping\\.exe.*-Port={{$GamePort}}.*$",
    "ExitMethod": "OS_CLOSE",
    "ExitString": "stop",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "TailLogFile",
    "RemoteAdminPassword": "Password123",
    "RCONHeartbeatCommand": "ping",
    "TailLogFilePath": "{{$FullBaseDir}}BoatGame/Saved/Logs/BoatGame.log",
    "SupportsIPv6": true,
    "MaxUsers": 10,
    "EnvironmentVariables": {
      "SteamAppId": "2686630",
      "WINEPREFIX": "{{$FullRootDir}}.wine",
      "WINEARCH": "win64",
      "WINEDEBUG": "-all",
      "EOS_OVERRIDE_HOST_IP": "{{EOS_OVERRIDE_HOST_IP}}"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan",
    "URL": "https://voyagersofnera.com/",
    "DisplayImageSource": "steam:2686630",
    "EndpointURIFormat": "{ip}:{GenericModule.App.Ports.$GamePort}",
    "SpecificDockerImage": "cubecoders/ampbase:wine-stable",
    "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux",
    "ContainerPolicyReason": "The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.",
    "ConfigVersion": "6",
    "BreakingReleaseNotes": "Linux now uses Wine instead of Proton GE. Container shards switch automatically unless they have an image override. Native shards: install Wine. Until then the old Proton GE install keeps working but is no longer updated. Proton saves are copied into the Wine prefix; .proton/compatdata is kept.",
    "MinAMPVersion": "2.6.2.8"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^\\[[\\d\\.]\u002B-[\\d\\.]\u002B:\\d\u002B\\]\\[[\\d ]\u002B\\]LogCommonSession: OnStartSessionComplete\\(SessionName: GameSession, bWasSuccessful: 1\\)$",
    "UserJoinRegex": "^\\[[\\d\\.]\u002B-[\\d\\.]\u002B:\\d\u002B\\]\\[[\\d ]\u002B\\]LogNet: Login request: \\?Name=(?\u003Cusername\u003E.\u002B?) userId: RedpointEOS:(?\u003Cuserid\u003E.\u002B?) platform: RedpointEOS$",
    "UserLeaveRegex": "^\\[[\\d\\.]\u002B-[\\d\\.]\u002B:\\d\u002B\\]\\[[\\d ]\u002B\\]LogNet: UChannel::Close: Sending CloseBunch\\.(?:.\u002B?) UniqueId: RedpointEOS:(?\u003Cuserid\u003E.\u002B?)$",
    "UserChatRegex": "^(?:\\[[\\d\\.]\u002B-[\\d\\.]\u002B:\\d\u002B\\]\\[[\\d ]\u002B\\])?$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "GamePort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "3937860",
      "UpdateSourceArgs": "2686630",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Component Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "1007",
      "UpdateSourceTarget": "{{$FullBaseDir}}BoatGame/Binaries/Win64",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create Config Directory",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}BoatGame/Saved/PersistedData/CustomConfig"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "CustomHostServerUserSettings.ini Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/voyagers-of-nera/customhostserverusersettings.ini",
      "UpdateSourceArgs": "CustomHostServerUserSettings.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}BoatGame/Saved/PersistedData/CustomConfig",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "CustomGameUserSettings.ini Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/voyagers-of-nera/customgameusersettings.ini",
      "UpdateSourceArgs": "CustomGameUserSettings.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}BoatGame/Saved/PersistedData/CustomConfig",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Initialise Wine",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022if [[ -x /usr/bin/wine ]]; then WINEPREFIX=\\\u0022{{$FullRootDir}}.wine\\\u0022 WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init --update || exit 1; old=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx/drive_c/users/steamuser\\\u0022; new=\\\u0022{{$FullRootDir}}.wine/drive_c/users/$(id -un)\\\u0022; if [[ -d \\\u0022$old\\\u0022 \u0026\u0026 -d \\\u0022$new\\\u0022 \u0026\u0026 ! -e \\\u0022{{$FullRootDir}}.wine/.proton-profile-copied\\\u0022 ]]; then cp -an \\\u0022$old/.\\\u0022 \\\u0022$new/\\\u0022 \u0026\u0026 touch \\\u0022{{$FullRootDir}}.wine/.proton-profile-copied\\\u0022 \u0026\u0026 echo \\\u0022Copied the Proton GE user profile into the Wine prefix\\\u0022; fi; for f in \\\u0022{{$FullRootDir}}.proton\\\u0022/*; do [[ \\\u0022$f\\\u0022 == */compatdata ]] || rm -rf \\\u0022$f\\\u0022; done; elif [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 ]]; then echo \\\u0022WARNING: Wine was not found at /usr/bin/wine, so this instance keeps running on its current Proton GE version, which is no longer updated. To switch to Wine, remove this shard\u0027s container image override or set it to cubecoders/ampbase:wine-stable, or install Wine (latest stable from winehq.org) on the host of a native shard.\\\u0022; else echo \\\u0022ERROR: Wine was not found at /usr/bin/wine. To switch to Wine, remove this shard\u0027s container image override or set it to cubecoders/ampbase:wine-stable, or install Wine (latest stable from winehq.org) on the host of a native shard.\\\u0022; exit 1; fi\u0022"
    }
  ],
