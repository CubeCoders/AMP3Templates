{
  "Id": "8ad0565c-2fb9-4303-b43d-479c0b915030",
  "TemplateSlug": "fistful-of-frags",
  "Lifecycle": {
    "RootDir": "./fof/",
    "BaseDirectory": "./fof/295230/",
    "ExecutableWin": "295230\\srcds.exe",
    "ExecutableLinux": "295230/srcds_linux",
    "WorkingDir": "295230",
    "CommandLineArgs": "{{$PlatformArgs}} -game fof -console -usercon -nobreakpad -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} -tickrate {{tickrate}} {{insecure}}{{nohltv}}{{CustomParameters}} {{CustomConVars}} \u002Btv_port {{$SourceTVPort}} \u002Bclientport {{$ClientPort}} \u002Bsv_logfile 1 {{$FormattedArgs}} \u002Bexec server.cfg \u002Bmap {{map}} \u002Blog on \u002Blogaddress_add {{$UDPLogAddress}}:{{$UDPLogPort}}",
    "ApplicationReadyMode": "RCONConnected",
    "ExitString": "quit",
    "ExitFile": "lock"
  },
  "Management": {
    "UDPLogger": true,
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "ForceIPBinding": true,
    "MaxUsers": 8,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullBaseDir}}:{{$FullBaseDir}}bin:%LD_LIBRARY_PATH%",
      "SteamAppId": "265630"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "NotSupported",
    "Author": "Greelan, connorrichlen (richlen99)",
    "URL": "https://fistful-of-frags.com/",
    "DisplayImageSource": "steam:265630",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "3",
    "MinAMPVersion": "2.6.0.4",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C{{UserIDRegex}}\u003E\u003C\u003E\u0022 entered the game$",
    "UserLeaveRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C{{UserIDRegex}}\u003E\u003C.*\u003E\u0022 disconnected \\(reason \u0022.*\u0022\\)$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "ServerPort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "295230",
      "UpdateSourceArgs": "265630"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server.cfg Template File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/fistful-of-frags/server.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullRootDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Metamod Download",
      "UpdateSourceData": "{{MetamodBuild.downloadUrl}}-linux.tar.gz",
      "UpdateSourceArgs": "metamod.tar.gz",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Metamod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{MetamodBuild.downloadUrl}}-windows.zip",
      "UpdateSourceArgs": "metamod.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourceData": "{{$FullRootDir}}metamod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}fof",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullRootDir}}metamod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}fof",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "SourceMod Download Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}sm",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourceData": "{{SourceModBuild.downloadUrl}}-linux.tar.gz",
      "UpdateSourceArgs": "sourcemod.tar.gz",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{SourceModBuild.downloadUrl}}-windows.zip",
      "UpdateSourceArgs": "sourcemod.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourceData": "{{$FullRootDir}}sourcemod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullRootDir}}sourcemod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022Set-Location -Path \u0027fof/295230\u0027; if (Test-Path \u0027fof/cfg/sourcemod\u0027) { Remove-Item -Path \u0027sm/cfg/sourcemod\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027fof/addons/sourcemod/configs\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/configs\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027fof/addons/sourcemod/plugins\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/plugins\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; Copy-Item -Path \u0027sm/*\u0027 -Destination \u0027fof\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; Remove-Item -Path \u0027sm\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd fof/295230 \u0026\u0026 [ -d fof/cfg/sourcemod ] \u0026\u0026 rm -rf sm/cfg/sourcemod \u003E/dev/null 2\u003E\u00261; [ -d fof/addons/sourcemod/configs ] \u0026\u0026 rm -rf sm/addons/sourcemod/configs \u003E/dev/null 2\u003E\u00261; [ -d fof/addons/sourcemod/plugins ] \u0026\u0026 rm -rf sm/addons/sourcemod/plugins \u003E/dev/null 2\u003E\u00261; \\cp -rf sm/* fof/ \u003E/dev/null 2\u003E\u00261; rm -rf sm \u003E/dev/null 2\u003E\u00261\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../fof/addons/metamod/bin/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}fof/addons/metamod.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C cd fof\\295230\\fof\\addons \u003E NUL 2\u003E\u00261 \u0026\u0026 del /Q /F metamod.vdf \u003E NUL 2\u003E\u00261 \u0026 exit /b 0",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd fof/295230/fof/addons \u003E/dev/null 2\u003E\u00261 \u0026\u0026 rm -rf metamod.vdf \u003E/dev/null 2\u003E\u00261; exit 0\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false"
    }
  ],
  "PreStartStages": [
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../fof/addons/metamod/bin/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}fof/addons/metamod.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C cd fof\\295230\\fof\\addons \u003E NUL 2\u003E\u00261 \u0026\u0026 del /Q /F metamod.vdf \u003E NUL 2\u003E\u00261 \u0026 exit /b 0",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd fof/295230/fof/addons \u003E/dev/null 2\u003E\u00261 \u0026\u0026 rm -rf metamod.vdf \u003E/dev/null 2\u003E\u00261; exit 0\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 27015,
      "Protocol": "Both"
    },
    {
      "Name": "port.SourceTVPort.name",
      "Description": "port.SourceTVPort.desc",
      "Ref": "SourceTVPort",
      "Port": 27020,
      "Protocol": "UDP"
    },
    {
      "Name": "port.ClientPort.name",
      "Description": "port.ClientPort.desc",
      "Ref": "ClientPort",
      "Port": 27005,
      "Protocol": "UDP"
    }
  ],
  "VersionSources": [
    {
      "Id": "metamod.builds",
      "Documents": [
        {
          "Url": "https://api.github.com/repos/alliedmodders/metamod-source/releases?per_page=100",
          "UrlTemplate": "https://github.com/alliedmodders/metamod-source/releases/download/{{MetamodBranch}}.0.{value}/mmsource-{{MetamodBranch}}.0-git{value}"
        },
        {
          "Url": "https://mms.alliedmods.net/mmsdrop/{{MetamodBranch}}/",
          "UrlTemplate": "https://mms.alliedmods.net/mmsdrop/{{MetamodBranch}}/mmsource-{{MetamodBranch}}.0-git{value}"
        }
      ],
      "Format": "Text",
      "Select": "(?:\u0022name\u0022\\s*:\\s*\u0022|href=\u0022)mmsource-(?\u003Cbranch\u003E[0-9]\u002B\\.[0-9]\u002B)\\.0-git(?\u003Cbuild\u003E[0-9]\u002B)-linux\\.tar\\.gz\u0022",
      "Value": "build",
      "Fields": {
        "branch": "branch"
      },
      "Where": {
        "branch": "{{MetamodBranch}}"
      },
      "Sort": "VersionDescending",
      "DependsOn": [
        "MetamodBranch"
      ]
    },
    {
      "Id": "sourcemod.builds",
      "Documents": [
        {
          "Url": "https://api.github.com/repos/alliedmodders/sourcemod/releases?per_page=100",
          "UrlTemplate": "https://github.com/alliedmodders/sourcemod/releases/download/{{SourceModBranch}}.0.{value}/sourcemod-{{SourceModBranch}}.0-git{value}"
        },
        {
          "Url": "https://api.github.com/repos/alliedmodders/sourcemod/releases?per_page=100\u0026page=2",
          "UrlTemplate": "https://github.com/alliedmodders/sourcemod/releases/download/{{SourceModBranch}}.0.{value}/sourcemod-{{SourceModBranch}}.0-git{value}"
        },
        {
          "Url": "https://sm.alliedmods.net/smdrop/{{SourceModBranch}}/",
          "UrlTemplate": "https://sm.alliedmods.net/smdrop/{{SourceModBranch}}/sourcemod-{{SourceModBranch}}.0-git{value}"
        }
      ],
      "Format": "Text",
      "Select": "(?:\u0022name\u0022\\s*:\\s*\u0022|href=\u0022)sourcemod-(?\u003Cbranch\u003E[0-9]\u002B\\.[0-9]\u002B)\\.0-git(?\u003Cbuild\u003E[0-9]\u002B)-linux\\.tar\\.gz\u0022",
      "Value": "build",
      "Fields": {
        "branch": "branch"
      },
      "Where": {
        "branch": "{{SourceModBranch}}"
      },
      "Sort": "VersionDescending",
      "DependsOn": [
        "SourceModBranch"
      ]
    }
  ],
