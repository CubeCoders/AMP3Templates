      "UpdateSourceArgs": "107410",
      "UpdateSourceVersion": "legacyports",
      "UpdateSourceConditionSetting": "ServerBranch",
      "UpdateSourceConditionValue": "legacyports"
    },
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "233780",
      "UpdateSourceArgs": "107410",
      "UpdateSourceVersion": "rc",
      "UpdateSourceConditionSetting": "ServerBranch",
      "UpdateSourceConditionValue": "rc"
    },
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "233780",
      "UpdateSourceArgs": "107410",
      "UpdateSourceVersion": "creatordlcrc",
      "UpdateSourceConditionSetting": "ServerBranch",
      "UpdateSourceConditionValue": "creatordlcrc"
    },
    {
      "UpdateSource": "CopyFilePath",
      "UpdateStageName": "Performance Profiling Binary Copy",
      "UpdateSourceData": "{{$FullBaseDir}}arma3server_x64",
      "UpdateSourceArgs": "{{$FullRootDir}}.profiling/arma3server_x64",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerBranch",
      "UpdateSourceConditionValue": "creatordlc-profiling"
    },
    {
      "UpdateSource": "CopyFilePath",
      "UpdateStageName": "Performance Profiling Binary Copy",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullBaseDir}}ArmA3Server_x64.exe",
      "UpdateSourceArgs": "{{$FullRootDir}}.profiling/ArmA3Server_x64.exe",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerBranch",
      "UpdateSourceConditionValue": "creatordlc-profiling"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server Config Template Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3server.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullBaseDir}}"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Basic Config File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3basic.cfg",
      "UpdateSourceArgs": "basic.cfg",
      "UpdateSourceTarget": "{{$FullBaseDir}}"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Create Server Parameters File",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}parameters.txt"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Create Headless Client Parameters File",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}hc_parameters.txt"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Modscript Download",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3managemods.sh",
      "UpdateSourceArgs": "managemods.sh",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Manage Mods",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "./managemods.sh {{ModDirFormat}}",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Modscript Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3managemods.ps1",
      "UpdateSourceArgs": "managemods.ps1",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Manage Mods",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -File \u0022managemods.ps1\u0022 \u0022{{ModDirFormat}}\u0022",
      "SkipOnFailure": true
    }
  ],
  "PreStartStages": [
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Delete Active File",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022rm -f \\\u0022{{$FullBaseDir}}battleye/\\\u0022beserver*_active_*.cfg \u003E/dev/null 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Delete Active File",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C del /Q /F \u0022{{$FullBaseDir}}battleye\\\u0022beserver*_active_*.cfg \u003E NUL 2\u003E\u00261",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Manage Bikeys",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd arma3/233780; find keys -name \\\u0022*.bikey\\\u0022 ! -name \\\u0022a3.bikey\\\u0022 -delete; IFS=\\\u0022;\\\u0022 read -ra subdirs_array \u003C\u003C\u003C \\\u0022{{mod}};{{clientmod}}\\\u0022; for subdir in \\\u0022${subdirs_array[@]}\\\u0022; do [ -n \\\u0022$(shopt -s nullglob; echo $subdir/*.bikey)\\\u0022 ] \u0026\u0026 \\cp \\\u0022$subdir/\\\u0022*.bikey keys/ \u003E/dev/null 2\u003E\u00261; [ -d \\\u0022$subdir/keys\\\u0022 ] \u0026\u0026 \\cp \\\u0022$subdir/keys/\\\u0022*.bikey keys/ \u003E/dev/null 2\u003E\u00261; [ -d \\\u0022$subdir/key\\\u0022 ] \u0026\u0026 \\cp \\\u0022$subdir/key/\\\u0022*.bikey keys/ \u003E/dev/null 2\u003E\u00261; done\u0022",
      "UpdateSourceConditionSetting": "ManageBikeys",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Manage Bikeys",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022$subdirs = \\\u0022{{mod}};{{clientmod}}\\\u0022 -split \u0027;\u0027; Set-Location arma3\\233780; Remove-Item \u0027.\\keys\\*.bikey\u0027 -Exclude \u0027a3.bikey\u0027 -Force -ErrorAction SilentlyContinue; foreach ($subdir in $subdirs) { Get-ChildItem -Path \\\u0022$subdir\\*.bikey\\\u0022 -File -ErrorAction SilentlyContinue | ForEach-Object { Copy-Item $_ -Destination \u0027.\\keys\u0027 }; if (Test-Path \\\u0022$subdir\\keys\\\u0022) { Copy-Item \\\u0022$subdir\\keys\\*.bikey\\\u0022 -Destination \u0027.\\keys\u0027 -Force -ErrorAction SilentlyContinue }; if (Test-Path \\\u0022$subdir\\key\\\u0022) { Copy-Item \\\u0022$subdir\\key\\*.bikey\\\u0022 -Destination \u0027.\\keys\u0027 -Force -ErrorAction SilentlyContinue }; }\u0022",
      "UpdateSourceConditionSetting": "ManageBikeys",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Headless Client Script Download",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3runhc.sh",
      "UpdateSourceArgs": "runhc.sh",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable",
      "UpdateSourceConditionValue": "_x64"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Headless Client Script Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3runhc.ps1",
      "UpdateSourceArgs": "runhc.ps1",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable",
      "UpdateSourceConditionValue": "_x64"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Headless Client Script Download",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3runhc32.sh",
      "UpdateSourceArgs": "runhc.sh",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Headless Client Script Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/arma3runhc32.ps1",
      "UpdateSourceArgs": "runhc.ps1",
      "UpdateSourceTarget": "{{$FullInstanceDir}}",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Start Headless Clients",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022chmod \u002Bx ./runhc.sh; ./runhc.sh {{HeadlessClientsNum}} {{$ApplicationIPBinding}} {{$GamePort}} \\\u0022{{password}}\\\u0022 \\\u0022{{mod}}\\\u0022 \\\u0022{{hc_parfile}}\\\u0022 {{HeadlessClientsStartLimit}} \u0026\u0022",
      "RunInBackground": true,
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Start Headless Clients",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C start powershell.exe -NoProfile -ExecutionPolicy Bypass -File \u0022runhc.ps1\u0022 {{HeadlessClientsNum}} {{$ApplicationIPBinding}} {{$GamePort}} \u0022{{password}}\u0022 \u0022{{mod}}\u0022 \u0022{{hc_parfile}}\u0022 {{HeadlessClientsStartLimit}}",
      "RunInBackground": true,
      "SkipOnFailure": true
    }
  ],
  "PortRequirements": [
