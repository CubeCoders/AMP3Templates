  "ConfigFileMappings": [
    {
      "ConfigFile": "server.cfg",
      "ConfigFileTemplate": "./arma3/233780/AMP_server.cfg",
      "ConfigType": "template",
      "AutoMap": true
    },
    {
      "ConfigFile": "battleye/beserver{{ServerExecutable}}.cfg",
      "ConfigFormat": "{0} {1}",
      "ConfigType": "kvp",
      "Subsections": [
        {
          "Heading": "$root",
          "SettingMappings": {
            "RConPassword": "$RemoteAdminPassword",
            "RConPort": "$RCONPort",
            "RConIP": "$ApplicationIPBinding"
          }
        }
      ]
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Arma 3",
      "meta.description": "Arma 3 Dedicated Server",
      "setting.hostname.name": "Server Name",
      "setting.hostname.desc": "Sets the server name visible in the game browser",
      "category.arma-3": "Arma 3",
      "category.server": "Server",
      "setting.password.name": "Server Password",
      "setting.password.desc": "Sets the password required to connect to the server. Default is no password",
      "setting.passwordAdmin.name": "Admin Password",
      "setting.passwordAdmin.desc": "Sets the password required for admin access to the server. Default is no password",
      "setting.serverCommandPassword.name": "Command Password",
      "setting.serverCommandPassword.desc": "Sets the password required by alternate syntax of \u0022serverCommand\u0022 server-side scripting. Default is no password",
      "setting.RCONPassword.name": "RCON Password",
      "setting.RCONPassword.desc": "See the Security and Privacy menu for configurable options for the server\u0027s RCON",
      "setting.admins.name": "Server Admins",
      "setting.admins.desc": "Sets the list of [Steam64 IDs](https://steamid.io/) for server admins. Format is \u0022SteamID\u0022,\u0022SteamID\u0022",
      "setting.motd.name": "MOTD",
      "setting.motd.desc": "Sets the player welcome message (MOTD). Format is \u0022Line1\u0022,\u0022Line 2\u0022",
      "setting.motdInterval.name": "MOTD Interval",
      "setting.motdInterval.desc": "Sets the time interval between display of each line of the MOTD",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of clients (including headless clients) that may connect to the server at one time",
      "setting.mod.name": "Load Mods",
      "setting.mod.desc": "Semi-colon separated list (moddir1;moddir2) of [mod directories](https://discourse.cubecoders.com/t/arma-3-server-guide/3475#p-7295-h-42-loading-6) to load (not server-side only mods). ONE LINE ONLY! Specify simply the mod ID or @modname (as applicable to the Updates settings) for any mods downloaded under Updates or the Store. Otherwise, use mod directory paths relative to the server base directory or full paths. Alternatively use the Startup Parameters File option",
      "setting.serverMod.name": "Load Server Mods",
      "setting.serverMod.desc": "Semi-colon separated list (moddir1;moddir2) of [server-side only mod directories](https://discourse.cubecoders.com/t/arma-3-server-guide/3475#p-7295-h-42-loading-6) to load (the mods are not broadcast to clients). ONE LINE ONLY! Specify simply the mod ID or @modname (as applicable to the Updates settings) for any mods downloaded under Updates or the Store. Otherwise, use mod directory paths relative to the server base directory or full paths. Alternatively use the Startup Parameters File option",
      "setting.clientmod.name": "Client Mods",
      "setting.clientmod.desc": "Semi-colon separated list (moddir1;moddir2) of [client-side only mod directories](https://discourse.cubecoders.com/t/arma-3-server-guide/3475#p-7295-h-42-loading-6). ONE LINE ONLY! These won\u0027t be loaded by the server, but will be used by the Manage Bikeys setting if enabled. Specify simply the mod ID or @modname (as applicable to the Updates settings) for any mods downloaded under Updates or the Store. Otherwise, use mod directory paths relative to the server base directory or full paths",
      "setting.ManageBikeys.name": "Manage Bikeys",
      "setting.ManageBikeys.desc": "If enabled, the bikey files for each of the mods specified in Load Mods and Client Mods will be copied to the \u0027keys\u0027 directory on server start, to enable addon signature verification. All existing bikeys in that directory (other than the default \u0027a3.bikey\u0027) will be deleted",
      "setting.ManageBikeys.value.False": "false",
      "setting.ManageBikeys.value.True": "true",
      "setting.ip.name": "Server/RCON IP Binding",
      "setting.ip.desc": "If required, you can change the binding of the server and BattlEye RCON by changing the Application IP Binding for this instance. NOTE: The IP must be reachable by AMP, otherwise AMP\u0027s console won\u0027t work",
      "setting.kickDuplicate.name": "Disallow Duplicate Game IDs",
      "setting.kickDuplicate.desc": "If enabled, players with an ID that is identical to another player will be kicked",
      "setting.kickDuplicate.value.False": "0",
      "setting.kickDuplicate.value.True": "1",
      "setting.verifySignatures.name": "Addon Signature Verification",
      "setting.verifySignatures.desc": "If enabled, players with unknown or unsigned mods will not be allowed to join",
      "setting.verifySignatures.value.False": "0",
      "setting.verifySignatures.value.True": "2",
      "setting.allowedFilePatching.name": "Allow Client File Patching",
      "setting.allowedFilePatching.desc": "Specifies whether to prevent or allow file patching for clients",
      "setting.allowedFilePatching.value.0": "Do not allow (default)",
      "setting.allowedFilePatching.value.1": "Allow headless clients only",
      "setting.allowedFilePatching.value.2": "Allow all clients",
      "setting.filePatchingExceptions.name": "Client File Patching Exceptions",
      "setting.filePatchingExceptions.desc": "Sets a whitelist of [Steam64 IDs](https://steamid.io/) for clients allowed to use file patching. Format is \u0022SteamID\u0022,\u0022SteamID\u0022",
      "setting.requiredBuild.name": "Minimum Client Version",
      "setting.requiredBuild.desc": "Sets the minimum client version, below which clients won\u0027t be allowed to join. Default of 99999999 equates to the server version. NOTE: If the server uses the Performance Profiling Build in any way, set this to 0, otherwise no client can connect",
      "setting.loopback.name": "Force LAN Mode",
      "setting.loopback.desc": "If enabled, the server will be forced into LAN mode - only local clients can connect",
      "setting.loopback.value.False": "false",
      "setting.loopback.value.True": "true",
      "setting.HeadlessClientsNum.name": "Headless Clients To Launch",
      "setting.HeadlessClientsNum.desc": "Sets the number of headless clients to launch when the server starts. Further information on configuration is [here](https://discourse.cubecoders.com/t/arma-3-generic-guide/3475#h-6-headless-clients-9)",
      "setting.HeadlessClientsStartLimit.name": "Headless Clients Launch Time Limit",
      "setting.HeadlessClientsStartLimit.desc": "Sets the maximum time allowed for the server to successfully start, for any headless clients to be launched. If the server takes longer to start, the clients will not be launched",
      "setting.headlessClients.name": "Headless Client IPs",
      "setting.headlessClients.desc": "Sets the IPs of headless clients able to connect to the server. Multiples connections and IPs are allowed. Format is \u0022IP1\u0022,\u0022IP2\u0022",
      "setting.hc_parfile.name": "Use Headless Client Startup Parameters File",
      "setting.hc_parfile.desc": "If enabled, allows the use of a [parameters file](https://community.bistudio.com/wiki/Startup_Parameters_Config_File) for additional startup parameters for headless clients. File is \u0022hc_parameters.txt\u0022 in the server base directory. Useful if the server also uses its own Startup Parameters File for mods. Use with care",
      "setting.hc_parfile.value.True": "hc_parameters.txt",
      "setting.localClient.name": "Local Headless Client IPs",
      "setting.localClient.desc": "Sets the IPs of those headless clients listed under Headless Client IPs that have unlimited bandwidth and nearly no latency. Format is \u0022IP1\u0022,\u0022IP2\u0022",
      "setting.limitFPS.name": "FPS Limit",
      "setting.limitFPS.desc": "Sets the limit for the server FPS. Setting this too high can have an effect on server performance",
      "setting.upnp.name": "Enable UPnP",
      "setting.upnp.desc": "If enabled, the server will automatically create port mappings on UPnP/IGD enabled routers",
      "setting.upnp.value.False": "false",
      "setting.upnp.value.True": "true",
      "setting.CustomServerArgs.name": "Additional Server Startup Parameters",
      "setting.CustomServerArgs.desc": "Specifies additional startup parameters that are not otherwise set by AMP. Alternatively, use the Startup Parameters File option. Use with care",
      "setting.parfile.name": "Use Server Startup Parameters File",
      "setting.parfile.desc": "If enabled, allows the use of a [parameters file](https://community.bistudio.com/wiki/Startup_Parameters_Config_File) for additional startup parameters for the server. File is \u0022parameters.txt\u0022 in the server base directory. Useful for long startup parameters such as -mod or -serverMod. Use with care",
      "setting.parfile.value.True": "-par=parameters.txt ",
      "setting.skipLobby.name": "Skip Lobby",
      "setting.skipLobby.desc": "If enabled, joining players will skip role selection",
      "category.gameplay": "Gameplay",
      "setting.skipLobby.value.False": "false",
      "setting.skipLobby.value.True": "true",
      "setting.voteMissionPlayers.name": "Minimum Players For Mission Selection",
      "setting.voteMissionPlayers.desc": "Sets the minimum number of players required before displaying the mission selection screen",
      "setting.voteThreshold.name": "Minimum Voting Threshold",
      "setting.voteThreshold.desc": "Sets the fraction (0.00 to 1.00) of players needed to vote something into effect",
      "setting.forceRotorLibSimulation.name": "Advanced Flight Model",
      "setting.forceRotorLibSimulation.desc": "Sets the Advanced Flight Model mode",
      "setting.forceRotorLibSimulation.value.0": "Player decides (default)",
      "setting.forceRotorLibSimulation.value.1": "Force Advanced Flight Model",
      "setting.forceRotorLibSimulation.value.2": "Force Simple Flight Model",
      "setting.disableVoN.name": "Disable Voice Chat",
      "setting.disableVoN.desc": "If set, players will not be able to use in-game voice chat",
      "setting.disableVoN.value.False": "0",
      "setting.disableVoN.value.True": "1",
      "setting.vonCodec.name": "Voice Chat Codec",
      "setting.vonCodec.desc": "Sets the voice chat codec type",
      "setting.vonCodec.value.0": "Old SPEEX codec",
      "setting.vonCodec.value.1": "New OPUS codec (default)",
      "setting.vonCodecQuality.name": "Voice Chat Quality",
      "setting.vonCodecQuality.desc": "Sets the voice sound range: 1-10 is 8kHz (narrowband), 11-20 is 16kHz (wideband), 21-30 is 32kHz (SPEEX) or 48kHz (OPUS) (ultrawideband)",
      "setting.autoInit.name": "Start Mission Immediately",
      "setting.autoInit.desc": "If enabled, begins the mission immediately instead of waiting for players to join (autoInit). Requires Persistent Mission to be enabled",
      "setting.autoInit.value.True": "-autoInit ",
      "setting.persistent.name": "Persistent Mission",
      "setting.persistent.desc": "If enabled, the mission keeps running when all players disconnect. Required for \u0022autoInit\u0022 (Start Mission Immediately option)",
      "setting.persistent.value.False": "0",
      "setting.persistent.value.True": "1",
      "setting.autoSelectMission.name": "Enable Automatic Mission Selection",
      "setting.autoSelectMission.desc": "If enabled, the server auto-starts the next mission in the mission cycle and waits for players in the role selection. Requires a [mission cycle](https://community.bistudio.com/wiki/Arma_3:_Server_Config_File#Mission_rotation) to be specified in AMP_server.cfg",
      "setting.autoSelectMission.value.False": "false",
      "setting.autoSelectMission.value.True": "true",
      "setting.randomMissionOrder.name": "Enable Random Mission Order",
      "setting.randomMissionOrder.desc": "If enabled, the server randomly chooses a mission from the mission cycle for starting or auto-starting. Requires a [mission cycle](https://community.bistudio.com/wiki/Arma_3:_Server_Config_File#Mission_rotation) to be specified in AMP_server.cfg",
      "setting.randomMissionOrder.value.False": "false",
      "setting.randomMissionOrder.value.True": "true",
      "setting.drawingInMap.name": "Enable Map Lines/Markers",
      "setting.drawingInMap.desc": "If enabled, gives the ability to place markers and draw lines in map",
      "setting.drawingInMap.value.False": "false",
      "setting.drawingInMap.value.True": "true",
      "setting.allowProfileGlasses.name": "Allow Profile Glasses",
      "setting.allowProfileGlasses.desc": "If disabled, glasses set in a player\u0027s profile will be ignored",
      "setting.allowProfileGlasses.value.False": "false",
      "setting.allowProfileGlasses.value.True": "true",
      "setting.forcedDifficulty.name": "Enforce Difficulty",
      "setting.forcedDifficulty.desc": "Forces the selected difficulty on the server. To use custom difficulty settings, you must configure them in the profile within the A3Master directory",
      "setting.forcedDifficulty.value._": "None (default)",
      "setting.forcedDifficulty.value.Recruit": "Recruit",
      "setting.forcedDifficulty.value.Regular": "Regular",
      "setting.forcedDifficulty.value.Veteran": "Veteran",
      "setting.forcedDifficulty.value.Custom": "Custom",
      "setting.statisticsEnabled.name": "Enable Statistics",
      "setting.statisticsEnabled.desc": "If enabled, the server will opt into [Arma 3 game analytics](https://community.bistudio.com/wiki/Arma_3:_Analytics)",
      "category.miscellaneous": "Miscellaneous",
      "setting.statisticsEnabled.value.False": "false",
      "setting.statisticsEnabled.value.True": "true",
      "setting.allowedLoadFileExtensions.name": "Allowed File Extensions",
      "setting.allowedLoadFileExtensions.desc": "Only allows files with the listed extensions to be loaded via the loadFile command",
      "setting.allowedPreprocessFileExtensions.name": "Allowed Preprocess File Extensions",
      "setting.allowedPreprocessFileExtensions.desc": "Only allows files with the listed extensions to be loaded via the preprocessFile / preprocessFileLineNumbers commands",
      "setting.allowedHTMLLoadExtensions.name": "Allowed HTML Extensions",
      "setting.allowedHTMLLoadExtensions.desc": "Only allows files and URLs with the listed extensions to be loaded via the htmlLoad command",
      "setting.timeStampFormat.name": "Log Time Stamp Format",
      "setting.timeStampFormat.desc": "Sets the format of the time stamps used in the log file",
      "setting.timeStampFormat.value.none": "None (default)",
      "setting.timeStampFormat.value.short": "Short",
      "setting.timeStampFormat.value.full": "Full",
      "setting.enablePlayerDiag.name": "Log Player Info",
      "setting.enablePlayerDiag.desc": "If enabled, the server logs players\u0027 bandwidth and desync info every 60 seconds, as well as \u0022network message is pending\u0022 owner identity",
      "setting.enablePlayerDiag.value.False": "0",
      "setting.enablePlayerDiag.value.True": "1",
      "setting.onUserConnected.name": "Run Script On User Connected",
      "setting.onUserConnected.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when a user has connected",
      "setting.onUserDisconnected.name": "Run Script On User Disconnected",
      "setting.onUserDisconnected.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when a user has disconnected",
      "setting.doubleIdDetected.name": "Run Script On Double ID Detected",
      "setting.doubleIdDetected.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when a second user with the same ID is detected",
      "setting.onUserKicked.name": "Run Script On User Kicked",
      "setting.onUserKicked.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when a user is kicked",
      "setting.onUnsignedData.name": "Run Script On Unsigned Data",
      "setting.onUnsignedData.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when unsigned data is detected",
      "setting.onHackedData.name": "Run Script On Hacked Data",
      "setting.onHackedData.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when a modification of a signed pbo is detected",
      "setting.onDifferentData.name": "Run Script On Different Data",
      "setting.onDifferentData.desc": "Sets [server side scripting](https://community.bistudio.com/wiki/ArmA:_Armed_Assault:_Server_Side_Scripting) to run when a signed pbo is detected with a valid signature, but is a different version than a server has. Use with caution",
      "setting.zeusCompositionScriptLevel.name": "Composition Script Level",
      "setting.zeusCompositionScriptLevel.desc": "Sets the composition script permission level",
      "setting.zeusCompositionScriptLevel.value.0": "All scripts forbidden",
      "setting.zeusCompositionScriptLevel.value.1": "Only attributes allowed (default)",
      "setting.zeusCompositionScriptLevel.value.2": "All scripts allowed",
      "setting.steamProtocolMaxDataSize.name": "Steam Query Packet Size",
      "setting.steamProtocolMaxDataSize.desc": "Sets the maximum Steam query packet size. Increasing this value can be dangerous",
      "setting.callExtReportLimit.name": "Call Extension Report Limit",
      "setting.callExtReportLimit.desc": "If a server-initiated callExtension takes longer than the specified limit, a warning will be logged as well as reflected in the extension return result",
      "setting.LogObjectNotFound.name": "Log Object Not Found",
      "setting.LogObjectNotFound.desc": "If enabled, \u0022object not found\u0022 messages will be logged",
      "setting.LogObjectNotFound.value.False": "false",
      "setting.LogObjectNotFound.value.True": "true",
      "setting.SkipDescriptionParsing.name": "Skip Description Parsing",
      "setting.SkipDescriptionParsing.desc": "If enabled, parsing of description.ext/mission.sqm will be skipped. Will show pbo filename instead of configured missionName",
      "setting.SkipDescriptionParsing.value.False": "false",
      "setting.SkipDescriptionParsing.value.True": "true",
      "setting.ignoreMissionLoadErrors.name": "Ignore Mission Load Errors",
      "setting.ignoreMissionLoadErrors.desc": "If enabled, a mission will load regardless of the number of loading errors",
      "setting.ignoreMissionLoadErrors.value.False": "false",
      "setting.ignoreMissionLoadErrors.value.True": "true",
      "setting.queueSizeLogG.name": "Message Queue Size Threshold",
      "setting.queueSizeLogG.desc": "If enabled, all of a player\u0027s message types and sizes are dumped to a logfile if #monitor is running and the player\u0027s Guaranteed Message Queue size goes above the set threshold",
      "setting.disconnectTimeout.name": "Disconnect Timeout",
      "setting.disconnectTimeout.desc": "Sets the server wait time before disconnecting a player after loss of an active traffic connection (if Kick On Disconnect Timeout is enabled)",
      "category.limits": "Limits",
      "setting.kickTimeout.name": "Kick On Disconnect Timeout",
      "setting.kickTimeout.desc": "If enabled, players hitting the disconnect timeout will be kicked, otherwise that will just be logged",
      "setting.kickTimeout.value.False": "0",
      "setting.kickTimeout.value.True": "1",
      "setting.maxDesync.name": "Maximum Desync",
      "setting.maxDesync.desc": "Sets the maximum desync value before the server kicks a player (if Kick On Maximum Desync is enabled)",
      "setting.kickDesync.name": "Kick On Maximum Desync",
      "setting.kickDesync.desc": "If enabled, players hitting the maximum desync value will be kicked, otherwise that will just be logged",
      "setting.kickDesync.value.False": "0",
      "setting.kickDesync.value.True": "1",
      "setting.maxPing.name": "Maximum Ping",
      "setting.maxPing.desc": "Sets the maximum latency (ping) before the server kicks a player (if Kick On Maximum Ping is enabled)",
      "setting.kickPing.name": "Kick On Maximum Ping",
      "setting.kickPing.desc": "If enabled, players hitting the maximum latency (ping) value will be kicked, otherwise that will just be logged",
      "setting.kickPing.value.False": "0",
      "setting.kickPing.value.True": "1",
      "setting.maxPacketLoss.name": "Maximum Packet Loss",
      "setting.maxPacketLoss.desc": "Sets the maximum packet loss before the server kicks a player (if Kick On Maximum Packet Loss is enabled)",
      "setting.kickLoss.name": "Kick On Maximum Packet Loss",
      "setting.kickLoss.desc": "If enabled, players hitting the maximum packet loss value will be kicked, otherwise that will just be logged",
      "setting.kickLoss.value.False": "0",
      "setting.kickLoss.value.True": "1",
      "setting.kickManual.name": "Manual Kick Waittime",
      "setting.kickManual.desc": "Sets the time interval before a player can return after a manual kick (such as vote kick, admin kick, bruteforce detection). -1 = until mission end, -2 = until server restart",
      "setting.kickConnectivity.name": "Connectivity Kick Waittime",
      "setting.kickConnectivity.desc": "Sets the time interval before a player can return after a connectivity kick (ping, timeout, packetloss, desync). -1 = until mission end, -2 = until server restart",
      "setting.kickBattlEye.name": "BattlEye Kick Waittime",
      "setting.kickBattlEye.desc": "Sets the time interval before a player can return after a BattlEye kick. -1 = until mission end, -2 = until server restart",
      "setting.kickHarmless.name": "Harmless Kick Waittime",
      "setting.kickHarmless.desc": "Sets the time interval before a player can return after a harmless kick (such as wrong addons, Steam timeout or checks, signatures, content, etc). -1 = until mission end, -2 = until server restart",
      "setting.votingTimeOut.name": "Voting Timeout",
      "setting.votingTimeOut.desc": "Sets the time limit for voting. Format is \u003Cready number\u003E,\u003Cnot ready number\u003E",
      "setting.roleTimeOut.name": "Role Selection Timeout",
      "setting.roleTimeOut.desc": "Sets the time limit for role selection. Format is \u003Cready number\u003E,\u003Cnot ready number\u003E",
      "setting.briefingTimeOut.name": "Briefing Timeout",
      "setting.briefingTimeOut.desc": "Sets the time limit for briefing. Format is \u003Cready number\u003E,\u003Cnot ready number\u003E",
      "setting.debriefingTimeOut.name": "Debriefing Timeout",
      "setting.debriefingTimeOut.desc": "Sets the time limit for debriefing. Format is \u003Cready number\u003E,\u003Cnot ready number\u003E",
      "setting.lobbyIdleTimeout.name": "Lobby Idle Timeout",
      "setting.lobbyIdleTimeout.desc": "Sets the time limit for lobby idle",
      "setting.armaUnitsTimeout.name": "ArmaUnits Data Timeout",
      "setting.armaUnitsTimeout.desc": "Sets how long a player will wait for armaUnits data when connecting",
      "setting.ServerExecutable.name": "Server Executable",
      "setting.ServerExecutable.desc": "Sets whether to run the 64 bit or 32 bit version of the server executable",
      "category.updates": "Updates",
      "category.runtime-configuration": "Runtime Configuration",
      "setting.ServerExecutable.value._x64": "64 bit (default)",
      "setting.ServerExecutable.value._": "32 bit",
      "setting.ServerBranch.name": "Server Branch",
      "setting.ServerBranch.desc": "Sets the [server branch](https://community.bistudio.com/wiki/Arma_3:_Steam_Branches#Arma_3_Server) (or branches) to install. Some require a Beta Password. NOTE: Update the server after switching branches, and set the Minimum Client Version to 0 if using the Performance Profiling Build in any way!",
      "category.steam-downloads": "Steam Downloads",
      "setting.ServerBranch.value.public": "Public (default)",
      "setting.ServerBranch.value.profiling": "Performance Profiling Build",
      "setting.ServerBranch.value.creatordlc": "Creator DLC Build",
      "setting.ServerBranch.value.contact": "Contact Build",
      "setting.ServerBranch.value.creatordlc-profiling": "Creator DLC \u002B Performance Profiling Builds",
      "setting.ServerBranch.value.legacy": "Legacy Build",
      "setting.ServerBranch.value.legacycontact": "Legacy Contact Build",
      "setting.ServerBranch.value.legacyports": "Legacy Mac Ports Build",
      "setting.ServerBranch.value.rc": "Release Candidate Build (limited availability)",
      "setting.ServerBranch.value.creatordlcrc": "Creator DLC RC Build (limited availability)",
      "setting.ModDirFormat.name": "Enable Named Mod Directory Links",
      "setting.ModDirFormat.desc": "If set, mods downloaded under \u0022Steam workshop items\u0022 will be linked to the server base directory in the format @modname, rather than just by reference to the mod ID. NOTE: Update the server after changing this setting",
      "category.steam-workshop": "Steam Workshop",
      "setting.ModDirFormat.value.False": "false",
      "setting.ModDirFormat.value.True": "true",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.GamePort.name": "Game Port",
      "port.GamePort.desc": "Port for game traffic",
      "port.QueryPort.name": "Query Port",
      "port.QueryPort.desc": "Port for Steam query traffic",
      "port.SteamPort.name": "Steam Port",
      "port.SteamPort.desc": "Port for Steam traffic",
      "port.ReservedPort.name": "Reserved Port",
      "port.ReservedPort.desc": "Port reserved for VON traffic",
      "port.BattlEyePort.name": "BattlEye Port",
      "port.BattlEyePort.desc": "Port for BattlEye traffic",
      "port.RCONPort.name": "RCON Port",
      "port.RCONPort.desc": "Port for RCON traffic"
    }
  }
}