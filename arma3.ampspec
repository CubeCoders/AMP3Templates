{
  "Id": "22f6f6c7-57c1-41aa-82c1-30875df9ff09",
  "TemplateSlug": "arma3",
  "Lifecycle": {
    "RootDir": "./arma3/",
    "BaseDirectory": "./arma3/233780/",
    "ExecutableWin": "233780\\ArmA3Server{{ServerExecutable}}.exe",
    "ExecutableLinux": "233780/arma3server{{ServerExecutable}}",
    "WorkingDir": "233780",
    "CommandLineArgs": "{{$PlatformArgs}} -name=AMPServer \u0022-profiles={{$FullBaseDir}}A3Master\u0022 \u0022-bepath={{$FullBaseDir}}battleye\u0022 -port={{$GamePort}} -config=server.cfg -cfg=basic.cfg -world=empty -ip={{$ApplicationIPBinding}} {{autoInit}}{{$FormattedArgs}} {{parfile}}{{CustomServerArgs}}",
    "CommandLineParameterFormat": "\u0022-{0}={1}\u0022",
    "SteamUpdateAnonymousLogin": "False",
    "ExitString": "#shutdown",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "BattlEyeRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatMinutes": 0.5,
    "RCONHeartbeatCommand": "ping",
    "MaxUsers": 64,
    "EnvironmentVariables": {
      "SteamAppId": "107410"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan",
    "URL": "https://arma3.com/",
    "DisplayImageSource": "steam:107410",
    "EndpointURIFormat": "steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ExtraSetupStepsURI": "https://discourse.cubecoders.com/docs?topic=3475?utm_source=ampcreate\u0026utm_content=arma3",
    "ConfigVersion": "14",
    "MinAMPVersion": "2.5.1.8",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^((WARNING|ERROR): Shader.\u002B|Unknown command)$",
    "AppReadyRegex": "^RCon admin #\\d\u002B \\([\\d\\.:]\u002B\\) logged in$",
    "UserJoinRegex": "^([\\d:]\u002B BattlEye Server: )?Player #(?\u003Csessionid\u003E.\u002B?) (?\u003Cusername\u003E.\u002B( \\(\\d\u002B\\))?) \\((?\u003Cendpoint\u003E.\u002B?):(?:\\d\u002B)\\) connected$",
    "UserLeaveRegex": "^([\\d:]\u002B BattlEye Server: )?Player #(?\u003Csessionid\u003E.\u002B?) (?\u003Cusername\u003E.\u002B( \\(\\d\u002B\\))?) disconnected$",
    "UserChatRegex": "^$"
  },
  "PortReferences": {
    "AdminPortRef": "RCONPort",
    "PrimaryApplicationPortRef": "GamePort",
    "UniversalSleepApplicationUDPPortRef": "GamePort",
    "UniversalSleepSteamQueryPortRef": "QueryPort"
  },
