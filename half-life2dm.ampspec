  "ConfigFileMappings": [
    {
      "ConfigFile": "hl2mp/cfg/server.cfg",
      "ConfigFileTemplate": "hl2dm/AMP_server.cfg",
      "ConfigType": "template",
      "AutoMap": true
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "Half-Life 2: Deathmatch",
      "meta.description": "Half-Life 2: Deathmatch Dedicated Server",
      "setting.$RemoteAdminPassword.name": "RCON Password",
      "category.half-life-2-deathmatch": "Half-Life 2 Deathmatch",
      "category.server": "Server",
      "setting.hostname.name": "Server Name",
      "setting.hostname.desc": "Sets the name of the server that appears in the server list",
      "setting.sv_tags.name": "Server Tags",
      "setting.sv_tags.desc": "Comma-separated list of server tags that give additional information about the server in the server browser",
      "setting.sv_steamgroup.name": "Server Steam Group",
      "setting.sv_steamgroup.desc": "Sets the ID of the steam group that the server belongs to. You can find your group\u0027s ID on the admin profile page in the steam community",
      "setting.sv_lan.name": "LAN Server",
      "setting.sv_lan.desc": "If enabled, the server will operate as a LAN server: no heartbeat, no authentication, and no non-class C addresses",
      "setting.sv_setsteamaccount.name": "Game Server Login Token (GSLT)",
      "setting.sv_setsteamaccount.desc": "Sets the [Steam Game Server Login Token](https://steamcommunity.com/dev/managegameservers) for the server, to allow it to be listed in the server browser. Use app ID 320 when generating the token",
      "setting.sv_password.name": "Server Password",
      "setting.sv_password.desc": "Sets the password required to connect to the server. Default is no password",
      "setting.map.name": "Initial Map",
      "setting.map.desc": "Sets the map to start the server with. If \u0022Custom\u0022 is selected, Custom Initial Map must also be specified",
      "setting.map.value.halls3": "Halls3",
      "setting.map.value.dm_lockdown": "Lockdown",
      "setting.map.value.dm_overwatch": "Overwatch",
      "setting.map.value.dm_powerhouse": "Powerhouse",
      "setting.map.value.dm_resistance": "Resistance",
      "setting.map.value.dm_runoff": "Run Off",
      "setting.map.value.dm_steamlab": "Steam Lab",
      "setting.map.value.dm_underpass": "Underpass",
      "setting.map.value._CustomMap_": "--Custom--",
      "setting.CustomMap.name": "Custom Initial Map",
      "setting.CustomMap.desc": "Sets a custom map to use for the Initial Map, if \u0022Custom\u0022 is selected",
      "setting.sv_region.name": "Server Region",
      "setting.sv_region.desc": "Sets the server region shown in the server browser",
      "setting.sv_region.value.-1": "No region",
      "setting.sv_region.value.0": "East Coast US",
      "setting.sv_region.value.1": "West Coast US",
      "setting.sv_region.value.2": "South America",
      "setting.sv_region.value.3": "Europe",
      "setting.sv_region.value.4": "Asia",
      "setting.sv_region.value.5": "Australia",
      "setting.sv_region.value.6": "Middle East",
      "setting.sv_region.value.7": "Africa",
      "setting.sv_region.value.255": "World",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server at one time",
      "setting.sv_visiblemaxplayers.name": "Visible Player Limit",
      "setting.sv_visiblemaxplayers.desc": "Sets the maximum players reported to prospective clients, regardless of the Player Limit. -1 = disabled",
      "setting.sv_pure.name": "Pure Server Mode",
      "setting.sv_pure.desc": "Sets whether clients are only allowed to use certain files",
      "setting.sv_pure.value.-1": "Do not restrict client files",
      "setting.sv_pure.value.0": "Apply rules in \u0027pure_server_minimal.txt\u0027 only",
      "setting.sv_pure.value.1": "Apply rules in \u0027pure_server_full.txt\u0027 and then \u0027pure_server_whitelist.txt\u0027",
      "setting.sv_pure.value.2": "Apply rules in \u0027pure_server_full.txt\u0027",
      "setting.sv_pure_kick_clients.name": "Kick Clients On Pure Server",
      "setting.sv_pure_kick_clients.desc": "If enabled, the server will kick clients with mismatching files. Otherwise, it will issue a warning to the clients",
      "setting.sv_forcepreload.name": "Force Preload",
      "setting.sv_forcepreload.desc": "If set, server side preloading will be forced",
      "setting.sv_cheats.name": "Enable Cheats",
      "setting.sv_cheats.desc": "If set, cheat convars will be allowed to be used on the server",
      "setting.insecure.name": "Disable Valve Anti-Cheat",
      "setting.insecure.desc": "If set, Valve Anti-Cheat (VAC) will be disabled",
      "setting.sv_filterban.name": "Enable IP Packet Filter",
      "setting.sv_filterban.desc": "If set, enables packet filtering by IP mode. If disabled, everyone will treated as IP-banned, but their IP won\u0027t be added to the banlist",
      "setting.tickrate.name": "Server Tickrate",
      "setting.tickrate.desc": "Sets the server tickrate",
      "setting.sv_allowdownload.name": "Allow Download From Server",
      "setting.sv_allowdownload.desc": "If set, clients will be allowed to download content from the server (maps, sprays and related)",
      "setting.sv_downloadurl.name": "Fast Download URL",
      "setting.sv_downloadurl.desc": "Sets the URL for clients to download custom content from, instead of sourcing the content from the server. This allows for faster downloads",
      "setting.sv_allowupload.name": "Allow Upload To Server",
      "setting.sv_allowupload.desc": "If set, clients will be allowed to upload customisation files to the server",
      "setting.net_maxfilesize.name": "Maximum File Size",
      "setting.net_maxfilesize.desc": "Sets the maximum allowed file size for uploading to the server",
      "setting.sv_minrate.name": "Minimum Client Rate",
      "setting.sv_minrate.desc": "Sets the minimum allowable bandwidth rate a client may have set when connected to the server. 0 = no minimum",
      "setting.sv_maxrate.name": "Maximum Client Rate",
      "setting.sv_maxrate.desc": "Sets the maximum allowable bandwidth rate a client may have set when connected to the server. 0 = no limit",
      "setting.sv_minupdaterate.name": "Minimum Server Update Rate",
      "setting.sv_minupdaterate.desc": "Sets the minimum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.sv_maxupdaterate.name": "Maximum Server Update Rate",
      "setting.sv_maxupdaterate.desc": "Sets the maximum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.sv_stats.name": "Enable CPU Stats Collection",
      "setting.sv_stats.desc": "If set, CPU stats will be collected",
      "setting.ip.name": "Server/RCON IPv4 IP Binding",
      "setting.ip.desc": "If required, you can change the IPv4 IP binding of the server and RCON by changing the Application IP Binding for this instance. NOTE: AMP requires the server to be bound to a specific IP, rather than 0.0.0.0, for the server to log to AMP\u0027s console. The IP must also be reachable by AMP",
      "setting.sv_timeout.name": "Player Timeout",
      "setting.sv_timeout.desc": "Sets the time before a client is dropped after loss of communication",
      "setting.decalfrequency.name": "Decal Frequency",
      "setting.decalfrequency.desc": "Sets the time before players can spray their decal again",
      "setting.sv_logbans.name": "Log Bans",
      "setting.sv_logbans.desc": "If set, server bans will be logged in the server log",
      "setting.CustomParameters.name": "Additional Command Line Parameters",
      "setting.CustomParameters.desc": "Specifies additional [command line parameters](https://developer.valvesoftware.com/wiki/Command_line_options#Command-Line_Parameters_6) (anything that begins with a -) that are not otherwise set by AMP. Use with care",
      "setting.CustomConVars.name": "Additional Console Variables",
      "setting.CustomConVars.desc": "Specifies additional [console variables](https://steamcommunity.com/sharedfiles/filedetails/?id=189354886) (anything that begins with a \u002B) that are not otherwise set by AMP. Use with care. Preferably, specify the equivalent under \u0022Additional Server Settings\u0022",
      "setting.UserSettings.name": "Additional Server Settings",
      "setting.UserSettings.desc": "Specifies additional [settings](https://steamcommunity.com/sharedfiles/filedetails/?id=189354886) to include in \u0027server.cfg\u0027 that are not otherwise set by AMP. One setting per line",
      "setting.coop.name": "Enable Cooperative Play",
      "setting.coop.desc": "If set, cooperative play will be enabled",
      "category.gameplay": "Gameplay",
      "setting.deathmatch.name": "Enable Deathmatch",
      "setting.deathmatch.desc": "If set, deathmatch will be enabled",
      "setting.sv_maxvelocity.name": "Maximum Velocity",
      "setting.sv_maxvelocity.desc": "Sets the maximum speed any ballistically moving object is allowed to attain per axis",
      "setting.sv_gravity.name": "World Gravity",
      "setting.sv_gravity.desc": "Sets the world gravity",
      "setting.sv_friction.name": "Player Friction",
      "setting.sv_friction.desc": "Sets the player friction. Setting this to a negative number will cause out-of-range errors",
      "setting.sv_accelerate.name": "Player Acceleration",
      "setting.sv_accelerate.desc": "Sets the player acceleration",
      "setting.sv_airaccelerate.name": "Player Air Acceleration",
      "setting.sv_airaccelerate.desc": "Sets the player air acceleration",
      "setting.sv_wateraccelerate.name": "Player Water Acceleration",
      "setting.sv_wateraccelerate.desc": "Sets the player water acceleration",
      "setting.sv_waterfriction.name": "Water Friction",
      "setting.sv_waterfriction.desc": "Sets the water friction",
      "setting.sv_stopspeed.name": "Minimum Stopping Speed",
      "setting.sv_stopspeed.desc": "Sets the minimum stopping speed when on the ground",
      "setting.mp_falldamage.name": "Fall Damage",
      "setting.mp_falldamage.desc": "Sets the damage inflicted from falls",
      "setting.mp_weaponstay.name": "Enable Weapons Stay",
      "setting.mp_weaponstay.desc": "If set, weapons will stay (allowing immediate pickup by players without weapons). Requires that there be additional ammo (can\u0027t pick up a weapon to get more ammo)",
      "setting.mp_forcerespawn.name": "Force Respawn",
      "setting.mp_forcerespawn.desc": "If sets, players will be forced to respawn after death",
      "setting.sv_hl2mp_weapon_respawn_time.name": "Weapon Respawn Time",
      "setting.sv_hl2mp_weapon_respawn_time.desc": "Sets the time period before weapons respawn",
      "setting.sv_hl2mp_item_respawn_time.name": "Item Respawn Time",
      "setting.sv_hl2mp_item_respawn_time.desc": "Sets the time period before items respawn",
      "setting.sv_maxspeed.name": "Maximum Player Movement Speed",
      "setting.sv_maxspeed.desc": "Sets the maximum speed that a player can move at when on the ground",
      "setting.mp_friendlyfire.name": "Enable Friendly Fire",
      "setting.mp_friendlyfire.desc": "If set, friendly fire will be enabled (teammates can cause damage to other teammates)",
      "setting.mp_footsteps.name": "Enable Footsteps",
      "setting.mp_footsteps.desc": "If set, footstep sounds will be enabled",
      "setting.sv_pausable.name": "Allow Players To Pause Server",
      "setting.sv_pausable.desc": "If set, players will be able to pause the server. Not recommended",
      "setting.sv_voiceenable.name": "Enable Voice",
