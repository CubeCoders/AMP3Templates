      "setting.Map.desc": "Sets the map to start the server with",
      "setting.Map.value.LargeTerrain_Central_Main": "Zhongzhou (default)",
      "setting.Map.value.LargeTerrain_Central2_Main": "Dongzhou",
      "setting.Map.value.LargeTerrain_Desert_Main": "Xizhou",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users that can connect to the server at one time",
      "setting.SteamModList.name": "Load Steam Mods",
      "setting.SteamModList.desc": "List (separated by \u0027\u002B\u0027) of Steam mod directories to load. ONE LINE ONLY! Example for mods downloaded under the Updates menu: Mods/3181632026\u002BMods/3202759474. Otherwise, use mod directory paths relative to the \u0027MOE/Binaries/Win64\u0027 directory or full paths",
      "setting.MapDifficultyRate.name": "Difficulty Level",
      "setting.MapDifficultyRate.desc": "Sets the difficulty level of the server, based on the strength and HP of NPCs and animals",
      "setting.GameServerPVPType.name": "Enable PvE / Disable PvP",
      "setting.GameServerPVPType.desc": "If set, PvE mode will be enabled on the server. Otherwise, PvP will be enabled",
      "setting.ForceSteamNet.name": "Enable Steam P2P",
      "setting.ForceSteamNet.desc": "If set, Steam P2P will be enabled",
      "setting.OutAddress.name": "Out IP Address",
      "setting.OutAddress.desc": "Sets the \u0027OutAddress\u0027 IP parameter. Usually this should be set to \u0027Public IP\u0027. However, for purely LAN servers, the \u0027Application IP Binding\u0027 may need to be used - make sure this is set to an actual IP for the instance, and not 0.0.0.0",
      "setting.OutAddress.value._ExternalIP_": "Public IP",
      "setting.OutAddress.value._ApplicationIPBinding_": "Application IP Binding",
      "setting.CustomArgs.name": "Additional Command Line Arguments",
      "setting.CustomArgs.desc": "Specifies [additional command line arguments](https://docs.google.com/spreadsheets/d/1xTy0iQzI6utIqVBSQ4IIOjIyrAeDzLyYpGUVKbjwudY/edit#gid=1781338141) that are not otherwise set by AMP. Alternatively use PrivateServerTool.exe on the client to generate relevant command line arguments. Use with care",
      "setting.bCanChat.name": "Enable Text Chat",
      "setting.bCanChat.desc": "If set, text chat will be enabled",
      "category.advanced": "Advanced",
      "setting.bCanVoiceChat.name": "Enable Voice Chat",
      "setting.bCanVoiceChat.desc": "If set, voice chat will be enabled",
      "setting.NoticeAllEnable.name": "Enable Join/Leave Messages",
      "setting.NoticeAllEnable.desc": "If set, join and leave broadcast messages will be enabled",
      "setting.NoticeEnterServer.name": "Join Message",
      "setting.NoticeEnterServer.desc": "Sets the message broadcast when a player joins the server. Enable Join/Leave Message must be set",
      "setting.NoticeLeaveServer.name": "Leave Message",
      "setting.NoticeLeaveServer.desc": "Sets the message broadcast when a player leaves the server. Enable Join/Leave Message must be set",
      "setting.SaveGameIntervalMinute.name": "Automatic Save Interval",
      "setting.SaveGameIntervalMinute.desc": "Sets the interval between automatic saves of the server",
