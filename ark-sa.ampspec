      "setting.Map.value.Valguero_WP": "Valguero",
      "setting.Map.value.LostColony_WP": "Lost Colony",
      "setting.Map.value.Genesis_WP": "Genesis",
      "setting.Map.value._CustomMap_": "--Custom--",
      "setting.CustomMap.name": "Custom Map Name",
      "setting.CustomMap.desc": "Sets a custom map for the server. \u0022Custom\u0022 type must be selected under Map, and the CurseForge Project ID for the map included under Mods List",
      "setting.mods.name": "Use Mods",
      "setting.mods.desc": "If set, enables automatic mod downloading, updating and loading (on server start). Specify the relevant mods under Mods List. Don\u0027t enable this setting if no mods are specified under Mods List or the server will not start",
      "setting.mods.value.True": "-mods={{modslist}} ",
      "setting.modslist.name": "Mods List",
      "setting.modslist.desc": "Comma-separated and ordered list of [CurseForge Project IDs](https://www.curseforge.com/ark-survival-ascended) for mods (including events) to install and load on server start (map mods will not load unless also named as a \u0022Custom\u0022 map under Custom Map Name). Requires Use Mods to be enabled",
      "setting.passivemods.name": "Use Passive Mods",
      "setting.passivemods.desc": "If enabled, this option activates the -passivemods function, allowing specified mods to load their data while disabling their functionality (even if the mods are listed under Mods List). Don\u0027t enable this setting if no mods are specified under Passive Mods List or the server will not start",
      "setting.passivemods.value.True": "-passivemods={{passivemodslist}} ",
      "setting.passivemodslist.name": "Passive Mods List",
      "setting.passivemodslist.desc": "Comma-separated and ordered list of [CurseForge Project IDs](https://www.curseforge.com/ark-survival-ascended) for mods to be loaded in passive mode, disabling their functionality while retaining their data. Requires Use Passive Mods to be enabled. When enabled, at least one mod ID must be specified, or the server will not start",
      "setting.pconlymods.name": "Enable Steam/PC Mods Only",
      "setting.pconlymods.desc": "If set, crossplay mods will be disabled on the server",
      "setting.pconlymods.value.True": "-pconlymods ",
      "setting.Colors.name": "Dino Event Colors",
      "setting.Colors.desc": "If particular event colors are selected, then dinos may spawn with those colors",
      "setting.Colors.value._": "None",
      "setting.Colors.value.-EasterColors_": "Easter Colors",
      "setting.Colors.value.-HalloweenColors_": "Halloween Colors",
      "setting.Colors.value.-OlympicColors_": "Olympic Colors",
      "setting.Colors.value.-PrideColors_": "Pride Colors",
      "setting.Colors.value.-ServerUseEventColors_": "Current Event Colors",
      "setting.RCONPassword.name": "RCON/Server Admin Password",
      "setting.RCONPassword.desc": "See the Security and Privacy menu for configurable options for the server\u0027s RCON password. The RCON password is also used in the in-game console for players to access administrator commands (unless they are whitelisted)",
      "setting.ServerPassword.name": "Server Password",
      "setting.ServerPassword.desc": "Sets the password for players to join the server",
      "setting.exclusivejoin.name": "Enable Player Whitelist",
      "setting.exclusivejoin.desc": "If set, only players with EOS IDs listed under Whitelisted Players or Whitelisted Players Above Limit can join the server",
      "setting.exclusivejoin.value.True": "-exclusivejoin ",
      "setting.PlayerWhitelist.name": "Whitelisted Players",
      "setting.PlayerWhitelist.desc": "List of EOS IDs for normal whitelisted players. EOS IDs can be found by using the \u0027whoami\u0027 command, by viewing another player\u0027s character in spectator mode, or by inspecting the server\u0027s log files",
      "setting.PlayerWhitelistAboveLimit.name": "Whitelisted Players Above Limit",
      "setting.PlayerWhitelistAboveLimit.desc": "List of EOS IDs for whitelisted players who can join the server even if the number of player slots is exhausted",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server. May be exceeded as a result of players listed under Whitelisted Players Above Limit",
      "setting.BattlEye.name": "Disable BattlEye",
      "setting.BattlEye.desc": "If set, BattlEye will be disabled on the server",
      "setting.BattlEye.value.True": "-NoBattlEye ",
      "setting.ServerPlatform.name": "Client Platform/Crossplay Support",
      "setting.ServerPlatform.desc": "List (separated by \u002B, such as: XSX\u002BPS5) of the game client platforms supported by the server. \u0027PC\u0027 = Steam/PC, \u0027XSX\u0027 = Xbox, \u0027WINGDK\u0027 = Microsoft Store/PC, \u0027PS5\u0027 = PlayStation 5, \u0027ALL\u0027 = all platforms. Crossplay will be enabled if more than one platform is specified",
      "setting.BanListURL.name": "Banlist URL",
      "setting.BanListURL.desc": "Sets a banlist to disallow access to the server to specified players (identified by Steam64 ID). Use either the global banlist of ARK, or a custom banlist URL",
      "setting.AdminLogging.name": "Enable Admin Logging In Chat",
      "setting.AdminLogging.desc": "If set, all admin commands used will be logged to in-game chat",
      "setting.AdminLogging.value.False": "False",
      "setting.AdminLogging.value.True": "True",
      "setting.EnableIdlePlayerKick.name": "Kick Idle Players",
      "setting.EnableIdlePlayerKick.desc": "If set, characters that have not moved or interacted within the Kick Idle Players Period will be kicked from the server",
      "setting.EnableIdlePlayerKick.value.True": "-EnableIdlePlayerKick ",
      "setting.KickIdlePlayersPeriod.name": "Kick Idle Players Period",
      "setting.KickIdlePlayersPeriod.desc": "Sets the time period after which characters that have not moved or interacted will be kicked (if Kick Idle Players is enabled)",
      "setting.AutoSavePeriodMinutes.name": "Auto Save Period",
      "setting.AutoSavePeriodMinutes.desc": "Sets the interval for automatic saves. 0 = constant saving, 9000000 = effectively disabled",
      "setting.NoHangDetection.name": "Disable Hang Detection",
      "setting.NoHangDetection.desc": "If set, prevents the server from shutdown if its start-time takes more than 2700 seconds (45 minutes). Useful for servers with big saves or very slow machines",
      "setting.NoHangDetection.value.True": "-NoHangDetection ",
      "setting.NoTransferFromFiltering.name": "Filter Transfers",
      "setting.NoTransferFromFiltering.desc": "If set, prevents ARK data usage between single player and servers that do not have a Cluster ID set. Even with a Cluster ID set, it is suggested to enable this option",
      "setting.NoTransferFromFiltering.value.True": "-NoTransferFromFiltering ",
      "setting.culture.name": "Language",
      "setting.culture.desc": "Sets the language of the server",
      "setting.culture.value.ca": "Catal\u00E0",
      "setting.culture.value.cs": "\u010De\u0161tina",
      "setting.culture.value.da": "dansk",
      "setting.culture.value.de": "Deutsch",
      "setting.culture.value.en": "English (default)",
      "setting.culture.value.es": "Espa\u00F1ol",
      "setting.culture.value.eu": "euskara",
      "setting.culture.value.fi": "suomi",
      "setting.culture.value.fr": "Fran\u00E7ais",
      "setting.culture.value.hu": "magyar",
      "setting.culture.value.it": "Italiano",
      "setting.culture.value.ja": "\u65E5\u672C\u8A9E",
      "setting.culture.value.ka": "\u10E5\u10D0\u10E0\u10D7\u10E3\u10DA\u10D8",
      "setting.culture.value.ko": "\uD55C\uAD6D\uC5B4",
      "setting.culture.value.nl": "Nederlands",
      "setting.culture.value.pl": "Polski",
      "setting.culture.value.pt_BR": "Portugu\u00EAs brasileiro",
      "setting.culture.value.ru": "\u0420\u0443\u0441\u0441\u043A\u0438\u0439",
      "setting.culture.value.sv": "Svenska",
      "setting.culture.value.th": "\u0E44\u0E17\u0E22",
      "setting.culture.value.tr": "T\u00FCrk\u00E7e",
      "setting.culture.value.zh": "\u4E2D\u6587",
      "setting.culture.value.zh-Hans-CN": "\u4F7F\u7528\u8005",
      "setting.culture.value.zh-TW": "\u56FD\u8BED",
      "setting.ServerIP.name": "Public IP Selection Mode",
      "setting.ServerIP.desc": "Sets whether ARK should automatically select the public IP advertised for the server, or whether it should use the IP set under Server Public IP",
      "setting.ServerIP.value._": "Automatic (default)",
      "setting.ServerIP.value.-ServerIP_ManualServerIP_": "Manual",
      "setting.ManualServerIP.name": "Server Public IP",
      "setting.ManualServerIP.desc": "Sets the public IP advertised for the server, if \u0022Manual\u0022 is selected as the Public IP Selection Mode. Useful if the host network has multiple public IPs, or the server is behind a public proxy",
      "setting.NoGameAnalytics.name": "Disable Game Analytics",
      "setting.NoGameAnalytics.desc": "If set, the server\u0027s game analytics reporting will be disabled",
      "setting.NoGameAnalytics.value.True": "-NoGameAnalytics ",
      "setting.CustomFlags.name": "Custom Command Line Flags",
      "setting.CustomFlags.desc": "Sets custom [command line flags](https://ark.wiki.gg/wiki/Server_configuration_(Survival_Ascended%29) for the server (those that start with a - (dash)). Include the dash and separate with a space. Don\u0027t use flags already in AMP\u0027s settings!",
      "setting.CustomOptions.name": "Custom Command Line Options",
      "setting.CustomOptions.desc": "Sets custom [command line options](https://ark.wiki.gg/wiki/Server_configuration_(Survival_Ascended%29) for the server (those that start with a ? (question mark)). Include the question mark but do not separate with a space. Don\u0027t use options already in AMP\u0027s settings!",
      "setting.ServerPVE.name": "Enable PvE / Disable PvP",
      "setting.ServerPVE.desc": "If set, PvE will be enabled, and PvP disabled",
      "category.gameplay": "Gameplay",
      "setting.ServerPVE.value.False": "False",
      "setting.ServerPVE.value.True": "True",
      "setting.PreventOfflinePvP.name": "Enable Offline Raiding Prevention",
      "setting.PreventOfflinePvP.desc": "If set, the Offline Raiding Prevention option will be enabled, so that when all tribe members are logged off, tribe characters, creatures and structures become invulnerable. Creature starvation still applies, and characters and creatures can still die if drowned",
      "setting.PreventOfflinePvP.value.False": "False",
      "setting.PreventOfflinePvP.value.True": "True",
      "setting.PreventOfflinePvPInterval.name": "Offline Raiding Prevention Interval",
      "setting.PreventOfflinePvPInterval.desc": "Sets the time period after which Offline Raiding Prevention becomes active for tribes/players and related creatures/structures. Recommended to set a minimum for performance reasons",
      "setting.ServerHardcore.name": "Enable Hardcore Mode",
      "setting.ServerHardcore.desc": "If set, enables hardcore mode, meaning player characters revert to level 1 upon death",
      "setting.ServerHardcore.value.False": "False",
      "setting.ServerHardcore.value.True": "True",
      "setting.OverrideOfficialDifficulty.name": "Override Official Difficulty",
      "setting.OverrideOfficialDifficulty.desc": "If enabled, sets the server difficulty level to the value set under \u0022Difficulty Override Level\u0022. This is generally the recommended way to set the difficulty level",
      "setting.OverrideOfficialDifficulty.value.True": "?OverrideOfficialDifficulty={{DifficultyOverrideLevel}}",
      "setting.DifficultyOverrideLevel.name": "Difficulty Override Level",
      "setting.DifficultyOverrideLevel.desc": "Sets the value of the difficulty level to be applied if \u0022Override Official Difficulty\u0022 is enabled, allowing the level to go above the default 4.0. Value of 5.0 will allow common creatures to spawn up to level 150. Be careful not to go too high!",
      "setting.DifficultyOffset.name": "Difficulty Offset",
      "setting.DifficultyOffset.desc": "As an alternative to using \u0022Override Official Difficulty\u0022, this setting sets the difficulty offset, which is used to calculate the [difficulty level](https://ark.wiki.gg/wiki/Difficulty)",
      "setting.ServerCrosshair.name": "Enable Crosshair",
      "setting.ServerCrosshair.desc": "If set, each player will be shown a crosshair",
      "setting.ServerCrosshair.value.False": "False",
      "setting.ServerCrosshair.value.True": "True",
      "setting.ServerForceNoHUD.name": "Disable HUD",
      "setting.ServerForceNoHUD.desc": "If set, the HUD (head-up display) will always be disabled for non-tribe owned NPCs",
      "setting.ServerForceNoHUD.value.False": "False",
      "setting.ServerForceNoHUD.value.Truue": "True",
      "setting.ShowMapPlayerLocation.name": "Show Player On Map",
      "setting.ShowMapPlayerLocation.desc": "If set, shows each player their own precise position when they view their map",
      "setting.ShowMapPlayerLocation.value.False": "False",
      "setting.ShowMapPlayerLocation.value.True": "True",
      "setting.AllowThirdPersonPlayer.name": "Allow Third Person View",
      "setting.AllowThirdPersonPlayer.desc": "If set, the third person camera is enabled",
      "setting.AllowThirdPersonPlayer.value.False": "False",
      "setting.AllowThirdPersonPlayer.value.True": "True",
      "setting.ShowFloatingDamageText.name": "Show Floating Damage Text",
      "setting.ShowFloatingDamageText.desc": "If set, damage caused is shown in a RPG style pop-up text",
      "setting.ShowFloatingDamageText.value.False": "False",
      "setting.ShowFloatingDamageText.value.True": "True",
      "setting.PreventSpawnAnimations.name": "Prevent Spawn Animation",
      "setting.PreventSpawnAnimations.desc": "If set, player characters spawn and respawn without the wake-up animation",
      "setting.PreventSpawnAnimations.value.False": "False",
      "setting.PreventSpawnAnimations.value.True": "True",
      "setting.PreventMateBoost.name": "Disable Creature Mate Boost",
      "setting.PreventMateBoost.desc": "If set, disables creature mate boosting",
      "setting.PreventMateBoost.value.False": "False",
      "setting.PreventMateBoost.value.True": "True",
      "setting.AllowHitMarkers.name": "Enable Hit Markers",
      "setting.AllowHitMarkers.desc": "If set, enables optional hit markers for ranged attacks",
      "setting.AllowHitMarkers.value.False": "False",
      "setting.AllowHitMarkers.value.True": "True",
      "setting.MaxTamedDinos.name": "Maximum Tamed Creatures",
      "setting.MaxTamedDinos.desc": "Sets the maximum number of tamed creatures on the server. This is a global cap",
      "setting.MaxPersonalTamedDinos.name": "Maximum Personal Tamed Creatures",
      "setting.MaxPersonalTamedDinos.desc": "Sets the maximum number of tamed creatures that a tribe is allowed to have. 0 = disabled",
      "setting.MaxTributeDinos.name": "Maximum Tribute Creatures",
      "setting.MaxTributeDinos.desc": "Sets the maximum number of slots for uploaded creatures",
      "setting.TheMaxStructuresInRange.name": "Maximum Structures",
      "setting.TheMaxStructuresInRange.desc": "Sets the maximum number of structures that can be constructed within a certain (currently hard-coded) range",
      "setting.MaxTributeItems.name": "Maximum Tribute Items",
      "setting.MaxTributeItems.desc": "Sets the maximum number of slots for uploaded items and resources",
      "setting.MaxNumberOfPlayersInTribe.name": "Maximum Players In Tribe",
      "setting.MaxNumberOfPlayersInTribe.desc": "Sets the maximum number of players in each tribe. 0 = no limit, 1 = tribes effectively disabled",
      "setting.PreventTribeAlliances.name": "Prevent Tribe Alliances",
      "setting.PreventTribeAlliances.desc": "If set, tribes will be prevented from creating alliances",
      "setting.PreventTribeAlliances.value.False": "False",
      "setting.PreventTribeAlliances.value.True": "True",
      "setting.bDisableFriendlyFire.name": "Disable PvP Friendly Fire",
      "setting.bDisableFriendlyFire.desc": "If set, prevents friendly fire among tribe-mates, tribe-dinosaurs and tribe-structures on PvP servers",
      "setting.bDisableFriendlyFire.value.False": "False",
      "setting.bDisableFriendlyFire.value.True": "True",
      "setting.bPvEDisableFriendlyFire.name": "Disable PvE Friendly Fire",
      "setting.bPvEDisableFriendlyFire.desc": "If set, prevents friendly fire among tribe-mates, tribe-dinosaurs and tribe-structures on PvE servers",
      "setting.bPvEDisableFriendlyFire.value.False": "False",
      "setting.bPvEDisableFriendlyFire.value.True": "True",
      "setting.EnablePvPGamma.name": "Enable PvP Gamma",
      "setting.EnablePvPGamma.desc": "If set, allows use of console command \u0022gamma\u0022 in PvP mode",
      "setting.EnablePvPGamma.value.False": "False",
      "setting.EnablePvPGamma.value.True": "True",
      "setting.DisablePvEGamma.name": "Disable PvE Gamma",
      "setting.DisablePvEGamma.desc": "If set, prevents use of console command \u0022gamma\u0022 in PvE mode",
      "setting.DisablePvEGamma.value.False": "False",
      "setting.DisablePvEGamma.value.True": "True",
      "setting.AlwaysNotifyPlayerJoined.name": "Notify Player Join",
      "setting.AlwaysNotifyPlayerJoined.desc": "If set, players will always be notified if someone joins the server",
      "setting.AlwaysNotifyPlayerJoined.value.False": "False",
      "setting.AlwaysNotifyPlayerJoined.value.True": "True",
      "setting.GlobalVoiceChat.name": "Enable Global Voice Chat",
      "setting.GlobalVoiceChat.desc": "If set, voice chat will be enabled globally",
      "setting.GlobalVoiceChat.value.False": "False",
      "setting.GlobalVoiceChat.value.True": "True",
      "setting.ProximityChat.name": "Enable Proximity Chat",
      "setting.ProximityChat.desc": "If set, only players near each other can see each other\u0027s chat messages",
      "setting.ProximityChat.value.False": "False",
      "setting.ProximityChat.value.True": "True",
      "setting.AllowCaveBuildingPVE.name": "Allow PvE Cave Building",
      "setting.AllowCaveBuildingPVE.desc": "If set, allows building in caves in PvE mode",
      "setting.AllowCaveBuildingPVE.value.False": "False",
      "setting.AllowCaveBuildingPVE.value.True": "True",
      "setting.AllowFlyerCarryPvE.name": "Allow PvE Flyer Carry",
      "setting.AllowFlyerCarryPvE.desc": "If set, flying dinosaurs will be permitted to pick up wild creatures in PvE mode",
      "setting.AllowFlyerCarryPvE.value.False": "False",
      "setting.AllowFlyerCarryPvE.value.True": "True",
      "setting.AllowSpeedLeveling.name": "Allow Speed Levelling",
      "setting.AllowSpeedLeveling.desc": "If set, players and non-flyers can have their movement speed levelled up. Disabled by default due to engine limitations. Use with caution",
      "setting.AllowSpeedLeveling.value.True": "-AllowSpeedLeveling ",
      "setting.ForceAllowCaveFlyers.name": "Allow Cave Flyers",
      "setting.ForceAllowCaveFlyers.desc": "If set, flyers will always be allowed into caves (flyers are able to go into caves by default on custom maps)",
      "setting.ForceAllowCaveFlyers.value.True": "-ForceAllowCaveFlyers ",
      "setting.nodinos.name": "Disable Wild Creature Spawn",
      "setting.nodinos.desc": "If set, wild creatures will not be spawned in the server. For an existing server, existing creatures need to be wiped with the admin command \u0022destroywilddinos\u0022",
      "setting.nodinos.value.True": "-nodinos ",
      "setting.ForceRespawnDinos.name": "Force Wild Creature Respawn On Start",
      "setting.ForceRespawnDinos.desc": "If set, all wild creatures that are not currently tamed will be destroyed on server start",
      "setting.ForceRespawnDinos.value.True": "-ForceRespawnDinos ",
      "setting.DisableRailgunPVP.name": "Disable Tek Railgun",
      "setting.DisableRailgunPVP.desc": "If set, the Tek Railgun will be disabled in PvP mode",
      "setting.DisableRailgunPVP.value.True": "-DisableRailgunPVP ",
      "setting.bDisableLootCrates.name": "Disable Loot Crates",
      "setting.bDisableLootCrates.desc": "If set, loot crates will not spawn. Artifact crates will still spawn",
      "setting.bDisableLootCrates.value.False": "False",
      "setting.bDisableLootCrates.value.True": "True",
      "setting.ResourceNoReplenishRadiusPlayers.name": "Player Radius For No Resource Replenish",
      "setting.ResourceNoReplenishRadiusPlayers.desc": "Sets the distance around players where resources are not allowed to grow back. Values higher than 1 increase it, values between 0 and 1 reduce it",
      "setting.ResourceNoReplenishRadiusStructures.name": "Structure Radius For No Resource Replenish",
      "setting.ResourceNoReplenishRadiusStructures.desc": "Sets the distance around structures where resources are not allowed to grow back. Values higher than 1 increase it, values between 0 and 1 reduce it",
      "setting.DisableDinoDecayPvE.name": "Disable PvE Creature Decay",
      "setting.DisableDinoDecayPvE.desc": "If set, the gradual (7 days) decay (or unclaiming) of creature ownership will be disabled in PvE mode. Otherwise, every creature can be claimed by any player",
      "setting.DisableDinoDecayPvE.value.False": "False",
      "setting.DisableDinoDecayPvE.value.True": "True",
      "setting.PvPDinoDecay.name": "Enable PvP Creature Decay",
      "setting.PvPDinoDecay.desc": "If set, the gradual decay (or unclaiming) of creature ownership will be enabled in PvP mode while Offline Raid Prevention is active",
      "setting.PvPDinoDecay.value.False": "False",
      "setting.PvPDinoDecay.value.True": "True",
      "setting.bPassiveDefensesDamageRiderlessDinos.name": "Enable Passive Defence Damage",
      "setting.bPassiveDefensesDamageRiderlessDinos.desc": "If set, wild and riderless dinosaurs can take damage from passive defence structures like spikewalls",
      "setting.bPassiveDefensesDamageRiderlessDinos.value.False": "False",
      "setting.bPassiveDefensesDamageRiderlessDinos.value.True": "True",
      "setting.PreventDiseases.name": "Prevent Diseases",
      "setting.PreventDiseases.desc": "If set, diseases will be completely disabled on the server",
      "setting.PreventDiseases.value.False": "False",
      "setting.PreventDiseases.value.True": "True",
      "setting.NonPermanentDiseases.name": "Disable Permanent Diseases",
      "setting.NonPermanentDiseases.desc": "If set, diseases will not be permanent (they will be lost on respawn)",
      "setting.NonPermanentDiseases.value.False": "False",
      "setting.NonPermanentDiseases.value.True": "True",
      "setting.AllowAnyoneBabyImprintCuddle.name": "Allow Care By Anyone",
      "setting.AllowAnyoneBabyImprintCuddle.desc": "If set, enables anyone to \u0022take care\u0022 of baby creatures (cuddle etc), not just whomever imprinted on it",
      "setting.AllowAnyoneBabyImprintCuddle.value.False": "False",
      "setting.AllowAnyoneBabyImprintCuddle.value.True": "True",
      "setting.DisableImprintDinoBuff.name": "Disable Imprint Creature Buff",
      "setting.DisableImprintDinoBuff.desc": "If set, disables the creature imprinting player Stat Bonus (where whomever specifically imprinted on the creature, and raised it to have an imprinting quality, gets extra damage/resistance buff)",
      "setting.DisableImprintDinoBuff.value.False": "False",
      "setting.DisableImprintDinoBuff.value.True": "True",
      "setting.AllowRaidDinoFeeding.name": "Allow Raid Dinosaur Feeding",
      "setting.AllowRaidDinoFeeding.desc": "If set, allows Titanosaurs to be permanently tamed (ie they can be fed). Note: The Island only spawns a maximum of 3 Titanosaurs, so 3 tamed ones will ultimately block any more spawning",
      "setting.AllowRaidDinoFeeding.value.False": "False",
      "setting.AllowRaidDinoFeeding.value.True": "True",
      "setting.AllowMultipleAttachedC4.name": "Allow Multiple Attached C4",
      "setting.AllowMultipleAttachedC4.desc": "If enabled, more than one C4 can be attached per creature",
      "setting.AllowMultipleAttachedC4.value.False": "False",
      "setting.AllowMultipleAttachedC4.value.True": "True",
      "setting.DisableWeatherFog.name": "Disable Weather Fog",
      "setting.DisableWeatherFog.desc": "If set, fog is disabled",
      "setting.DisableWeatherFog.value.False": "False",
      "setting.DisableWeatherFog.value.True": "True",
      "setting.RandomSupplyCratePoints.name": "Enable Random Supply Crate Points",
      "setting.RandomSupplyCratePoints.desc": "If enabled, supply drops will be in random locations",
      "setting.RandomSupplyCratePoints.value.False": "False",
      "setting.RandomSupplyCratePoints.value.True": "True",
      "setting.DayCycleSpeedScale.name": "Day/Night Cycle Speed Multiplier",
      "setting.DayCycleSpeedScale.desc": "Sets the scaling factor for the server day/night cycle. The default value 1 sets the same speed as a singleplayer game, ie 1 minute real time = approx 28 minutes server time. A scale of 0.035 would set a day/night cycle of approx 24 hours real time",
      "category.multipliers": "Multipliers",
      "setting.DayTimeSpeedScale.name": "Day Time Speed Multiplier",
      "setting.DayTimeSpeedScale.desc": "Sets the scaling factor for the length of each server day, relative to the length of each night. Lowering this value increases the day length",
      "setting.NightTimeSpeedScale.name": "Night Time Speed Multiplier",
      "setting.NightTimeSpeedScale.desc": "Sets the scaling factor for the length of each server night, relative to the length of each day. Lowering this value increases the night length",
      "setting.XPMultiplier.name": "XP Multiplier",
      "setting.XPMultiplier.desc": "Sets the scaling factor for experience (XP) received by players, tribes and dinosaurs for various actions. The default value 1 provides the same experience as a singleplayer game. Higher values increase XP amounts awarded, lower values decrease it",
      "setting.PlayerCharacterFoodDrainMultiplier.name": "Player Food Drain Multiplier",
      "setting.PlayerCharacterFoodDrainMultiplier.desc": "Sets the scaling factor for player characters\u0027 food consumption. Higher values increase food consumption (player characters get hungry faster)",
      "setting.PlayerCharacterWaterDrainMultiplier.name": "Player Water Drain Multiplier",
      "setting.PlayerCharacterWaterDrainMultiplier.desc": "Sets the scaling factor for player characters\u0027 water consumption. Higher values increase water consumption (player characters get thirsty faster)",
      "setting.PlayerCharacterHealthRecoveryMultiplier.name": "Player Health Recovery Multiplier",
      "setting.PlayerCharacterHealthRecoveryMultiplier.desc": "Sets the scaling factor for player characters\u0027 health recovery. Higher values increase the recovery rate (player characters heal faster)",
      "setting.PlayerCharacterStaminaDrainMultiplier.name": "Player Stamina Drain Multiplier",
      "setting.PlayerCharacterStaminaDrainMultiplier.desc": "Sets the scaling factor for player characters\u0027 stamina consumption. Higher values increase stamina consumption (player characters get tired faster)",
      "setting.PlayerDamageMultiplier.name": "Player Damage Multiplier",
      "setting.PlayerDamageMultiplier.desc": "Sets the scaling factor for the damage that players cause with their attacks. The default value 1 causes normal damage. Higher values increase damage, lower values decrease it",
      "setting.PlayerResistanceMultiplier.name": "Player Resistance Multiplier",
      "setting.PlayerResistanceMultiplier.desc": "Sets the scaling factor for players\u0027 damage resistance when attacked. The default value 1 causes normal damage. Higher values decrease resistance, increasing damage per attack. Lower values increase it, reducing damage per attack",
      "setting.DinoCharacterFoodDrainMultiplier.name": "Creature Food Drain Multiplier",
      "setting.DinoCharacterFoodDrainMultiplier.desc": "Sets the scaling factor for creatures\u0027 food consumption. Higher values increase food consumption (creatures get hungry faster)",
      "setting.DinoCharacterHealthRecoveryMultiplier.name": "Creature Health Recovery Multiplier",
      "setting.DinoCharacterHealthRecoveryMultiplier.desc": "Sets the scaling factor for creatures\u0027 health recovery. Higher values increase the recovery rate (creatures heal faster)",
      "setting.DinoCharacterStaminaDrainMultiplier.name": "Creature Stamina Drain Multiplier",
      "setting.DinoCharacterStaminaDrainMultiplier.desc": "Sets the scaling factor for creatures\u0027 stamina consumption. Higher values increase stamina consumption (creatures get tired faster)",
      "setting.DinoDamageMultiplier.name": "Creature Damage Multiplier",
      "setting.DinoDamageMultiplier.desc": "Sets the scaling factor for the damage that wild creatures cause with their attacks. The default value 1 causes normal damage. Higher values increase damage, lower values decrease it",
      "setting.DinoResistanceMultiplier.name": "Creature Resistance Multiplier",
      "setting.DinoResistanceMultiplier.desc": "Sets the scaling factor for wild creatures\u0027 damage resistance when attacked. The default value 1 causes normal damage. Higher values decrease resistance, increasing damage per attack. Lower values increase it, reducing damage per attack",
      "setting.PvEDinoDecayPeriodMultiplier.name": "PvE Creature Decay Period Multiplier",
      "setting.PvEDinoDecayPeriodMultiplier.desc": "Set the scaling factor for the unclaiming speed of creatures in PvE mode. Requires Disable PvE Creature Decay to be off",
      "setting.StructurePreventResourceRadiusMultiplier.name": "Structure Prevent Resources Radius Multiplier",
      "setting.StructurePreventResourceRadiusMultiplier.desc": "Sets how resources regrow closer or farther away from structures. Values higher than 1.0 increase the distance around structures where resources are not allowed to grow back. Values between 0 and 1.0 reduce it",
      "setting.StructureResistanceMultiplier.name": "Structure Resistance Multiplier",
      "setting.StructureResistanceMultiplier.desc": "Sets the scaling factor for structures\u0027 damage resistance when attacked. The default value 1 causes normal damage. Higher values decrease resistance, increasing damage per attack. Lower values increase it, reducing damage per attack",
      "setting.PerPlatformMaxStructuresMultiplier.name": "Maximum Platform Structures Multiplier",
      "setting.PerPlatformMaxStructuresMultiplier.desc": "Sets the scaling factor for the maximum number of structures placeable on platform saddles and rafts. NOTE: high values may lead to lag",
      "setting.HarvestAmountMultiplier.name": "Harvest Amount Multiplier",
      "setting.HarvestAmountMultiplier.desc": "Sets the scaling factor for yields from all harvesting activities (chopping down trees, picking berries, carving carcasses, mining rocks, etc). Higher values increase the amount harvested with each strike",
      "setting.HarvestHealthMultiplier.name": "Harvest Health Multiplier",
      "setting.HarvestHealthMultiplier.desc": "Sets the scaling factor for the \u0022health\u0022 of harvestable items (trees, rocks, carcasses, etc). Higher values increase the number of strikes needed to destroy them, increasing harvest yields",
      "setting.ResourcesRespawnPeriodMultiplier.name": "Resources Respawn Period Multiplier",
      "setting.ResourcesRespawnPeriodMultiplier.desc": "Sets the scaling factor for the resource node respawn rate (trees, rocks, bushes, etc). Lower values cause nodes to respawn more frequently",
      "setting.TamingSpeedMultiplier.name": "Creature Taming Speed Multiplier",
      "setting.TamingSpeedMultiplier.desc": "Sets the scaling factor for creature taming speed. Higher values make taming faster",
      "setting.OxygenSwimSpeedStatMultiplier.name": "Oxygen Swim Speed Multiplier",
      "setting.OxygenSwimSpeedStatMultiplier.desc": "Sets the scaling factor for swim speed, relative to the level spent in oxygen",
      "setting.ItemStackSizeMultiplier.name": "Item Stack Size Multiplier",
      "setting.ItemStackSizeMultiplier.desc": "Sets the scaling factor for the global item stack size. All default stack sizes will be multiplied by this value (excluding items that have a stack size of 1 by default)",
      "setting.RaidDinoCharacterFoodDrainMultiplier.name": "Raid Dinosaur Food Drain Multiplier",
      "setting.RaidDinoCharacterFoodDrainMultiplier.desc": "Sets the scaling factor for how quickly the food drains on \u0022raid dinos\u0022 (eg Titanosaurus)",
      "setting.UseStructureStasisGrid.name": "Enable Structure Stasis Grid",
      "setting.UseStructureStasisGrid.desc": "If set, enables the structure stasis grid to improve server performance on large bases with lots of players. Structures are loaded based on grids with players. Not recommended for modded servers",
      "category.structures": "Structures",
      "setting.UseStructureStasisGrid.value.True": "-UseStructureStasisGrid ",
      "setting.DisableStructureDecayPvE.name": "Disable PvE Structure Decay",
      "setting.DisableStructureDecayPvE.desc": "If set, the gradual (7 days) decay of player structures will be disabled in PvE mode",
      "setting.DisableStructureDecayPvE.value.False": "False",
      "setting.DisableStructureDecayPvE.value.True": "True",
      "setting.OverrideStructurePlatformPrevention.name": "Override Structure Platform Prevention",
      "setting.OverrideStructurePlatformPrevention.desc": "If set, turret and spike structures will be buildable and functional on platform saddles",
      "setting.OverrideStructurePlatformPrevention.value.False": "False",
      "setting.OverrideStructurePlatformPrevention.value.True": "True",
      "setting.EnableExtraStructurePreventionVolumes.name": "Disable Building In Rich Resource Areas",
      "setting.EnableExtraStructurePreventionVolumes.desc": "If set, completely disables building in specific resource-rich areas, in particular setup on The Island around the major mountains",
      "setting.EnableExtraStructurePreventionVolumes.value.False": "False",
      "setting.EnableExtraStructurePreventionVolumes.value.True": "True",
      "setting.PvEAllowStructuresAtSupplyDrops.name": "Allow PvE Structures At Supply Drops",
      "setting.PvEAllowStructuresAtSupplyDrops.desc": "If set, building near supply drop points will be allowed in PvE mode",
      "setting.PvEAllowStructuresAtSupplyDrops.value.False": "False",
      "setting.PvEAllowStructuresAtSupplyDrops.value.True": "True",
      "setting.bDisableStructurePlacementCollision.name": "Disable Structure Placement Collision",
      "setting.bDisableStructurePlacementCollision.desc": "If set, allows for structures to clip into the terrain",
      "setting.bDisableStructurePlacementCollision.value.False": "False",
      "setting.bDisableStructurePlacementCollision.value.True": "True",
      "setting.AlwaysAllowStructurePickup.name": "Always Allow Structure Pickup",
      "setting.AlwaysAllowStructurePickup.desc": "If set, the timer on the quick pick-up system will be disabled",
      "setting.AlwaysAllowStructurePickup.value.False": "False",
      "setting.AlwaysAllowStructurePickup.value.True": "True",
      "setting.StructurePickupHoldDuration.name": "Structure Pickup Hold Duration",
      "setting.StructurePickupHoldDuration.desc": "Sets the quick pick-up hold duration. 0 = instant pick-up",
      "setting.StructurePickupTimeAfterPlacement.name": "Structure Pickup Time After Placement",
      "setting.StructurePickupTimeAfterPlacement.desc": "Sets the amount of time after placement that quick pick-up is available",
      "setting.EnableCluster.name": "Enable Cluster",
      "setting.EnableCluster.desc": "If set, the use of a server cluster will be enabled. Requires Cluster Directory Override and Cluster ID to be set",
      "category.clusters": "Clusters",
      "setting.EnableCluster.value.True": "-ClusterDirOverride=\u0022{{ClusterDirOverride}}\u0022 -clusterID={{clusterID}} ",
      "setting.ClusterDirOverride.name": "Cluster Directory Override",
      "setting.ClusterDirOverride.desc": "Sets the path to a shared cluster directory for a server cluster. The cluster directory must be accessible to all cluster servers. If the server is in Docker, the directory must be mounted in the container. Requires Enable Cluster to be set",
      "setting.clusterID.name": "Cluster ID",
      "setting.clusterID.desc": "Sets the cluster ID for a server cluster. The cluster ID must be the same on all servers in the cluster. Requires Enable Cluster to be set",
      "setting.NoTributeDownloads.name": "Prevent Character Download",
      "setting.NoTributeDownloads.desc": "If set, prevents the download of characters from a cluster to the server",
      "setting.NoTributeDownloads.value.False": "False",
      "setting.NoTributeDownloads.value.True": "True",
      "setting.PreventDownloadSurvivors.name": "Prevent Survivor Download",
      "setting.PreventDownloadSurvivors.desc": "If set, prevents the download of survivors from a cluster to the server",
      "setting.PreventDownloadSurvivors.value.False": "False",
      "setting.PreventDownloadSurvivors.value.True": "True",
      "setting.PreventDownloadItems.name": "Prevent Item Download",
      "setting.PreventDownloadItems.desc": "If set, prevents the download of items from a cluster to the server",
      "setting.PreventDownloadItems.value.False": "False",
      "setting.PreventDownloadItems.value.True": "True",
      "setting.PreventDownloadDinos.name": "Prevent Creature Download",
      "setting.PreventDownloadDinos.desc": "If set, prevents the download of tamed creatures from a cluster to the server",
      "setting.PreventDownloadDinos.value.False": "False",
      "setting.PreventDownloadDinos.value.True": "True",
      "setting.PreventUploadSurvivors.name": "Prevent Survivor Upload",
      "setting.PreventUploadSurvivors.desc": "If set, prevents the upload of survivors from the server to a cluster",
      "setting.PreventUploadSurvivors.value.False": "False",
      "setting.PreventUploadSurvivors.value.True": "True",
      "setting.PreventUploadItems.name": "Prevent Item Upload",
      "setting.PreventUploadItems.desc": "If set, prevents the upload of items from the server to a cluster",
      "setting.PreventUploadItems.value.False": "False",
      "setting.PreventUploadItems.value.True": "True",
      "setting.PreventUploadDinos.name": "Prevent Creature Upload",
      "setting.PreventUploadDinos.desc": "If set, prevents the upload of tamed creatures from the server to a cluster",
      "setting.PreventUploadDinos.value.False": "False",
      "setting.PreventUploadDinos.value.True": "True",
      "setting.usestore.name": "Use Unified Save Data",
      "setting.usestore.desc": "If set, a player\u0027s character profile file (.arkprofile) will not be saved separately from the map save (.ark), nor its backup. When necessary (such as a character just transferred or a new character has been created), a temporary character profile file is created and kept until next world-save. Tribe profiles are stored in a different format (.arktributetribe)",
      "setting.usestore.value.True": "{{converttostore}}-usestore {{BackupTransferPlayerDatas}}",
      "setting.converttostore.name": "Convert To Unified Save Data",
      "setting.converttostore.desc": "If set, non-stored data (default save behaviour of unofficial and legacy) will be converted to stored data (default save behaviour of official non-legacy) at next world-save. It will not delete older character profile saves. Requires Use Unified Save Data to be enabled",
      "setting.converttostore.value.True": "-converttostore ",
      "setting.BackupTransferPlayerDatas.name": "Backup Transfer Player Data",
      "setting.BackupTransferPlayerDatas.desc": "If set, the server will fully mimic official (non-legacy) servers on handling player characters data, adding permanent character profile backup files separately from the world-save. Requires Use Unified Save Data to be enabled",
      "setting.BackupTransferPlayerDatas.value.True": "-BackupTransferPlayerDatas ",
      "setting.SpecificReleaseVersion.name": "Proton GE Release Version (Linux)",
      "setting.SpecificReleaseVersion.desc": "Sets the Proton GE [release version](https://github.com/GloriousEggroll/proton-ge-custom/releases) to install. Empty = latest. Example: GE-Proton9-1",
      "category.updates": "Updates",
      "category.runtime-configuration": "Runtime Configuration",
      "setting.ServerExecutable.name": "Server Executable",
      "setting.ServerExecutable.desc": "Sets whether to run the vanilla server or the [ServerAPI launcher](https://github.com/ArkServerApi/AsaApi). NOTE: Update the server after selecting the ServerAPI launcher",
      "setting.ServerExecutable.value.ArkAscendedServer": "Vanilla server (default)",
      "setting.ServerExecutable.value.AsaApiLoader": "ServerAPI launcher",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.GamePort.name": "Game Port",
      "port.GamePort.desc": "Port for game traffic",
      "port.HTTPServerPort.name": "HTTP Server Port",
      "port.HTTPServerPort.desc": "Port for remote control API HTTP server",
      "port.RCONPort.name": "RCON Port",
      "port.RCONPort.desc": "Port for RCON traffic"
    }
  }
}