  "ConfigFileMappings": [
    {
      "ConfigFile": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini",
      "ConfigFormat": "{0}=\u0022{1}\u0022",
      "ConfigFormatRegex": "^(?\u003Ckey\u003E.\u002B?)\\s*=\\s*\u0022(?\u003Cvalue\u003E.*?)\u0022$",
      "ConfigType": "ini",
      "AutoMap": true
    },
