{
  "Id": "218120ac-08ee-466e-9f60-5ba605436e11",
  "TemplateSlug": "ark-sa",
  "Lifecycle": {
    "RootDir": "./ark-sa/",
    "BaseDirectory": "./ark-sa/2430930/",
    "ExecutableWin": "2430930\\ShooterGame\\Binaries\\Win64\\{{ServerExecutable}}.exe",
    "ExecutableLinux": ".proton/proton",
    "WorkingDir": "2430930/ShooterGame/Binaries/Win64",
    "LinuxCommandLineArgs": "runinprefix \u0022{{$FullBaseDir}}ShooterGame/Binaries/Win64/{{ServerExecutable}}.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} {{Map}}?listen?Port={{$GamePort}}?RCONEnabled=True?RCONServerGameLogBuffer=600?RCONPort={{$RCONPort}}?{{$FormattedArgs}}{{OverrideOfficialDifficulty}}{{CustomOptions}}?ServerAdminPassword={{$RemoteAdminPassword}} -WinLiveMaxPlayers={{$MaxUsers}} {{passivemods}}{{mods}}{{pconlymods}}{{Colors}}{{exclusivejoin}}{{BattlEye}}{{usestore}}-ServerPlatform={{ServerPlatform}} {{EnableIdlePlayerKick}}{{NoHangDetection}}{{NoTransferFromFiltering}}{{NoGameAnalytics}}{{AllowSpeedLeveling}}{{ForceAllowCaveFlyers}}{{nodinos}}{{ForceRespawnDinos}}{{DisableRailgunPVP}}{{UseStructureStasisGrid}}-culture={{culture}} {{EnableCluster}}{{ServerIP}}{{CustomFlags}} -servergamelog",
    "CommandLineParameterFormat": "{0}={1}",
    "CommandLineParameterDelimiter": "?",
    "ApplicationReadyMode": "RCONConnected",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}ShooterGame\\\\Binaries\\\\Win64\\\\{{ServerExecutable}}\\.exe.*Port={{$GamePort}}.*$",
    "ExitTimeout": 15,
    "ExitString": "DoExit",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONConnectDelaySeconds": 15,
    "RCONHeartbeatMinutes": 0.09,
    "RCONHeartbeatCommand": "GetGameLog",
    "MaxUsers": 70,
    "EnvironmentVariables": {
      "SteamAppId": "2399830",
      "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam",
      "HOME": "{{$FullBaseDir}}"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan, IceOfWraith",
    "URL": "https://survivetheark.com/",
    "DisplayImageSource": "steam:2399830",
    "EndpointURIFormat": "{0}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ExtraSetupStepsURI": "https://discourse.cubecoders.com/docs?topic=6738?utm_source=ampcreate\u0026utm_content=arksa",
    "ExtraContainerPackages": [
      "pciutils"
    ],
    "ConfigVersion": "16",
    "MinAMPVersion": "2.5.0.4"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "ThrowawayMessageRegex": "^(Keep Alive|\\[S_API FAIL\\] SteamAPI_Init\\(\\) failed; SteamAPI_IsSteamRunning\\(\\) failed\\.|Server received, But no response!! \\n |Setting breakpad minidump AppID = 2399830)$",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^[\\d\\.]\u002B_[\\d\\.]\u002B: (?\u003Cusername\u003E.\u002B?) \\[UniqueNetId:(?\u003Cuserid\u003E.\u002B?) Platform:.*\\] joined this ARK!(?:\\n \\n )?$",
    "UserLeaveRegex": "^[\\d\\.]\u002B_[\\d\\.]\u002B: (?\u003Cusername\u003E.\u002B?) \\[UniqueNetId:(?\u003Cuserid\u003E.\u002B?) Platform:.*\\] left this ARK!(?:\\n \\n )?$",
    "UserChatRegex": "^[\\d\\.]\u002B_[\\d\\.]\u002B:(\u00A0| )(?\u003Cusername\u003E.\u002B?)(\u00A0| )\\((?:.\u002B?)\\): (?\u003Cmessage\u003E.\u002B)(?:\\n \\n )?$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "RCONPort",
    "PrimaryApplicationPortRef": "GamePort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "2430930",
      "UpdateSourceArgs": "2399830",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "CopyFilePath",
      "UpdateStageName": "ServerAPI Config Backup",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{$FullBaseDir}}ShooterGame/Binaries/Win64/ArkApi/Plugins/Permissions/config.json.bak",
      "UpdateSourceArgs": "{{$FullBaseDir}}ShooterGame/Binaries/Win64/ArkApi/Plugins/Permissions/config.json",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable",
      "UpdateSourceConditionValue": "AsaApiLoader",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "GithubRelease",
      "UpdateStageName": "ServerAPI Launcher Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "ArkServerApi/AsaApi",
      "UpdateSourceTarget": "{{$FullBaseDir}}ShooterGame/Binaries/Win64/",
      "UnzipUpdateSource": true,
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable",
      "UpdateSourceConditionValue": "AsaApiLoader",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "CopyFilePath",
      "UpdateStageName": "ServerAPI Config Restore",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "{{$FullBaseDir}}ShooterGame/Binaries/Win64/ArkApi/Plugins/Permissions/config.json",
      "UpdateSourceArgs": "{{$FullBaseDir}}ShooterGame/Binaries/Win64/ArkApi/Plugins/Permissions/config.json.bak",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "ServerExecutable",
      "UpdateSourceConditionValue": "AsaApiLoader",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Config Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}ShooterGame/Saved/Config/WindowsServer"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Game.ini Config Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/ark-sagame.ini",
      "UpdateSourceArgs": "Game.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}ShooterGame/Saved/Config/WindowsServer/"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "GameUserSettings.ini Config Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/ark-sawin-gameusersettings.ini",
      "UpdateSourceArgs": "GameUserSettings.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}ShooterGame/Saved/Config/WindowsServer/"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Proton GE Download",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullRootDir}}\\\u0022; mkdir -p \\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 \\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullBaseDir}}.config/protonfixes\\\u0022; ProtonVersion=\\\u0022{{SpecificReleaseVersion}}\\\u0022 \u0026\u0026 if [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 \u0026\u0026 -f \\\u0022{{$FullRootDir}}.proton/version\\\u0022 ]]; then read _ InstalledVersion \u003C \\\u0022{{$FullRootDir}}.proton/version\\\u0022; else InstalledVersion=\\\u0022\\\u0022; fi; if [[ -z \\\u0022$ProtonVersion\\\u0022 ]]; then ProtonVersion=$(wget -qO- https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest | jq -r .tag_name); fi; if [[ ! \\\u0022$ProtonVersion\\\u0022 =~ ^GE-Proton[0-9]\u002B-[0-9]\u002B$ ]]; then echo \\\u0022Invalid Proton GE release version format specified\\\u0022 \u0026\u0026 exit 1; elif [[ \\\u0022$InstalledVersion\\\u0022 == \\\u0022$ProtonVersion\\\u0022* ]]; then echo \\\u0022Proton GE version $ProtonVersion already installed. Skipping\\\u0022 \u0026\u0026 exit 0; else [[ -f GE-Proton.tar.gz ]] \u0026\u0026 rm -f GE-Proton.tar.gz \u003E/dev/null 2\u003E\u00261; suffix=\\\u0022\\\u0022; ver=\\\u0022${ProtonVersion#GE-Proton}\\\u0022; major=\\\u0022${ver%%-*}\\\u0022; minor=\\\u0022${ver#*-}\\\u0022; if (( major \u003E 11 || (major == 11 \u0026\u0026 minor \u003E= 4) )); then suffix=\\\u0022-x86_64\\\u0022; fi; wget -qO GE-Proton.tar.gz https://github.com/GloriousEggroll/proton-ge-custom/releases/download/$ProtonVersion/${ProtonVersion}${suffix}.tar.gz || { echo \\\u0022Proton GE download failed from GitHub. Aborting\\\u0022; exit 1; }; rm -rf \\\u0022{{$FullRootDir}}.proton/compatdata/\\\u0022* \u003E/dev/null 2\u003E\u00261; tar -xzf GE-Proton.tar.gz -C \\\u0022{{$FullRootDir}}.proton\\\u0022 --strip-components=1 \u0026\u0026 rm -f GE-Proton.tar.gz \u003E/dev/null 2\u003E\u00261 \u0026\u0026 echo \\\u0022Proton GE version $ProtonVersion downloaded\\\u0022 \u0026\u0026 { STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 PROTON_LOG=1 \u003E/dev/null 2\u003E\u00261; exit 0; }; fi\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Prefix Sound",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullRootDir}}\\\u0022 \u0026\u0026 export PATH=\\\u0022{{$FullRootDir}}.proton/files/bin:$PATH\\\u0022; export WINEPREFIX=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx\\\u0022; export WINEARCH=win64; ./.proton/protonfixes/winetricks sound=disabled \u003E winescript_log.txt 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    }
  ],
