      "setting.map.value.c13m4_cutthroatcreek": "Cold Stream: Cut/Throat Creek",
      "setting.map.value._CustomMap_": "--Custom--",
      "setting.CustomMap.name": "Custom Initial Map",
      "setting.CustomMap.desc": "Sets a custom map to use for the Initial Map, if \u0022Custom\u0022 is selected",
      "setting.sv_gametypes.name": "Allowed Game Modes",
      "setting.sv_gametypes.desc": "Sets a comma-separated list of game modes allowed on the server. Choose from: coop, realism, survival, versus, scavenge, dash, holdout, shootzones",
      "setting.mp_gamemode.name": "Initial Game Mode",
      "setting.mp_gamemode.desc": "Sets the game mode to start the server with. Should be one of the Allowed Game Modes. Requires SourceMod",
      "setting.mp_gamemode.value.coop": "Co-op",
      "setting.mp_gamemode.value.realism": "Realism",
      "setting.mp_gamemode.value.versus": "Versus",
      "setting.mp_gamemode.value.survival": "Survival",
      "setting.mp_gamemode.value.scavenge": "Scavenge",
      "setting.mp_gamemode.value.dash": "Dash",
      "setting.mp_gamemode.value.holdout": "Holdout",
      "setting.mp_gamemode.value.shootzones": "Shootzones",
      "setting.sv_region.name": "Server Region",
      "setting.sv_region.desc": "Sets the server region shown in the server browser",
      "setting.sv_region.value.-1": "No region",
      "setting.sv_region.value.0": "East Coast US",
      "setting.sv_region.value.1": "West Coast US",
      "setting.sv_region.value.2": "South America",
      "setting.sv_region.value.3": "Europe",
      "setting.sv_region.value.4": "Asia",
      "setting.sv_region.value.5": "Australia",
      "setting.sv_region.value.6": "Middle East",
      "setting.sv_region.value.7": "Africa",
      "setting.sv_region.value.255": "World",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server at one time. For more than 4 users, a suitable SourceMod plugin is required",
      "setting.UserIDRegex.name": "Bot Player Count Mode",
      "setting.UserIDRegex.desc": "Sets whether to count bots as players for the player count in AMP. This AMP instance must be restarted for changes to this setting to take effect",
      "setting.UserIDRegex.value._BOT_userid_BOT_": "Count bots as players (default)",
      "setting.UserIDRegex.value._userid_BOT_": "Don\u0027t count bots as players",
      "setting.sv_visiblemaxplayers.name": "Visible Player Limit",
      "setting.sv_visiblemaxplayers.desc": "Sets the maximum players reported to prospective clients, regardless of the Player Limit. -1 = do not override",
      "setting.mp_allowspectators.name": "Allow Spectators",
      "setting.mp_allowspectators.desc": "If set, spectator mode will be enabled. Requires SourceMod",
      "setting.sv_allow_lobby_connect_only.name": "Allow Lobby Connect Only",
      "setting.sv_allow_lobby_connect_only.desc": "Allow only connections to the server from the matchmaking lobby, and no direct connections",
      "setting.sv_pure.name": "Pure Server Mode",
      "setting.sv_pure.desc": "Sets whether clients are only allowed to use certain files",
      "setting.sv_pure.value.0": "Client files not restricted",
      "setting.sv_pure.value.1": "All client files except those listed in pure_server_whitelist.txt must match the server",
      "setting.sv_pure.value.2": "All client files must come from Steam",
      "setting.sv_pure_kick_clients.name": "Kick Clients On Pure Server",
      "setting.sv_pure_kick_clients.desc": "If enabled, the server will kick clients with mismatching files. Otherwise, it will issue a warning to the clients",
      "setting.sv_consistency.name": "Require File Consistency",
      "setting.sv_consistency.desc": "If set, the server will enforce file consistency for critical files",
      "setting.sv_cheats.name": "Enable Cheats",
      "setting.sv_cheats.desc": "If set, cheat convars will be allowed to be used on the server",
      "setting.insecure.name": "Disable Valve Anti-Cheat",
      "setting.insecure.desc": "If set, Valve Anti-Cheat (VAC) will be disabled",
      "setting.sv_filterban.name": "Enable IP Packet Filter",
      "setting.sv_filterban.desc": "If set, enables packet filtering by IP mode. If disabled, everyone will treated as IP-banned, but their IP won\u0027t be added to the banlist. Requires SourceMod",
      "setting.sv_allowdownload.name": "Allow Download From Server",
      "setting.sv_allowdownload.desc": "If set, clients will be allowed to download content from the server (maps, sprays and related). Requires SourceMod",
      "setting.sv_downloadurl.name": "Fast Download URL",
      "setting.sv_downloadurl.desc": "Sets the URL for clients to download custom content from, instead of sourcing the content from the server. This allows for faster downloads",
      "setting.sv_allowupload.name": "Allow Upload To Server",
      "setting.sv_allowupload.desc": "If set, clients will be allowed to upload customisation files to the server. Requires SourceMod",
      "setting.net_maxfilesize.name": "Maximum File Size",
      "setting.net_maxfilesize.desc": "Sets the maximum allowed file size for uploading to the server. Requires SourceMod",
      "setting.sv_minrate.name": "Minimum Client Rate",
      "setting.sv_minrate.desc": "Sets the minimum allowable bandwidth rate a client may have set when connected to the server. 0 = no minimum",
      "setting.sv_maxrate.name": "Maximum Client Rate",
      "setting.sv_maxrate.desc": "Sets the maximum allowable bandwidth rate a client may have set when connected to the server. 0 = no limit",
      "setting.sv_minupdaterate.name": "Minimum Server Update Rate",
      "setting.sv_minupdaterate.desc": "Sets the minimum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients. Requires SourceMod",
      "setting.sv_maxupdaterate.name": "Maximum Server Update Rate",
      "setting.sv_maxupdaterate.desc": "Sets the maximum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients. Requires SourceMod",
      "setting.decalfrequency.name": "Decal Frequency",
      "setting.decalfrequency.desc": "Sets the time between decal sprays. Requires SourceMod",
      "setting.sv_forcepreload.name": "Force Preload",
      "setting.sv_forcepreload.desc": "If set, server side preloading will be forced",
      "setting.pingboost.name": "Ping Boost",
      "setting.pingboost.desc": "Selects between optimised network code stack. Setting at 2 usually reduces latency toward 1ms without loss of activity input packets",
      "setting.pingboost.value._": "None",
      "setting.pingboost.value.-pingboost_1_": "1",
      "setting.pingboost.value.-pingboost_2_": "2",
      "setting.pingboost.value.-pingboost_3_": "3",
      "setting.sv_stats.name": "Enable CPU Stats Collection",
      "setting.sv_stats.desc": "If set, CPU stats will be collected. Requires SourceMod",
      "setting.ip.name": "Server/RCON IPv4 IP Binding",
      "setting.ip.desc": "If required, you can change the IPv4 IP binding of the server and RCON by changing the Application IP Binding for this instance. NOTE: AMP requires the server to be bound to a specific IP, rather than 0.0.0.0, for the server to log to AMP\u0027s console. The IP must also be reachable by AMP",
      "setting.CustomParameters.name": "Additional Command Line Parameters",
      "setting.CustomParameters.desc": "Specifies additional command line parameters (anything that begins with a -) that are not otherwise set by AMP. Use with care",
      "setting.CustomConVars.name": "Additional Console Variables",
      "setting.CustomConVars.desc": "Specifies additional [console variables](https://developer.valvesoftware.com/wiki/List_of_Left_4_Dead_2_console_commands_and_variables) (anything that begins with a \u002B) that are not otherwise set by AMP. Use with care. Preferably, specify the equivalent under \u0022Additional Server Settings\u0022",
      "setting.UserSettings.name": "Additional Server Settings",
      "setting.UserSettings.desc": "Specifies additional [settings](https://developer.valvesoftware.com/wiki/List_of_L4D2_Cvars) to include in \u0027server.cfg\u0027 that are not otherwise set by AMP. Example: sv_maxcmdrate 66. One setting per line",
      "setting.z_difficulty.name": "Difficulty Level",
      "setting.z_difficulty.desc": "Sets the game difficulty level",
      "category.gameplay": "Gameplay",
      "setting.z_difficulty.value.Easy": "Easy",
      "setting.z_difficulty.value.Normal": "Normal",
      "setting.z_difficulty.value.Hard": "Advanced (Hard)",
      "setting.z_difficulty.value.Impossible": "Expert (Impossible)",
      "setting.mp_friendlyfire.name": "Enable Friendly Fire",
      "setting.mp_friendlyfire.desc": "If set, friendly fire will be enabled (teammates can cause damage to other teammates). Requires SourceMod",
      "setting.survivor_friendly_fire_factor_easy.name": "Friendly Fire Damage Factor (Easy)",
      "setting.survivor_friendly_fire_factor_easy.desc": "Sets the friendly fire damage factor for survivors on Easy difficulty. 0 = disabled. Requires SourceMod",
      "setting.survivor_friendly_fire_factor_normal.name": "Friendly Fire Damage Factor (Normal)",
      "setting.survivor_friendly_fire_factor_normal.desc": "Sets the friendly fire damage factor for survivors on Normal difficulty. 0 = disabled. Requires SourceMod",
      "setting.survivor_friendly_fire_factor_hard.name": "Friendly Fire Damage Factor (Advanced)",
      "setting.survivor_friendly_fire_factor_hard.desc": "Sets the friendly fire damage factor for survivors on Advanced difficulty. 0 = disabled. Requires SourceMod",
      "setting.survivor_friendly_fire_factor_expert.name": "Friendly Fire Damage Factor (Expert)",
      "setting.survivor_friendly_fire_factor_expert.desc": "Sets the friendly fire damage factor for survivors on Expert difficulty. 0 = disabled. Requires SourceMod",
      "setting.mp_flashlight.name": "Enable Flashlight",
      "setting.mp_flashlight.desc": "If sets, allows the use of the flashlight by pressing the F button. Requires SourceMod",
      "setting.mp_footsteps.name": "Enable Footsteps",
      "setting.mp_footsteps.desc": "If set, footstep sounds will be enabled. Requires SourceMod",
      "setting.mp_autocrosshair.name": "Enable Auto Crosshair",
      "setting.mp_autocrosshair.desc": "If set, the auto crosshair will be enabled. Requires SourceMod",
      "setting.sv_pausable.name": "Allow Players To Pause Server",
      "setting.sv_pausable.desc": "If set, players will be able to pause the server. Not recommended",
      "setting.sv_allow_wait_command.name": "Allow Wait Command",
      "setting.sv_allow_wait_command.desc": "If enabled, the wait command will be allowed on clients connected to the server. Recommended to keep disabled to prevent server crash exploits",
      "setting.sv_voiceenable.name": "Enable Voice Communication",
      "setting.sv_voiceenable.desc": "If set, voice communication will be enabled on the server",
      "setting.sv_alltalk.name": "Allow All Talk",
      "setting.sv_alltalk.desc": "If enabled, players can communicate with all other players, with no team restrictions",
      "setting.mp_fadetoblack.name": "Enable Fade To Black",
      "setting.mp_fadetoblack.desc": "If enabled, a player\u0027s screen fades to black for the remainder of the round after death (HUD and chat still works). Requires SourceMod",
      "setting.mp_autoteambalance.name": "Automatic Team Balancing",
      "setting.mp_autoteambalance.desc": "Sets whether to automatically balance teams based on the Teams Unbalance Limit. Requires SourceMod",
      "setting.mp_autoteambalance.value.0": "Off",
      "setting.mp_autoteambalance.value.1": "Forcibly switch (default)",
      "setting.mp_autoteambalance.value.2": "Ask for volunteers",
      "setting.mp_teams_unbalance_limit.name": "Teams Unbalance Limit",
      "setting.mp_teams_unbalance_limit.desc": "Teams will be considered unbalanced for the purpose of Automatic Team Balancing when one team has this many more players than the other team. 0 = check disabled. Requires SourceMod",
      "setting.mp_stalemate_enable.name": "Enable Stalemate Mode",
      "setting.mp_stalemate_enable.desc": "If set, the stalemate mode will be enabled. Requires SourceMod",
      "setting.mp_stalemate_timelimit.name": "Stalemate Mode Time Limit",
      "setting.mp_stalemate_timelimit.desc": "Sets the time limit of the stalemate round. Requires SourceMod",
      "setting.mp_timelimit.name": "Map Rotation Time Limit",
      "setting.mp_timelimit.desc": "Sets the game time per map. 0 = disabled. Requires SourceMod",
      "setting.mp_maxrounds.name": "Map Rotation Round Limit",
      "setting.mp_maxrounds.desc": "Sets the maximum number of rounds to play before the map rotates. 0 = disabled. Requires SourceMod",
      "setting.mp_winlimit.name": "Map Rotation Win Limit",
      "setting.mp_winlimit.desc": "Sets the maximum score one team can reach before the map rotates. 0 = disabled. Requires SourceMod",
      "setting.mp_roundlimit.name": "Versus Round Limit",
      "setting.mp_roundlimit.desc": "Sets the number of rounds to play for the versus game mode",
      "setting.mp_forcecamera.name": "Restrict Spectator Mode",
      "setting.mp_forcecamera.desc": "If enabled, the spectator mode for dead players will be restricted. Requires SourceMod",
      "setting.sv_disable_glow_survivors.name": "Disable Survivor Glow",
      "setting.sv_disable_glow_survivors.desc": "Disable glow effect on survivors. Requires SourceMod",
      "setting.sv_disable_glow_faritems.name": "Disable Glow on Far Items",
      "setting.sv_disable_glow_faritems.desc": "Disable glow effect on far items. Requires SourceMod",
      "setting.sv_rescue_disabled.name": "Disable Rescue",
      "setting.sv_rescue_disabled.desc": "Disable rescue. Requires SourceMod",
      "setting.pipe_bomb_timer_duration.name": "Pipe Bomb Timer Duration",
      "setting.pipe_bomb_timer_duration.desc": "Duration of pipe bomb timer",
      "setting.sv_alternateticks.name": "Alternate Ticks",
      "setting.sv_alternateticks.desc": "If set, the server only simulates entities on even numbered ticks",
      "setting.nohltv.name": "Disable SourceTV",
      "setting.nohltv.desc": "If set, SourceTV will be disabled on the server",
      "category.sourcetv": "SourceTV",
      "setting.tv_autorecord.name": "Enable Automatic Demo Recording",
      "setting.tv_autorecord.desc": "If set, all games will be recorded as SourceTV demos. Requires SourceMod",
      "setting.tv_maxclients.name": "SourceTV Viewer Limit",
      "setting.tv_maxclients.desc": "Sets the maximum number of clients allowed to connect to the server\u0027s SourceTV. 0 = no SourceTV viewers are allowed, the game will only be recorded locally. Requires SourceMod",
      "setting.tv_maxrate.name": "Maximum SourceTV Bandwidth",
      "setting.tv_maxrate.desc": "Sets the maximum SourceTV spectator bandwidth rate allowed. 0 = unlimited. Requires SourceMod",
      "setting.InstallMod.name": "Metamod and SourceMod Management",
      "setting.InstallMod.desc": "Sets how to manage Metamod and SourceMod on the server. Branch and Build Versions must be set accordingly for installation. Update the server after changing this setting (unless \u0022Do nothing\u0022 is selected)",
      "category.updates": "Updates",
      "category.metamod-and-sourcemod": "Metamod and SourceMod",
      "setting.InstallMod.value.none": "Do nothing (default)",
      "setting.InstallMod.value.false": "Deactivate mods",
      "setting.InstallMod.value.true": "Install and activate mods",
      "setting.MetamodBranch.name": "Metamod Branch",
      "setting.MetamodBranch.desc": "Specifies the [Metamod](https://www.metamodsource.net/downloads.php) branch to install",
      "setting.MetamodBranch.value.1_11": "Old stable (1.11)",
      "setting.MetamodBranch.value.1_12": "Stable (1.12) (default)",
      "setting.MetamodBranch.value.2_0": "Development (2.0)",
      "setting.MetamodBuild.name": "Metamod Build Version",
      "setting.MetamodBuild.desc": "Specifies the [Metamod build version](https://www.metamodsource.net/downloads.php) to install. Empty = latest build for the branch specified under Metamod Branch",
      "setting.SourceModBranch.name": "SourceMod Branch",
      "setting.SourceModBranch.desc": "Specifies the [SourceMod](https://www.sourcemod.net/downloads.php) branch to install",
      "setting.SourceModBranch.value.1_11": "Old stable (1.11)",
      "setting.SourceModBranch.value.1_12": "Stable (1.12) (default)",
      "setting.SourceModBranch.value.1_13": "Development (1.13)",
      "setting.SourcemodBuild.name": "SourceMod Build Version",
      "setting.SourcemodBuild.desc": "Specifies the [SourceMod build version](https://www.sourcemod.net/downloads.php) to install. Empty = latest build for the branch specified under SourceMod Branch",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.ServerPort.name": "Game and RCON Port",
      "port.ServerPort.desc": "Port for game and RCON traffic",
      "port.SourceTVPort.name": "SourceTV Port",
      "port.SourceTVPort.desc": "Port for SourceTV traffic"
    }
  }
}
