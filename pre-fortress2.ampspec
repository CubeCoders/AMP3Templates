      "setting.sv_region.value.-1": "No region",
      "setting.sv_region.value.0": "East Coast US",
      "setting.sv_region.value.1": "West Coast US",
      "setting.sv_region.value.2": "South America",
      "setting.sv_region.value.3": "Europe",
      "setting.sv_region.value.4": "Asia",
      "setting.sv_region.value.5": "Australia",
      "setting.sv_region.value.6": "Middle East",
      "setting.sv_region.value.7": "Africa",
      "setting.sv_region.value.255": "World",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server at one time",
      "setting.mp_allowspectators.name": "Allow Spectators",
      "setting.mp_allowspectators.desc": "If set, spectator mode will be enabled",
      "setting.mp_allowspectators.value.False": "0",
      "setting.mp_allowspectators.value.True": "1",
      "setting.sv_pure.name": "Pure Server Mode",
      "setting.sv_pure.desc": "Sets whether clients are only allowed to use certain files",
      "setting.sv_pure.value.-1": "Do not restrict client files",
      "setting.sv_pure.value.0": "Apply rules in \u0027pure_server_minimal.txt\u0027 only",
      "setting.sv_pure.value.1": "Apply rules in \u0027pure_server_full.txt\u0027 and then \u0027pure_server_whitelist.txt\u0027",
      "setting.sv_pure.value.2": "Apply rules in \u0027pure_server_full.txt\u0027",
      "setting.sv_pure_kick_clients.name": "Kick Clients On Pure Server",
      "setting.sv_pure_kick_clients.desc": "If enabled, the server will kick clients with mismatching files. Otherwise, it will issue a warning to the clients",
      "setting.sv_pure_kick_clients.value.False": "0",
      "setting.sv_pure_kick_clients.value.True": "1",
      "setting.sv_cheats.name": "Enable Cheats",
      "setting.sv_cheats.desc": "If set, cheat convars will be allowed to be used on the server",
      "setting.sv_cheats.value.False": "0",
      "setting.sv_cheats.value.True": "1",
      "setting.sv_filterban.name": "Enable IP Packet Filter",
      "setting.sv_filterban.desc": "If set, enables packet filtering by IP mode. If disabled, everyone will treated as IP-banned, but their IP won\u0027t be added to the banlist",
      "setting.sv_filterban.value.False": "0",
      "setting.sv_filterban.value.True": "1",
      "setting.sv_allowdownload.name": "Allow Download From Server",
      "setting.sv_allowdownload.desc": "If set, clients will be allowed to download content from the server (maps, sprays and related)",
      "setting.sv_allowdownload.value.False": "0",
      "setting.sv_allowdownload.value.True": "1",
      "setting.sv_downloadurl.name": "Fast Download URL",
      "setting.sv_downloadurl.desc": "Sets the URL for clients to download custom content from, instead of sourcing the content from the server. This allows for faster downloads",
      "setting.sv_allowupload.name": "Allow Upload To Server",
      "setting.sv_allowupload.desc": "If set, clients will be allowed to upload customisation files to the server",
      "setting.sv_allowupload.value.False": "0",
      "setting.sv_allowupload.value.True": "1",
      "setting.net_maxfilesize.name": "Maximum Upload File Size",
      "setting.net_maxfilesize.desc": "Sets the maximum allowed file size for uploading to the server",
      "setting.sv_minrate.name": "Minimum Client Rate",
      "setting.sv_minrate.desc": "Sets the minimum allowable bandwidth rate a client may have set when connected to the server. 0 = no minimum",
      "setting.sv_maxrate.name": "Maximum Client Rate",
      "setting.sv_maxrate.desc": "Sets the maximum allowable bandwidth rate a client may have set when connected to the server. 0 = no limit",
      "setting.sv_minupdaterate.name": "Minimum Server Update Rate",
      "setting.sv_minupdaterate.desc": "Sets the minimum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.sv_maxupdaterate.name": "Maximum Server Update Rate",
      "setting.sv_maxupdaterate.desc": "Sets the maximum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.decalfrequency.name": "Decal Frequency",
      "setting.insecure.name": "Disable Valve Anti-Cheat",
      "setting.insecure.desc": "If set, Valve Anti-Cheat (VAC) will be disabled",
      "setting.insecure.value.True": "-insecure ",
      "setting.ip.name": "Server/RCON IPv4 IP Binding",
      "setting.ip.desc": "If required, you can change the IPv4 IP binding of the server and RCON by changing the Application IP Binding for this instance. NOTE: AMP requires the server to be bound to a specific IP, rather than 0.0.0.0, for the server to log to AMP\u0027s console. The IP must also be reachable by AMP",
      "setting.CustomParameters.name": "Additional Command Line Parameters",
      "setting.CustomParameters.desc": "Specifies additional command line parameters (anything that begins with a -) that are not otherwise set by AMP. Use with care (maximum 512 characters for command line)",
      "setting.CustomConVars.name": "Additional Console Variables",
      "setting.CustomConVars.desc": "Specifies additional console variables (anything that begins with a \u002B) that are not otherwise set by AMP. Use with care (maximum 512 characters for command line). Preferably, specify the equivalent under \u0022Additional Server Settings\u0022",
      "setting.UserSettings.name": "Additional Server Settings",
      "setting.UserSettings.desc": "Specifies additional settings to include in \u0022server.cfg\u0022 that are not otherwise set by AMP. Example: sv_maxcmdrate 66. One setting per line",
      "setting.mp_friendlyfire.name": "Enable Friendly Fire",
      "setting.mp_friendlyfire.desc": "If set, friendly fire will be enabled (teammates can cause damage to other teammates)",
      "category.gameplay": "Gameplay",
      "setting.mp_friendlyfire.value.False": "0",
      "setting.mp_friendlyfire.value.True": "1",
      "setting.mp_flashlight.name": "Enable Flashlight",
      "setting.mp_flashlight.desc": "If sets, allows the use of the flashlight by pressing the F button",
      "setting.mp_flashlight.value.False": "0",
      "setting.mp_flashlight.value.True": "1",
      "setting.mp_footsteps.name": "Enable Footsteps",
      "setting.mp_footsteps.desc": "If set, footstep sounds will be enabled",
      "setting.mp_footsteps.value.False": "0",
      "setting.mp_footsteps.value.True": "1",
      "setting.mp_autocrosshair.name": "Enable Auto Crosshair",
      "setting.mp_autocrosshair.desc": "If set, the auto crosshair will be enabled",
      "setting.mp_autocrosshair.value.False": "0",
      "setting.mp_autocrosshair.value.True": "1",
      "setting.sv_pausable.name": "Allow Players To Pause Server",
      "setting.sv_pausable.desc": "If set, players will be able to pause the server. Not recommended",
      "setting.sv_pausable.value.False": "0",
      "setting.sv_pausable.value.True": "1",
      "setting.sv_allow_wait_command.name": "Allow Wait Command",
      "setting.sv_allow_wait_command.desc": "If enabled, the wait command will be allowed on clients connected to the server. Recommended to keep disabled to prevent server crash exploits",
      "setting.sv_allow_wait_command.value.False": "0",
      "setting.sv_allow_wait_command.value.True": "1",
      "setting.sv_alltalk.name": "Allow All Talk",
      "setting.sv_alltalk.desc": "If enabled, players can communicate with all other players, with no team restrictions",
      "setting.sv_alltalk.value.False": "0",
      "setting.sv_alltalk.value.True": "1",
      "setting.mp_fadetoblack.name": "Enable Fade To Black",
      "setting.mp_fadetoblack.desc": "If enabled, a player\u0027s screen fades to black for the remainder of the round after death (HUD and chat still works)",
      "setting.mp_fadetoblack.value.False": "0",
      "setting.mp_fadetoblack.value.True": "1",
      "setting.mp_autoteambalance.name": "Automatic Team Balancing",
      "setting.mp_autoteambalance.desc": "Sets whether to automatically balance teams based on the Teams Unbalance Limit",
      "setting.mp_autoteambalance.value.0": "Off",
      "setting.mp_autoteambalance.value.1": "Forcibly switch (default)",
      "setting.mp_autoteambalance.value.2": "Ask for volunteers",
      "setting.mp_teams_unbalance_limit.name": "Teams Unbalance Limit",
      "setting.mp_teams_unbalance_limit.desc": "Teams will be considered unbalanced for the purpose of Automatic Team Balancing when one team has this many more players than the other team. 0 = check disabled",
      "setting.mp_stalemate_enable.name": "Enable Stalemate Mode",
      "setting.mp_stalemate_enable.desc": "If set, the stalemate mode will be enabled",
      "setting.mp_stalemate_enable.value.False": "0",
      "setting.mp_stalemate_enable.value.True": "1",
      "setting.mp_stalemate_timelimit.name": "Stalemate Mode Time Limit",
      "setting.mp_stalemate_timelimit.desc": "Sets the time limit of the stalemate round",
      "setting.mp_winlimit.name": "Map Rotation Win Limit",
      "setting.mp_winlimit.desc": "Sets the maximum score one team can reach before the map rotates. 0 = disabled",
      "setting.tf_damage_disablespread.name": "Disable Damage Spread",
