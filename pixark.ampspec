{
  "Id": "79bb4c35-7e34-4ce7-b685-ccded8c4f1d7",
  "TemplateSlug": "pixark",
  "Lifecycle": {
    "RootDir": "./pixark/",
    "BaseDirectory": "./pixark/824360/",
    "ExecutableWin": "824360\\ShooterGame\\Binaries\\Win64\\PixARKServer.exe",
    "ExecutableLinux": "/bin/bash",
    "WorkingDir": "824360/ShooterGame/Binaries/Win64",
    "LinuxCommandLineArgs": "-c \u0022if [[ -x /usr/bin/wine ]]; then exec /usr/bin/wine \\\u0022{{$FullBaseDir}}ShooterGame/Binaries/Win64/PixARKServer.exe\\\u0022 \\\u0022$@\\\u0022; elif [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 ]]; then unset WINEPREFIX WINEARCH WINEDEBUG; export STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 HOME=\\\u0022{{$FullBaseDir}}\\\u0022; exec \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 runinprefix \\\u0022{{$FullBaseDir}}ShooterGame/Binaries/Win64/PixARKServer.exe\\\u0022 \\\u0022$@\\\u0022; else echo \\\u0022ERROR: Wine was not found at /usr/bin/wine, and this instance has no Proton GE runtime to fall back to.\\\u0022; exit 1; fi\u0022 amp-launch",
    "CommandLineArgs": "{{$PlatformArgs}} {{Map}}?listen?DelayRegisterServer=True?bRawSockets=True?Port={{$GamePort}}?QueryPort={{$QueryPort}}?RCONEnabled=True?RCONPort={{$RCONPort}}?SessionName=\u0022{{SessionName}}\u0022?MultiHome={{$ApplicationIPBinding}}?{{$FormattedArgs}}?ServerAdminPassword={{$RemoteAdminPassword}}{{CustomOptions}} -Seed={{Seed}} -CULTUREFORCOOKING=en -NoBattlEye -CubePort={{$CubePort}} -cubeworld={{cubeworld}} -nosteamclient -NoHangDetection {{NoTransferFromFiltering}}-ClusterDirOverride=\u0022{{ClusterDirOverride}}\u0022 -clusterid={{clusterid}} -server {{CustomFlags}} -gameplaylogging -log",
    "CommandLineParameterFormat": "{0}={1}",
    "CommandLineParameterDelimiter": "?",
    "ApplicationReadyMode": "RCONConnected",
    "MonitorChildProcessName": "^.*PixARKServer\\.exe.*Port={{$GamePort}}.*$",
    "ExitTimeout": 15,
    "ExitString": "DoExit",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONConnectDelaySeconds": 15,
    "RCONHeartbeatMinutes": 0.09,
    "RCONHeartbeatCommand": "GetGameLog",
    "MaxUsers": 20,
    "EnvironmentVariables": {
      "SteamAppId": "593600",
      "WINEPREFIX": "{{$FullRootDir}}.wine",
      "WINEARCH": "win64",
      "WINEDEBUG": "-all"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan",
    "URL": "https://snail.com/portfolio/pixark",
    "DisplayImageSource": "steam:593600",
    "EndpointURIFormat": "steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}",
    "SpecificDockerImage": "cubecoders/ampbase:wine-stable",
    "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux",
    "ContainerPolicyReason": "The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.",
    "ConfigVersion": "4",
    "BreakingReleaseNotes": "Linux now uses Wine instead of Proton GE. Container shards switch automatically unless they have an image override. Native shards: install Wine. Until then the old Proton GE install keeps working but is no longer updated. Proton saves are copied into the Wine prefix; .proton/compatdata is kept.",
    "MinAMPVersion": "2.5.1.4"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|Keep Alive|Server received, But no response!! \\n |LogOnline:Warning: STEAM: Server setting .* overflows Steam SetGameTags call|LogOnline:Warning: STEAM: Empty session setting .* :OnlineService of type String|CubeWorldServer:Warning: compose_generator.cpp \\d\u002B cubesvr::CComposeGenerator::ComposeColumn  biome not exists\\. \\d\u002B|LogShooter:Warning: Receive Command : GetGameLog|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^[\\d\\.]\u002B_[\\d\\.]\u002B: (?\u003Cusername\u003E.\u002B?) joined this ARK!\\n \\n $",
    "UserLeaveRegex": "^[\\d\\.]\u002B_[\\d\\.]\u002B: (?\u003Cusername\u003E.\u002B?) left this ARK!\\n \\n $",
    "UserChatRegex": "^[\\d\\.]\u002B_[\\d\\.]\u002B:(\u00A0| )(?\u003Cusername\u003E.\u002B?)(\u00A0| )\\((?:.\u002B?)\\): (?\u003Cmessage\u003E.\u002B)\\n \\n $",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "RCONPort",
    "PrimaryApplicationPortRef": "GamePort",
    "UniversalSleepApplicationUDPPortRef": "GamePort",
    "UniversalSleepSteamQueryPortRef": "QueryPort"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "824360",
      "UpdateSourceArgs": "593600",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Initialise Wine",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022if [[ -x /usr/bin/wine ]]; then WINEPREFIX=\\\u0022{{$FullRootDir}}.wine\\\u0022 WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init --update || exit 1; old=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx/drive_c/users/steamuser\\\u0022; new=\\\u0022{{$FullRootDir}}.wine/drive_c/users/$(id -un)\\\u0022; if [[ -d \\\u0022$old\\\u0022 \u0026\u0026 -d \\\u0022$new\\\u0022 \u0026\u0026 ! -e \\\u0022{{$FullRootDir}}.wine/.proton-profile-copied\\\u0022 ]]; then cp -an \\\u0022$old/.\\\u0022 \\\u0022$new/\\\u0022 \u0026\u0026 touch \\\u0022{{$FullRootDir}}.wine/.proton-profile-copied\\\u0022 \u0026\u0026 echo \\\u0022Copied the Proton GE user profile into the Wine prefix\\\u0022; fi; for f in \\\u0022{{$FullRootDir}}.proton\\\u0022/*; do [[ \\\u0022$f\\\u0022 == */compatdata ]] || rm -rf \\\u0022$f\\\u0022; done; elif [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 ]]; then echo \\\u0022WARNING: Wine was not found at /usr/bin/wine, so this instance keeps running on its current Proton GE version, which is no longer updated. To switch to Wine, remove this shard\u0027s container image override or set it to cubecoders/ampbase:wine-stable, or install Wine (latest stable from winehq.org) on the host of a native shard.\\\u0022; else echo \\\u0022ERROR: Wine was not found at /usr/bin/wine. To switch to Wine, remove this shard\u0027s container image override or set it to cubecoders/ampbase:wine-stable, or install Wine (latest stable from winehq.org) on the host of a native shard.\\\u0022; exit 1; fi\u0022"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.GamePort.name",
      "Description": "port.GamePort.desc",
      "Ref": "GamePort",
      "Port": 7777,
      "Protocol": "UDP"
    },
    {
      "Name": "port.QueryPort.name",
      "Description": "port.QueryPort.desc",
      "Ref": "QueryPort",
      "Port": 27015,
      "Protocol": "UDP"
    },
    {
      "Name": "port.RCONPort.name",
      "Description": "port.RCONPort.desc",
      "Ref": "RCONPort",
      "Port": 27020
    },
    {
      "Name": "port.CubePort.name",
      "Ref": "CubePort",
      "Port": 14999
    }
  ],
  "Settings": [
    {
      "FieldName": "Map",
      "ParamFieldName": "Map",
      "DefaultValue": "CubeWorld_Light",
      "Category": "category.pixark:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.Map.name",
      "Description": "setting.Map.desc",
      "Keywords": "map,cubeworld,skyward,terracrypt,underground",
      "InputType": "enum",
      "EnumValues": {
        "CubeWorld_Light": "setting.Map.value.CubeWorld_Light",
        "Skypiea_light": "setting.Map.value.Skypiea_light",
        "Underground_Light": "setting.Map.value.Underground_Light",
        "{{CustomMap}}": "setting.Map.value._CustomMap_"
      }
    },
    {
      "FieldName": "CustomMap",
      "ParamFieldName": "CustomMap",
