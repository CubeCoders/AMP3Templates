  "Locale": {
    "en": {
      "meta.name": "PixARK",
      "meta.description": "PixARK Dedicated Server",
      "setting.Map.name": "Server Map",
      "setting.Map.desc": "Sets the map for the server. Terracrypt requires the Terracrypt DLC. If Custom is selected, Custom Map Name must also be set. Each map keeps its own world saves, so changing this starts a new world rather than converting the existing one",
      "category.pixark": "PixARK",
      "category.server": "Server",
      "setting.Map.value.CubeWorld_Light": "PixARK (default)",
      "setting.Map.value.Skypiea_light": "Skyward",
      "setting.Map.value.Underground_Light": "Terracrypt",
      "setting.Map.value._CustomMap_": "--Custom--",
      "setting.CustomMap.name": "Custom Map Name",
      "setting.CustomMap.desc": "Sets a custom map for the server. \u0022Custom\u0022 must be selected under Server Map. Use this for maps added by a future DLC or update that are not yet listed above",
      "setting.SessionName.name": "Server Name",
      "setting.SessionName.desc": "Set the name of the server as it appears publicly. Don\u0027t include a question mark",
      "setting.Seed.name": "Server Seed",
      "setting.Seed.desc": "Sets the seed for randomisation of the map. Default = random seed",
      "setting.cubeworld.name": "World Save Name",
      "setting.cubeworld.desc": "Sets the name of the world save to load, or to create if it does not exist",
      "setting.ServerPassword.name": "Server Password",
      "setting.ServerPassword.desc": "Sets the password for players to join the server. Don\u0027t include a question mark",
      "setting.RCONPassword.name": "RCON/Server Admin Password",
      "setting.RCONPassword.desc": "See the Security and Privacy menu for configurable options for the server\u0027s RCON password. The RCON password is also used in the in-game console for players to access administrator commands",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server",
      "setting.MultiHome.name": "MultiHome IP Binding",
      "setting.MultiHome.desc": "If required, you can change the binding of the server and RCON by changing the Application IP Binding for this instance. NOTE: The IP must be reachable by AMP, otherwise AMP\u0027s console won\u0027t work",
      "setting.CustomFlags.name": "Custom Command Line Flags",
      "setting.CustomFlags.desc": "Sets custom command line flags for the server (those that start with a - (dash)). Include the dash and separate with a space. Don\u0027t use flags already in AMP\u0027s settings!",
      "setting.CustomOptions.name": "Custom Command Line Options",
      "setting.CustomOptions.desc": "Sets custom command line options for the server (those that start with a ? (question mark)). Include the question mark but do not separate with a space. Don\u0027t use options already in AMP\u0027s settings!",
      "setting.ClusterDirOverride.name": "Cluster Directory Override",
      "setting.ClusterDirOverride.desc": "Sets the path to a shared cluster directory for a server cluster. The cluster directory must be accessible to all cluster servers. If the server is in Docker, the directory must be mounted in the container",
      "category.clusters": "Clusters",
      "setting.clusterid.name": "Cluster ID",
      "setting.clusterid.desc": "Sets the cluster ID for a server cluster. The cluster ID must be the same on all servers in the cluster",
      "setting.NoTransferFromFiltering.name": "Filter Transfers",
      "setting.NoTransferFromFiltering.desc": "If set, prevents ARK data usage between single player and servers that do not have a Cluster ID set. Even with a Cluster ID set, it is suggested to enable this option",
      "setting.NoTransferFromFiltering.value.True": "-NoTransferFromFiltering ",
      "category.updates": "Updates",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.GamePort.name": "Game Port",
      "port.GamePort.desc": "Port for game traffic",
      "port.QueryPort.name": "Query Port",
      "port.QueryPort.desc": "Port for Steam query traffic",
      "port.RCONPort.name": "RCON Port",
      "port.RCONPort.desc": "Port for RCON traffic",
      "port.CubePort.name": "Cube Port"
    }
  }
}