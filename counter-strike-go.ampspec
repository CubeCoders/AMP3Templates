{
  "Id": "49f9ced8-621b-47c8-ab4f-8a6bcc430dd3",
  "TemplateSlug": "counter-strike-go",
  "Lifecycle": {
    "RootDir": "./csgo/",
    "BaseDirectory": "./csgo/740/",
    "ExecutableWin": "740\\srcds.exe",
    "ExecutableLinux": "740/srcds_linux",
    "WorkingDir": "740",
    "CommandLineArgs": "{{$PlatformArgs}} -game {{mod}} -console -usercon -nobreakpad -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers_override {{$MaxUsers}} -authkey \u0022{{authkey}}\u0022 -tickrate {{tickrate}} {{insecure}}{{nohltv}}{{CustomParameters}} {{CustomConVars}} \u002Btv_port {{$SourceTVPort}} \u002Bsv_logfile 1 {{$FormattedArgs}} \u002Bexec server.cfg \u002Bmap {{map}} {{gamemode}} \u002Bsv_game_mode_flags {{sv_game_mode_flags}} \u002Bsv_skirmish_id {{sv_skirmish_id}} \u002Blog on \u002Blogaddress_add {{$UDPLogAddress}}:{{$UDPLogPort}}",
    "ApplicationReadyMode": "RCONConnected",
    "ExitString": "quit",
    "ExitFile": "lock"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "UDPLogger": true,
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "ForceIPBinding": true,
    "MaxUsers": 8,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullBaseDir}}:{{$FullBaseDir}}bin:%LD_LIBRARY_PATH%",
      "SteamAppId": "4465480"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "NotSupported",
    "Author": "Greelan",
    "URL": "https://blog.counter-strike.net/",
    "DisplayImageSource": "url:https://developer.valvesoftware.com/w/images/4/49/Software_Cover_-_Counter-Strike_Global_Offensive.jpg",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "7",
    "MinAMPVersion": "2.5.0.4",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C\u003E\u0022 entered the game$",
    "UserLeaveRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C.*\u003E\u0022 disconnected \\(reason \u0022.*\u0022\\)$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "ServerPort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "ServerPort",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "740",
      "UpdateSourceArgs": "4465480"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Remove Old Library",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022rm -rf csgo/740/bin/libgcc_s.so.1 \u003E/dev/null 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server.cfg Template File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/counter-strike-goserver.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullRootDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Metamod Download",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022MetamodBuild=\\\u0022{{MetamodBuild}}\\\u0022 \u0026\u0026 MetamodBranch=\\\u0022{{ModBranch}}\\\u0022 \u0026\u0026 if [[ -z \\\u0022$MetamodBuild\\\u0022 ]]; then wget -qO metamod.tar.gz \\\u0022https://metamodsource.net/latest.php?os=linux\u0026version=$MetamodBranch\\\u0022 \u0026\u0026 echo \\\u0022Latest Metamod $MetamodBranch build downloaded\\\u0022 \u0026\u0026 exit 0; elif [[ ! \\\u0022$MetamodBuild\\\u0022 =~ ^[0-9]\u002B$ ]]; then echo \\\u0022Invalid Metamod build version format specified\\\u0022 \u0026\u0026 exit 1; fi; if { [[ \\\u0022$MetamodBranch\\\u0022 == \\\u00222.0\\\u0022 ]] \u0026\u0026 [[ \\\u0022$MetamodBuild\\\u0022 -ge 1391 ]]; } || { [[ \\\u0022$MetamodBranch\\\u0022 == \\\u00221.12\\\u0022 ]] \u0026\u0026 [[ \\\u0022$MetamodBuild\\\u0022 -ge 1221 ]]; }; then DownloadURL=\\\u0022https://github.com/alliedmodders/metamod-source/releases/download/$MetamodBranch.0.$MetamodBuild/mmsource-$MetamodBranch.0-git$MetamodBuild-linux.tar.gz\\\u0022; else DownloadURL=\\\u0022https://mms.alliedmods.net/mmsdrop/$MetamodBranch/mmsource-$MetamodBranch.0-git$MetamodBuild-linux.tar.gz\\\u0022; fi; wget -qO metamod.tar.gz \\\u0022$DownloadURL\\\u0022 \u0026\u0026 echo \\\u0022Metamod $MetamodBranch build $MetamodBuild downloaded\\\u0022\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Metamod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022$ProgressPreference=\u0027SilentlyContinue\u0027; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $MetamodBuild=\u0027{{MetamodBuild}}\u0027; $MetamodBranch=\u0027{{ModBranch}}\u0027; if ([string]::IsNullOrWhiteSpace($MetamodBuild)) { Invoke-WebRequest -UseBasicParsing -Uri \\\u0022https://metamodsource.net/latest.php?os=windows\u0026version=$MetamodBranch\\\u0022 -OutFile \u0027metamod.zip\u0027; if ($?) { Write-Output \\\u0022Latest Metamod $MetamodBranch build downloaded\\\u0022; exit 0 } } elseif ($MetamodBuild -notmatch \u0027^\\d\u002B$\u0027) { Write-Output \\\u0022Invalid Metamod build version format specified\\\u0022; exit 1 }; if (($MetamodBranch -eq \u00272.0\u0027 -and [int]$MetamodBuild -ge 1391) -or ($MetamodBranch -eq \u00271.12\u0027 -and [int]$MetamodBuild -ge 1221)) { $DownloadURL = \\\u0022https://github.com/alliedmodders/metamod-source/releases/download/$MetamodBranch.0.$MetamodBuild/mmsource-$MetamodBranch.0-git$MetamodBuild-windows.zip\\\u0022 } else { $DownloadURL = \\\u0022https://mms.alliedmods.net/mmsdrop/$MetamodBranch/mmsource-$MetamodBranch.0-git$MetamodBuild-windows.zip\\\u0022 }; Invoke-WebRequest -UseBasicParsing -Uri $DownloadURL -OutFile \u0027metamod.zip\u0027; if ($?) { Write-Output \\\u0022Metamod $MetamodBranch build $MetamodBuild downloaded\\\u0022 }\u0022"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourceData": "metamod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}csgo",
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "metamod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}csgo",
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "SourceMod Download Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}sm"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022SourceModBuild=\\\u0022{{SourceModVersion}}\\\u0022 \u0026\u0026 SourceModBranch=\\\u0022{{SourceModBranch}}\\\u0022 \u0026\u0026 if [[ -z \\\u0022$SourceModBuild\\\u0022 ]]; then wget -qO sourcemod.tar.gz \\\u0022https://sourcemod.net/latest.php?os=linux\u0026version=$SourceModBranch\\\u0022 \u0026\u0026 echo \\\u0022Latest SourceMod $SourceModBranch build downloaded\\\u0022 \u0026\u0026 exit 0; elif [[ ! \\\u0022$SourceModBuild\\\u0022 =~ ^[0-9]\u002B$ ]]; then echo \\\u0022Invalid SourceMod build version format specified\\\u0022 \u0026\u0026 exit 1; fi; if { [[ \\\u0022$SourceModBranch\\\u0022 == \\\u00221.13\\\u0022 ]] \u0026\u0026 [[ \\\u0022$SourceModBuild\\\u0022 -ge 7311 ]]; } || { [[ \\\u0022$SourceModBranch\\\u0022 == \\\u00221.12\\\u0022 ]] \u0026\u0026 [[ \\\u0022$SourceModBuild\\\u0022 -ge 7225 ]]; }; then DownloadURL=\\\u0022https://github.com/alliedmodders/sourcemod/releases/download/$SourceModBranch.0.$SourceModBuild/sourcemod-$SourceModBranch.0-git$SourceModBuild-linux.tar.gz\\\u0022; else DownloadURL=\\\u0022https://sm.alliedmods.net/smdrop/$SourceModBranch/sourcemod-$SourceModBranch.0-git$SourceModBuild-linux.tar.gz\\\u0022; fi; wget -qO sourcemod.tar.gz \\\u0022$DownloadURL\\\u0022 \u0026\u0026 echo \\\u0022SourceMod $SourceModBranch build $SourceModBuild downloaded\\\u0022\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022$ProgressPreference=\u0027SilentlyContinue\u0027; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $SourceModBuild=\u0027{{SourceModVersion}}\u0027; $SourceModBranch=\u0027{{SourceModBranch}}\u0027; if ([string]::IsNullOrWhiteSpace($SourceModBuild)) { Invoke-WebRequest -UseBasicParsing -Uri \\\u0022https://sourcemod.net/latest.php?os=windows\u0026version=$SourceModBranch\\\u0022 -OutFile \u0027sourcemod.zip\u0027; if ($?) { Write-Output \\\u0022Latest SourceMod $SourceModBranch build downloaded\\\u0022; exit 0 } } elseif ($SourceModBuild -notmatch \u0027^\\d\u002B$\u0027) { Write-Output \\\u0022Invalid SourceMod build version format specified\\\u0022; exit 1 }; if (($SourceModBranch -eq \u00271.13\u0027 -and [int]$SourceModBuild -ge 7311) -or ($SourceModBranch -eq \u00271.12\u0027 -and [int]$SourceModBuild -ge 7225)) { $DownloadURL = \\\u0022https://github.com/alliedmodders/sourcemod/releases/download/$SourceModBranch.0.$SourceModBuild/sourcemod-$SourceModBranch.0-git$SourceModBuild-windows.zip\\\u0022 } else { $DownloadURL = \\\u0022https://sm.alliedmods.net/smdrop/$SourceModBranch/sourcemod-$SourceModBranch.0-git$SourceModBuild-windows.zip\\\u0022 }; Invoke-WebRequest -UseBasicParsing -Uri $DownloadURL -OutFile \u0027sourcemod.zip\u0027; if ($?) { Write-Output \\\u0022SourceMod $SourceModBranch build $SourceModBuild downloaded\\\u0022 }\u0022"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourceData": "sourcemod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "sourcemod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022Set-Location -Path \u0027csgo/740\u0027; if (Test-Path \u0027csgo/cfg/sourcemod\u0027) { Remove-Item -Path \u0027sm/cfg/sourcemod\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027csgo/addons/sourcemod/configs\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/configs\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027csgo/addons/sourcemod/plugins\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/plugins\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; Copy-Item -Path \u0027sm/*\u0027 -Destination \u0027csgo\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; Remove-Item -Path \u0027sm\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd csgo/740 \u0026\u0026 [ -d csgo/cfg/sourcemod ] \u0026\u0026 rm -rf sm/cfg/sourcemod \u003E/dev/null 2\u003E\u00261; [ -d csgo/addons/sourcemod/configs ] \u0026\u0026 rm -rf sm/addons/sourcemod/configs \u003E/dev/null 2\u003E\u00261; [ -d csgo/addons/sourcemod/plugins ] \u0026\u0026 rm -rf sm/addons/sourcemod/plugins \u003E/dev/null 2\u003E\u00261; \\cp -rf sm/* csgo/ \u003E/dev/null 2\u003E\u00261; rm -rf sm \u003E/dev/null 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../csgo/addons/metamod/bin/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}csgo/addons/metamod.vdf",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "GithubRelease",
      "UpdateStageName": "NoLobbyReservation Plugin Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "nuxencs/NoLobbyReservation",
      "UpdateSourceTarget": "{{$FullBaseDir}}csgo",
      "UnzipUpdateSource": true,
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "NoLobbyReservation Gamedata Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/nuxencs/NoLobbyReservation/refs/heads/master/addons/sourcemod/gamedata/nolobbyreservation.games.txt",
      "UpdateSourceTarget": "{{$FullBaseDir}}csgo/addons/sourcemod/gamedata",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "NoLobbyReservation Scripting Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/nuxencs/NoLobbyReservation/refs/heads/master/addons/sourcemod/scripting/nolobbyreservation.sp",
      "UpdateSourceTarget": "{{$FullBaseDir}}csgo/addons/sourcemod/scripting",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Update steam.inf File",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022if [[ -f csgo/740/csgo/steam.inf ]]; then sed -i \\\u0022s/^\\s*appID=730\\s*$/appID=4465480/\\\u0022 csgo/740/csgo/steam.inf; fi\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Update steam.inf File",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022if (Test-Path \u0027csgo\\740\\csgo\\steam.inf\u0027) { (Get-Content \u0027csgo\\740\\csgo\\steam.inf\u0027) -replace \u0027^\\s*appID=730\\s*$\u0027, \u0027appID=4465480\u0027 | Set-Content \u0027csgo\\740\\csgo\\steam.inf\u0027 }\u0022"
    }
  ],
