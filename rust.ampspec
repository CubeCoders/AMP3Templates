        },
        {
            "FieldName": "levelurl",
            "DisplayName": "setting.levelurl.name",
            "Description": "setting.levelurl.desc",
            "Order": 4,
            "InputType": "text",
            "DefaultValue": "",
            "Placeholder": "https://example.org/myserverdata/",
            "SkipIfEmpty": true,
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.world:public"
        },
        {
            "FieldName": "server.pve",
            "DisplayName": "setting.server.pve.name",
            "Description": "setting.server.pve.desc",
            "Order": 1,
