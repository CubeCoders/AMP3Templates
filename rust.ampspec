            "DisplayName": "setting.server.level.name",
            "Description": "setting.server.level.desc",
            "EnumValues": {
                "Procedural Map": "setting.server.level.value.Procedural Map",
                "Barren": "setting.server.level.value.Barren",
                "HapisIsland": "setting.server.level.value.HapisIsland",
                "SavasIsland": "setting.server.level.value.SavasIsland",
