{
    "Id": "c9e51f52-e1ec-1faa-8b66-228171598263",
    "TemplateSlug": "rust",
    "SchemaVersion": 1,
    "Metadata": {
        "DisplayName": "meta.name",
        "Description": "meta.description",
        "OS": "Windows, Linux",
        "Arch": "X64",
        "AarchSupport": "NotSupported",
        "Author": "CubeCoders Limited",
        "URL": "https://rust.facepunch.com/",
        "DisplayImageSource": "steam:252490",
        "EndpointURIFormat": "steam://connect/{0}",
        "SpecificDockerImage": "cubecoders/ampbase:debian",
        "ContainerPolicy": "Supported",
        "ConfigReleaseState": "NotSpecified"
    },
    "Lifecycle": {
        "RootDir": "./rust/",
        "BaseDirectory": "./rust/258550/",
        "ExecutableWin": "258550\\RustDedicated.exe",
        "ExecutableLinux": "258550/RustDedicated",
        "WorkingDir": "258550",
        "CommandLineArgs": "-batchmode -logfile - -nographics {{$FormattedArgs}} {{CustomArgs}}",
        "CommandLineParameterFormat": "+{0} \"{1}\"",
        "ApplicationReadyMode": "RegexMatch",
        "ExitMethod": "String",
        "ExitString": "quit",
        "ExitTimeout": 120,
        "SteamUpdateAnonymousLogin": "True"
    },
    "Management": {
        "AdminMethod": "WebRCON",
        "UseRandomAdminPassword": true,
        "PersistRandomPassword": true,
        "HasWriteableConsole": true,
        "HasReadableConsole": true,
        "ApplicationIPBinding": "0.0.0.0",
        "SupportsIPv6": false,
        "MaxUsers": 100
    },
    "Console": {
        "AppReadyRegex": "Server startup complete",
        "UserJoinRegex": "^(?<username>.+?) with steamid (?<userid>\\d+) joined from ip (?<endpoint>[\\d\\.]+:\\d+)$",
        "UserIdKind": "steam64",
        "UserLeaveRegex": "^[\\d\\.]+:\\d+\\/(?<userid>\\d+)\\/(?<username>.+?) disconnecting: (?<reason>.+)$",
        "UserChatRegex": "^\\[CHAT\\] (?<username>.+?)\\[\\d+\\] : (?<message>.+)$",
        "UpdateAvailableRegex": "^New version detected!$",
        "ThrowawayMessageRegex": "^(?:Unsupported encoding: 'utf8'|Reporting Performance Data system/server)$"
    },
    "PortReferences": {
        "PrimaryApplicationPortRef": "ServerPort",
        "AdminPortRef": "RemoteAdminPort"
    },
    "UpdateStages": [
        {
            "UpdateStageName": "SteamCMD Server Download",
            "UpdateSourcePlatform": "All",
            "UpdateSource": "SteamCMD",
            "UpdateSourceData": "258550",
            "UpdateSourceArgs": "252490",
            "UpdateSourceVersion": "{{ServerBranch}}"
        },
        {
            "UpdateStageName": "UMod Download",
            "UpdateSourcePlatform": "Windows",
            "UpdateSource": "FetchURL",
            "UpdateSourceData": "https://umod.org/games/rust/download",
            "UpdateSourceTarget": "{{$FullBaseDir}}",
            "UpdateSourceArgs": "UMod-Rust.zip",
            "UnzipUpdateSource": true,
            "OverwriteExistingFiles": true,
            "UpdateSourceConditionSetting": "InstallUMod",
            "UpdateSourceConditionValue": "true"
        },
        {
            "UpdateStageName": "UMod Download",
            "UpdateSourcePlatform": "Linux",
            "UpdateSource": "FetchURL",
            "UpdateSourceData": "https://umod.org/games/rust/download/develop",
            "UpdateSourceTarget": "{{$FullBaseDir}}",
            "UpdateSourceArgs": "UMod-Rust.zip",
            "UnzipUpdateSource": true,
            "OverwriteExistingFiles": true,
            "UpdateSourceConditionSetting": "InstallUMod",
            "UpdateSourceConditionValue": "true"
        },
        {
            "UpdateStageName": "UMod Compiler",
            "UpdateSourcePlatform": "Linux",
            "UpdateSource": "FetchURL",
            "UpdateSourceData": "https://assets.umod.org/compiler/Compiler.x86_x64",
            "UpdateSourceTarget": "{{$FullBaseDir}}",
            "UpdateSourceArgs": "Compiler.x86_x64",
            "OverwriteExistingFiles": true,
            "UpdateSourceConditionSetting": "InstallUMod",
            "UpdateSourceConditionValue": "true"
        }
    ],
    "PortRequirements": [
        {
            "Name": "port.ServerPort.name",
            "Description": "port.ServerPort.desc",
            "Ref": "ServerPort",
            "Port": 28015,
            "Protocol": "UDP"
        },
        {
            "Name": "port.QueryPort.name",
            "Description": "port.QueryPort.desc",
            "Ref": "QueryPort",
            "Port": 28016,
            "Protocol": "UDP"
        },
        {
            "Name": "port.RemoteAdminPort.name",
            "Description": "port.RemoteAdminPort.desc",
            "Ref": "RemoteAdminPort",
            "Port": 28017,
            "Protocol": "TCP"
        },
        {
            "Name": "port.RustPlusPort.name",
            "Description": "port.RustPlusPort.desc",
            "Ref": "RustPlusPort",
            "Port": 28082,
            "Protocol": "TCP"
        }
    ],
    "Settings": [
        {
            "FieldName": "server.hostname",
            "DisplayName": "setting.server.hostname.name",
            "Description": "setting.server.hostname.desc",
            "Order": 1,
            "InputType": "text",
            "DefaultValue": "My Rust server | Powered by AMP",
            "SkipIfEmpty": true,
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.server:dns"
        },
        {
            "FieldName": "server.description",
            "DisplayName": "setting.server.description.name",
            "Description": "setting.server.description.desc",
            "Order": 2,
            "InputType": "multiline",
            "DefaultValue": "My Rust server | Powered by AMP",
            "SkipIfEmpty": true,
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.server:dns"
        },
        {
            "FieldName": "server.headerimage",
            "DisplayName": "setting.server.headerimage.name",
            "Description": "setting.server.headerimage.desc",
            "Order": 3,
            "InputType": "text",
            "DefaultValue": "",
            "Placeholder": "https://example.org/banner.png",
            "SkipIfEmpty": true,
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.server:dns"
        },
        {
            "FieldName": "server.url",
            "DisplayName": "setting.server.url.name",
            "Description": "setting.server.url.desc",
            "Order": 4,
            "InputType": "text",
            "DefaultValue": "",
            "Placeholder": "https://example.org",
            "SkipIfEmpty": true,
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.server:dns"
        },
        {
            "FieldName": "$MaxUsers",
            "ParamFieldName": "server.maxplayers",
            "DisplayName": "setting.$MaxUsers.name",
            "Description": "setting.$MaxUsers.desc",
            "Order": 5,
            "InputType": "number",
            "DefaultValue": "100",
            "MinValue": 1,
            "MaxValue": 1000,
            "Suffix": "players",
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.server:dns"
        },
        {
            "FieldName": "server.seed",
            "DisplayName": "setting.server.seed.name",
            "Description": "setting.server.seed.desc",
            "Order": 1,
            "InputType": "number",
            "DefaultValue": "6738",
            "MinValue": 0,
            "MaxValue": 2147483647,
            "IncludeInCommandLine": true,
            "IncludeInConfigFile": false,
            "Category": "category.world:public"
        },
        {
            "FieldName": "server.worldsize",
            "DisplayName": "setting.server.worldsize.name",
            "Description": "setting.server.worldsize.desc",
            "Order": 2,
            "InputType": "number",
            "DefaultValue": "4500",
            "MinValue": 2000,
            "MaxValue": 8000,
            "Suffix": "units",
