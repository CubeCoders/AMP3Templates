{
  "Id": "b1e29303-0c4f-4d32-9a3c-b2659e782d30",
  "TemplateSlug": "contagion",
  "Lifecycle": {
    "RootDir": "./contagion/",
    "BaseDirectory": "./contagion/293030/",
    "ExecutableWin": "293030\\contagionds.exe",
    "ExecutableLinux": "/usr/bin/xvfb-run",
    "WorkingDir": "293030",
    "LinuxCommandLineArgs": "-a wine \u0022./contagionds.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} -game contagion -console -usercon -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} \u002Brcon_password \u0022{{$RemoteAdminPassword}}\u0022 \u002Bsv_logfile 1 {{$FormattedArgs}} \u002Bexec server.cfg \u002Bmap {{map}} \u002Blog on \u002Blogaddress_add {{$UDPLogAddress}}:{{$UDPLogPort}}",
    "ApplicationReadyMode": "RCONConnected",
    "MonitorChildProcessName": "^.*contagionds\\.exe.*-port {{$ServerPort}}.*$",
    "ExitString": "quit"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "UDPLogger": true,
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONConnectDelaySeconds": 20,
    "ForceIPBinding": true,
    "EnvironmentVariables": {
      "SteamAppId": "238430",
      "WINEPREFIX": "{{$FullRootDir}}.wine",
      "WINEARCH": "win64",
      "WINEDEBUG": "-all"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "NotSupported",
    "Author": "Shinynecrid",
    "URL": "https://www.contagion-game.com/",
    "DisplayImageSource": "steam:238430",
    "SpecificDockerImage": "cubecoders/ampbase:wine-stable",
    "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux",
    "ContainerPolicyReason": "The server requires Wine (ideally latest stable from winehq.org) and Xvfb to run on Linux. Using a container avoids the need for you to install these dependencies on the host.",
    "ConfigVersion": "1",
    "MinAMPVersion": "2.6.0.4",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(?\u003Cuserid\u003E.\u002B?)\u003E\u003C\u003E\u0022 connected, address \u0022.*\u0022$",
    "UserLeaveRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(?\u003Cuserid\u003E.\u002B?)\u003E\u003C.*\u003E\u0022 disconnected .*$"
  },
  "PortReferences": {
    "AdminPortRef": "ServerPort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "ServerPort"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "293030",
      "UpdateSourceVersion": "public",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server Config Template Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/contagion/server.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullRootDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Initialise Wine",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022rm -rf \\\u0022{{$FullRootDir}}.wine\\\u0022 \u003E/dev/null 2\u003E\u00261; WINEPREFIX=\\\u0022{{$FullRootDir}}.wine\\\u0022 WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init\u0022"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 27015,
      "Protocol": "Both"
    }
  ],
  "Settings": [
    {
      "FieldName": "$RemoteAdminPassword",
      "ParamFieldName": "rcon_password",
      "Hidden": true,
      "Category": "category.contagion:stadia_controller",
      "Subcategory": "category.security:lock:2",
      "DisplayName": "setting.$RemoteAdminPassword.name",
      "Description": "setting.$RemoteAdminPassword.desc",
      "Keywords": "rcon,password,admin",
      "InputType": "password"
