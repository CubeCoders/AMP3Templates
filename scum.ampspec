    },
    {
      "FieldName": "nobattleye",
      "ParamFieldName": "nobattleye",
      "DefaultValue": "",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.nobattleye.name",
      "Description": "setting.nobattleye.desc",
      "Keywords": "battleye,anti,cheat,nobattleye",
      "InputType": "checkbox",
      "EnumValues": {
        "False": "",
        "True": "-nobattleye "
      }
    },
    {
      "FieldName": "CustomArgs",
      "ParamFieldName": "CustomArgs",
      "DefaultValue": "",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.CustomArgs.name",
      "Description": "setting.CustomArgs.desc",
      "Keywords": "custom,server,arguments,parameters",
      "InputType": "text"
    },
    {
      "FieldName": "SpecificReleaseVersion",
      "ParamFieldName": "SpecificReleaseVersion",
      "Required": true,
      "Platform": "Linux",
      "DefaultValue": "[Latest]",
      "Category": "category.updates",
      "Subcategory": "category.runtime-configuration:build:3",
      "DisplayName": "setting.SpecificReleaseVersion.name",
      "Description": "setting.SpecificReleaseVersion.desc",
      "Keywords": "proton,release,version",
      "InputType": "enum",
      "ValueSourceId": "protonge.releases"
    },
    {
      "FieldName": "$ApplicationIPBinding",
      "DefaultValue": "0.0.0.0",
      "Category": "category.networking:lan",
      "DisplayName": "setting.$ApplicationIPBinding.name",
      "Description": "setting.$ApplicationIPBinding.desc",
      "Keywords": "ip,binding,bind,address,interface",
      "InputType": "text",
      "Placeholder": "0.0.0.0"
    }
  ],
  "ConfigFileMappings": [
    {
      "ConfigFile": "SCUM/Saved/Config/WindowsServer/ServerSettings.ini",
      "ConfigType": "ini",
      "AutoMap": true
    }
  ],
  "Locale": {
    "en": {
      "meta.name": "SCUM",
      "meta.description": "SCUM Dedicated Server",
      "setting.ServerSettings.name": "Server Settings",
      "setting.ServerSettings.desc": "Settings for the server can be configured in \u0027SCUM/Saved/Config/WindowsServer/ServerSettings.ini\u0027, or in-game by admins listed under Admin Users For Server Settings",
      "category.scum": "SCUM",
      "category.server": "Server",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users that may connect to the server at one time",
      "setting.ExclusiveUsers.name": "Exclusive Join List",
      "setting.ExclusiveUsers.desc": "List of [Steam64 IDs](https://steamid.io/) of players who are allowed to join the server. If any IDs are set, only those players will be able to connect, turning the server into a \u0027whitelist\u0027 server",
      "setting.WhitelistedUsers.name": "Reserved List",
      "setting.WhitelistedUsers.desc": "List of [Steam64 IDs](https://steamid.io/) of players who are allowed to join the server even if it is otherwise full. Commonly used as a VIP list. If the server is full, a random player will be kicked from the server to allow a reserved player to join",
      "setting.AdminUsers.name": "Admin Users",
      "setting.AdminUsers.desc": "List of [Steam64 IDs](https://steamid.io/) for users who will be allowed to use admin commands in-game and (if desired) their specific permissions. Specific permissions must be specified in square brackets immediately after the Steam64 ID (no spaces), such as: 3456789098765432[SetGodMode,RestartServer]",
      "setting.ServerSettingsAdminUsers.name": "Admin Users For Server Settings",
      "setting.ServerSettingsAdminUsers.desc": "List of [Steam64 IDs](https://steamid.io/) for users who will be allowed to change server settings in-game",
      "setting.nobattleye.name": "Disable BattlEye",
      "setting.nobattleye.desc": "If set, BattlEye anti-cheat will be disabled on the server",
      "setting.CustomArgs.name": "Additional Command Line Arguments",
      "setting.CustomArgs.desc": "Specifies additional command line arguments (anything that begins with a - ) that are not otherwise set by AMP. Use with care",
      "setting.SpecificReleaseVersion.name": "Proton GE Release Version (Linux)",
      "setting.SpecificReleaseVersion.desc": "Sets the Proton GE [release version](https://github.com/GloriousEggroll/proton-ge-custom/releases) to install.",
      "category.updates": "Updates",
      "category.runtime-configuration": "Runtime Configuration",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.ServerPort.name": "Server Port",
      "port.ServerPort.desc": "Port for main game traffic",
      "port.ClientPort.name": "Client Port",
      "port.ClientPort.desc": "Port for client connections",
      "port.QueryPort.name": "Query Port",
      "port.QueryPort.desc": "Port for Steam query traffic"
    }
  }
}