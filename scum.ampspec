{
  "Id": "721f4476-0b57-4765-9f36-21cbae019e46",
  "TemplateSlug": "scum",
  "Lifecycle": {
    "RootDir": "./scum/",
    "BaseDirectory": "./scum/3792580/",
    "ExecutableWin": "3792580\\SCUM\\Binaries\\Win64\\SCUMServer.exe",
    "ExecutableLinux": ".proton/proton",
    "WorkingDir": "3792580",
    "LinuxCommandLineArgs": "runinprefix \u0022{{$FullBaseDir}}SCUM/Binaries/Win64/SCUMServer.exe\u0022",
    "CommandLineArgs": "{{$PlatformArgs}} SCUM -Port={{$ServerPort}} -QueryPort={{$QueryPort}} -MaxPlayers={{$MaxUsers}} {{nobattleye}}{{$FormattedArgs}} {{CustomArgs}}",
    "CommandLineParameterFormat": "-{0}={1}",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}SCUM\\\\Binaries\\\\Win64\\\\SCUMServer\\.exe.*-Port={{$ServerPort}}.*$",
    "ExitMethod": "OS_CLOSE",
    "ExitString": "stop",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "AdminMethod": "TailLogFile",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONConnectDelaySeconds": 10,
    "RCONHeartbeatCommand": "ping",
    "TailLogFilePath": "{{$FullBaseDir}}SCUM/Saved/Logs/SCUM.log",
    "MaxUsers": 64,
    "EnvironmentVariables": {
      "SteamAppId": "513710",
      "STEAM_COMPAT_DATA_PATH": "{{$FullRootDir}}.proton/compatdata",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{{$FullBaseDir}}.steam/steam",
      "HOME": "{{$FullBaseDir}}"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan",
    "URL": "https://scum.game/",
    "DisplayImageSource": "steam:513710",
    "EndpointURIFormat": "{ip}:{GenericModule.App.Ports.$ClientPort}",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "5",
    "MinAMPVersion": "2.6.0.0"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: Global Stats:.*$",
    "UserJoinRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: \u0027(?\u003Cendpoint\u003E.*?) (?\u003Cuserid\u003E\\d\u002B?):(?\u003Cusername\u003E.*?)\\(\\d\u002B\\)\u0027 logged in at:.*$",
    "UserLeaveRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: Warning: Prisoner logging out: (?\u003Cusername\u003E.*?) \\((?\u003Cuserid\u003E\\d\u002B?)\\)$",
    "UserChatRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$",
    "MetricsRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: Global Stats: \\d\u002B\\.\\d\u002Bms\\s\u002B\\(\\s\u002B\\d\u002B\\.\\d\u002BFPS\\), \\d\u002B\\.\\d\u002Bms\\s\u002B\\(\\s\u002B(?\u003CFPS\u003E\\d\u002B\\.\\d\u002B?)FPS\\), \\d\u002B\\.\\d\u002Bms\\s\u002B\\(\\s\u002B\\d\u002B\\.\\d\u002BFPS\\).*$"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SCUM Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "3792580",
      "UpdateSourceArgs": "513710",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Proton GE Download",
      "UpdateSourceData": "{{SpecificReleaseVersion.downloadUrl}}",
      "UpdateSourceTarget": "{{$FullRootDir}}.proton"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Proton GE Installation",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd \\\u0022{{$FullRootDir}}.proton\\\u0022 \u0026\u0026 mkdir -p compatdata \\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullBaseDir}}.config/protonfixes\\\u0022 || exit 1; ProtonVersion=\\\u0022{{SpecificReleaseVersion}}\\\u0022; Archive=\\\u0022{{SpecificReleaseVersion.downloadUrl}}\\\u0022; Archive=\\\u0022${Archive##*/}\\\u0022; if [[ ! -s \\\u0022$Archive\\\u0022 ]]; then InstalledVersion=\\\u0022\\\u0022; [[ -x proton \u0026\u0026 -f version ]] \u0026\u0026 read _ InstalledVersion \u003C version; if [[ \\\u0022$InstalledVersion\\\u0022 == \\\u0022$ProtonVersion\\\u0022 || \\\u0022$InstalledVersion\\\u0022 == \\\u0022$ProtonVersion\\\u0022-* ]]; then echo \\\u0022Proton GE version $ProtonVersion already installed. Skipping\\\u0022; exit 0; fi; rm -f \\\u0022$Archive\\\u0022; echo \\\u0022Proton GE version $ProtonVersion is not installed. Update again to download it\\\u0022; exit 1; fi; rm -rf compatdata/* \u003E/dev/null 2\u003E\u00261; if ! tar -xzf \\\u0022$Archive\\\u0022 --strip-components=1; then rm -f \\\u0022$Archive\\\u0022; echo \\\u0022Proton GE archive could not be extracted. Aborting\\\u0022; exit 1; fi; find . -maxdepth 1 -name \u0027GE-Proton*.tar.gz\u0027 ! -name \\\u0022$Archive\\\u0022 -delete; : \u003E \\\u0022$Archive\\\u0022; echo \\\u0022Proton GE version $ProtonVersion downloaded\\\u0022; STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 PROTON_LOG=1 \u003E/dev/null 2\u003E\u00261; exit 0\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Prefix Sound",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd scum \u0026\u0026 export PATH=\\\u0022{{$FullRootDir}}.proton/files/bin:$PATH\\\u0022; export WINEPREFIX=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx\\\u0022; export WINEARCH=win64; ./.proton/protonfixes/winetricks sound=disabled \u003E winescript_log.txt 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Config Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}SCUM/Saved/Config/WindowsServer"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "ServerSettings.ini File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/scum/serversettings.ini",
      "UpdateSourceArgs": "ServerSettings.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}SCUM/Saved/Config/WindowsServer"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 7777,
      "Protocol": "UDP",
      "ChildPorts": [
        {
          "Name": "port.ClientPort.name",
          "Description": "port.ClientPort.desc",
          "Ref": "ClientPort",
          "Port": 7779,
          "Offset": 2
        }
      ]
    },
    {
      "Name": "port.QueryPort.name",
      "Description": "port.QueryPort.desc",
      "Ref": "QueryPort",
      "Port": 27015,
      "Protocol": "UDP"
    }
  ],
  "VersionSources": [
    {
      "Id": "protonge.releases",
      "Url": "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases?per_page=100",
      "Format": "Text",
      "Select": "\u0022browser_download_url\u0022\\s*:\\s*\u0022(?\u003Curl\u003Ehttps://github\\.com/GloriousEggroll/proton-ge-custom/releases/download/(?\u003Ctag\u003EGE-Proton[0-9]\u002B-[0-9]\u002B)/\\k\u003Ctag\u003E(?:-x86_64)?\\.tar\\.gz)\u0022",
      "Value": "tag",
      "Fields": {
        "downloadUrl": "url"
      },
      "Sort": "VersionDescending"
    }
  ],
  "Settings": [
    {
      "FieldName": "ServerSettings",
      "ParamFieldName": "ServerSettings",
      "DefaultValue": "",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.ServerSettings.name",
      "Description": "setting.ServerSettings.desc",
      "InputType": "hidden"
    },
    {
      "FieldName": "$MaxUsers",
      "ParamFieldName": "General.scum.MaxPlayers",
      "DefaultValue": "64",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "DisplayName": "setting.$MaxUsers.name",
      "Description": "setting.$MaxUsers.desc",
      "Keywords": "maximum,players,clients,limit,maxplayers,slots",
      "InputType": "number",
      "Placeholder": "64",
      "Suffix": "users",
      "MinValue": 1,
      "MaxValue": 128
    },
    {
      "FieldName": "ExclusiveUsers",
      "ParamFieldName": "ExclusiveUsers",
      "DefaultValue": "",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "Special": "listfile:./scum/3792580/SCUM/Saved/Config/WindowsServer/ExclusiveUsers.ini",
      "DisplayName": "setting.ExclusiveUsers.name",
      "Description": "setting.ExclusiveUsers.desc",
      "Keywords": "exclusive,users,join,list,whitelist,ExclusiveUsers",
      "InputType": "list"
    },
    {
      "FieldName": "WhitelistedUsers",
      "ParamFieldName": "WhitelistedUsers",
      "DefaultValue": "",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "Special": "listfile:./scum/3792580/SCUM/Saved/Config/WindowsServer/WhitelistedUsers.ini",
      "DisplayName": "setting.WhitelistedUsers.name",
      "Description": "setting.WhitelistedUsers.desc",
      "Keywords": "reserved,users,WhitelistedUsers",
      "InputType": "list"
    },
    {
      "FieldName": "AdminUsers",
      "ParamFieldName": "AdminUsers",
      "DefaultValue": "",
      "Category": "category.scum:stadia_controller",
      "Subcategory": "category.server:dns:1",
      "Special": "listfile:./scum/3792580/SCUM/Saved/Config/WindowsServer/AdminUsers.ini",
      "DisplayName": "setting.AdminUsers.name",
      "Description": "setting.AdminUsers.desc",
