{
  "Id": "721f4476-0b57-4765-9f36-21cbae019e46",
  "TemplateSlug": "scum",
  "Lifecycle": {
    "RootDir": "./scum/",
    "BaseDirectory": "./scum/3792580/",
    "ExecutableWin": "3792580\\SCUM\\Binaries\\Win64\\SCUMServer.exe",
    "ExecutableLinux": "/bin/bash",
    "WorkingDir": "3792580",
    "LinuxCommandLineArgs": "-c \u0022if [[ -x /usr/bin/wine ]]; then exec /usr/bin/wine \\\u0022{{$FullBaseDir}}SCUM/Binaries/Win64/SCUMServer.exe\\\u0022 \\\u0022$@\\\u0022; elif [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 ]]; then unset WINEPREFIX WINEARCH WINEDEBUG; export STEAM_COMPAT_DATA_PATH=\\\u0022{{$FullRootDir}}.proton/compatdata\\\u0022 STEAM_COMPAT_CLIENT_INSTALL_PATH=\\\u0022{{$FullBaseDir}}.steam/steam\\\u0022 HOME=\\\u0022{{$FullBaseDir}}\\\u0022; exec \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 runinprefix \\\u0022{{$FullBaseDir}}SCUM/Binaries/Win64/SCUMServer.exe\\\u0022 \\\u0022$@\\\u0022; else echo \\\u0022ERROR: Wine was not found at /usr/bin/wine, and this instance has no Proton GE runtime to fall back to.\\\u0022; exit 1; fi\u0022 amp-launch",
    "CommandLineArgs": "{{$PlatformArgs}} SCUM -Port={{$ServerPort}} -QueryPort={{$QueryPort}} -MaxPlayers={{$MaxUsers}} {{nobattleye}}{{$FormattedArgs}} {{CustomArgs}}",
    "CommandLineParameterFormat": "-{0}={1}",
    "MonitorChildProcessName": "^.*{{$WineBaseDir}}SCUM\\\\Binaries\\\\Win64\\\\SCUMServer\\.exe.*-Port={{$ServerPort}}.*$",
    "ExitMethod": "OS_CLOSE",
    "ExitString": "stop",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "AdminMethod": "TailLogFile",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONConnectDelaySeconds": 10,
    "RCONHeartbeatCommand": "ping",
    "TailLogFilePath": "{{$FullBaseDir}}SCUM/Saved/Logs/SCUM.log",
    "MaxUsers": 64,
    "EnvironmentVariables": {
      "SteamAppId": "513710",
      "WINEPREFIX": "{{$FullRootDir}}.wine",
      "WINEARCH": "win64",
      "WINEDEBUG": "-all"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan",
    "URL": "https://scum.game/",
    "DisplayImageSource": "steam:513710",
    "EndpointURIFormat": "{ip}:{GenericModule.App.Ports.$ClientPort}",
    "SpecificDockerImage": "cubecoders/ampbase:wine-stable",
    "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux",
    "ContainerPolicyReason": "The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install this dependency on the host.",
    "ConfigVersion": "6",
    "BreakingReleaseNotes": "Linux now uses Wine instead of Proton GE. Container shards switch automatically unless they have an image override. Native shards: install Wine. Until then the old Proton GE install keeps working but is no longer updated. Proton saves are copied into the Wine prefix; .proton/compatdata is kept.",
    "MinAMPVersion": "2.6.0.0"
  },
  "Console": {
    "FilterMatchRegex": "(\\e\\[(\\d\u002B;)*(\\d\u002B)?[ABCDHJKfmsu]|\\e\\[?[?\\\u003E\\=\\da-z]\u002B|ProtonFixes\\[\\d\u002B\\] WARN: Skipping fix execution\\. We are probably running a unit test\\.)",
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: Global Stats:.*$",
    "UserJoinRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: \u0027(?\u003Cendpoint\u003E.*?) (?\u003Cuserid\u003E\\d\u002B?):(?\u003Cusername\u003E.*?)\\(\\d\u002B\\)\u0027 logged in at:.*$",
    "UserLeaveRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: Warning: Prisoner logging out: (?\u003Cusername\u003E.*?) \\((?\u003Cuserid\u003E\\d\u002B?)\\)$",
    "UserChatRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$",
    "MetricsRegex": "^\\[[\\d.]\u002B-[\\d.:]\u002B\\]\\[[\\d ]\u002B\\]LogSCUM: Global Stats: \\d\u002B\\.\\d\u002Bms\\s\u002B\\(\\s\u002B\\d\u002B\\.\\d\u002BFPS\\), \\d\u002B\\.\\d\u002Bms\\s\u002B\\(\\s\u002B(?\u003CFPS\u003E\\d\u002B\\.\\d\u002B?)FPS\\), \\d\u002B\\.\\d\u002Bms\\s\u002B\\(\\s\u002B\\d\u002B\\.\\d\u002BFPS\\).*$"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SCUM Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "3792580",
      "UpdateSourceArgs": "513710",
      "ForceDownloadPlatform": "Windows"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Initialise Wine",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022if [[ -x /usr/bin/wine ]]; then WINEPREFIX=\\\u0022{{$FullRootDir}}.wine\\\u0022 WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init --update || exit 1; old=\\\u0022{{$FullRootDir}}.proton/compatdata/pfx/drive_c/users/steamuser\\\u0022; new=\\\u0022{{$FullRootDir}}.wine/drive_c/users/$(id -un)\\\u0022; if [[ -d \\\u0022$old\\\u0022 \u0026\u0026 -d \\\u0022$new\\\u0022 \u0026\u0026 ! -e \\\u0022{{$FullRootDir}}.wine/.proton-profile-copied\\\u0022 ]]; then cp -an \\\u0022$old/.\\\u0022 \\\u0022$new/\\\u0022 \u0026\u0026 touch \\\u0022{{$FullRootDir}}.wine/.proton-profile-copied\\\u0022 \u0026\u0026 echo \\\u0022Copied the Proton GE user profile into the Wine prefix\\\u0022; fi; for f in \\\u0022{{$FullRootDir}}.proton\\\u0022/*; do [[ \\\u0022$f\\\u0022 == */compatdata ]] || rm -rf \\\u0022$f\\\u0022; done; elif [[ -x \\\u0022{{$FullRootDir}}.proton/proton\\\u0022 ]]; then echo \\\u0022WARNING: Wine was not found at /usr/bin/wine, so this instance keeps running on its current Proton GE version, which is no longer updated. To switch to Wine, remove this shard\u0027s container image override or set it to cubecoders/ampbase:wine-stable, or install Wine (latest stable from winehq.org) on the host of a native shard.\\\u0022; else echo \\\u0022ERROR: Wine was not found at /usr/bin/wine. To switch to Wine, remove this shard\u0027s container image override or set it to cubecoders/ampbase:wine-stable, or install Wine (latest stable from winehq.org) on the host of a native shard.\\\u0022; exit 1; fi\u0022"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Prefix Sound",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022[[ -x /usr/bin/wine ]] || exit 0; cd scum \u0026\u0026 [[ -f winetricks ]] \u0026\u0026 rm -f winetricks; wget -q https://raw.githubusercontent.com/Winetricks/winetricks/refs/tags/20260125/src/winetricks \u0026\u0026 chmod \u002Bx winetricks; export WINEPREFIX=\\\u0022{{$FullRootDir}}.wine\\\u0022; export WINEARCH=win64; ./winetricks sound=disabled \u003E winescript_log.txt 2\u003E\u00261\u0022",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Config Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}SCUM/Saved/Config/WindowsServer"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "ServerSettings.ini File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/scum/serversettings.ini",
      "UpdateSourceArgs": "ServerSettings.ini",
      "UpdateSourceTarget": "{{$FullBaseDir}}SCUM/Saved/Config/WindowsServer"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 7777,
      "Protocol": "UDP",
      "ChildPorts": [
        {
          "Name": "port.ClientPort.name",
          "Description": "port.ClientPort.desc",
          "Ref": "ClientPort",
          "Port": 7779,
          "Offset": 2
        }
      ]
    },
    {
      "Name": "port.QueryPort.name",
      "Description": "port.QueryPort.desc",
      "Ref": "QueryPort",
      "Port": 27015,
      "Protocol": "UDP"
    }
  ],
  "Settings": [
