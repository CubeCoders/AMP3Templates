  "ConfigFileMappings": [
    {
      "ConfigFile": "garrysmod/cfg/server.cfg",
      "ConfigFileTemplate": "garrysmod/AMP_server.cfg",
      "ConfigType": "template",
      "AutoMap": true
    },
    {
      "ConfigFile": "garrysmod/lua/autorun/server/resource.lua",
      "ConfigFormat": "{0}{1}",
      "ConfigType": "kvp",
      "Subsections": [
        {
          "Heading": "$root",
          "SettingMappings": {
            "": "ResourceLuaCode"
          }
        }
      ]
    }
