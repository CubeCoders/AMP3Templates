{
  "Id": "3d7b363b-888e-4807-bd0c-93f03ceb8fde",
  "TemplateSlug": "garrys-mod",
  "Lifecycle": {
    "RootDir": "./garrysmod/",
    "BaseDirectory": "./garrysmod/4020/",
    "ExecutableWin": "4020\\srcds.exe",
    "ExecutableLinux": "4020/srcds_linux",
    "WorkingDir": "4020",
    "CommandLineArgs": "{{$PlatformArgs}} -game garrysmod -console -usercon -nobreakpad -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} {{insecure}}{{nohltv}}{{CustomParameters}} {{CustomConVars}} \u002Btv_port {{$SourceTVPort}} \u002Bclientport {{$ClientPort}} \u002Bsv_logfile 1 {{$FormattedArgs}} \u002Blog on \u002Blogaddress_add {{$UDPLogAddress}}:{{$UDPLogPort}}",
    "ApplicationReadyMode": "RCONConnected",
    "ExitString": "quit",
    "ExitFile": "lock"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "UDPLogger": true,
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "ForceIPBinding": true,
    "MaxUsers": 16,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": ".:bin:%LD_LIBRARY_PATH%",
      "SteamAppId": "4000"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "NotSupported",
    "Author": "Greelan",
    "URL": "https://gmod.facepunch.com/",
    "DisplayImageSource": "steam:4000",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "6",
    "MinAMPVersion": "2.4.7",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^Connection to Steam servers successful\\.$",
    "UserJoinRegex": "^.*[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C\u003E\u0022 entered the game$",
    "UserLeaveRegex": "^.*[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C.*\u003E\u0022 disconnected \\(reason \u0022.*\u0022\\)$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "ServerPort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "ServerPort",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "Garry\u0027s Mod Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "4020",
      "UpdateSourceArgs": "4000",
      "UpdateSourceVersion": "{{ServerBranch}}"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server.cfg Template File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/garrys-mod/server.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullRootDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "CSS Content Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "232330",
      "UpdateSourceArgs": "4000",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "install",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Mount CSS Content",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022sed -i \\\u0022/^.*\\\\\\\u0022cstrike\\\\\\\u0022.*$/ { s//\\t\\\\\\\u0022cstrike\\\\\\\u0022\\t\\\\\\\u0022..\\/232330\\/cstrike\\\\\\\u0022/ }\\\u0022 garrysmod/4020/garrysmod/cfg/mount.cfg\u0022",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "install",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Mount CSS Content",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \u0022(Get-Content \u0027garrysmod\\4020\\garrysmod\\cfg\\mount.cfg\u0027) -replace \u0027^.*\\\u0022cstrike\\\u0022.\u002B$\u0027, \u0027    \\\u0022cstrike\\\u0022   \\\u0022..\\232330\\cstrike\\\u0022\u0027 | Set-Content \u0027garrysmod\\4020\\garrysmod\\cfg\\mount.cfg\u0027\u0022",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "install",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "TF2 Content Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "232250",
      "UpdateSourceArgs": "4000",
      "UpdateSourceConditionSetting": "TF2Content",
      "UpdateSourceConditionValue": "install",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Mount TF2 Content",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022sed -i \\\u0022/^.*\\\\\\\u0022tf\\\\\\\u0022.*$/ { s//\\t\\\\\\\u0022tf\\\\\\\u0022\\t\\t\\\\\\\u0022..\\/232250\\/tf\\\\\\\u0022/ }\\\u0022 garrysmod/4020/garrysmod/cfg/mount.cfg\u0022",
      "UpdateSourceConditionSetting": "TF2Content",
      "UpdateSourceConditionValue": "install",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Mount TF2 Content",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \u0022(Get-Content \u0027garrysmod\\4020\\garrysmod\\cfg\\mount.cfg\u0027) -replace \u0027^.*\\\u0022tf\\\u0022.\u002B$\u0027, \u0027    \\\u0022tf\\\u0022        \\\u0022..\\232250\\tf\\\u0022\u0027 | Set-Content \u0027garrysmod\\4020\\garrysmod\\cfg\\mount.cfg\u0027\u0022",
      "UpdateSourceConditionSetting": "TF2Content",
      "UpdateSourceConditionValue": "install",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Unmount CSS Content",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022sed -i \\\u0022/^.*\\\\\\\u0022cstrike\\\\\\\u0022/ { s//\\/\\/\\t\\\\\\\u0022cstrike\\\\\\\u0022/ }\\\u0022 garrysmod/4020/garrysmod/cfg/mount.cfg\u0022",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "remove",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Unmount CSS Content",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \u0022(Get-Content \u0027garrysmod\\4020\\garrysmod\\cfg\\mount.cfg\u0027) -replace \u0027^.*\\\u0022cstrike\\\u0022\u0027, \u0027//  \\\u0022cstrike\\\u0022\u0027 | Set-Content \u0027garrysmod\\4020\\garrysmod\\cfg\\mount.cfg\u0027\u0022",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "remove",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "CSS Content Removal",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd garrysmod \u0026\u0026 rm -rf 232330 \u003E/dev/null 2\u003E\u00261\u0022",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "remove",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "CSS Content Removal",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C cd garrysmod \u0026\u0026 rd /S /Q 232330 \u003E NUL 2\u003E\u00261",
      "UpdateSourceConditionSetting": "CSSContent",
      "UpdateSourceConditionValue": "remove",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Unmount TF2 Content",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022sed -i \\\u0022/^.*\\\\\\\u0022tf\\\\\\\u0022/ { s//\\/\\/\\t\\\\\\\u0022tf\\\\\\\u0022/ }\\\u0022 garrysmod/4020/garrysmod/cfg/mount.cfg\u0022",
      "UpdateSourceConditionSetting": "TF2Content",
