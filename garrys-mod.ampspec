  "Locale": {
    "en": {
      "meta.name": "Garry\u0027s Mod",
      "meta.description": "Garry\u0027s Mod Dedicated Server",
      "setting.hostname.name": "Server Name",
      "setting.hostname.desc": "Sets the name of the server that appears in the server list",
      "category.garry-s-mod": "Garry\u0027s Mod",
      "category.server": "Server",
      "setting.sv_lan.name": "LAN Server",
      "setting.sv_lan.desc": "If enabled, the server will operate as a LAN server: no heartbeat, no authentication, and no non-class C addresses",
      "setting.sv_lan.value.False": "0",
      "setting.sv_lan.value.True": "1",
      "setting.sv_setsteamaccount.name": "Game Server Login Token (GSLT)",
      "setting.sv_setsteamaccount.desc": "Sets the [Steam Game Server Login Token](https://steamcommunity.com/dev/managegameservers) for the server, otherwise the server\u0027s ranking will be impacted in the server browser. Use app ID 4000 when generating the token",
      "setting.sv_password.name": "Server Password",
      "setting.sv_password.desc": "Sets the password required to connect to the server. Default is no password",
      "setting.$RemoteAdminPassword.name": "RCON Password",
      "setting.$RemoteAdminPassword.desc": "See the Security and Privacy menu for configurable options for the server\u0027s RCON",
      "setting.gamemode.name": "Initial Gamemode",
      "setting.gamemode.desc": "Sets the [gamemode](https://steamcommunity.com/workshop/browse/?appid=4000\u0026searchtext=\u0026childpublishedfileid=0\u0026browsesort=trend\u0026section=readytouseitems\u0026requiredtags%5B%5D=Gamemode\u0026created_date_range_filter_start=0\u0026created_date_range_filter_end=0\u0026updated_date_range_filter_start=0\u0026updated_date_range_filter_end=0) to start the server with. You can use another gamemode by selecting \u0022Custom\u0022 and specifying the gamemode in Custom Gamemode. The gamemode must be in \u0027garrysmod/gamemodes\u0027 or \u0027garrysmod/addons\u0027",
      "setting.gamemode.value.sandbox": "Sandbox (default)",
      "setting.gamemode.value.terrortown": "Trouble in Terrorist Town",
      "setting.gamemode.value._CustomGamemode_": "--Custom--",
      "setting.CustomGamemode.name": "Custom Gamemode",
      "setting.CustomGamemode.desc": "Sets a custom gamemode to use for the Initial Gamemode, if \u0022Custom\u0022 is selected",
      "setting.map.name": "Initial Map",
      "setting.map.desc": "Sets the [map](https://steamcommunity.com/workshop/browse/?appid=4000\u0026searchtext=\u0026childpublishedfileid=0\u0026browsesort=trend\u0026section=readytouseitems\u0026requiredtags%5B%5D=Map\u0026created_date_range_filter_start=0\u0026created_date_range_filter_end=0\u0026updated_date_range_filter_start=0\u0026updated_date_range_filter_end=0) to start the server with. You can use another map by selecting \u0022Custom\u0022 and specifying the map in Custom Map. The map must be in \u0027garrysmod/maps\u0027 or in a workshop collection downloaded under Workshop Collection ID",
      "setting.map.value.gm_construct": "Construct (default)",
      "setting.map.value.gm_flatgrass": "Flatgrass",
      "setting.map.value._CustomMap_": "--Custom--",
      "setting.CustomMap.name": "Custom Map",
      "setting.CustomMap.desc": "Sets a custom map to use for the Initial Map, if \u0022Custom\u0022 is selected. Must be a map appropriate for the specified Initial Gamemode",
      "setting.mp_timelimit.name": "Map Game Time Limit",
      "setting.mp_timelimit.desc": "Sets the game time per map. 0 = disabled",
      "setting.host_workshop_collection.name": "Workshop Collection ID",
      "setting.host_workshop_collection.desc": "Sets the ID of a [Steam workshop collection](https://steamcommunity.com/workshop/browse/?appid=4000\u0026browsesort=trend\u0026section=collections) to download and load on the server",
      "setting.ResourceLuaCode.name": "Resource Lua Code",
      "setting.ResourceLuaCode.desc": "Sets the [code](https://www.yourdevtools.com/gmod/workshop) to force players to automatically download the corresponding workshop collection addons when connecting",
      "setting.CSSContent.name": "CSS Content Mode",
      "setting.CSSContent.desc": "Sets how to handle Counter Strike: Source content for the server. Update the server after changing this setting (unless \u0022Do nothing\u0022 is selected)",
      "setting.CSSContent.value.none": "Do nothing",
      "setting.CSSContent.value.install": "Install and mount content",
      "setting.CSSContent.value.remove": "Unmount and remove content",
      "setting.TF2Content.name": "TF2 Content Mode",
      "setting.TF2Content.desc": "Sets how to handle Team Fortress 2 content for the server. Update the server after changing this setting (unless \u0022Do nothing\u0022 is selected)",
      "setting.TF2Content.value.none": "Do nothing",
      "setting.TF2Content.value.install": "Install and mount content",
      "setting.TF2Content.value.remove": "Unmount and remove content",
      "setting.sv_region.name": "Server Region",
      "setting.sv_region.desc": "Sets the server region shown in the server browser",
      "setting.sv_region.value.-1": "No region",
      "setting.sv_region.value.0": "East Coast US",
      "setting.sv_region.value.1": "West Coast US",
      "setting.sv_region.value.2": "South America",
      "setting.sv_region.value.3": "Europe",
      "setting.sv_region.value.4": "Asia",
      "setting.sv_region.value.5": "Australia",
      "setting.sv_region.value.6": "Middle East",
      "setting.sv_region.value.7": "Africa",
      "setting.sv_region.value.255": "World",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server at one time",
      "setting.mp_allowspectators.name": "Allow Spectators",
      "setting.mp_allowspectators.desc": "If set, spectator mode will be enabled",
      "setting.mp_allowspectators.value.False": "0",
      "setting.mp_allowspectators.value.True": "1",
      "setting.sv_pure.name": "Pure Server Mode",
      "setting.sv_pure.desc": "Sets whether clients are only allowed to use certain files",
      "setting.sv_pure.value.-1": "Do not restrict client files",
      "setting.sv_pure.value.0": "Apply rules in \u0027pure_server_minimal.txt\u0027 only",
      "setting.sv_pure.value.1": "Apply rules in \u0027pure_server_full.txt\u0027 and then \u0027pure_server_whitelist.txt\u0027",
      "setting.sv_pure.value.2": "Apply rules in \u0027pure_server_full.txt\u0027",
      "setting.sv_cheats.name": "Enable Cheats",
      "setting.sv_cheats.desc": "If set, cheat convars will be allowed to be used on the server",
      "setting.sv_cheats.value.False": "0",
      "setting.sv_cheats.value.True": "1",
      "setting.sv_filterban.name": "Enable IP Packet Filter",
      "setting.sv_filterban.desc": "If set, enables packet filtering by IP mode. If disabled, everyone will treated as IP-banned, but their IP won\u0027t be added to the banlist",
      "setting.sv_filterban.value.False": "0",
      "setting.sv_filterban.value.True": "1",
      "setting.sv_loadingurl.name": "Loading URL",
      "setting.sv_loadingurl.desc": "Sets the URL to show to clients while joining the server. Must start with http:// or https://",
      "setting.sv_allowdownload.name": "Allow Download From Server",
      "setting.sv_allowdownload.desc": "If set, clients will be allowed to download content from the server (maps, sprays and related)",
      "setting.sv_allowdownload.value.False": "0",
      "setting.sv_allowdownload.value.True": "1",
      "setting.sv_downloadurl.name": "Fast Download URL",
      "setting.sv_downloadurl.desc": "Sets the URL for clients to download custom content from, instead of sourcing the content from the server. This allows for faster downloads",
      "setting.sv_allowupload.name": "Allow Upload To Server",
      "setting.sv_allowupload.desc": "If set, clients will be allowed to upload customisation files to the server",
      "setting.sv_allowupload.value.False": "0",
      "setting.sv_allowupload.value.True": "1",
      "setting.net_maxfilesize.name": "Maximum Upload File Size",
      "setting.net_maxfilesize.desc": "Sets the maximum allowed file size for uploading to the server",
      "setting.sv_minrate.name": "Minimum Client Rate",
      "setting.sv_minrate.desc": "Sets the minimum allowable bandwidth rate a client may have set when connected to the server. 0 = no minimum",
      "setting.sv_maxrate.name": "Maximum Client Rate",
      "setting.sv_maxrate.desc": "Sets the maximum allowable bandwidth rate a client may have set when connected to the server. 0 = no limit",
      "setting.sv_minupdaterate.name": "Minimum Server Update Rate",
      "setting.sv_minupdaterate.desc": "Sets the minimum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.sv_maxupdaterate.name": "Maximum Server Update Rate",
      "setting.sv_maxupdaterate.desc": "Sets the maximum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.decalfrequency.name": "Decal Frequency",
      "setting.decalfrequency.desc": "Sets the time between decal sprays",
      "setting.pingboost.name": "Ping Boost",
      "setting.pingboost.desc": "Selects between optimised network code stack. Setting at 2 usually reduces latency toward 1ms without loss of activity input packets",
      "setting.pingboost.value._": "None",
      "setting.pingboost.value.-pingboost_1_": "1",
      "setting.pingboost.value.-pingboost_2_": "2",
      "setting.pingboost.value.-pingboost_3_": "3",
      "setting.mp_logmessages.name": "Log Chat Messages",
      "setting.mp_logmessages.desc": "If set, logging of chat messages will be enabled",
      "setting.mp_logmessages.value.False": "0",
      "setting.mp_logmessages.value.True": "1",
      "setting.insecure.name": "Disable Valve Anti-Cheat",
      "setting.insecure.desc": "If set, Valve Anti-Cheat (VAC) will be disabled",
      "setting.insecure.value.True": "-insecure ",
      "setting.ip.name": "Server/RCON IPv4 IP Binding",
      "setting.ip.desc": "If required, you can change the IPv4 IP binding of the server and RCON by changing the Application IP Binding for this instance. NOTE: AMP requires the server to be bound to a specific IP, rather than 0.0.0.0, for the server to log to AMP\u0027s console. The IP must also be reachable by AMP",
      "setting.CustomParameters.name": "Additional Command Line Parameters",
      "setting.CustomParameters.desc": "Specifies additional command line parameters (anything that begins with a -) that are not otherwise set by AMP. Use with care",
      "setting.CustomConVars.name": "Additional Console Variables",
      "setting.CustomConVars.desc": "Specifies additional [console variables](https://developer.valvesoftware.com/wiki/List_of_Garry%27s_Mod_console_commands_and_variables) (anything that begins with a \u002B) that are not otherwise set by AMP. Use with care. Preferably, specify the equivalent under \u0022Additional Server Settings\u0022",
      "setting.UserSettings.name": "Additional Server Settings",
      "setting.UserSettings.desc": "Specifies additional settings to include in \u0022server.cfg\u0022 that are not otherwise set by AMP. One setting per line",
      "setting.PowerUserSettings.name": "Advanced/Power User Server Settings",
      "setting.PowerUserSettings.desc": "For advanced/power users, specifies additional settings to include in \u0022server.cfg\u0022 that override any settings set by AMP in that file. One setting per line. USE AT YOUR OWN RISK",
      "setting.mp_friendlyfire.name": "Enable Friendly Fire",
      "setting.mp_friendlyfire.desc": "If set, friendly fire will be enabled (teammates can cause damage to other teammates)",
      "category.gameplay": "Gameplay",
      "setting.mp_friendlyfire.value.False": "0",
      "setting.mp_friendlyfire.value.True": "1",
      "setting.mp_flashlight.name": "Enable Flashlight",
      "setting.mp_flashlight.desc": "If sets, allows the use of the flashlight by pressing the F button",
      "setting.mp_flashlight.value.False": "0",
      "setting.mp_flashlight.value.True": "1",
      "setting.mp_footsteps.name": "Enable Footsteps",
      "setting.mp_footsteps.desc": "If set, footstep sounds will be enabled",
      "setting.mp_footsteps.value.False": "0",
      "setting.mp_footsteps.value.True": "1",
      "setting.mp_autocrosshair.name": "Enable Auto Crosshair",
