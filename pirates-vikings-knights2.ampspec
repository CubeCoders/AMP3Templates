{
  "Id": "292b7f25-3f48-4d87-9e29-660a214ac90e",
  "TemplateSlug": "pirates-vikings-knights2",
  "Lifecycle": {
    "RootDir": "./pvkii/",
    "BaseDirectory": "./pvkii/17575/",
    "ExecutableWin": "17575\\srcds_win{{ServerVersion}}.exe",
    "ExecutableLinux": "17575/srcds_linux{{ServerVersion}}",
    "WorkingDir": "17575",
    "CommandLineArgs": "{{$PlatformArgs}} -game pvkii -console -usercon -nobreakpad -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} -tickrate {{tickrate}} {{insecure}}{{nohltv}}{{CustomParameters}} {{CustomConVars}} \u002Btv_port {{$SourceTVPort}} \u002Bclientport {{$ClientPort}} \u002Bsv_logfile 1 {{$FormattedArgs}} \u002Bexec server.cfg \u002Bmap {{map}} \u002Blog on \u002Blogaddress_add {{$UDPLogAddress}}:{{$UDPLogPort}}",
    "ApplicationReadyMode": "RCONConnected",
    "ExitString": "quit",
    "ExitFile": "lock"
  },
  "Management": {
    "HasWriteableConsole": false,
    "HasReadableConsole": false,
    "UDPLogger": true,
    "AdminMethod": "SourceRCON",
    "UseRandomAdminPassword": true,
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "ForceIPBinding": true,
    "MaxUsers": 24,
    "EnvironmentVariables": {
      "LD_LIBRARY_PATH": "{{$FullBaseDir}}:{{$FullBaseDir}}bin:{{$FullBaseDir}}bin/x64:{{$FullBaseDir}}bin/sniper-runtime/usr/lib/i386-linux-gnu:{{$FullBaseDir}}bin/sniper-runtime/usr/lib32:{{$FullBaseDir}}bin/x64/sniper-runtime/usr/lib/x86_64-linux-gnu:{{$FullBaseDir}}bin/x64/sniper-runtime/usr/lib64:{{$FullBaseDir}}bin/steam:{{$FullBaseDir}}bin/x64/steam:%LD_LIBRARY_PATH%",
      "SteamAppId": "17570"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "AarchSupport": "NotSupported",
    "Author": "Greelan",
    "URL": "https://www.pvkii.com/",
    "DisplayImageSource": "steam:17570",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "4",
    "MinAMPVersion": "2.6.0.0",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.\u002B$",
    "AppReadyRegex": "^$",
    "UserJoinRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C\u003E\u0022 entered the game$",
    "UserLeaveRegex": "^(?:L )?[\\d\\/]\u002B - [\\d:]\u002B: \u0022(?\u003Cusername\u003E.\u002B?)\u003C\\d\u002B\u003E\u003C(BOT|(?\u003Cuserid\u003E(?!BOT).\u002B?))\u003E\u003C.*\u003E\u0022 disconnected \\(reason \u0022.*\u0022\\)$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]\u002B.$"
  },
  "PortReferences": {
    "AdminPortRef": "ServerPort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "ServerPort",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "SteamCMD",
      "UpdateStageName": "SteamCMD Server Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "17575",
      "UpdateSourceArgs": "17570"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server.cfg Template File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/pirates-vikings-knights2/server.cfg",
      "UpdateSourceArgs": "AMP_server.cfg",
      "UpdateSourceTarget": "{{$FullRootDir}}",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Metamod Download",
      "UpdateSourceData": "{{MetamodBuild.downloadUrl}}-linux.tar.gz",
      "UpdateSourceArgs": "metamod.tar.gz",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Metamod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{MetamodBuild.downloadUrl}}-windows.zip",
      "UpdateSourceArgs": "metamod.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourceData": "{{$FullRootDir}}metamod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}pvkii",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "Metamod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullRootDir}}metamod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}pvkii",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "SourceMod Download Directory Creation",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}sm",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourceData": "{{SourceModBuild.downloadUrl}}-linux.tar.gz",
      "UpdateSourceArgs": "sourcemod.tar.gz",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "SourceMod Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{SourceModBuild.downloadUrl}}-windows.zip",
      "UpdateSourceArgs": "sourcemod.zip",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourceData": "{{$FullRootDir}}sourcemod.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "ExtractArchive",
      "UpdateStageName": "SourceMod Extract",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "{{$FullRootDir}}sourcemod.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}sm",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "powershell.exe",
      "UpdateSourceArgs": "-NoProfile -Command \u0022Set-Location -Path \u0027pvkii/17575\u0027; if (Test-Path \u0027pvkii/cfg/sourcemod\u0027) { Remove-Item -Path \u0027sm/cfg/sourcemod\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027pvkii/addons/sourcemod/configs\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/configs\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; if (Test-Path \u0027pvkii/addons/sourcemod/plugins\u0027) { Remove-Item -Path \u0027sm/addons/sourcemod/plugins\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null }; Copy-Item -Path \u0027sm/*\u0027 -Destination \u0027pvkii\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; Remove-Item -Path \u0027sm\u0027 -Recurse -Force -ErrorAction SilentlyContinue | Out-Null\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "SourceMod Installation",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd pvkii/17575 \u0026\u0026 [ -d pvkii/cfg/sourcemod ] \u0026\u0026 rm -rf sm/cfg/sourcemod \u003E/dev/null 2\u003E\u00261; [ -d pvkii/addons/sourcemod/configs ] \u0026\u0026 rm -rf sm/addons/sourcemod/configs \u003E/dev/null 2\u003E\u00261; [ -d pvkii/addons/sourcemod/plugins ] \u0026\u0026 rm -rf sm/addons/sourcemod/plugins \u003E/dev/null 2\u003E\u00261; \\cp -rf sm/* pvkii/ \u003E/dev/null 2\u003E\u00261; rm -rf sm \u003E/dev/null 2\u003E\u00261\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true",
      "SkipOnFailure": true
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../pvkii/addons/metamod/bin/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}pvkii/addons/metamod.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../pvkii/addons/metamod/bin/win64/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}pvkii/addons/metamod_x64.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
      "UpdateSourceData": "\u0022Plugin\u0022\n{\n\t\u0022file\u0022\t\u0022../pvkii/addons/metamod/bin/linux64/server\u0022\n}",
      "UpdateSourceArgs": "{{$FullBaseDir}}pvkii/addons/metamod_x64.vdf",
      "OverwriteExistingFiles": true,
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "true"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C cd pvkii\\17575\\pvkii\\addons \u003E NUL 2\u003E\u00261 \u0026\u0026 del /Q /F metamod.vdf metamod_x64.vdf \u003E NUL 2\u003E\u00261 \u0026 exit /b 0",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Disable Metamod and SourceMod",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \u0022cd pvkii/17575/pvkii/addons \u003E/dev/null 2\u003E\u00261 \u0026\u0026 rm -rf metamod.vdf metamod_x64.vdf \u003E/dev/null 2\u003E\u00261; exit 0\u0022",
      "UpdateSourceConditionSetting": "InstallMod",
      "UpdateSourceConditionValue": "false"
    }
  ],
  "PreStartStages": [
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Activate Metamod and SourceMod",
