      "setting.CustomMap.name": "Custom Initial Map",
      "setting.CustomMap.desc": "Sets a custom map to use for the Initial Map, if \u0022Custom\u0022 is selected",
      "setting.sv_region.name": "Server Region",
      "setting.sv_region.desc": "Sets the server region shown in the server list",
      "setting.sv_region.value.-1": "No region",
      "setting.sv_region.value.0": "East Coast US",
      "setting.sv_region.value.1": "West Coast US",
      "setting.sv_region.value.2": "South America",
      "setting.sv_region.value.3": "Europe",
      "setting.sv_region.value.4": "Asia",
      "setting.sv_region.value.5": "Australia",
      "setting.sv_region.value.6": "Middle East",
      "setting.sv_region.value.7": "Africa",
      "setting.sv_region.value.255": "World",
      "setting.$MaxUsers.name": "User Limit",
      "setting.$MaxUsers.desc": "Sets the maximum number of users allowed on the server at one time",
      "setting.sv_visiblemaxplayers.name": "Visible Player Limit",
      "setting.sv_visiblemaxplayers.desc": "Sets the maximum players reported to prospective clients, regardless of the Player Limit. -1 = disabled",
      "setting.mp_allowspectators.name": "Allow Spectators",
      "setting.mp_allowspectators.desc": "If set, spectator mode will be enabled",
      "setting.sv_pure.name": "Pure Server Mode",
      "setting.sv_pure.desc": "Sets whether clients are only allowed to use certain files",
      "setting.sv_pure.value.-1": "Do not restrict client files",
      "setting.sv_pure.value.0": "Apply rules in \u0027pure_server_minimal.txt\u0027 only",
      "setting.sv_pure.value.1": "Apply rules in \u0027pure_server_full.txt\u0027 and then \u0027pure_server_whitelist.txt\u0027",
      "setting.sv_pure.value.2": "Apply rules in \u0027pure_server_full.txt\u0027",
      "setting.sv_pure_kick_clients.name": "Kick Clients On Pure Server",
      "setting.sv_pure_kick_clients.desc": "If enabled, the server will kick clients with mismatching files. Otherwise, it will issue a warning to the clients",
      "setting.sv_forcepreload.name": "Force Preload",
      "setting.sv_forcepreload.desc": "If set, server side preloading will be forced",
      "setting.sv_cheats.name": "Enable Cheats",
      "setting.sv_cheats.desc": "If set, cheat convars will be allowed to be used on the server",
      "setting.insecure.name": "Disable Valve Anti-Cheat",
      "setting.insecure.desc": "If set, Valve Anti-Cheat (VAC) will be disabled",
      "setting.sv_filterban.name": "Enable IP Packet Filter",
      "setting.sv_filterban.desc": "If set, enables packet filtering by IP mode. If disabled, everyone will treated as IP-banned, but their IP won\u0027t be added to the banlist",
      "setting.tickrate.name": "Server Tickrate",
      "setting.tickrate.desc": "Sets the server tickrate",
      "setting.sv_allowdownload.name": "Allow Download From Server",
      "setting.sv_allowdownload.desc": "If set, clients will be allowed to download content from the server (maps, sprays and related)",
      "setting.sv_downloadurl.name": "Fast Download URL",
      "setting.sv_downloadurl.desc": "Sets the URL for clients to download custom content from, instead of sourcing the content from the server. This allows for faster downloads",
      "setting.sv_allowupload.name": "Allow Upload To Server",
      "setting.sv_allowupload.desc": "If set, clients will be allowed to upload customisation files to the server",
      "setting.net_maxfilesize.name": "Maximum File Size",
      "setting.net_maxfilesize.desc": "Sets the maximum allowed file size for uploading to the server",
      "setting.sv_minrate.name": "Minimum Client Rate",
      "setting.sv_minrate.desc": "Sets the minimum allowable bandwidth rate a client may have set when connected to the server. 0 = no minimum",
      "setting.sv_maxrate.name": "Maximum Client Rate",
      "setting.sv_maxrate.desc": "Sets the maximum allowable bandwidth rate a client may have set when connected to the server. 0 = no limit",
      "setting.sv_minupdaterate.name": "Minimum Server Update Rate",
      "setting.sv_minupdaterate.desc": "Sets the minimum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.sv_maxupdaterate.name": "Maximum Server Update Rate",
      "setting.sv_maxupdaterate.desc": "Sets the maximum number of updates per second of the positions of the server\u0027s models (players, guns, etc) that server sends to clients",
      "setting.pingboost.name": "Ping Boost",
      "setting.pingboost.desc": "Selects between optimised network code stack. Setting at 2 usually reduces latency toward 1ms without loss of activity input packets",
      "setting.pingboost.value._": "None",
      "setting.pingboost.value.-pingboost_1_": "1",
      "setting.pingboost.value.-pingboost_2_": "2",
      "setting.pingboost.value.-pingboost_3_": "3",
      "setting.sv_stats.name": "Enable CPU Stats Collection",
      "setting.sv_stats.desc": "If set, CPU stats will be collected",
      "setting.ip.name": "Server/RCON IPv4 IP Binding",
      "setting.ip.desc": "If required, you can change the IPv4 IP binding of the server and RCON by changing the Application IP Binding for this instance. NOTE: AMP requires the server to be bound to a specific IP, rather than 0.0.0.0, for the server to log to AMP\u0027s console. The IP must also be reachable by AMP",
      "setting.CustomParameters.name": "Additional Command Line Parameters",
      "setting.CustomParameters.desc": "Specifies additional [command line parameters](https://developer.valvesoftware.com/wiki/Command_line_options#Command-Line_Parameters_6) (anything that begins with a -) that are not otherwise set by AMP. Use with care",
      "setting.CustomConVars.name": "Additional Console Variables",
      "setting.CustomConVars.desc": "Specifies additional console variables (anything that begins with a \u002B) that are not otherwise set by AMP. Use with care. Preferably, specify the equivalent under \u0022Additional Server Settings\u0022",
      "setting.UserSettings.name": "Additional Server Settings",
      "setting.UserSettings.desc": "Specifies additional settings to include in \u0027server.cfg\u0027 that are not otherwise set by AMP. One setting per line",
      "setting.mp_friendlyfire.name": "Enable Friendly Fire",
      "setting.mp_friendlyfire.desc": "If set, friendly fire will be enabled (teammates can cause damage to other teammates)",
      "category.gameplay": "Gameplay",
      "setting.mp_footsteps.name": "Enable Footsteps",
      "setting.mp_footsteps.desc": "If set, the server will always play footstep sounds",
      "setting.mp_teamplay.name": "Enable Teamplay",
      "setting.mp_teamplay.desc": "If enabled, teamplay game rules will apply",
      "setting.sv_pausable.name": "Allow Players To Pause Server",
      "setting.sv_pausable.desc": "If set, players will be able to pause the server. Not recommended",
      "setting.sv_allow_wait_command.name": "Allow Wait Command",
      "setting.sv_allow_wait_command.desc": "If enabled, the wait command will be allowed on clients connected to the server. Recommended to keep disabled to prevent server crash exploits",
      "setting.sv_voiceenable.name": "Enable Voice Communication",
      "setting.sv_voiceenable.desc": "If set, voice communication will be enabled on the server",
      "setting.sv_alltalk.name": "Allow All Talk",
      "setting.sv_alltalk.desc": "If enabled, players can communicate with all other players, with no team restrictions",
      "setting.mp_forcerespawn.name": "Force Respawn",
      "setting.mp_forcerespawn.desc": "If enabled, players will be forced to respawn after death",
      "setting.mp_fadetoblack.name": "Enable Fade To Black",
      "setting.mp_fadetoblack.desc": "If enabled, a player\u0027s screen fades to black for the remainder of the round after death (HUD and chat still works)",
      "setting.mp_timelimit.name": "Map Rotation Time Limit",
      "setting.mp_timelimit.desc": "Sets the game time per map. 0 = disabled",
      "setting.mp_timelimit_waitroundend.name": "Rotate Map Only After Round End",
      "setting.mp_timelimit_waitroundend.desc": "If set, the server will wait for the end of round before changing map",
      "setting.mp_fraglimit.name": "Round Kill Limit",
      "setting.mp_fraglimit.desc": "Sets the number of kills at which the map ends. 0 = disabled",
      "setting.mp_winlimit.name": "Win Limit",
      "setting.mp_winlimit.desc": "Sets the win limit in number of rounds. 0 = disabled",
      "setting.mp_roundtime.name": "Round Time",
      "setting.mp_roundtime.desc": "Sets the round time",
      "setting.mp_roundlimit.name": "Round Limit",
      "setting.mp_roundlimit.desc": "Sets the number of rounds to play for the versus game mode",
      "setting.mp_forcecamera.name": "Restrict Spectator Mode",
      "setting.mp_forcecamera.desc": "If set, the spectator mode for dead players will be restricted",
      "setting.sv_alternateticks.name": "Alternate Ticks",
      "setting.sv_alternateticks.desc": "If set, the server only simulates entities on even numbered ticks",
      "setting.nohltv.name": "Disable SourceTV",
      "setting.nohltv.desc": "If set, SourceTV will be disabled on the server",
      "category.sourcetv": "SourceTV",
      "setting.tv_autorecord.name": "Enable Automatic Demo Recording",
      "setting.tv_autorecord.desc": "If set, all games will be recorded as SourceTV demos",
      "setting.tv_maxclients.name": "SourceTV Viewer Limit",
      "setting.tv_maxclients.desc": "Sets the maximum number of clients allowed to connect to the server\u0027s SourceTV. 0 = no SourceTV viewers are allowed, the game will only be recorded locally",
      "setting.tv_maxrate.name": "Maximum SourceTV Bandwidth",
      "setting.tv_maxrate.desc": "Sets the maximum SourceTV spectator bandwidth rate allowed. 0 = unlimited",
      "setting.ServerVersion.name": "Server Version",
      "setting.ServerVersion.desc": "Sets whether to run the 64 bit or 32 bit version of the server",
      "category.updates": "Updates",
      "category.runtime-configuration": "Runtime Configuration",
      "setting.ServerVersion.value.32": "32 bit (default)",
      "setting.ServerVersion.value.64": "64 bit",
      "setting.InstallMod.name": "Metamod and SourceMod Management",
      "setting.InstallMod.desc": "Sets how to manage Metamod and SourceMod on the server. Branch and Build Versions must be set accordingly for installation. Update the server after changing this setting (unless \u0022Do nothing\u0022 is selected)",
      "setting.InstallMod.value.none": "Do nothing (default)",
      "setting.InstallMod.value.false": "Deactivate mods",
      "setting.InstallMod.value.true": "Install and activate mods",
      "setting.MetamodBranch.name": "Metamod Branch",
      "setting.MetamodBranch.desc": "Specifies the [Metamod](https://www.metamodsource.net/downloads.php) branch to install",
      "setting.MetamodBranch.value.1_11": "Old stable (1.11)",
      "setting.MetamodBranch.value.1_12": "Stable (1.12) (default)",
      "setting.MetamodBranch.value.2_0": "Development (2.0)",
      "setting.MetamodBuild.name": "Metamod Build Version",
      "setting.MetamodBuild.desc": "Specifies the [Metamod build version](https://www.metamodsource.net/downloads.php) to install from the branch specified under Metamod Branch.",
      "setting.SourceModBranch.name": "SourceMod Branch",
      "setting.SourceModBranch.desc": "Specifies the [SourceMod](https://www.sourcemod.net/downloads.php) branch to install",
      "setting.SourceModBranch.value.1_11": "Old stable (1.11)",
      "setting.SourceModBranch.value.1_12": "Stable (1.12) (default)",
      "setting.SourceModBranch.value.1_13": "Development (1.13)",
      "setting.SourceModBuild.name": "SourceMod Build Version",
      "setting.SourceModBuild.desc": "Specifies the [SourceMod build version](https://www.sourcemod.net/downloads.php) to install from the branch specified under SourceMod Branch.",
      "setting.$ApplicationIPBinding.name": "IP Binding",
      "setting.$ApplicationIPBinding.desc": "The network address the server binds its ports to. 0.0.0.0 binds every interface (recommended for most setups); set a specific address on multi-IP hosts.",
      "category.networking": "Networking",
      "port.ServerPort.name": "Game and RCON Port",
      "port.ServerPort.desc": "Port for game and RCON traffic",
      "port.SourceTVPort.name": "SourceTV Port",
      "port.SourceTVPort.desc": "Port for SourceTV traffic",
      "port.ClientPort.name": "Client Port",
