{
  "Id": "c4021427-e349-48ef-9afe-99b3bc3560b3",
  "TemplateSlug": "teeworlds",
  "Lifecycle": {
    "RootDir": "./teeworlds/",
    "BaseDirectory": "./teeworlds/",
    "ExecutableWin": "teeworlds_srv.exe",
    "ExecutableLinux": "teeworlds_srv",
    "CommandLineArgs": "{{$PlatformArgs}} -f serverconfig.cfg",
    "CommandLineParameterFormat": "-{0} {1}",
    "ExitString": "shutdown",
    "ExitFile": "app_exit.lck"
  },
  "Management": {
    "AdminMethod": "TelnetRCON",
    "PersistRandomPassword": true,
    "RCONHeartbeatCommand": "ping",
    "IgnoreSTDOUTAfterRCON": true,
    "MaxUsers": 8,
    "EnvironmentVariables": {
      "SteamAppId": "380840"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Greelan",
    "URL": "https://teeworlds.com/",
    "DisplayImageSource": "steam:380840",
    "EndpointURIFormat": " ",
    "SpecificDockerImage": "cubecoders/ampbase:debian",
    "ConfigVersion": "3",
    "MinAMPVersion": "2.6.0.0",
    "AppIsMultiIPAware": true
  },
  "Console": {
    "ThrowawayMessageRegex": "^(WARNING|ERROR): Shader.+$",
    "AppReadyRegex": "^\\[[\\d-]+ [\\d:]+\\]\\[server\\]: version .*$",
    "UserJoinRegex": "^$",
    "UserLeaveRegex": "^$",
    "UserChatRegex": "^$",
    "UpdateAvailableRegex": "^\\[\\d\\d:\\d\\d:\\d\\d\\] \\[INFO\\] A new server update is available! v[\\d\\.]+.$"
  },
  "PortReferences": {
    "AdminPortRef": "ConsolePort",
    "PrimaryApplicationPortRef": "ServerPort",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server Download",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "https://github.com/teeworlds/teeworlds/releases/download/0.7.5/teeworlds-0.7.5-win64.zip",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "UnzipUpdateSource": true,
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Server Download",
      "UpdateSourceData": "https://github.com/teeworlds/teeworlds/releases/download/0.7.5/teeworlds-0.7.5-linux_x86_64.tar.gz",
      "UpdateSourceTarget": "{{$FullBaseDir}}",
      "UnzipUpdateSource": true,
      "OverwriteExistingFiles": true,
      "DeleteAfterExtract": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Server Files Copy",
      "UpdateSourcePlatform": "Windows",
      "UpdateSourceData": "cmd.exe",
      "UpdateSourceArgs": "/C cd teeworlds && del /Q /F teeworlds-0.7.5-win64\\storage.cfg > NUL 2>&1 && xcopy /E /Y /I teeworlds-0.7.5-win64\\* .\\ > NUL 2>&1 && rmdir /Q /S teeworlds-0.7.5-win64 > NUL 2>&1"
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Server Files Copy",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \"cd teeworlds && rm -f teeworlds-0.7.5-linux_x86_64/storage.cfg >/dev/null 2>&1 && \\cp -rf teeworlds-0.7.5-linux_x86_64/* ./ >/dev/null 2>&1 && rm -rf teeworlds-0.7.5-linux_x86_64 >/dev/null 2>&1\""
    },
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create User Directory",
      "UpdateSourcePlatform": "All",
      "UpdateSourceArgs": "{{$FullBaseDir}}user"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Serverconfig.cfg File Download",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "https://raw.githubusercontent.com/CubeCoders/AMP3Templates/main/configtemplates/teeworlds/serverconfig.cfg",
      "UpdateSourceArgs": "serverconfig.cfg",
      "UpdateSourceTarget": "{{$FullBaseDir}}user"
    },
    {
      "UpdateSource": "CreateFile",
      "UpdateStageName": "Create Storage.cfg File",
      "UpdateSourcePlatform": "All",
      "UpdateSourceData": "add_path user\nadd_path $DATADIR\nadd_path $CURRENTDIR",
      "UpdateSourceArgs": "{{$FullBaseDir}}storage.cfg"
    }
  ],
  "PortRequirements": [
    {
      "Name": "port.ServerPort.name",
      "Description": "port.ServerPort.desc",
      "Ref": "ServerPort",
      "Port": 8303,
      "Protocol": "UDP"
    },
    {
      "Name": "port.ConsolePort.name",
      "Description": "port.ConsolePort.desc",
      "Ref": "ConsolePort",
      "Port": 8304
    }
  ],
